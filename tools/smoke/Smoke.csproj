<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Toolchain smoke-test project (NOT part of the compiler).

    Its sole job is to prove the dev image is wired correctly: that the pinned
    LLVMSharp managed package restores under the pinned .NET SDK, and that at
    runtime it can dlopen the native libLLVM provided by the image and call into
    the LLVM-C API. See tools/smoke/Program.cs and tools/smoke/run.sh.

    Versions here must track docs/toolchain.md (TargetFramework <-> .NET SDK,
    LLVMSharp <-> native LLVM major).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET SDK 10.0 (LTS) -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- LLVMSharp.Interop's LLVM-C entry points take raw pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Managed LLVM bindings; major MUST equal the native libLLVM major (20). -->
    <PackageReference Include="LLVMSharp" Version="20.1.2" />
  </ItemGroup>

</Project>
