namespace Test.GenericsMonoinferUnit

import {
    collect: Suru.Compiler.Semantic.Mono.Collect
    mono: Suru.Compiler.Semantic.Mono.Infer
    nodes: Suru.Compiler.Parser.Nodes
}

export { main }

// Unit test for monoInfer.suru.
//
// Constructs a minimal GenericRegistry containing Pair<T, U> and a statement
// list containing:
//   let x Pair<i64, String>: <dummy-expr>
//
// Verifies that collectInstantiations produces exactly one InstantiationRequest
// for "Pair" with concrete types ["i64", "String"].
//
// Also verifies that a duplicate annotation produces only one request
// (deduplication), and that inferFromAnnotation alone works correctly.
fn main() {
    // ── Build a GenericRegistry with Pair<T, U> ──────────────────────────────

    let fields Array<Param>: []
    let f1 Param: nodes.newParam("first",  "T")
    let f2 Param: nodes.newParam("second", "U")
    fields.add(f1)
    fields.add(f2)

    let typeParams Array<String>: []
    typeParams.add("T")
    typeParams.add("U")

    let methods Array<MethodSig>: []
    let pairNode TypeDeclNode: { name: "Pair", fields: fields, methods: methods, typeParams: typeParams, isCType: false, line: 0, col: 0 }
    let def GenericTypeDef: collect.newGenericTypeDef("Pair", pairNode)

    let regTypes Array<GenericTypeDef>: []
    regTypes.add(def)
    let regFns Array<GenericFnDef>: []
    let regSumTypes Array<GenericSumTypeDef>: []
    let registry GenericRegistry: collect.newGenericRegistry(regFns, regTypes, regSumTypes)

    // ── Build stmts: one LetNode with typeName "Pair<i64, String>" ─────────
    // The value is a bare IntLitNode (contents don't matter for annotation inference).

    let litVal IntLitNode: { text: "0", resolvedType: "i64" }
    let letStmt LetNode: { name: "x", typeName: "Pair<i64, String>", value: litVal, line: 0, col: 0, srcPath: "" }

    let stmts Array<AstNode>: []
    stmts.add(letStmt)

    // ── collectInstantiations ─────────────────────────────────────────────────

    let reqs Array<InstantiationRequest>: mono.collectInstantiations(stmts, registry)
    printLn(reqs.len())

    let req InstantiationRequest: reqs.at(0)
    printLn(req.genericName)
    printLn(req.concreteTypes.at(0))
    printLn(req.concreteTypes.at(1))

    // ── Deduplication: two identical LetNodes → still one request ─────────────

    // Use a fresh litVal so letStmt2.value doesn't alias letStmt.value (would double-free on drop(stmts)).
    let litVal2 IntLitNode: { text: "0", resolvedType: "i64" }
    let letStmt2 LetNode: { name: "y", typeName: "Pair<i64, String>", value: litVal2, line: 0, col: 0, srcPath: "" }
    stmts.add(letStmt2)

    let reqs2 Array<InstantiationRequest>: mono.collectInstantiations(stmts, registry)
    printLn(reqs2.len())
    
    drop(reqs2)
    drop(reqs)
    drop(stmts)
    drop(registry)
}
