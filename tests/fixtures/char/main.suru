namespace Test.Char

fn main(args Array<String>) {
    // char literals and char.ord()
    let a char: 'a'
    let z char: 'z'
    let nl char: '\n'
    let bs char: '\\'
    let tab char: '\t'
    printLn(a.ord())    // 97
    printLn(z.ord())    // 122
    printLn(nl.ord())   // 10
    printLn(bs.ord())   // 92
    printLn(tab.ord())  // 9

    // char.equals()
    printLn(a.equals('a'))  // true
    printLn(a.equals('b'))  // false

    // char.toString()
    let sa String: a.toString()
    printLn(sa)  // a
    drop(sa)

    // String.__at(i64) → char
    let word String: "hello"
    let ch0 char: word.__at(0)
    let ch4 char: word.__at(4)
    printLn(ch0.ord())   // 104  (h)
    printLn(ch4.ord())   // 111  (o)
    drop(word)

    // match on char patterns
    match a {
        'a': { printLn("matched a") }
        'b': { printLn("matched b") }
        _:   { printLn("other") }
    }
    match z {
        'a': { printLn("matched a") }
        _:   { printLn("not a") }
    }

    // Array<char>: clone + drop. char is a 1-byte scalar element, so clone is a
    // bitcopy (no per-element dispatch); exercises the static-dispatch array path.
    let chars Array<char>: ['h', 'i', '!']
    printLn(chars.len())          // 3
    printLn(chars.at(0).ord())    // 104
    let charsCopy Array<char>: clone(chars)
    charsCopy.set('X', 0)
    printLn(charsCopy.at(0).ord())  // 88  (clone is independent)
    printLn(chars.at(0).ord())      // 104 (original unchanged)
    drop(charsCopy)
    drop(chars)
}
