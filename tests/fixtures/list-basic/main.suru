namespace Test.ListBasic

import { [List, newList]: Suru.Stdlib.List }

fn main(args Array<String>) {
    // --- add and at ---
    let arr List<i64>: newList()
    arr.add(10)
    arr.add(20)
    arr.add(30)
    arr.add(40)
    arr.add(50)
    printLn(arr.len().toString())      // 5
    printLn(arr.at(0).toString())      // 10
    printLn(arr.at(4).toString())      // 50

    // --- set ---
    arr.set(2, 99)
    printLn(arr.at(2).toString())      // 99

    // --- clone: changes to original do not affect clone ---
    let copy List<i64>: arr.clone()
    arr.set(0, 0)
    printLn(arr.at(0).toString())      // 0
    printLn(copy.at(0).toString())     // 10

    // --- slice [1,3): elements at index 1 and 2 ---
    let sl List<i64>: arr.slice(1, 3)
    printLn(sl.len().toString())       // 2
    printLn(sl.at(0).toString())       // 20
    printLn(sl.at(1).toString())       // 99

    // --- growth: add beyond initial capacity of 8 ---
    let big List<i64>: newList()
    let i i64: 0
    while i.lt(16) {
        big.add(i)
        i: i.add(1)
    }
    printLn(big.len().toString())      // 16
    printLn(big.at(15).toString())     // 15

    drop(arr)
    drop(copy)
    drop(sl)
    drop(big)
}
