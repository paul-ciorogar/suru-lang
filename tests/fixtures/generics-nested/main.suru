namespace Test.GenericsNested

export { main }

// Verify that the same generic type can be instantiated with three different
// concrete type arguments (i64, String, bool) in a single program.  The mono
// pass must produce Box-i64, Box-String, and Box-bool as independent
// concrete types, each with its own correct clone/drop pair.
type Box<T>: { value T }

fn main(args Array<String>) {
    let a Box<i64>: { value: 42 }
    let b Box<String>: { value: "hello" }
    let c Box<bool>: { value: true }
    printLn(a.value)
    printLn(b.value)
    printLn(c.value)
    drop(a)
    drop(b)
    drop(c)
}
