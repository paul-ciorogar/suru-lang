type Point: { x i64, y i64 }

fn main(args Array<String>) {
    // TODO: Array.equals() hits a codegen bug — element comparison emits
    // `icmp eq ptr` even for scalar element types (i64 mismatch). Uncomment
    // when the Array.equals codegen is fixed.
    // let a Array<i64>: [1, 2, 3]
    // let b Array<i64>: [1, 2, 3]
    // let c Array<i64>: [1, 2, 4]
    // printLn(a.equals(b))  // true
    // printLn(a.equals(c))  // false
    // drop(a) drop(b) drop(c)

    // Array<UserStruct>: push, access fields, clone, drop
    let pts Array<Point>: []
    let p1 Point: { x: 10, y: 20 }
    let p2 Point: { x: 30, y: 40 }
    pts.add(p1)
    pts.add(p2)
    printLn(pts.len())           // 2
    printLn(pts.at(0).x)        // 10
    printLn(pts.at(1).y)        // 40

    let pts2 Array<Point>: clone(pts)
    printLn(pts2.len())          // 2
    printLn(pts2.at(0).x)       // 10

    drop(pts2)
    drop(pts)
}
