include "lib.suru" as lib

// Regression: cross-module qualified-call type leniency (XFAIL).
//
// `lib.needInt(badArg)` references the undefined variable `badArg`. The
// SAME call written same-file (`needInt(badArg)`) is correctly rejected:
//   <path>: undefined variable 'badArg'
//
// Through a `ns.fn()` include alias the semantic analyzer's namespace
// heuristic (semantic/exprs.suru analyzeExpr, MethodCallNode arm) skips
// the call entirely — no recursion into arguments, no arity/type checks —
// so this compiles cleanly and a guaranteed runtime bug ships.
//
// This test (compileError mode) asserts the compiler emits that exact
// diagnostic. CURRENT: compiler emits nothing, exits 0 -> XFAIL (known,
// non-blocking). WHEN FIXED: analyzer reports it -> output matches
// expected.txt -> XPASS, signalling the xfail marker should be removed.
fn main(args Array<String>) {
    let r Bool: lib.needInt(badArg)
    printLn(r)
}
