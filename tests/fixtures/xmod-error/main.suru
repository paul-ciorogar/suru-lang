namespace Test.XmodError

import { lib: Test.XmodError.Lib }

// Regression: cross-module qualified-call argument type checking.
//
// `lib.needInt(args)` passes `args` (Array<String>) to a function that
// expects i64. Through a `ns.fn()` include alias the semantic analyzer's
// namespace heuristic previously skipped the call entirely — no recursion
// into arguments, no type checks — so this compiled cleanly and a
// guaranteed runtime bug shipped.
//
// This test (compileError mode) asserts the compiler emits the type-mismatch
// diagnostic. Fixed in semantic/exprs.suru MethodCallNode namespace-alias arm.
fn main(args Array<String>) {
    let r bool: lib.needInt(args)
    printLn(r)
}
