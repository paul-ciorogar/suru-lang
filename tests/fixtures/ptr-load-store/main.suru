namespace PtrLoadStore

import { [ptrLoad, ptrStore]: stdlib.ffi }

extern fn malloc(size i64) ptr
extern fn free(p ptr) void

fn main(args Array<String>) {
    // Allocate 24 bytes: i64 at offset 0, i32 at offset 8, bool at offset 12
    let buf ptr: malloc(24)

    ptrStore(buf, 0, 42)
    let i32val i32: 77
    ptrStore(buf, 8, i32val)
    ptrStore(buf, 12, true)

    let a i64: ptrLoad(buf, 0)
    let b i32: ptrLoad(buf, 8)
    let c bool: ptrLoad(buf, 12)

    printLn(a.toString())
    printLn(b.toString())
    if c { printLn("true") } else { printLn("false") }

    free(buf)
}
