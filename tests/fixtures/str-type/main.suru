namespace Test.StrType

// `Str` is the borrowed static-string type (string literals). It shares the
// %suru.String layout and all read-only operations with the owned heap `String`;
// it differs only in ownership (drop is a no-op) and is assignable to a `String`
// parameter/return (the boundary materializes an owned copy).

fn takesString(s String) i64 {
    return s.len()
}

fn firstChar(s Str) char {
    return s.__at(0)
}

fn main(args Array<String>) {
    let s Str: "hello"
    printLn(s)               // hello
    printLn(s.len())         // 5
    printLn(s.__at(0).ord()) // 104 (h)

    // Str is assignable where a String parameter is expected.
    printLn(takesString(s))  // 5

    // Str parameter.
    printLn(firstChar(s).ord())  // 104

    // match on a Str scrutinee (strcmp path, same as String).
    match s {
        "hello": { printLn("matched hello") }
        _:       { printLn("no match") }
    }

    // slice of a Str produces an owned String temp.
    let sub String: s.slice(1, 4)
    printLn(sub)             // ell
    drop(sub)

    // ── Owned element slots (B2) ─────────────────────────────────────────────
    // Array elements participate in the array's deep drop, so an element slot is
    // owned and its type is `String` even though every element here is a literal
    // (which now infers as `Str`). The array must therefore carry elem_tag 6 and
    // type Array:String — NOT elem_tag 8 / Array:Str, which is what element-0
    // type inference would have produced unnormalized. Valgrind is the real
    // assertion: a wrong element type picks the wrong per-element drop helper.
    let names Array<String>: ["alpha", "beta"]
    names.add("gamma")
    printLn(names.len())     // 3
    printLn(names.at(0))     // alpha
    printLn(names.at(2))     // gamma
    drop(names)

    // ── Owned locals (B3) ────────────────────────────────────────────────────
    // A `String`-annotated local is an owned slot: the literal is materialized
    // into a heap copy at the `let`, so the drop below frees that copy rather
    // than the .rodata global. Valgrind asserts both halves — a missing copy is
    // an invalid free, a missing drop is a leak.
    let owned String: "copied"
    printLn(owned)           // copied
    drop(owned)

    // The ownership of a local is fixed by its DECLARATION, not by the value it
    // currently holds — which is what keeps the drop decision correct across a
    // loop back-edge. `built` starts as a materialized copy of "" and is replaced
    // by an owned append result on every iteration; each `drop` must free the
    // value that iteration produced.
    let built String: ""
    let n i64: 0
    while n.lt(3) {
        let grown String: built.append("x")
        drop(built)
        built: grown
        n: n.add(1)
    }
    printLn(built)           // xxx
    drop(built)

    // The same builder written in place: `__append` frees the old receiver and
    // stores the fresh one back into the local's slot, so the local must be owned
    // from the start — otherwise that free would be aimed at the .rodata `""`.
    // This is the shape the compiler's own lexer uses to accumulate text.
    let inPlace String: ""
    inPlace.__append("a")
    inPlace.__append("b")
    printLn(inPlace)         // ab
    drop(inPlace)

    drop(s)                  // no-op (borrowed static)
    printLn("done")
}
