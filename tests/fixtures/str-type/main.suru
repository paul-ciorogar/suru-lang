namespace Test.StrType

// `Str` is the borrowed static-string type (string literals). It shares the
// %suru.String layout and all read-only operations with the owned heap `String`;
// it differs only in ownership (drop is a no-op) and is assignable to a `String`
// parameter/return (the boundary materializes an owned copy).

fn takesString(s String) i64 {
    return s.len()
}

fn firstChar(s Str) char {
    return s.__at(0)
}

fn main(args Array<String>) {
    let s Str: "hello"
    printLn(s)               // hello
    printLn(s.len())         // 5
    printLn(s.__at(0).ord()) // 104 (h)

    // Str is assignable where a String parameter is expected.
    printLn(takesString(s))  // 5

    // Str parameter.
    printLn(firstChar(s).ord())  // 104

    // match on a Str scrutinee (strcmp path, same as String).
    match s {
        "hello": { printLn("matched hello") }
        _:       { printLn("no match") }
    }

    // slice of a Str produces an owned String temp.
    let sub String: s.slice(1, 4)
    printLn(sub)             // ell
    drop(sub)

    // ── Owned element slots (B2) ─────────────────────────────────────────────
    // Array elements participate in the array's deep drop, so an element slot is
    // owned and its type is `String` even though every element here is a literal
    // (which now infers as `Str`). The array must therefore carry elem_tag 6 and
    // type Array:String — NOT elem_tag 8 / Array:Str, which is what element-0
    // type inference would have produced unnormalized. Valgrind is the real
    // assertion: a wrong element type picks the wrong per-element drop helper.
    let names Array<String>: ["alpha", "beta"]
    names.add("gamma")
    printLn(names.len())     // 3
    printLn(names.at(0))     // alpha
    printLn(names.at(2))     // gamma
    drop(names)

    // A literal bound to a String-annotated local: accepted by the string family.
    // A local is not a deep-dropped slot, so it stays a borrowed `Str` (no copy);
    // the drop below is therefore a safe no-op.
    let owned String: "copied"
    printLn(owned)           // copied
    drop(owned)

    drop(s)                  // no-op (borrowed static)
    printLn("done")
}
