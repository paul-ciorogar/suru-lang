include "greeter.suru" as gmod

// Root file ALSO declares its own Greeter literal. With the per-file vtable
// symbol fix, main.ll and greeter.ll emit distinct vtable globals
// (@vtable.<sanitised-main>.Greeter.0 vs @vtable.<sanitised-greeter>.Greeter.0)
// and the linker resolves both without collision. Without the fix both files
// would mint `@vtable.Greeter.0` and clang would reject the duplicate.
fn main() Int64 {
    let local Greeter: {
        name: "Local",
        fn greet(p String) String { return p.append("?").append(this.name) }
    }
    let remote Greeter: gmod.makeGreeter("Remote")
    printLn(local.greet("Hi "))
    printLn(remote.greet("Hello "))
    return 0
}
