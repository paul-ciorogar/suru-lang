namespace Test.WhileLoop

export { main }

fn main(args Array<String>) {
    let i i64: 1
    while i.lte(5) {
        printLn(i)
        i: i.add(1)
    }

    let sum i64: 0
    let j i64: 1
    while j.lte(10) {
        sum: sum.add(j)
        j: j.add(1)
    }
    printLn(sum)

    let s String: ""
    let k i64: 0
    while k.lt(3) {
        let tmp String: s.append("x")
        drop(s)
        s: tmp
        k: k.add(1)
    }
    printLn(s)
    drop(s)

}
