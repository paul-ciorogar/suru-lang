type DataStruct: { tall bool, height i64 }
type Named: { name String, height i64 }
type Lvl3: { someValue i64, name String }
type Lvl2: { anotherParam Lvl3 }
type Lvl1: { otherParam Lvl2 }
type Parent: { someArray Array<Lvl1> }

fn structFromFunction() Named {
    return {
        name: "Suru"
        height: 2283
    }
}

fn getHeight(data Named) i64 {
    return data.height
}

fn main(args Array<String>) {
    // basic: field read/write/clone/drop
    let data DataStruct: { tall: true, height: 2283 }
    printLn(data.tall)
    printLn(data.height)

    data.tall: false
    printLn(data.tall)

    let copy DataStruct: clone(data)
    printLn(copy.tall)
    drop(data)
    drop(copy)

    // struct returned from function — extract via typed let
    let suru Named: structFromFunction()
    let suruName String: suru.name
    printLn(suruName)

    let suruHeight i64: suru.height
    printLn(suruHeight)
    drop(suru)

    // struct passed to function, field returned
    let tok Named: { name: "hello", height: 42 }
    let height i64: getHeight(tok)
    printLn(height)
    drop(tok)

    // deep chain via let intermediaries:
    // covers struct.someArray.at(i).nested.deeper.value
    let lvl3 Lvl3: { someValue: 2281, name: "Suru" }
    let lvl2 Lvl2: { anotherParam: lvl3 }
    let lvl1 Lvl1: { otherParam: lvl2 }
    let someArray Array<Lvl1>: [lvl1]
    let parent Parent: { someArray: someArray }

    printLn(parent.someArray.at(0).otherParam.anotherParam.someValue)
    printLn(parent.someArray.at(0).otherParam.anotherParam.name)
    printLn(parent.someArray.at(0).otherParam.anotherParam.someValue.equals(2281))
    printLn(parent.someArray.at(0).otherParam.anotherParam.name.equals("Suru"))
    drop(parent)
}
