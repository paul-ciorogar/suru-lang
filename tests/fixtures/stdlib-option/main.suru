namespace Test.StdlibOption

import {
    [Option, some, none]: Suru.Stdlib.Option
}

fn describeOpt(x Option<i64>) {
    match x {
        Some: { printLn(x.value) }
        None: { printLn("none") }
    }
}

fn main(args Array<String>) {
    let s Option<i64>: some(42)
    let n Option<i64>: none()
    describeOpt(s)
    describeOpt(n)
    drop(s)
    drop(n)
}
