fn main(args Array<String>) {
    let s String: "hello"
    printLn(s.len())
    printLn(s.equals("hello"))
    printLn(s.equals("world"))

    let s2 String: s.append(" world")
    printLn(s2)

    let s3 String: s.slice(1, 3)
    printLn(s3)

    let n Int64: Int64.from("42")
    printLn(n)

    let str String: n.toString()
    printLn(str)

    let c String: s.at(0)
    printLn(c)

    drop(s)
    drop(s2)
    drop(s3)
    drop(str)
    drop(c)
}
