namespace Test.StdlibResult

export { main }

import { res: Suru.Stdlib.Result }

fn describeResult(x Result<i64, String>) {
    match x {
        Ok: { printLn(x.value) }
        Err: { printLn(x.error) }
    }
}

fn main(args Array<String>) {
    let ok Result<i64, String>: res.ok(99)
    let err Result<i64, String>: res.err("oops")
    describeResult(ok)
    describeResult(err)
    drop(ok)
    drop(err)
}
