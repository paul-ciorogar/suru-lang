include "../../../src/stdlib/result.suru" as res

fn describeResult(x Result<Int64, String>) {
    match x {
        Ok: { printLn(x.value) }
        Err: { printLn(x.error) }
    }
}

fn main(args Array<String>) {
    let ok Result<Int64, String>: res.ok(99)
    let err Result<Int64, String>: res.err("oops")
    describeResult(ok)
    describeResult(err)
    drop(ok)
    drop(err)
}
