namespace Test.Arithmetic

fn main(args Array<String>) {
    let x i64: 2.add(3)
    printLn(x)

    let y i64: 10.take(4)
    printLn(y)

    let z i64: 3.multiply(2)
    printLn(z)

    let w i64: 9.split(3)
    printLn(w)

    let n i64: 5.invert()
    printLn(n)

    let a bool: true
    let b bool: false
    printLn(a)
    printLn(b)

    let p i32: 7
    let q i32: 3
    printLn(p)
    printLn(q)

    let ni i64: -5
    let nf f64: -2.5
    printLn(ni)
    printLn(nf)
    printLn(ni.add(-3))
    printLn(ni.add(12))
}
