let CONST_MONDAY i64: 1
let CONST_FRIDAY i64: 5

fn classify(n i64) String {
    match n {
        0: { return "zero" }
        1: { return "one" }
        _: {}
    }
    return "many"
}

fn describeSign(n i64) String {
    match n.lt(0) {
        true: {
            let msg String: "negative"
            return msg
        }
        _: {}
    }
    return "non-negative"
}

fn voidMatch(flag bool) {
    match flag {
        true: { printLn("yes") }
        _: { printLn("no") }
    }
}

fn main(args Array<String>) {
    printLn(classify(0))
    printLn(classify(1))
    printLn(classify(99))
    printLn(describeSign(-5))
    printLn(describeSign(3))
    voidMatch(true)
    voidMatch(false)
    match true { true: printLn("backward-compat"), _: printLn("nope") }

    let x bool: true
    match x { true: printLn(1), _: printLn(0) }

    let y i64: match x { true: 1, _: 0 }
    printLn(y)

    let a bool: 3.equals(3)
    printLn(a)

    let b bool: 5.lt(10)
    printLn(b)

    let c bool: 5.lt(3)
    printLn(c)

    let day String: "Monday"
    match day { "Monday": printLn(1), "Friday": printLn(2), _: printLn(0) }

    let n i64: 0.take(1)
    match n { -1: printLn(1), 0: printLn(2), 1: printLn(3), _: printLn(0) }

    let cmp i64: 2.compare(5)
    printLn(cmp)

    match 5 {
        CONST_MONDAY: printLn("Monday")
        CONST_FRIDAY: printLn("Friday")
        _: printLn("undefined")
    }

    let monday i64: 1
    let friday i64: 5
    match 5 {
        monday: printLn("Monday")
        friday: printLn("Friday")
        _: printLn("undefined")
    }
}
