// Exercises function definitions with parameters, variable returns, and
// method calls on variable receivers — patterns that previously caused
// use-after-free in the bootstrapped compiler (isPrintTempString / CallNode).

fn identity(x i64) i64 {
    return x
}

fn addOne(x i64) i64 {
    return x.add(1)
}

fn double(x i64) i64 {
    return x.multiply(2)
}

fn isPositive(x i64) bool {
    return x.gt(0)
}

fn greet(name String) String {
    return "hello, ".append(name)
}

fn strLen(s String) i64 {
    return s.len()
}

fn main(args Array<String>) {
    printLn(identity(42))
    printLn(addOne(9))
    printLn(double(7))
    printLn(isPositive(5))
    printLn(isPositive(-3))

    let g String: greet("world")
    printLn(g)
    drop(g)

    let x i64: 4
    let y i64: x.add(3)
    printLn(y)

    let s String: "hello"
    let n i64: s.len()
    printLn(n)
    drop(s)
}
