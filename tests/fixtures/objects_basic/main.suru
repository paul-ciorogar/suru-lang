namespace Test.ObjectsBasic

export { main }

type Greeter: { name String, fn greet(prefix String) String, fn rename(n String) }

fn shout(g Greeter) String {
    return g.greet("HEY ")
}

fn main() {
    let a Greeter: {
        name: "World",
        fn greet(prefix String) String { return prefix.append(this.name) }
        fn rename(n String) { 
            let tmp String: this.name
            this.name: n 
            drop(tmp)
        }
    }
    let b Greeter: {
        name: "Suru",
        fn greet(prefix String) String { return prefix.append("!").append(this.name) }
        fn rename(n String) { 
            let tmp String: this.name
            this.name: n 
            drop(tmp)
        }
    }
    
    let msg String: a.greet("Hello ")
    printLn(msg)
    drop(msg)

    a.rename("Earth")

    msg: a.greet("Hello ")
    printLn(msg)
    drop(msg)

    msg: b.greet("Hi ")
    printLn(msg)
    drop(msg)

    msg: shout(a)
    printLn(msg)
    drop(msg)
    
    drop(a)
    drop(b)
}
