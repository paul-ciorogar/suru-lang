fn main(args Array<String>) {
    let i i64: 0
    while i.lt(50) {
        let s String: "prefix-".append(i.toString())
        drop(s)
        i: i.add(1)
    }
    printLn("string loop ok")

    let arr Array<String>: []
    let j i64: 0
    while j.lt(30) {
        let s String: "item-".append(j.toString())
        arr.add(s)
        j: j.add(1)
    }
    printLn(arr.len())
    drop(arr)
    printLn("array add ok")

    let base Array<String>: ["alpha", "beta", "gamma"]
    let copy Array<String>: clone(base)
    printLn(copy.len())
    drop(copy)
    drop(base)
    printLn("clone drop ok")

    let matrix Array<Array<i64>>: []
    let k i64: 0
    while k.lt(5) {
        let row Array<i64>: [k, k.add(1), k.add(2)]
        matrix.add(row)
        k: k.add(1)
    }
    printLn(matrix.len())
    drop(matrix)
    printLn("matrix ok")

    let some SumType: choseOne(1)
    drop(some)
}

type SomeType: {name String, height i64 }
type OtherType: {otherName string, otherHeight i64 }
type SumType: SomeType, OtherType

fn choseOne(index i64) SumType {
    if index.equals(1) {
        let result SomeType: {name: "Suru", height: 2283 } 
        return result
    }
    let result OtherType: {otherName: "still Suru", otherHeight: 2283 } 
    return result
}
