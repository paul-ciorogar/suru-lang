namespace Test.GenericsFnBasic

export { main }

// Verify a generic function can be instantiated with both scalar (i64) and
// heap (String) type arguments.  The mono pass must produce identity__Int64
// and identity__String as separate concrete functions.
fn identity<T>(x T) T {
    return x
}

fn main(args Array<String>) {
    let r i64: identity(42)
    printLn(r)
    let s String: identity("hello")
    printLn(s)
}
