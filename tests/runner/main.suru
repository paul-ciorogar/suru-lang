// xfail marks a known-broken test that must NOT block the build: an xfail that
// fails prints XFAIL (not counted as a failure); an xfail that unexpectedly
// passes prints XPASS so the marker can be removed. No test is currently xfail
// (cli-lex was, until the sum-type / Array<AstNode> clone-drop codegen bug was
// fixed). Keep the field — it's the harness's escape hatch for future cases.
// compileError: when true, the test asserts the COMPILER's output. The runner
// runs `suru compile` capturing stdout+stderr and compares it to `expected`
// (the exact diagnostic the compiler must emit); clang/run/valgrind are
// skipped. Used to pin specific semantic-analysis errors.
type TestCase: { name String, source String, args String, expected String, xfail Bool, compileError Bool }

fn main(args Array<String>) {
    let runtime String: "/usr/local/lib/suru/runtime"
    let cases Array<TestCase>: [
        { name: "simple",   source: "tests/fixtures/simple",   args: "",                                        expected: readFile("/work/tests/fixtures/simple/expected.txt")   },
        { name: "arithmetic",   source: "tests/fixtures/arithmetic",   args: "",                                        expected: readFile("/work/tests/fixtures/arithmetic/expected.txt")   },
        { name: "fibonacci",    source: "tests/fixtures/fibonacci",    args: "",                                        expected: readFile("/work/tests/fixtures/fibonacci/expected.txt")    },
        { name: "while-loop",   source: "tests/fixtures/while-loop",   args: "",                                        expected: readFile("/work/tests/fixtures/while-loop/expected.txt")   },
        { name: "strings",      source: "tests/fixtures/strings",      args: "",                                        expected: readFile("/work/tests/fixtures/strings/expected.txt")      },
        { name: "string-append-inplace", source: "tests/fixtures/string-append-inplace", args: "",                       expected: readFile("/work/tests/fixtures/string-append-inplace/expected.txt") },
        { name: "sum-types",    source: "tests/fixtures/sum-types",    args: "",                                        expected: readFile("/work/tests/fixtures/sum-types/expected.txt")    },
        { name: "comparisons",  source: "tests/fixtures/comparisons",  args: "",                                        expected: readFile("/work/tests/fixtures/comparisons/expected.txt")  },
        { name: "arrays",       source: "tests/fixtures/arrays",       args: "",                                        expected: readFile("/work/tests/fixtures/arrays/expected.txt")       },
        { name: "types",        source: "tests/fixtures/types",        args: "",                                        expected: readFile("/work/tests/fixtures/types/expected.txt")        },
        { name: "file_io",      source: "tests/fixtures/file_io",      args: " /work/tests/fixtures/file_io/input.txt", expected: readFile("/work/tests/fixtures/file_io/expected.txt")      },
        { name: "exec-test",    source: "tests/fixtures/exec-test",    args: "",                                        expected: readFile("/work/tests/fixtures/exec-test/expected.txt")    },
        { name: "alloc-stress", source: "tests/fixtures/alloc-stress", args: "",                                        expected: readFile("/work/tests/fixtures/alloc-stress/expected.txt") },
        { name: "functions",    source: "tests/fixtures/functions",    args: "",                                        expected: readFile("/work/tests/fixtures/functions/expected.txt")    },
        { name: "control-flow", source: "tests/fixtures/control-flow", args: "",                                        expected: readFile("/work/tests/fixtures/control-flow/expected.txt") },
        { name: "if-statements", source: "tests/fixtures/if-statements", args: "",                                       expected: readFile("/work/tests/fixtures/if-statements/expected.txt") },
        { name: "resolved-type-smoke", source: "tests/fixtures/resolved-type-smoke", args: "",                          expected: readFile("/work/tests/fixtures/resolved-type-smoke/expected.txt") },
        { name: "nested-struct-return", source: "tests/fixtures/nested-struct-return", args: "",                       expected: readFile("/work/tests/fixtures/nested-struct-return/expected.txt") },
        { name: "cli-lex",      source: "src/cli",                     args: " lex /work/tests/fixtures/simple/main.suru", expected: readFile("/work/tests/fixtures/cli-lex/expected.txt"), xfail: false },
        { name: "modules",   source: "tests/fixtures/modules",   args: "",                                        expected: readFile("/work/tests/fixtures/modules/expected.txt")   },
        { name: "objects_basic", source: "tests/fixtures/objects_basic", args: "",                                  expected: readFile("/work/tests/fixtures/objects_basic/expected.txt") },
        { name: "objects_modules", source: "tests/fixtures/objects_modules", args: "",                              expected: readFile("/work/tests/fixtures/objects_modules/expected.txt") },
        { name: "xmod-error", source: "tests/fixtures/xmod-error", args: "",                                       expected: readFile("/work/tests/fixtures/xmod-error/expected.txt"), xfail: true, compileError: true },
        { name: "generics-monoinstantiate-unit", source: "tests/fixtures/generics-monoinstantiate-unit", args: "", expected: readFile("/work/tests/fixtures/generics-monoinstantiate-unit/expected.txt") },
        { name: "generics-monoinfer-unit", source: "tests/fixtures/generics-monoinfer-unit", args: "", expected: readFile("/work/tests/fixtures/generics-monoinfer-unit/expected.txt") },
        { name: "generics-box-basic", source: "tests/fixtures/generics-box-basic", args: "", expected: readFile("/work/tests/fixtures/generics-box-basic/expected.txt") },
        { name: "generics-fn-basic", source: "tests/fixtures/generics-fn-basic", args: "", expected: readFile("/work/tests/fixtures/generics-fn-basic/expected.txt") },
        { name: "generics-type-basic", source: "tests/fixtures/generics-type-basic", args: "", expected: readFile("/work/tests/fixtures/generics-type-basic/expected.txt") },
        { name: "generics-multi-param", source: "tests/fixtures/generics-multi-param", args: "", expected: readFile("/work/tests/fixtures/generics-multi-param/expected.txt") },
        { name: "generics-nested", source: "tests/fixtures/generics-nested", args: "", expected: readFile("/work/tests/fixtures/generics-nested/expected.txt") },
        { name: "generics-cross-module", source: "tests/fixtures/generics-cross-module", args: "", expected: readFile("/work/tests/fixtures/generics-cross-module/expected.txt") },
        { name: "char",              source: "tests/fixtures/char",              args: "", expected: readFile("/work/tests/fixtures/char/expected.txt") },
        { name: "bool-ops",          source: "tests/fixtures/bool-ops",          args: "", expected: readFile("/work/tests/fixtures/bool-ops/expected.txt") },
        { name: "sum-types-dispatch", source: "tests/fixtures/sum-types-dispatch", args: "", expected: readFile("/work/tests/fixtures/sum-types-dispatch/expected.txt") },
        { name: "generics-advanced", source: "tests/fixtures/generics-advanced", args: "", expected: readFile("/work/tests/fixtures/generics-advanced/expected.txt") },
        { name: "array-advanced",    source: "tests/fixtures/array-advanced",    args: "", expected: readFile("/work/tests/fixtures/array-advanced/expected.txt") },
        { name: "string-advanced",   source: "tests/fixtures/string-advanced",   args: "", expected: readFile("/work/tests/fixtures/string-advanced/expected.txt") },
        { name: "float-match",       source: "tests/fixtures/float-match",       args: "", expected: readFile("/work/tests/fixtures/float-match/expected.txt") },
        { name: "file-io-write",     source: "tests/fixtures/file-io-write",     args: "", expected: readFile("/work/tests/fixtures/file-io-write/expected.txt") },
        { name: "builtins-misc",     source: "tests/fixtures/builtins-misc",     args: "", expected: readFile("/work/tests/fixtures/builtins-misc/expected.txt") },
    ]

    let passed Int64: 0
    let failed Int64: 0
    let memFailed Int64: 0
    let xfailed Int64: 0
    let xpassed Int64: 0
    let i Int64: 0

    while i.lt(cases.len()) {
        let tc TestCase: cases.at(i)
        let dir String: "/tmp/suru-test-".append(tc.name).append("-ll/")
        let ll String: dir.append("main.ll")
        let bin String: "/tmp/suru-test-".append(tc.name)
        let outFile String: bin.append(".out")

        exec("mkdir -p ".append(dir))
        let actual String: ""
        let memCheck Int64: 0
        if tc.compileError {
            // Assert the compiler's own diagnostic: capture stdout+stderr of
            // `suru compile`; skip clang/run/valgrind.
            exec("suru compile /work/".append(tc.source).append("/main.suru ").append(ll).append(" > ").append(outFile).append(" 2>&1"))
            actual: readFile(outFile)
        } else {
            exec("suru compile /work/".append(tc.source).append("/main.suru ").append(ll).append(" 2>/dev/null"))
            exec("clang-18 ".append(dir).append("*.ll ").append(runtime).append("/*.ll -o ").append(bin).append(" 2>/dev/null"))
            exec(bin.append(tc.args).append(" > ").append(outFile).append(" 2>&1"))
            actual: readFile(outFile)
            memCheck: exec("valgrind --error-exitcode=1 --leak-check=full --quiet ".append(bin).append(tc.args).append(" >/dev/null 2>&1"))
        }

        let ok Bool: actual.equals(tc.expected)
        match tc.xfail {
            true: {
                // Known-broken test: a failure is expected (XFAIL, not counted);
                // an unexpected pass (XPASS) is surfaced so the marker can go.
                match ok {
                    true:  {
                        printLn("XPASS ".append(tc.name).append(" (unexpected pass — remove xfail)"))
                        xpassed: xpassed.add(1)
                    }
                    _: {
                        printLn("XFAIL ".append(tc.name).append(" (known-broken, not blocking — todo.md L2)"))
                        xfailed: xfailed.add(1)
                    }
                }
            }
            _: {
                match ok {
                    true: {
                        passed: passed.add(1)
                        match memCheck.equals(0) {
                            true: { printLn("PASS ".append(tc.name).append("  memcheck ok")) }
                            _: {
                                printLn("PASS ".append(tc.name).append("  memcheck FAIL"))
                                memFailed: memFailed.add(1)
                            }
                        }
                    }
                    _: {
                        failed: failed.add(1)
                        match memCheck.equals(0) {
                            true: { printLn("FAIL ".append(tc.name).append("  memcheck ok")) }
                            _: {
                                printLn("FAIL ".append(tc.name).append("  memcheck FAIL"))
                                memFailed: memFailed.add(1)
                            }
                        }
                    }
                }
            }
        }

        i: i.add(1)
    }

    printLn("")
    printLn("Results: ".append(passed.toString()).append(" passed, ").append(failed.toString()).append(" failed, ").append(xfailed.toString()).append(" xfailed, ").append(xpassed.toString()).append(" xpassed, ").append(memFailed.toString()).append(" memcheck failures"))

    match failed.gt(0) {
        true: { exit(1) }
        _: {}
    }
    // match memFailed.gt(0) {
    //     true: { exit(1) }
    //     _: {}
    // }
}
