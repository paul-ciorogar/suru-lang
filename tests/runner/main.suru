namespace Suru.Tests.Runner

import { [lexerTests]: Test.Unit.Compiler.Lexer }
import { [ctypeLayoutTests]: Test.Unit.Compiler.CTypeLayout }
import { [structLayoutTests]: Test.Unit.Compiler.StructLayout }
import { [ptrTests]: Test.Unit.Compiler.Ptr }
import { [externTypeTests]: Test.Unit.Compiler.ExternType }
import { [sizeExprTests]: Test.Unit.Compiler.SizeExpr }
import { [ptrLoadStoreTests]: Test.Unit.Compiler.PtrLoadStore }
import { [suruStringOrderTests]: Test.Unit.Stdlib.String }
import { [stringBuilderNumTests]: Test.Unit.Stdlib.StringBuilderNum }
import { [reportResults]: Test.Unit.Assert }

// xfail marks a known-broken test that must NOT block the build: an xfail that
// fails prints XFAIL (not counted as a failure); an xfail that unexpectedly
// passes prints XPASS so the marker can be removed. No test is currently xfail
// (cli-lex was, until the sum-type / Array<AstNode> clone-drop codegen bug was
// fixed). Keep the field — it's the harness's escape hatch for future cases.
// compileError: when true, the test asserts the COMPILER's output. The runner
// runs `suru compile` capturing stdout+stderr and compares it to `expected`
// (the exact diagnostic the compiler must emit); clang/run/valgrind are
// skipped. Used to pin specific semantic-analysis errors.
type TestCase: { name String, source String, args String, expected String, xfail bool, compileError bool }

fn main(args Array<String>) {
    let runtime String: "/usr/local/lib/suru/runtime"
    let cases Array<TestCase>: [
        { name: "simple",   source: "tests/fixtures/simple",   args: "",                                        expected: readFile("/work/tests/fixtures/simple/expected.txt"),   xfail: false, compileError: false },
        { name: "arithmetic",   source: "tests/fixtures/arithmetic",   args: "",                                        expected: readFile("/work/tests/fixtures/arithmetic/expected.txt"),   xfail: false, compileError: false },
        { name: "fibonacci",    source: "tests/fixtures/fibonacci",    args: "",                                        expected: readFile("/work/tests/fixtures/fibonacci/expected.txt"),    xfail: false, compileError: false },
        { name: "while-loop",   source: "tests/fixtures/while-loop",   args: "",                                        expected: readFile("/work/tests/fixtures/while-loop/expected.txt"),   xfail: false, compileError: false },
        { name: "strings",      source: "tests/fixtures/strings",      args: "",                                        expected: readFile("/work/tests/fixtures/strings/expected.txt"),      xfail: false, compileError: false },
        { name: "string-append-inplace", source: "tests/fixtures/string-append-inplace", args: "",                       expected: readFile("/work/tests/fixtures/string-append-inplace/expected.txt"), xfail: false, compileError: false },
        { name: "sum-types",    source: "tests/fixtures/sum-types",    args: "",                                        expected: readFile("/work/tests/fixtures/sum-types/expected.txt"),    xfail: false, compileError: false },
        { name: "comparisons",  source: "tests/fixtures/comparisons",  args: "",                                        expected: readFile("/work/tests/fixtures/comparisons/expected.txt"),  xfail: false, compileError: false },
        { name: "arrays",       source: "tests/fixtures/arrays",       args: "",                                        expected: readFile("/work/tests/fixtures/arrays/expected.txt"),       xfail: false, compileError: false },
        { name: "types",        source: "tests/fixtures/types",        args: "",                                        expected: readFile("/work/tests/fixtures/types/expected.txt"),        xfail: false, compileError: false },
        { name: "struct-layout", source: "tests/fixtures/struct-layout", args: "",                                        expected: readFile("/work/tests/fixtures/struct-layout/expected.txt"), xfail: false, compileError: false },
        { name: "file_io",      source: "tests/fixtures/file_io",      args: " /work/tests/fixtures/file_io/input.txt", expected: readFile("/work/tests/fixtures/file_io/expected.txt"),      xfail: false, compileError: false },
        { name: "exec-test",    source: "tests/fixtures/exec-test",    args: "",                                        expected: readFile("/work/tests/fixtures/exec-test/expected.txt"),    xfail: false, compileError: false },
        { name: "alloc-stress", source: "tests/fixtures/alloc-stress", args: "",                                        expected: readFile("/work/tests/fixtures/alloc-stress/expected.txt"), xfail: false, compileError: false },
        { name: "functions",    source: "tests/fixtures/functions",    args: "",                                        expected: readFile("/work/tests/fixtures/functions/expected.txt"),    xfail: false, compileError: false },
        { name: "control-flow", source: "tests/fixtures/control-flow", args: "",                                        expected: readFile("/work/tests/fixtures/control-flow/expected.txt"), xfail: false, compileError: false },
        { name: "if-statements", source: "tests/fixtures/if-statements", args: "",                                       expected: readFile("/work/tests/fixtures/if-statements/expected.txt"), xfail: false, compileError: false },
        { name: "resolved-type-smoke", source: "tests/fixtures/resolved-type-smoke", args: "",                          expected: readFile("/work/tests/fixtures/resolved-type-smoke/expected.txt"), xfail: false, compileError: false },
        { name: "nested-struct-return", source: "tests/fixtures/nested-struct-return", args: "",                       expected: readFile("/work/tests/fixtures/nested-struct-return/expected.txt"), xfail: false, compileError: false },
        { name: "cli-lex",      source: "src/cli",                     args: " lex /work/tests/fixtures/simple/main.suru", expected: readFile("/work/tests/fixtures/cli-lex/expected.txt"), xfail: false, compileError: false },
        { name: "modules",   source: "tests/fixtures/modules",   args: "",                                        expected: readFile("/work/tests/fixtures/modules/expected.txt"),   xfail: false, compileError: false },
        { name: "objects_basic", source: "tests/fixtures/objects_basic", args: "",                                  expected: readFile("/work/tests/fixtures/objects_basic/expected.txt"), xfail: false, compileError: false },
        { name: "objects_modules", source: "tests/fixtures/objects_modules", args: "",                              expected: readFile("/work/tests/fixtures/objects_modules/expected.txt"), xfail: false, compileError: false },
        { name: "xmod-error", source: "tests/fixtures/xmod-error", args: "",                                       expected: readFile("/work/tests/fixtures/xmod-error/expected.txt"), xfail: false, compileError: true },
        { name: "generics-monoinstantiate-unit", source: "tests/fixtures/generics-monoinstantiate-unit", args: "", expected: readFile("/work/tests/fixtures/generics-monoinstantiate-unit/expected.txt"), xfail: false, compileError: false },
        { name: "generics-monoinfer-unit", source: "tests/fixtures/generics-monoinfer-unit", args: "", expected: readFile("/work/tests/fixtures/generics-monoinfer-unit/expected.txt"), xfail: false, compileError: false },
        { name: "generics-box-basic", source: "tests/fixtures/generics-box-basic", args: "", expected: readFile("/work/tests/fixtures/generics-box-basic/expected.txt"), xfail: false, compileError: false },
        { name: "generics-fn-basic", source: "tests/fixtures/generics-fn-basic", args: "", expected: readFile("/work/tests/fixtures/generics-fn-basic/expected.txt"), xfail: false, compileError: false },
        { name: "generics-type-basic", source: "tests/fixtures/generics-type-basic", args: "", expected: readFile("/work/tests/fixtures/generics-type-basic/expected.txt"), xfail: false, compileError: false },
        { name: "generics-multi-param", source: "tests/fixtures/generics-multi-param", args: "", expected: readFile("/work/tests/fixtures/generics-multi-param/expected.txt"), xfail: false, compileError: false },
        { name: "generics-nested", source: "tests/fixtures/generics-nested", args: "", expected: readFile("/work/tests/fixtures/generics-nested/expected.txt"), xfail: false, compileError: false },
        { name: "generics-cross-module", source: "tests/fixtures/generics-cross-module", args: "", expected: readFile("/work/tests/fixtures/generics-cross-module/expected.txt"), xfail: false, compileError: false },
        { name: "char",              source: "tests/fixtures/char",              args: "", expected: readFile("/work/tests/fixtures/char/expected.txt"), xfail: false, compileError: false },
        { name: "bool-ops",          source: "tests/fixtures/bool-ops",          args: "", expected: readFile("/work/tests/fixtures/bool-ops/expected.txt"), xfail: false, compileError: false },
        { name: "sum-types-dispatch", source: "tests/fixtures/sum-types-dispatch", args: "", expected: readFile("/work/tests/fixtures/sum-types-dispatch/expected.txt"), xfail: false, compileError: false },
        { name: "sum-type-with-methods", source: "tests/fixtures/sum-type-with-methods", args: "", expected: readFile("/work/tests/fixtures/sum-type-with-methods/expected.txt"), xfail: false, compileError: false },
        { name: "generics-advanced", source: "tests/fixtures/generics-advanced", args: "", expected: readFile("/work/tests/fixtures/generics-advanced/expected.txt"), xfail: false, compileError: false },
        { name: "array-advanced",    source: "tests/fixtures/array-advanced",    args: "", expected: readFile("/work/tests/fixtures/array-advanced/expected.txt"), xfail: false, compileError: false },
        { name: "string-advanced",   source: "tests/fixtures/string-advanced",   args: "", expected: readFile("/work/tests/fixtures/string-advanced/expected.txt"), xfail: false, compileError: false },
        { name: "string-escapes",    source: "tests/fixtures/string-escapes",    args: "", expected: readFile("/work/tests/fixtures/string-escapes/expected.txt"), xfail: false, compileError: false },
        { name: "float-match",       source: "tests/fixtures/float-match",       args: "", expected: readFile("/work/tests/fixtures/float-match/expected.txt"), xfail: false, compileError: false },
        { name: "file-io-write",     source: "tests/fixtures/file-io-write",     args: "", expected: readFile("/work/tests/fixtures/file-io-write/expected.txt"), xfail: false, compileError: false },
        { name: "builtins-misc",     source: "tests/fixtures/builtins-misc",     args: "", expected: readFile("/work/tests/fixtures/builtins-misc/expected.txt"), xfail: false, compileError: false },
        { name: "stdlib-option",          source: "tests/fixtures/stdlib-option",          args: "", expected: readFile("/work/tests/fixtures/stdlib-option/expected.txt"),          xfail: false, compileError: false },
        { name: "stdlib-option-all-types", source: "tests/fixtures/stdlib-option-all-types", args: "", expected: readFile("/work/tests/fixtures/stdlib-option-all-types/expected.txt"), xfail: false, compileError: false },
        { name: "objects-option-find",    source: "tests/fixtures/objects-option-find",    args: "", expected: readFile("/work/tests/fixtures/objects-option-find/expected.txt"),    xfail: false, compileError: false },
        { name: "stdlib-result",          source: "tests/fixtures/stdlib-result",          args: "", expected: readFile("/work/tests/fixtures/stdlib-result/expected.txt"),          xfail: false, compileError: false },
        { name: "extern-fn-basic",        source: "tests/fixtures/extern-fn-basic",        args: "", expected: readFile("/work/tests/fixtures/extern-fn-basic/expected.txt"), xfail: false, compileError: false },
        { name: "extern-fn-ptr",          source: "tests/fixtures/extern-fn-ptr",          args: "", expected: readFile("/work/tests/fixtures/extern-fn-ptr/expected.txt"),    xfail: false, compileError: false },
        { name: "extern-fn-fileio",       source: "tests/fixtures/extern-fn-fileio",       args: "", expected: readFile("/work/tests/fixtures/extern-fn-fileio/expected.txt"),  xfail: false, compileError: false },
        { name: "ctype-struct",           source: "tests/fixtures/ctype-struct",           args: "", expected: readFile("/work/tests/fixtures/ctype-struct/expected.txt"), xfail: false, compileError: false },
        { name: "private-fields",          source: "tests/fixtures/private-fields",          args: "", expected: readFile("/work/tests/fixtures/private-fields/expected.txt"), xfail: false, compileError: false },
        { name: "private-fields-error",    source: "tests/fixtures/private-fields-error",    args: "", expected: readFile("/work/tests/fixtures/private-fields-error/expected.txt"), xfail: false, compileError: true },
        { name: "move-valid",              source: "tests/fixtures/move-valid",              args: "", expected: readFile("/work/tests/fixtures/move-valid/expected.txt"), xfail: false, compileError: false },
        { name: "move-error",              source: "tests/fixtures/move-error",              args: "", expected: readFile("/work/tests/fixtures/move-error/expected.txt"), xfail: false, compileError: true },
        { name: "break-valid",             source: "tests/fixtures/break-valid",             args: "", expected: readFile("/work/tests/fixtures/break-valid/expected.txt"), xfail: false, compileError: false },
        { name: "continue-valid",          source: "tests/fixtures/continue-valid",          args: "", expected: readFile("/work/tests/fixtures/continue-valid/expected.txt"), xfail: false, compileError: false },
        { name: "break-error",             source: "tests/fixtures/break-error",             args: "", expected: readFile("/work/tests/fixtures/break-error/expected.txt"), xfail: false, compileError: true },
        { name: "continue-error",                source: "tests/fixtures/continue-error",                args: "", expected: readFile("/work/tests/fixtures/continue-error/expected.txt"),                xfail: false, compileError: true },
        { name: "private-fields-constructor",    source: "tests/fixtures/private-fields-constructor",    args: "", expected: readFile("/work/tests/fixtures/private-fields-constructor/expected.txt"), xfail: false, compileError: false },
        { name: "lex-error",      source: "tests/fixtures/lex-error",      args: "", expected: readFile("/work/tests/fixtures/lex-error/expected.txt"),      xfail: false, compileError: true },
        { name: "parse-error",    source: "tests/fixtures/parse-error",    args: "", expected: readFile("/work/tests/fixtures/parse-error/expected.txt"),    xfail: false, compileError: true },
        { name: "dup-type-error",              source: "tests/fixtures/dup-type-error",              args: "", expected: readFile("/work/tests/fixtures/dup-type-error/expected.txt"),              xfail: false, compileError: true },
        { name: "struct-missing-field-error", source: "tests/fixtures/struct-missing-field-error", args: "", expected: readFile("/work/tests/fixtures/struct-missing-field-error/expected.txt"), xfail: false, compileError: true },
        { name: "struct-undeclared-method-error", source: "tests/fixtures/struct-undeclared-method-error", args: "", expected: readFile("/work/tests/fixtures/struct-undeclared-method-error/expected.txt"), xfail: false, compileError: true },
        { name: "ctype-method-error",     source: "tests/fixtures/ctype-method-error",     args: "", expected: readFile("/work/tests/fixtures/ctype-method-error/expected.txt"),     xfail: false, compileError: true },
        { name: "ctype-clone-error",      source: "tests/fixtures/ctype-clone-error",      args: "", expected: readFile("/work/tests/fixtures/ctype-clone-error/expected.txt"),      xfail: false, compileError: true },
        { name: "ctype-nested-error",     source: "tests/fixtures/ctype-nested-error",     args: "", expected: readFile("/work/tests/fixtures/ctype-nested-error/expected.txt"),     xfail: false, compileError: true },
        { name: "ctype-field-type-error", source: "tests/fixtures/ctype-field-type-error", args: "", expected: readFile("/work/tests/fixtures/ctype-field-type-error/expected.txt"), xfail: false, compileError: true },
        { name: "namespace-export", source: "tests/fixtures/namespace-export", args: "", expected: readFile("/work/tests/fixtures/namespace-export/expected.txt"), xfail: false, compileError: false },
        { name: "namespace-import",          source: "tests/fixtures/namespace-import",          args: "", expected: readFile("/work/tests/fixtures/namespace-import/expected.txt"),          xfail: false, compileError: true },
        { name: "namespace-error-invalid",   source: "tests/fixtures/namespace-error-invalid",   args: "", expected: readFile("/work/tests/fixtures/namespace-error-invalid/expected.txt"),   xfail: false, compileError: true },
        { name: "namespace-error-duplicate", source: "tests/fixtures/namespace-error-duplicate", args: "", expected: readFile("/work/tests/fixtures/namespace-error-duplicate/expected.txt"), xfail: false, compileError: true },
        { name: "namespace-error-not-first", source: "tests/fixtures/namespace-error-not-first", args: "", expected: readFile("/work/tests/fixtures/namespace-error-not-first/expected.txt"), xfail: false, compileError: true },
        { name: "namespace-export-error",    source: "tests/fixtures/namespace-export-error",    args: "", expected: readFile("/work/tests/fixtures/namespace-export-error/expected.txt"),    xfail: false, compileError: true },
        { name: "namespace-import-error",    source: "tests/fixtures/namespace-import-error",    args: "", expected: readFile("/work/tests/fixtures/namespace-import-error/expected.txt"),    xfail: false, compileError: true },
        { name: "namespace-import-conflict", source: "tests/fixtures/namespace-import-conflict", args: "", expected: readFile("/work/tests/fixtures/namespace-import-conflict/expected.txt"), xfail: false, compileError: true },
        { name: "namespace-import-fullns",   source: "tests/fixtures/namespace-import-fullns",   args: "", expected: readFile("/work/tests/fixtures/namespace-import-fullns/expected.txt"),   xfail: false, compileError: false },
        { name: "namespace-qualified-call",    source: "tests/fixtures/namespace-qualified-call",    args: "", expected: readFile("/work/tests/fixtures/namespace-qualified-call/expected.txt"),    xfail: false, compileError: false },
        { name: "namespace-qualified-const",   source: "tests/fixtures/namespace-qualified-const",   args: "", expected: readFile("/work/tests/fixtures/namespace-qualified-const/expected.txt"),   xfail: false, compileError: false },
        { name: "namespace-include-compat",    source: "tests/fixtures/namespace-include-compat",    args: "", expected: readFile("/work/tests/fixtures/namespace-include-compat/expected.txt"),    xfail: false, compileError: false },
        { name: "namespace-error-missing",           source: "tests/fixtures/namespace-error-missing",           args: "", expected: readFile("/work/tests/fixtures/namespace-error-missing/expected.txt"),           xfail: false, compileError: true },
        { name: "namespace-import-aliastns",          source: "tests/fixtures/namespace-import-aliastns",          args: "", expected: readFile("/work/tests/fixtures/namespace-import-aliastns/expected.txt"),          xfail: false, compileError: false },
        { name: "namespace-import-selective-multi",   source: "tests/fixtures/namespace-import-selective-multi",   args: "", expected: readFile("/work/tests/fixtures/namespace-import-selective-multi/expected.txt"),   xfail: false, compileError: false },
        { name: "namespace-import-selective-aliased", source: "tests/fixtures/namespace-import-selective-aliased", args: "", expected: readFile("/work/tests/fixtures/namespace-import-selective-aliased/expected.txt"), xfail: false, compileError: false },
        { name: "extern-type-opaque",      source: "tests/fixtures/extern-type-opaque",      args: "", expected: readFile("/work/tests/fixtures/extern-type-opaque/expected.txt"),      xfail: false, compileError: false },
        { name: "extern-type-clone-error", source: "tests/fixtures/extern-type-clone-error", args: "", expected: readFile("/work/tests/fixtures/extern-type-clone-error/expected.txt"), xfail: false, compileError: true },
        { name: "extern-type-field-error", source: "tests/fixtures/extern-type-field-error", args: "", expected: readFile("/work/tests/fixtures/extern-type-field-error/expected.txt"), xfail: false, compileError: true },
        { name: "custom-lifecycle",                  source: "tests/fixtures/custom-lifecycle",                  args: "", expected: readFile("/work/tests/fixtures/custom-lifecycle/expected.txt"),                  xfail: false, compileError: false },
        { name: "custom-lifecycle-ptr-no-lifecycle", source: "tests/fixtures/custom-lifecycle-ptr-no-lifecycle", args: "", expected: readFile("/work/tests/fixtures/custom-lifecycle-ptr-no-lifecycle/expected.txt"), xfail: false, compileError: true },
        { name: "size-expr",                         source: "tests/fixtures/size-expr",                         args: "", expected: readFile("/work/tests/fixtures/size-expr/expected.txt"),                         xfail: false, compileError: false },
        { name: "ptr-load-store",                    source: "tests/fixtures/ptr-load-store",                    args: "", expected: readFile("/work/tests/fixtures/ptr-load-store/expected.txt"),                    xfail: false, compileError: false },
        { name: "list-basic",                        source: "tests/fixtures/list-basic",                        args: "", expected: readFile("/work/tests/fixtures/list-basic/expected.txt"),                        xfail: false, compileError: false },
        { name: "list-string",                       source: "tests/fixtures/list-string",                       args: "", expected: readFile("/work/tests/fixtures/list-string/expected.txt"),                       xfail: false, compileError: false },
        { name: "surustring-basic",                  source: "tests/fixtures/surustring-basic",                  args: "", expected: readFile("/work/tests/fixtures/surustring-basic/expected.txt"),                  xfail: false, compileError: false },
        { name: "surustring-print",                  source: "tests/fixtures/surustring-print",                  args: "", expected: readFile("/work/tests/fixtures/surustring-print/expected.txt"),                  xfail: false, compileError: false },
        { name: "stringbuilder-basic",               source: "tests/fixtures/stringbuilder-basic",               args: "", expected: readFile("/work/tests/fixtures/stringbuilder-basic/expected.txt"),               xfail: false, compileError: false },
    ]

    let passed i64: 0
    let failed i64: 0
    let memFailed i64: 0
    let xfailed i64: 0
    let xpassed i64: 0
    let i i64: 0

    // In-process unit tests run first. reportResults prints a PASS/FAIL line per
    // assertion and returns the failure count, folded into the suite tally so a
    // failing unit test fails the build (via the exit(1) on failed > 0 below).
    printLn("--- Unit tests ---")
    let unitFailed i64: reportResults("lexer", lexerTests())
    failed: failed.add(unitFailed)
    let ctypeFailed i64: reportResults("ctype-layout", ctypeLayoutTests())
    failed: failed.add(ctypeFailed)
    let structFailed i64: reportResults("struct-layout", structLayoutTests())
    failed: failed.add(structFailed)
    let ptrFailed i64: reportResults("ptr", ptrTests())
    failed: failed.add(ptrFailed)
    let externTypeFailed i64: reportResults("extern-type", externTypeTests())
    failed: failed.add(externTypeFailed)
    let sizeExprFailed i64: reportResults("size-expr", sizeExprTests())
    failed: failed.add(sizeExprFailed)
    let ptrLoadStoreFailed i64: reportResults("ptr-load-store", ptrLoadStoreTests())
    failed: failed.add(ptrLoadStoreFailed)
    let suruStrOrderFailed i64: reportResults("surustring-order", suruStringOrderTests())
    failed: failed.add(suruStrOrderFailed)
    let sbNumFailed i64: reportResults("stringbuilder-num", stringBuilderNumTests())
    failed: failed.add(sbNumFailed)
    printLn("")

    while i.lt(cases.len()) {
        let tc TestCase: cases.at(i)
        let dir String: "/tmp/suru-test-".append(tc.name).append("-ll/")
        let ll String: dir.append("main.ll")
        let bin String: "/tmp/suru-test-".append(tc.name)
        let outFile String: bin.append(".out")

        exec("mkdir -p ".append(dir))
        let actual String: ""
        let memCheck i64: 0
        if tc.compileError {
            // Assert the compiler's own diagnostic: capture stdout+stderr of
            // `suru compile`; skip clang/run/valgrind.
            exec("suru compile /work/".append(tc.source).append("/main.suru ").append(ll).append(" > ").append(outFile).append(" 2>&1"))
            actual: readFile(outFile)
        } else {
            exec("suru compile /work/".append(tc.source).append("/main.suru ").append(ll).append(" 2>/dev/null"))
            exec("clang-18 ".append(dir).append("*.ll ").append(runtime).append("/*.o -o ").append(bin).append(" 2>/dev/null"))
            exec(bin.append(tc.args).append(" > ").append(outFile).append(" 2>&1"))
            actual: readFile(outFile)
            memCheck: exec("valgrind --error-exitcode=1 --leak-check=full --quiet ".append(bin).append(tc.args).append(" >/dev/null 2>&1"))
        }

        let ok bool: actual.equals(tc.expected)
        match tc.xfail {
            true: {
                // Known-broken test: a failure is expected (XFAIL, not counted);
                // an unexpected pass (XPASS) is surfaced so the marker can go.
                match ok {
                    true:  {
                        printLn("XPASS ".append(tc.name).append(" (unexpected pass — remove xfail)"))
                        xpassed: xpassed.add(1)
                    }
                    _: {
                        printLn("XFAIL ".append(tc.name).append(" (known-broken, not blocking — todo.md L2)"))
                        xfailed: xfailed.add(1)
                    }
                }
            }
            _: {
                match ok {
                    true: {
                        passed: passed.add(1)
                        match memCheck.equals(0) {
                            true: { printLn("PASS ".append(tc.name).append("  memcheck ok")) }
                            _: {
                                printLn("PASS ".append(tc.name).append("  memcheck FAIL"))
                                memFailed: memFailed.add(1)
                            }
                        }
                    }
                    _: {
                        failed: failed.add(1)
                        match memCheck.equals(0) {
                            true: { printLn("FAIL ".append(tc.name).append("  memcheck ok")) }
                            _: {
                                printLn("FAIL ".append(tc.name).append("  memcheck FAIL"))
                                memFailed: memFailed.add(1)
                            }
                        }
                    }
                }
            }
        }

        i: i.add(1)
    }

    printLn("")
    printLn("Results: ".append(passed.toString()).append(" passed, ").append(failed.toString()).append(" failed, ").append(xfailed.toString()).append(" xfailed, ").append(xpassed.toString()).append(" xpassed, ").append(memFailed.toString()).append(" memcheck failures"))

    match failed.gt(0) {
        true: { exit(1) }
        _: {}
    }
    // match memFailed.gt(0) {
    //     true: { exit(1) }
    //     _: {}
    // }
}
