// mono_objfield_newlist.suru — regression-oracle fixture (Phase 0, task 0.1).
//
// The FAILING case: the same generic zero-arg `newList()` initialising an
// object-literal FIELD whose declared type is `List<i64>`. monoInfer has no
// object-literal-field arm, so it never binds T=i64 from the field annotation and
// the monomorphizer does NOT instantiate `List-i64` / `newList-i64`. (Downstream,
// pass-3 would report `undefined function 'newList'`, but the oracle stops at the
// "mono" pass — before that error — and simply records the missing instantiation.)
//
// This pins the known bug described in semantic_analysis_architecture_rd.md §0.
// Phase 2.4 of the refactor fixes it; at that point the oracle assertion flips
// from "absent" to "present".

namespace Test.Unit.Compiler.Fixtures.MonoObjFieldNewList

import { [List, newList]: Suru.Stdlib.List }

type Container: { items List<i64> }

fn main() {
    let c Container: { items: newList() }
    printLn(c.items.len().toString())
    drop(c)
}
