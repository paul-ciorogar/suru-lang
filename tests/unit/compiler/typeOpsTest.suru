// typeOpsTest.suru — unit tests for equalType (task 1.4) + substitute (task 1.5).
//
// Run in-process by the test runner (tests/runner/main.suru), which calls
// typeOpsTests() and reports the returned results.
//
// Most `Type` values are built by routing a source-form string through parseType
// (concise, and exercises the parse boundary at the same time); the `Var` cases
// are hand-built with varType because parseType is context-free and never mints a
// `Var` (a bare name is always a `Prim` — see typeParse.suru header).
//
// equalType coverage emphasizes the two ways structural equality can fail beyond a
// plain payload mismatch: ARG ORDER (`Pair<i64, String>` != `Pair<String, i64>`)
// and ARITY (`Pair<i64, String>` != `Pair<i64>`).
// substitute coverage drives the replacements through equalType, including the
// nested `List<T>` with `T=Token` case.

namespace Test.Unit.Compiler.TypeOps

import {
    [TestResult, assertTrue, assertEqStr]: Test.Unit.Assert
    [parseType]: Suru.Compiler.Types.Parse
    [printSuruType]: Suru.Compiler.Types.Print
    [Type, varType, namedType, arrType]: Suru.Compiler.Types
    [equalType, canonType, substitute, binding, Binding, unify, UnifyResult]: Suru.Compiler.Types.Ops
    [makeSuruType]: Suru.Compiler.Codegen.TypeHelpers
}

// typeOpsTests — one TestResult per assertion.
export fn typeOpsTests() Array<TestResult> {
    let results Array<TestResult>: []

    // ─── Equal: same shape, same payload ─────────────────────────────────────────

    results.add(assertTrue("eq i64 == i64",
        equalType(parseType("i64"), parseType("i64"))))
    results.add(assertTrue("eq List<Token> == List<Token>",
        equalType(parseType("List<Token>"), parseType("List<Token>"))))
    results.add(assertTrue("eq Pair<i64, String> == itself",
        equalType(parseType("Pair<i64, String>"), parseType("Pair<i64, String>"))))
    results.add(assertTrue("eq nested List<Option<Token>>",
        equalType(parseType("List<Option<Token>>"), parseType("List<Option<Token>>"))))
    results.add(assertTrue("eq Array<i64> == Array<i64>",
        equalType(parseType("Array<i64>"), parseType("Array<i64>"))))
    results.add(assertTrue("eq Var(0,T) == Var(0,T)",
        equalType(varType(0, "T"), varType(0, "T"))))

    // ─── Not equal: payload, shape, arg order, arity ─────────────────────────────

    results.add(assertTrue("neq i64 vs bool",
        not equalType(parseType("i64"), parseType("bool"))))
    // Shape mismatch: bare `Prim "List"` vs applied `Named List<Token>`.
    results.add(assertTrue("neq Prim List vs Named List<Token>",
        not equalType(parseType("List"), parseType("List<Token>"))))
    results.add(assertTrue("neq List<Token> vs List<i64> (arg differs)",
        not equalType(parseType("List<Token>"), parseType("List<i64>"))))
    // Arg ORDER is significant.
    results.add(assertTrue("neq Pair<i64, String> vs Pair<String, i64> (order)",
        not equalType(parseType("Pair<i64, String>"), parseType("Pair<String, i64>"))))
    // ARITY mismatch.
    results.add(assertTrue("neq Pair<i64, String> vs Pair<i64> (arity)",
        not equalType(parseType("Pair<i64, String>"), parseType("Pair<i64>"))))
    results.add(assertTrue("neq Array<i64> vs Array<bool>",
        not equalType(parseType("Array<i64>"), parseType("Array<bool>"))))
    // Var equality compares both id and name.
    results.add(assertTrue("neq Var(0,T) vs Var(1,T) (id)",
        not equalType(varType(0, "T"), varType(1, "T"))))
    results.add(assertTrue("neq Var(0,T) vs Var(0,U) (name)",
        not equalType(varType(0, "T"), varType(0, "U"))))

    // ─── substitute (task 1.5) ───────────────────────────────────────────────────
    //
    // The variable-bearing INPUT types are built with constructors (varType inside
    // namedType/arrType), because parseType is context-free and never mints a `Var`
    // — `parseType("List<T>")` makes `T` a `Prim`, which substitute correctly leaves
    // alone. The concrete EXPECTED types are built with parseType for brevity.

    // A bare type variable is replaced by its bound type.
    let bT Array<Binding>: [binding("T", parseType("i64"))]
    results.add(assertTrue("subst Var T -> i64",
        equalType(substitute(varType(0, "T"), bT), parseType("i64"))))

    // An unbound variable passes through unchanged (no binding for "U").
    results.add(assertTrue("subst unbound Var U passes through",
        equalType(substitute(varType(0, "U"), bT), varType(0, "U"))))

    // Empty bindings is the identity (a deep copy): nothing is replaced.
    let bEmpty Array<Binding>: []
    results.add(assertTrue("subst [] is identity on List<Token>",
        equalType(substitute(parseType("List<Token>"), bEmpty), parseType("List<Token>"))))

    // Nested: `List<T>` with `T=Token` -> `List<Token>`.
    let bTok Array<Binding>: [binding("T", parseType("Token"))]
    let listOfT Type: namedType("List", [varType(0, "T")])
    results.add(assertTrue("subst List<T> with T=Token -> List<Token>",
        equalType(substitute(listOfT, bTok), parseType("List<Token>"))))

    // Multi-arg: each variable resolved by name independently.
    let bTU Array<Binding>: [binding("T", parseType("i64")), binding("U", parseType("String"))]
    let pairOfTU Type: namedType("Pair", [varType(0, "T"), varType(0, "U")])
    results.add(assertTrue("subst Pair<T, U> -> Pair<i64, String>",
        equalType(substitute(pairOfTU, bTU), parseType("Pair<i64, String>"))))

    // Array element substitution flows through the dedicated `Arr` shape.
    let bBool Array<Binding>: [binding("T", parseType("bool"))]
    let arrOfT Type: arrType(varType(0, "T"))
    results.add(assertTrue("subst Array<T> with T=bool -> Array<bool>",
        equalType(substitute(arrOfT, bBool), parseType("Array<bool>"))))

    // Deeply nested generic application recurses all the way down.
    let listOptT Type: namedType("List", [namedType("Option", [varType(0, "T")])])
    results.add(assertTrue("subst List<Option<T>> with T=Token -> List<Option<Token>>",
        equalType(substitute(listOptT, bTok), parseType("List<Option<Token>>"))))

    // A type containing no variable is copied unchanged regardless of bindings.
    results.add(assertTrue("subst i64 unaffected by bindings",
        equalType(substitute(parseType("i64"), bBool), parseType("i64"))))

    // ─── unify (task 1.6) ────────────────────────────────────────────────────────
    //
    // `unify(pattern, target)` is the inverse of `substitute`: it FINDS the bindings
    // that make `pattern` equal `target`. So every solve case is checked by the
    // round-trip `substitute(varT, res.bindings) == <expected concrete type>`, reusing
    // the ops under test rather than reaching into the bindings list. The pattern's
    // type variable is built as `varType(0, "T")` (parseType never mints a `Var`).

    let varT Type: varType(0, "T")
    let varU Type: varType(1, "U")

    // Solve: `List<?0> = List<Token>` recovers `?0 = Token` (case 1).
    let uList UnifyResult: unify(namedType("List", [varType(0, "T")]), parseType("List<Token>"))
    results.add(assertTrue("unify List<?0> = List<Token> ok", uList.ok))
    results.add(assertTrue("unify List<?0> = List<Token> solves ?0=Token",
        equalType(substitute(varT, uList.bindings), parseType("Token"))))

    // A bare variable binds to a whole compound type.
    let uCompound UnifyResult: unify(varType(0, "T"), parseType("List<Token>"))
    results.add(assertTrue("unify ?0 = List<Token> ok", uCompound.ok))
    results.add(assertTrue("unify ?0 = List<Token> solves ?0=List<Token>",
        equalType(substitute(varT, uCompound.bindings), parseType("List<Token>"))))

    // Symmetric: a variable on the RIGHT side is bound just the same.
    let uSym UnifyResult: unify(parseType("Token"), varType(0, "T"))
    results.add(assertTrue("unify Token = ?0 ok", uSym.ok))
    results.add(assertTrue("unify Token = ?0 solves ?0=Token",
        equalType(substitute(varT, uSym.bindings), parseType("Token"))))

    // No variables, structurally equal: succeeds with an empty solution.
    let uPrim UnifyResult: unify(parseType("i64"), parseType("i64"))
    results.add(assertTrue("unify i64 = i64 ok", uPrim.ok))
    results.add(assertTrue("unify i64 = i64 has empty bindings",
        uPrim.bindings.len().equals(0)))

    // Mismatch (primitive name) fails.
    results.add(assertTrue("unify i64 = bool fails",
        not unify(parseType("i64"), parseType("bool")).ok))
    // Mismatch (named shape) fails.
    results.add(assertTrue("unify List<Token> = Option<Token> fails",
        not unify(parseType("List<Token>"), parseType("Option<Token>")).ok))
    // Mismatch (arity) fails.
    results.add(assertTrue("unify Pair<i64, String> = Pair<i64> fails",
        not unify(parseType("Pair<i64, String>"), parseType("Pair<i64>")).ok))

    // Multi-var: each variable resolved independently by name.
    let uPair UnifyResult: unify(namedType("Pair", [varType(0, "T"), varType(1, "U")]),
        parseType("Pair<i64, String>"))
    results.add(assertTrue("unify Pair<?0, ?1> = Pair<i64, String> ok", uPair.ok))
    results.add(assertTrue("unify Pair<?0, ?1> solves ?0=i64",
        equalType(substitute(varT, uPair.bindings), parseType("i64"))))
    results.add(assertTrue("unify Pair<?0, ?1> solves ?1=String",
        equalType(substitute(varU, uPair.bindings), parseType("String"))))

    // Consistency: the same variable cannot bind to two different types.
    results.add(assertTrue("unify Pair<?0, ?0> = Pair<i64, String> fails (conflict)",
        not unify(namedType("Pair", [varType(0, "T"), varType(0, "T")]),
            parseType("Pair<i64, String>")).ok))
    // Same variable, SAME type on both positions, succeeds.
    let uSame UnifyResult: unify(namedType("Pair", [varType(0, "T"), varType(0, "T")]),
        parseType("Pair<i64, i64>"))
    results.add(assertTrue("unify Pair<?0, ?0> = Pair<i64, i64> ok", uSame.ok))
    results.add(assertTrue("unify Pair<?0, ?0> = Pair<i64, i64> solves ?0=i64",
        equalType(substitute(varT, uSame.bindings), parseType("i64"))))

    // Array elements unify through the dedicated `Arr` shape.
    let uArr UnifyResult: unify(arrType(varType(0, "T")), parseType("Array<Token>"))
    results.add(assertTrue("unify Array<?0> = Array<Token> ok", uArr.ok))
    results.add(assertTrue("unify Array<?0> solves ?0=Token",
        equalType(substitute(varT, uArr.bindings), parseType("Token"))))

    // ─── canonType (§3.4) ────────────────────────────────────────────────────────
    //
    // The point of canonType: an APPLICATION and its MANGLED name denote one type,
    // but parse to different shapes (Named vs Prim — parseType does not read the
    // hyphen form). Canonicalizing folds the application, so equalType sees through
    // the duality. Each pair below is exactly what isAssignable is handed when a
    // post-mono annotation meets a registered instantiation name.

    results.add(assertTrue("canon Box<i64> == Box-i64",
        equalType(canonType(parseType("Box<i64>")), canonType(parseType("Box-i64")))))
    // Multi-arg: the case a depth-blind comma split used to mangle wrongly.
    results.add(assertTrue("canon Pair<i64, String> == Pair-i64-String",
        equalType(canonType(parseType("Pair<i64, String>")), canonType(parseType("Pair-i64-String")))))
    // Nested: printSymbol flattens every level, so the inner Array folds too.
    results.add(assertTrue("canon Option<Array<i64>> == Option-Array-i64",
        equalType(canonType(parseType("Option<Array<i64>>")), canonType(parseType("Option-Array-i64")))))
    // The built-in array keeps its `Arr` shape (colon and source forms agree)...
    results.add(assertTrue("canon Array<i64> == Array:i64",
        equalType(canonType(parseType("Array<i64>")), canonType(parseType("Array:i64")))))
    // ...and is NOT collapsed to a name, so it stays distinct from a user type
    // that happens to be called "Array-i64".
    results.add(assertTrue("canon Array<i64> != Array-i64 (Arr is not folded)",
        not equalType(canonType(parseType("Array<i64>")), canonType(parseType("Array-i64")))))
    // A user generic is still distinguished from a different one, and from a bare name.
    results.add(assertTrue("canon Box<i64> != Box<bool>",
        not equalType(canonType(parseType("Box<i64>")), canonType(parseType("Box<bool>")))))
    results.add(assertTrue("canon List<Token> != Array<Token>",
        not equalType(canonType(parseType("List<Token>")), canonType(parseType("Array<Token>")))))
    // An array of a generic keeps the Arr wrapper and folds only the element.
    results.add(assertTrue("canon Array<Box<i64>> == Array:Box-i64",
        equalType(canonType(parseType("Array<Box<i64>>")), canonType(parseType("Array:Box-i64")))))

    // KEY INVARIANT: canonType is printSuruType-preserving, so routing both sides of
    // isAssignable through it feeds the string-keyed registries exactly the strings
    // makeSuruType produced before §3.4.
    results.add(assertEqStr("canon preserves suruType i64",
        printSuruType(canonType(parseType("i64"))), makeSuruType("i64")))
    results.add(assertEqStr("canon preserves suruType Array<i64>",
        printSuruType(canonType(parseType("Array<i64>"))), makeSuruType("Array<i64>")))
    results.add(assertEqStr("canon preserves suruType Array:i64",
        printSuruType(canonType(parseType("Array:i64"))), makeSuruType("Array:i64")))
    results.add(assertEqStr("canon preserves suruType Box<i64>",
        printSuruType(canonType(parseType("Box<i64>"))), makeSuruType("Box<i64>")))
    results.add(assertEqStr("canon preserves suruType Box-i64",
        printSuruType(canonType(parseType("Box-i64"))), makeSuruType("Box-i64")))
    results.add(assertEqStr("canon preserves suruType Pair<i64, String>",
        printSuruType(canonType(parseType("Pair<i64, String>"))), makeSuruType("Pair<i64, String>")))
    results.add(assertEqStr("canon preserves suruType Option<Array<i64>>",
        printSuruType(canonType(parseType("Option<Array<i64>>"))), makeSuruType("Option<Array<i64>>")))
    results.add(assertEqStr("canon preserves suruType Array<Array<i64>>",
        printSuruType(canonType(parseType("Array<Array<i64>>"))), makeSuruType("Array<Array<i64>>")))

    return results
}
