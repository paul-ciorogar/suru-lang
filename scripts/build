#!/usr/bin/env bash
#
# scripts/build — build the Suru compiler and drive its `build` subcommand.
#
# One of the scripts/ wrappers. Each wrapper is a thin shim meant to run INSIDE
# the suru-dev container, so the canonical invocation is:
#
#   docker compose run --rm dev scripts/build
#
# The compose entrypoint execs its arguments at WORKDIR /workspace, so the
# relative path `scripts/build` resolves directly — no PATH wiring needed.
#
# What it does, end to end:
#   1. Build the whole solution in Release  (`dotnet build Suru.slnx`).
#   2. Locate the emitted `suru` apphost. Suru.Cli sets AssemblyName=suru, so a
#      plain build already produces a runnable native launcher (no `publish`).
#   3. Invoke the CLI `build` subcommand through that apphost, forwarding any
#      extra arguments, so the full build→binary→CLI plumbing is exercised.
#
# Exit code: propagated from the CLI (via `exec`), or non-zero if the build or
# the apphost-presence check fails first.
#
# NOTE: this relies on the environment docker-compose.yml already provides
# (writable HOME, NUGET_PACKAGES under .cache/, telemetry opt-out). Running it
# outside the container works too as long as the pinned .NET SDK is on PATH.
set -euo pipefail

# Resolve the repo root from this script's own location so the wrapper works no
# matter what the caller's CWD is. scripts/build lives one level under the root.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${here}/.." && pwd)"
cd "${root}"

# 1. Build the solution. Release matches the config the smoke test and docs use.
echo "== dotnet build (Release) =="
dotnet build Suru.slnx -c Release

# 2. The apphost the build emits for Suru.Cli. AssemblyName=suru (see the
#    .csproj) means the native launcher is named `suru`; the framework build
#    lands under bin/<Config>/<TargetFramework>/.
suru="${root}/src/Suru.Cli/bin/Release/net10.0/suru"
if [[ ! -x "${suru}" ]]; then
    echo "ERROR: expected the suru apphost at ${suru} but it is missing or not executable." >&2
    echo "       (Did the Suru.Cli output layout change? Check AssemblyName / TargetFramework.)" >&2
    exit 1
fi

# 3. Drive the CLI `build` subcommand, forwarding any extra args. `exec` hands
#    our PID (and exit code) to the CLI so callers/CI see its status directly.
echo "== suru build =="
exec "${suru}" build "$@"
