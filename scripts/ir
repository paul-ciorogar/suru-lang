#!/usr/bin/env bash
#
# scripts/ir — dump the LLVM IR for a Suru source file (scripts/ wrapper).
#
# Thin shim over the CLI `ir` subcommand, meant to run INSIDE the suru-dev
# container:
#
#   docker compose run --rm dev scripts/ir path/to/program.suru
#
# The compose entrypoint execs its args at WORKDIR /workspace, so the relative
# path `scripts/ir` resolves directly.
#
# There is no IR emission yet, so this reports "not implemented"; the point now
# is that the `.suru` path is forwarded to the CLI correctly. Like scripts/run
# it uses `dotnet run`, which builds-if-needed and executes.
#
# Exit code: propagated from the CLI (a placeholder `ir` reports failure, exit 1).
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${here}/.." && pwd)"
cd "${root}"

# `--` separates `dotnet run` options from the arguments passed to the program,
# so "$@" (the .suru path and any extra args) reaches the CLI verbatim.
exec dotnet run --project src/Suru.Cli -c Release -- ir "$@"
