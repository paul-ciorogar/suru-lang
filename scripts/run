#!/usr/bin/env bash
#
# scripts/run — compile and run a Suru program (scripts/ wrapper).
#
# Thin shim over the CLI `run` subcommand, meant to run INSIDE the suru-dev
# container:
#
#   docker compose run --rm dev scripts/run path/to/program.suru
#
# The compose entrypoint execs its args at WORKDIR /workspace, so the relative
# path `scripts/run` resolves directly.
#
# The compiler pipeline is a placeholder, so this reports "not implemented";
# the point now is that the `.suru` path is forwarded to the CLI correctly.
# Unlike scripts/build (whose job is to emit the binary), run/ir use
# `dotnet run`, which builds-if-needed and executes in one step.
#
# Exit code: propagated from the CLI (a placeholder `run` reports failure, exit 1).
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${here}/.." && pwd)"
cd "${root}"

# `--` separates `dotnet run` options from the arguments passed to the program,
# so "$@" (the .suru path and any extra args) reaches the CLI verbatim.
exec dotnet run --project src/Suru.Cli -c Release -- run "$@"
