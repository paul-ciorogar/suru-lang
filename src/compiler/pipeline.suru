// pipeline.suru — Suru compilation pipeline library.
//
// All pipeline stages shared between the bootstrap driver (build.suru) and
// the user-facing CLI (src/cli/main.suru).
//
// Public entry points:
//   runBuildDriver(sourcePath, outputPath)  — full pipeline + write per-module .ll files
//   generateIRText(sourcePath)              — full pipeline, return IR string (no file I/O)
//   compilePipeline(sourcePath, buildDir)   — full pipeline + mkdir + clang link
//
// Utilities re-used by the CLI for lex/parse commands:
//   dirName, baseName, normalizePath, fileNameStem

namespace Suru.Compiler.Pipeline

import {
    lex: Suru.Compiler.Lexer
    parser: Suru.Compiler.Parser
    nodes: Suru.Compiler.Parser.Nodes
    irCodegen: Suru.Compiler.Codegen
    semantic: Suru.Compiler.Semantic
    passes: Suru.Compiler.Semantic.Passes
    semstmts: Suru.Compiler.Semantic.Stmts
    fns: Suru.Compiler.Semantic.Fns
    semresolve: Suru.Compiler.Semantic.ResolveTypes
    monoPass: Suru.Compiler.Semantic.Mono
    collect: Suru.Compiler.Semantic.Mono.Collect
    infer: Suru.Compiler.Semantic.Mono.Infer
    inst: Suru.Compiler.Semantic.Mono.Instantiate
    nsPass: Suru.Compiler.Semantic.NamespacePass
    exportPass: Suru.Compiler.Semantic.ExportPass
    importPass: Suru.Compiler.Semantic.ImportPass
    qualNamePass: Suru.Compiler.Semantic.QualNamePass
    nsReg: Suru.Compiler.Semantic.NsRegistry
    Suru.Compiler.PathUtils
}


// ─── Project file discovery ────────────────────────────────────────────────────

// findProjectFile — walk upward from startDir looking for a `.suruproject`
// file. Returns the absolute path to the first one found, or "" if none exists
// within 20 directory levels.
//
// A `.suruproject` file at the repo root lets the compiler scan source
// directories outside the entry-file's own directory (e.g. `src/compiler/`
// when the entry file lives in `src/cli/`).
fn findProjectFile(startDir String) String {
    let tmpFile String: "/tmp/__suru_projfile.txt"
    let d String: startDir
    let maxLevels i64: 20
    let level i64: 0
    while level.lt(maxLevels) {
        let dir String: d
        if dir.len().gt(0) and not dir.at(dir.len().take(1)).equals("/") {
            dir: dir.append("/")
        }
        if dir.len().equals(0) { return "" }
        let candidate String: dir.append(".suruproject")
        exec("test -f '".append(candidate).append("' && echo '").append(candidate).append("' > ").append(tmpFile).append(" || echo '' > ").append(tmpFile))
        let content String: readFile(tmpFile)
        let lines Array<String>: nsReg.splitLines(content)
        if lines.len().gt(0) {
            let first String: lines.at(0)
            if not first.equals("") { return first }
        }
        // Strip trailing slash then take parent with dirName.
        let noSlash String: dir.slice(0, dir.len().take(1))
        if noSlash.len().equals(0) { return "" }
        let parent String: dirName(noSlash)
        if parent.equals(dir) { return "" }
        d: parent
        level: level.add(1)
    }
    return ""
}

// readProjectSourceDirs — parse a `.suruproject` file and return a list of
// source-root directories. Each non-empty, non-comment line is one entry;
// relative paths are resolved against the directory that contains the project
// file; absolute paths are used as-is.
fn readProjectSourceDirs(projectFile String) Array<String> {
    let projectDir String: dirName(projectFile)
    let content String: readFile(projectFile)
    let rawLines Array<String>: nsReg.splitLines(content)
    let dirs Array<String>: []
    let i i64: 0
    while i.lt(rawLines.len()) {
        let line String: rawLines.at(i)
        if line.len().gt(0) and not line.at(0).equals("#") {
            if line.at(0).equals("/") {
                dirs.add(line)
            } else {
                dirs.add(projectDir.append(line))
            }
        }
        i: i.add(1)
    }
    return dirs
}

// registryRootsFor — compute the full list of directories to scan when building
// the namespace registry for sourcePath. Always includes the entry file's own
// directory; if a `.suruproject` file is found by walking upward, its listed
// source roots are appended.
fn registryRootsFor(sourcePath String) Array<String> {
    let roots Array<String>: []
    roots.add(dirName(sourcePath))
    let projectFile String: findProjectFile(dirName(sourcePath))
    if not projectFile.equals("") {
        let extraDirs Array<String>: readProjectSourceDirs(projectFile)
        let i i64: 0
        while i.lt(extraDirs.len()) {
            roots.add(extraDirs.at(i))
            i: i.add(1)
        }
    }
    return roots
}

// ─── Include resolution ────────────────────────────────────────────────────────

// Module — a first-class compilation unit. Each source file in the transitive
// dependency graph produces one Module. The pipeline operates on Array<Module>
// for per-module passes and derives the flat merged stmts for global passes.
//
// stmts holds the file's own declarations (FnDeclNode, TypeDeclNode, etc.) —
// same nodes added to ResolveState.decls, but grouped per file.
// importedNs holds the namespace strings from every ImportNode in the file;
// used to build the per-module import context for semantic validation.
export type Module: { srcPath String, ns String, stmts Array<AstNode>, importedNs Array<String> }

// Carries accumulated declarations and the set of already-resolved absolute
// paths so transitive and diamond includes are handled without re-processing.
// nsExports accumulates namespace→exported-names pairs from resolved files;
// populated by resolveIncludesRec so the import desugaring pass can validate
// selective imports without re-parsing resolved sources.
// srcNsEntries maps each resolved file's absolute path to its namespace declaration,
// so codegen can namespace-mangle symbols without re-parsing.
// modules accumulates one Module per resolved file (including the root).
export type ResolveState: { decls Array<AstNode>, resolved Array<String>, nsExports Array<NsExportEntry>, srcNsEntries Array<SrcNsEntry>, modules Array<Module> }

// Return value of resolveIncludes: merged statement list + ordered deduplicated
// list of resolved absolute source paths (in depth-first resolution order).
// modules is the ordered list of per-file Module objects (root first, then
// transitive dependencies in depth-first order).
export type ResolveResult: { stmts Array<AstNode>, includedPaths Array<String>, nsExports Array<NsExportEntry>, srcNsEntries Array<SrcNsEntry>, modules Array<Module> }

// Linear scan: true if path already appears in the resolved list.
fn pathResolved(resolved Array<String>, path String) bool {
    let i i64: 0
    while i.lt(resolved.len()) {
        if resolved.at(i).equals(path) { return true }
        i: i.add(1)
    }
    return false
}

// Depth-first recursive resolver.  For each ImportNode entry in stmts:
//   - look up the namespace in the registry to find the file path
//   - skip if already in state.resolved (diamond dedup)
//   - otherwise mark as resolved, recurse into that file's own imports first,
//     then add its FnDeclNode / TypeDeclNode / SumTypeDeclNode / scalar LetNode
//     to state.decls.
export fn resolveIncludesRec(stmts Array<AstNode>, dir String, filePath String, state ResolveState, reg NamespaceRegistry) ResolveState {
    // Pre-scan: extract this file's namespace and exported names so the import
    // desugaring pass can validate selective imports against this file's exports.
    let fileNs String: ""
    let pi i64: 0
    while pi.lt(stmts.len()) {
        match stmts.at(pi) {
            NamespaceDeclNode: {
                let ns NamespaceDeclNode: stmts.at(pi)
                fileNs: ns.name
            }
            _: {}
        }
        pi: pi.add(1)
    }
    if not fileNs.equals("") {
        let exported Array<String>: []
        let ei i64: 0
        while ei.lt(stmts.len()) {
            match stmts.at(ei) {
                ExportNode: {
                    let en ExportNode: stmts.at(ei)
                    let enEntries Array<ExportEntry>: en.entries
                    let ej i64: 0
                    while ej.lt(enEntries.len()) {
                        exported.add(enEntries.at(ej).exportedAs)
                        ej: ej.add(1)
                    }
                }
                _: {}
            }
            ei: ei.add(1)
        }
        let nse NsExportEntry: { ns: fileNs, exported: exported }
        state.nsExports.add(nse)
        // Also record the srcPath→namespace mapping so codegen can namespace-mangle symbols.
        let nsentry SrcNsEntry: { srcPath: filePath, ns: fileNs }
        state.srcNsEntries.add(nsentry)
    }
    // Collect this file's imported namespaces for the per-module import registry.
    // Done before Pass 1 so the Module record reflects this file's own imports only.
    let importedNs Array<String>: []
    let imNsIdx i64: 0
    while imNsIdx.lt(stmts.len()) {
        match stmts.at(imNsIdx) {
            ImportNode: {
                let imp ImportNode: stmts.at(imNsIdx)
                let imNsEi i64: 0
                while imNsEi.lt(imp.entries.len()) {
                    importedNs.add(imp.entries.at(imNsEi).ns)
                    imNsEi: imNsEi.add(1)
                }
            }
            _: {}
        }
        imNsIdx: imNsIdx.add(1)
    }
    // Pass 1: add this file's own declarations first (pre-order DFS).
    // Record the decls count before so we can slice out this file's own entries.
    let fileDeclStart i64: state.decls.len()
    let i i64: 0
    while i.lt(stmts.len()) {
        let s AstNode: stmts.at(i)
        match s {
            FnDeclNode: {
                let fd FnDeclNode: s
                fd.srcPath: filePath
                state.decls.add(fd)
            }
            TypeDeclNode:    { state.decls.add(s) }
            SumTypeDeclNode: { state.decls.add(s) }
            LetNode: {
                // Stamp srcPath so codegen can namespace-mangle global constant names.
                let ld LetNode: s
                match ld.value {
                    IntLitNode: {
                        ld.srcPath: filePath
                        state.decls.add(ld)
                    }
                    BoolLitNode: {
                        ld.srcPath: filePath
                        state.decls.add(ld)
                    }
                    FloatLitNode: {
                        ld.srcPath: filePath
                        state.decls.add(ld)
                    }
                    _: {}
                }
            }
            _: {}
        }
        i: i.add(1)
    }
    // Build the Module for this file from the declarations added in Pass 1
    // and the imported namespaces collected above.  Added to state.modules before
    // Pass 2 recurses so that the DFS order matches state.decls order.
    let fileDecls Array<AstNode>: state.decls.slice(fileDeclStart, state.decls.len())
    let fileModule Module: { srcPath: filePath, ns: fileNs, stmts: fileDecls, importedNs: importedNs }
    state.modules.add(fileModule)
    // Pass 2: auto-discover files referenced by ImportNode entries.
    // For each import entry, look up the namespace in the registry; if a file
    // is found and has not already been merged, load it exactly like an include.
    let impi i64: 0
    while impi.lt(stmts.len()) {
        match stmts.at(impi) {
            ImportNode: {
                let imp ImportNode: stmts.at(impi)
                let ei i64: 0
                while ei.lt(imp.entries.len()) {
                    let entry ImportEntry: imp.entries.at(ei)
                    let nsPath String: nsReg.nsRegistryLookup(reg, entry.ns)
                    if not nsPath.equals("") {
                        if not pathResolved(state.resolved, nsPath) {
                            state.resolved.add(nsPath)
                            let nsSrc String: readFile(nsPath)
                            let nsToks Array<Token>: lex.tokenize(nsSrc, nsPath)
                            let nsMod AstModule: parser.parse(nsToks, nsPath)
                            state: resolveIncludesRec(nsMod.stmts, dirName(nsPath), nsPath, state, reg)
                        }
                    }
                    ei: ei.add(1)
                }
            }
            _: {}
        }
        impi: impi.add(1)
    }
    // Pass 3: discover files referenced by unimported fully-qualified name calls
    // (e.g. My.Lib.fn() with no import statement).  collectQualNsPrefixes extracts
    // candidate namespace strings from the AST; any that match a registry entry are
    // loaded exactly like an ImportNode-driven dependency.
    let qualPrefixes Array<String>: qualNamePass.collectQualNsPrefixes(stmts)
    let qi i64: 0
    while qi.lt(qualPrefixes.len()) {
        let qns String: qualPrefixes.at(qi)
        let qnsPath String: nsReg.nsRegistryLookup(reg, qns)
        if not qnsPath.equals("") {
            if not pathResolved(state.resolved, qnsPath) {
                state.resolved.add(qnsPath)
                let qnsSrc String: readFile(qnsPath)
                let qnsToks Array<Token>: lex.tokenize(qnsSrc, qnsPath)
                let qnsMod AstModule: parser.parse(qnsToks, qnsPath)
                state: resolveIncludesRec(qnsMod.stmts, dirName(qnsPath), qnsPath, state, reg)
            }
        }
        qi: qi.add(1)
    }
    return state
}

// Resolve all transitive dependencies from mainStmts via the namespace registry.
// Returns the merged statement list (main file's own nodes FIRST, then transitive
// declarations) and the ordered deduplicated list of resolved absolute source paths.
export fn resolveIncludes(mainStmts Array<AstNode>, dir String, rootPath String, reg NamespaceRegistry) ResolveResult {
    let initSrcNsEntries Array<SrcNsEntry>: []
    let initModules Array<Module>: []
    let state ResolveState: { decls: [], resolved: [], nsExports: [], srcNsEntries: initSrcNsEntries, modules: initModules }
    // Seed the root path into the resolved set so an import cycle that leads
    // back to the root (e.g. String → StringBuilder → String, when the root is
    // String or StringBuilder) does not re-include the root as a transitive
    // dependency — that would add the root's own declarations a second time and
    // make codegen emit every root function/object-literal twice. The root's
    // own declarations are added by the dedicated root-handling block below, not
    // by resolveIncludesRec. rootPath is excluded from the returned includedPaths.
    state.resolved.add(rootPath)
    // Auto-discover files for the root file's ImportNode entries.
    // For each import entry namespace, look up the registry and load the file
    // if it hasn't already been merged.
    let ri i64: 0
    while ri.lt(mainStmts.len()) {
        match mainStmts.at(ri) {
            ImportNode: {
                let imp ImportNode: mainStmts.at(ri)
                let ei i64: 0
                while ei.lt(imp.entries.len()) {
                    let entry ImportEntry: imp.entries.at(ei)
                    let nsPath String: nsReg.nsRegistryLookup(reg, entry.ns)
                    if not nsPath.equals("") {
                        if not pathResolved(state.resolved, nsPath) {
                            state.resolved.add(nsPath)
                            let nsSrc String: readFile(nsPath)
                            let nsToks Array<Token>: lex.tokenize(nsSrc, nsPath)
                            let nsMod AstModule: parser.parse(nsToks, nsPath)
                            state: resolveIncludesRec(nsMod.stmts, dirName(nsPath), nsPath, state, reg)
                        }
                    }
                    ei: ei.add(1)
                }
            }
            _: {}
        }
        ri: ri.add(1)
    }
    // Extract the root file's namespace declaration (if any) and register it in
    // srcNsEntries so codegen can namespace-mangle the root file's own symbols.
    let rootNs String: ""
    let ni i64: 0
    while ni.lt(mainStmts.len()) {
        match mainStmts.at(ni) {
            NamespaceDeclNode: {
                let nd NamespaceDeclNode: mainStmts.at(ni)
                rootNs: nd.name
            }
            _: {}
        }
        ni: ni.add(1)
    }
    if not rootNs.equals("") {
        let rootNsEntry SrcNsEntry: { srcPath: rootPath, ns: rootNs }
        state.srcNsEntries.add(rootNsEntry)
    }
    // Collect the root file's imported namespaces for its Module record.
    let rootImportedNs Array<String>: []
    let rni i64: 0
    while rni.lt(mainStmts.len()) {
        match mainStmts.at(rni) {
            ImportNode: {
                let rimp ImportNode: mainStmts.at(rni)
                let rnei i64: 0
                while rnei.lt(rimp.entries.len()) {
                    rootImportedNs.add(rimp.entries.at(rnei).ns)
                    rnei: rnei.add(1)
                }
            }
            _: {}
        }
        rni: rni.add(1)
    }
    // Main file's own nodes FIRST, then transitive declarations.
    // Stamp the root file's own functions with rootPath so their symbols are
    // mangled consistently with the declares emitted in files that include it.
    // Also stamp scalar LetNodes so registerConstants can namespace-mangle them.
    // Collect rootDecls in parallel for the root Module.
    let all Array<AstNode>: []
    let rootDecls Array<AstNode>: []
    let j i64: 0
    while j.lt(mainStmts.len()) {
        let s AstNode: mainStmts.at(j)
        match s {
            FnDeclNode: {
                let fd FnDeclNode: s
                fd.srcPath: rootPath
                all.add(fd)
                rootDecls.add(fd)
            }
            LetNode: {
                let ld LetNode: s
                match ld.value {
                    IntLitNode: {
                        ld.srcPath: rootPath
                        all.add(ld)
                        rootDecls.add(ld)
                    }
                    BoolLitNode: {
                        ld.srcPath: rootPath
                        all.add(ld)
                        rootDecls.add(ld)
                    }
                    FloatLitNode: {
                        ld.srcPath: rootPath
                        all.add(ld)
                        rootDecls.add(ld)
                    }
                    _: { all.add(s) }
                }
            }
            TypeDeclNode: {
                all.add(s)
                rootDecls.add(s)
            }
            SumTypeDeclNode: {
                all.add(s)
                rootDecls.add(s)
            }
            _: { all.add(s) }
        }
        j: j.add(1)
    }
    let k i64: 0
    while k.lt(state.decls.len()) {
        all.add(state.decls.at(k))
        k: k.add(1)
    }
    // Build the root Module and prepend it to the module list (root first).
    let rootModule Module: { srcPath: rootPath, ns: rootNs, stmts: rootDecls, importedNs: rootImportedNs }
    let allModules Array<Module>: []
    allModules.add(rootModule)
    let mi i64: 0
    while mi.lt(state.modules.len()) {
        allModules.add(state.modules.at(mi))
        mi: mi.add(1)
    }
    // Exclude rootPath (seeded as a cycle guard) from includedPaths so callers
    // like runBuildDriver don't recompile the root as if it were a dependency.
    let includedPaths Array<String>: []
    let ipi i64: 0
    while ipi.lt(state.resolved.len()) {
        let rp String: state.resolved.at(ipi)
        if not rp.equals(rootPath) { includedPaths.add(rp) }
        ipi: ipi.add(1)
    }
    return { stmts: all, includedPaths: includedPaths, nsExports: state.nsExports, srcNsEntries: state.srcNsEntries, modules: allModules }
}

// ─── Semantic analysis helpers ─────────────────────────────────────────────────

// Returns a copy of stmts containing the main file's own statements only
// (transitive dependency declarations are appended by resolveIncludes after
// the root file's own nodes, so callers can pass mod.stmts directly to get
// just the root file's own declarations).
export fn collectNonInclude(stmts Array<AstNode>) Array<AstNode> {
    let result Array<AstNode>: []
    let i i64: 0
    while i.lt(stmts.len()) {
        result.add(stmts.at(i))
        i: i.add(1)
    }
    return result
}

// ─── Object method lambda-lift ─────────────────────────────────────────────────
//
// Runs after resolveModuleTypes (so every ObjectLitNode.resolvedType and every
// method-body expression is type-annotated) and before codegen. For each
// object literal of a type that declares methods it:
//   • synthesises one top-level FnDeclNode per declared method, with an
//     implicit leading `this` param, body = the per-instance method body;
//   • builds a constant vtable reference listing those functions in the type's
//     declared-method order;
//   • rewrites the literal's members to a single leading `$vtable` data field
//     (value = VtableRefNode) followed by the original data fields.
// Synthetic FnDeclNodes are appended to the module statement list so the normal
// codegen function loop emits them.

fn srcPathForLowering(fnSrc String, root String) String {
    if fnSrc.equals("") { return root }
    return fnSrc
}

// Declared methods of a type (in declaration order), from the analyzer state.
fn loTypeMethods(state AnalyzerState, typeName String) Array<SemMethodEntry> {
    let decls Array<SemTypeEntry>: state.typeDecls
    let i i64: 0
    while i.lt(decls.len()) {
        if decls.at(i).name.equals(typeName) { return decls.at(i).methods }
        i: i.add(1)
    }
    let empty Array<SemMethodEntry>: []
    return empty
}

fn loHasMethodMembers(fields Array<ObjectFieldNode>) bool {
    let i i64: 0
    while i.lt(fields.len()) {
        if fields.at(i).isMethod { return true }
        i: i.add(1)
    }
    return false
}

// Find the method member named `name` in a literal, or a sentinel whose
// name is "" when absent (strict-contract violation).
fn loFindMethodMember(fields Array<ObjectFieldNode>, name String) ObjectFieldNode {
    let i i64: 0
    while i.lt(fields.len()) {
        let f ObjectFieldNode: fields.at(i)
        if f.isMethod {
            if f.name.equals(name) { return f }
        }
        i: i.add(1)
    }
    let dummy WildcardNode: {}
    let noP Array<Param>: []
    let noB Array<AstNode>: []
    let none ObjectFieldNode: nodes.newObjectFieldNode("", dummy, false, false, "", noP, "", noB)
    return none
}

// lookupSrcPathNs — return the namespace string for srcPath from nsEntries, or "" if not found.
// Used by lowerObjectsObjectLit to mangle vtable entry names consistently with function definitions.
fn lookupSrcPathNs(nsEntries Array<SrcNsEntry>, srcPath String) String {
    let i i64: 0
    while i.lt(nsEntries.len()) {
        if nsEntries.at(i).srcPath.equals(srcPath) { return nsEntries.at(i).ns }
        i: i.add(1)
    }
    return ""
}

// nsToPrefix — converts a namespace string to a symbol prefix, keeping the dots
// ('.' is a valid unquoted LLVM symbol char users cannot write; e.g. "Suru.Cli"
// → "Suru.Cli"). Used for vtable global symbol names.
fn nsToPrefix(ns String) String {
    let out String: ""
    let i i64: 0
    while i.lt(ns.len()) {
        let ch String: ns.at(i)
        if ch.equals(".") { out: out.append(".") } else { out: out.append(ch) }
        i: i.add(1)
    }
    return out
}

// sanitizePathLocal — replaces every non-[A-Za-z0-9_] character in a path with
// '_' so it can be used as an LLVM symbol prefix. Fallback for files that have
// no namespace declaration (e.g. test fixtures that predate Task 13).
fn sanitizePathLocal(p String) String {
    let out String: ""
    let i i64: 0
    while i.lt(p.len()) {
        let ch String: p.at(i)
        let c i64: ch.ord()
        let isDig bool: c.gte(48) and c.lt(58)
        let isLow bool: c.gte(97) and c.lt(123)
        let isUp  bool: c.gte(65) and c.lt(91)
        let isUnd bool: ch.equals("_")
        let keep bool: isDig or isLow or isUp or isUnd
        if keep { out: out.append(ch) } else { out: out.append("_") }
        i: i.add(1)
    }
    return out
}

// vtablePrefix — returns a unique per-file symbol prefix for vtable globals:
// namespace-based when the source file has a namespace declaration, path-based
// otherwise (for files that predate the namespace transition).
fn vtablePrefix(ns String, srcPath String) String {
    if not ns.equals("") { return nsToPrefix(ns) }
    return sanitizePathLocal(srcPath)
}

fn lowerObjectsBody(state AnalyzerState, stmts Array<AstNode>, newDecls Array<AstNode>, ctr Array<i64>, srcPath String, root String, nsEntries Array<SrcNsEntry>) {
    let i i64: 0
    while i.lt(stmts.len()) {
        lowerObjectsStmt(state, stmts.at(i), newDecls, ctr, srcPath, root, nsEntries)
        i: i.add(1)
    }
}

fn lowerObjectsStmt(state AnalyzerState, stmt AstNode, newDecls Array<AstNode>, ctr Array<i64>, srcPath String, root String, nsEntries Array<SrcNsEntry>) {
    match stmt {
        FnDeclNode: {
            let f FnDeclNode: stmt
            let sp String: srcPathForLowering(f.srcPath, root)
            lowerObjectsBody(state, f.body, newDecls, ctr, sp, root, nsEntries)
        }
        LetNode: {
            let l LetNode: stmt
            lowerObjectsExpr(state, l.value, newDecls, ctr, srcPath, root, nsEntries)
        }
        AssignNode: {
            let a AssignNode: stmt
            lowerObjectsExpr(state, a.value, newDecls, ctr, srcPath, root, nsEntries)
        }
        FieldAssignNode: {
            let fa FieldAssignNode: stmt
            lowerObjectsExpr(state, fa.receiver, newDecls, ctr, srcPath, root, nsEntries)
            lowerObjectsExpr(state, fa.value, newDecls, ctr, srcPath, root, nsEntries)
        }
        ReturnNode: {
            let r ReturnNode: stmt
            if r.hasValue { lowerObjectsExpr(state, r.value, newDecls, ctr, srcPath, root, nsEntries) }
        }
        WhileNode: {
            let w WhileNode: stmt
            lowerObjectsExpr(state, w.condition, newDecls, ctr, srcPath, root, nsEntries)
            lowerObjectsBody(state, w.body, newDecls, ctr, srcPath, root, nsEntries)
        }
        IfNode: {
            let n IfNode: stmt
            lowerObjectsExpr(state, n.condition, newDecls, ctr, srcPath, root, nsEntries)
            let tb BlockNode: n.thenBranch
            lowerObjectsBody(state, tb.stmts, newDecls, ctr, srcPath, root, nsEntries)
            let eb BlockNode: n.elseBranch
            lowerObjectsBody(state, eb.stmts, newDecls, ctr, srcPath, root, nsEntries)
        }
        MatchStmtNode: {
            let ms MatchStmtNode: stmt
            lowerObjectsExpr(state, ms.condition, newDecls, ctr, srcPath, root, nsEntries)
            let arms Array<MatchStmtArm>: ms.arms
            let ai i64: 0
            while ai.lt(arms.len()) {
                lowerObjectsBody(state, arms.at(ai).stmts, newDecls, ctr, srcPath, root, nsEntries)
                ai: ai.add(1)
            }
        }
        BlockNode: {
            let b BlockNode: stmt
            lowerObjectsBody(state, b.stmts, newDecls, ctr, srcPath, root, nsEntries)
        }
        ExprStmtNode: {
            let e ExprStmtNode: stmt
            lowerObjectsExpr(state, e.expr, newDecls, ctr, srcPath, root, nsEntries)
        }
        _: {}
    }
}

fn lowerObjectsExprList(state AnalyzerState, xs Array<AstNode>, newDecls Array<AstNode>, ctr Array<i64>, srcPath String, root String, nsEntries Array<SrcNsEntry>) {
    let i i64: 0
    while i.lt(xs.len()) {
        lowerObjectsExpr(state, xs.at(i), newDecls, ctr, srcPath, root, nsEntries)
        i: i.add(1)
    }
}

fn lowerObjectsExpr(state AnalyzerState, expr AstNode, newDecls Array<AstNode>, ctr Array<i64>, srcPath String, root String, nsEntries Array<SrcNsEntry>) {
    match expr {
        ObjectLitNode: {
            let lit ObjectLitNode: expr
            lowerObjectsObjectLit(state, lit, newDecls, ctr, srcPath, root, nsEntries)
        }
        ArrayLitNode: {
            let a ArrayLitNode: expr
            lowerObjectsExprList(state, a.elems, newDecls, ctr, srcPath, root, nsEntries)
        }
        CallNode: {
            let c CallNode: expr
            lowerObjectsExprList(state, c.args, newDecls, ctr, srcPath, root, nsEntries)
        }
        MethodCallNode: {
            let mc MethodCallNode: expr
            lowerObjectsExpr(state, mc.receiver, newDecls, ctr, srcPath, root, nsEntries)
            lowerObjectsExprList(state, mc.args, newDecls, ctr, srcPath, root, nsEntries)
        }
        FieldAccessNode: {
            let fa FieldAccessNode: expr
            lowerObjectsExpr(state, fa.receiver, newDecls, ctr, srcPath, root, nsEntries)
        }
        MatchExprNode: {
            let me MatchExprNode: expr
            lowerObjectsExpr(state, me.condition, newDecls, ctr, srcPath, root, nsEntries)
            let arms Array<MatchArm>: me.arms
            let ai i64: 0
            while ai.lt(arms.len()) {
                lowerObjectsExpr(state, arms.at(ai).body, newDecls, ctr, srcPath, root, nsEntries)
                ai: ai.add(1)
            }
        }
        UnaryNode: {
            let u UnaryNode: expr
            lowerObjectsExpr(state, u.operand, newDecls, ctr, srcPath, root, nsEntries)
        }
        BinaryNode: {
            let b BinaryNode: expr
            lowerObjectsExpr(state, b.left, newDecls, ctr, srcPath, root, nsEntries)
            lowerObjectsExpr(state, b.right, newDecls, ctr, srcPath, root, nsEntries)
        }
        _: {}
    }
}

fn lowerObjectsObjectLit(state AnalyzerState, lit ObjectLitNode, newDecls Array<AstNode>, ctr Array<i64>, srcPath String, root String, nsEntries Array<SrcNsEntry>) {
    let typeName String: lit.resolvedType
    let fields Array<ObjectFieldNode>: lit.fields
    let methods Array<SemMethodEntry>: loTypeMethods(state, typeName)
    let hasM bool: loHasMethodMembers(fields)
    if hasM and methods.len().equals(0) {
        state.addError("object literal supplies a method body but type '".append(typeName).append("' declares no methods"), lit.line, lit.col)
        return
    }
    if methods.len().equals(0) {
        // Plain data struct — just recurse field values for nested objects.
        let d i64: 0
        while d.lt(fields.len()) {
            lowerObjectsExpr(state, fields.at(d).value, newDecls, ctr, srcPath, root, nsEntries)
            d: d.add(1)
        }
        return
    }
    let site i64: ctr.at(0)
    ctr.set(site.add(1), 0)
    let siteStr String: site.toString()
    let entrySyms Array<String>: []
    let j i64: 0
    let errsBefore i64: state.errors.len()
    while j.lt(methods.len()) {
        let m SemMethodEntry: methods.at(j)
        let member ObjectFieldNode: loFindMethodMember(fields, m.name)
        if member.name.equals("") {
            state.addError("object literal of type '".append(typeName).append("' is missing required implementation for method '").append(m.name).append("'"), lit.line, lit.col)
            j: j.add(1)
        }
        if not member.name.equals("") {
            let synth String: "$m_".append(typeName).append("_").append(m.name).append("_").append(siteStr)
            let params Array<Param>: []
            params.add(nodes.newParam("this", typeName))
            let mp Array<Param>: member.methodParams
            let k i64: 0
            while k.lt(mp.len()) {
                params.add(mp.at(k))
                k: k.add(1)
            }
            let body Array<AstNode>: member.methodBody
            // Lift nested object literals inside the method body too.
            lowerObjectsBody(state, body, newDecls, ctr, srcPath, root, nsEntries)
            let fnDecl FnDeclNode: { name: synth, params: params, returnType: member.methodRet, body: body, srcPath: srcPath, typeParams: [], line: 0, col: 0 }
            newDecls.add(fnDecl)
            // Use namespace-based mangling when the source file has a namespace, so
            // vtable entry names match the function definitions emitted by fnMangleSym.
            let entryNs String: lookupSrcPathNs(nsEntries, srcPath)
            let entrySym String: match entryNs.equals("") {
                true: synth
                _:    mangleNsSym(entryNs, synth)
            }
            entrySyms.add(entrySym)
            j: j.add(1)
        }
    }
    if state.errors.len().gt(errsBefore) { return }
    // Include the owning file in the vtable global's symbol so two files that
    // each declare a literal of the same type at the same site index don't
    // mint colliding `@vtable.<Type>.<n>` definitions. Each .ll only emits its
    // own vtable globals (codegen of an included file's literal is skipped in
    // the root compilation), so this naming guarantees link-time uniqueness.
    let vtsym String: "@vtable.".append(vtablePrefix(entryNs, srcPath)).append(".").append(typeName).append(".").append(siteStr)
    let newFields Array<ObjectFieldNode>: []
    let vr VtableRefNode: { sym: vtsym, entries: entrySyms, resolvedType: typeName }
    let noP Array<Param>: []
    let noB Array<AstNode>: []
    newFields.add(nodes.newObjectFieldNode("$vtable", vr, false, false, "", noP, "", noB))
    let d i64: 0
    while d.lt(fields.len()) {
        let f ObjectFieldNode: fields.at(d)
        if not f.isMethod {
            newFields.add(f)
            lowerObjectsExpr(state, f.value, newDecls, ctr, srcPath, root, nsEntries)
        }
        d: d.add(1)
    }
    lit.fields: newFields
}

// ─── Private field codegen augmentation ──────────────────────────────────────
// These helpers scan the stmts for object literals that carry isPrivate data
// fields and inject those fields into the corresponding TypeDeclNode.fields so
// the codegen's registerTypes step includes them in the struct layout.
// This must run before lowerObjects (and therefore before registerTypes).

// augPrivAddField — finds the TypeDeclNode for `typeName` in stmts and appends
// the private field (fieldName, fieldTypeName) if not already present.
fn augPrivAddField(stmts Array<AstNode>, typeName String, fieldName String, fieldTypeName String) {
    // After monomorphization, the object literal's return/let type annotation may
    // still use the generic-application form ("DynArray<i64>") while the TypeDeclNode
    // uses the mangled form ("DynArray-i64"). Normalize so both forms match.
    let mangledTypeName String: passes.normalizeGenericTypeName(typeName)
    let i i64: 0
    while i.lt(stmts.len()) {
        match stmts.at(i) {
            TypeDeclNode: {
                let td TypeDeclNode: stmts.at(i)
                if td.name.equals(typeName) or td.name.equals(mangledTypeName) {
                    let fields Array<Param>: td.fields
                    let alreadyHas bool: false
                    let k i64: 0
                    while k.lt(fields.len()) {
                        if fields.at(k).name.equals(fieldName) { alreadyHas: true }
                        k: k.add(1)
                    }
                    if not alreadyHas { fields.add(nodes.newParam(fieldName, fieldTypeName)) }
                }
            }
            _: {}
        }
        i: i.add(1)
    }
    drop(mangledTypeName)
}

// augPrivAddMethod — finds the TypeDeclNode for `typeName` in stmts and appends
// the private method signature (name, params, returnType) if not already present.
// Mirrors augPrivAddField: this injects the method into TypeDeclNode.methods so
// codegen's registerTypes builds a TypeMethodEntry for it and methodIndex finds
// it (→ proper vtable dispatch instead of the -1 fall-through that segfaults).
fn augPrivAddMethod(stmts Array<AstNode>, typeName String, name String, params Array<Param>, returnType String) {
    let mangledTypeName String: passes.normalizeGenericTypeName(typeName)
    let i i64: 0
    while i.lt(stmts.len()) {
        match stmts.at(i) {
            TypeDeclNode: {
                let td TypeDeclNode: stmts.at(i)
                if td.name.equals(typeName) or td.name.equals(mangledTypeName) {
                    let methods Array<MethodSig>: td.methods
                    let alreadyHas bool: false
                    let k i64: 0
                    while k.lt(methods.len()) {
                        if methods.at(k).name.equals(name) { alreadyHas: true }
                        k: k.add(1)
                    }
                    if not alreadyHas { methods.add(nodes.newMethodSig(name, params, returnType)) }
                }
            }
            _: {}
        }
        i: i.add(1)
    }
    drop(mangledTypeName)
}

// augPrivFromLitFields — iterates a object literal's fields; for each private
// data field, calls augPrivAddField; for each private method, calls
// augPrivAddMethod to update the TypeDeclNode.
fn augPrivFromLitFields(stmts Array<AstNode>, typeName String, litFields Array<ObjectFieldNode>) {
    let i i64: 0
    while i.lt(litFields.len()) {
        let f ObjectFieldNode: litFields.at(i)
        if f.isPrivate {
            if f.isMethod {
                augPrivAddMethod(stmts, typeName, f.name, f.methodParams, f.methodRet)
            } else {
                augPrivAddField(stmts, typeName, f.name, f.privateTypeName)
            }
        }
        i: i.add(1)
    }
}

// augPrivInBody — scans a function body for LetNode and ReturnNode struct
// literals and calls augPrivFromLitFields for any that have private fields.
// returnTypeName is the enclosing function's declared return type, used to
// identify the TypeDeclNode when a ReturnNode directly contains a struct lit.
export fn augPrivInBody(stmts Array<AstNode>, body Array<AstNode>, returnTypeName String) {
    let i i64: 0
    while i.lt(body.len()) {
        match body.at(i) {
            LetNode: {
                let ln LetNode: body.at(i)
                match ln.value {
                    ObjectLitNode: {
                        let sl ObjectLitNode: ln.value
                        augPrivFromLitFields(stmts, ln.typeName, sl.fields)
                    }
                    _: {}
                }
            }
            ReturnNode: {
                let rn ReturnNode: body.at(i)
                if rn.hasValue {
                    match rn.value {
                        ObjectLitNode: {
                            let sl ObjectLitNode: rn.value
                            augPrivFromLitFields(stmts, returnTypeName, sl.fields)
                        }
                        _: {}
                    }
                }
            }
            _: {}
        }
        i: i.add(1)
    }
}

// augmentPrivateFields — top-level pass: walks function declarations and
// injects private data fields from their body object literals into TypeDeclNodes.
fn augmentPrivateFields(stmts Array<AstNode>) {
    let i i64: 0
    while i.lt(stmts.len()) {
        match stmts.at(i) {
            FnDeclNode: {
                let fd FnDeclNode: stmts.at(i)
                augPrivInBody(stmts, fd.body, fd.returnType)
            }
            _: {}
        }
        i: i.add(1)
    }
}

// lowerObjects — module driver. Walks `stmts`, lifts object methods, and
// appends every synthesised FnDeclNode to `stmts`.
export fn lowerObjects(state AnalyzerState, stmts Array<AstNode>, root String, nsEntries Array<SrcNsEntry>) {
    // Pre-pass: inject private data fields from object literals into TypeDeclNodes
    // so the codegen's registerTypes creates the correct struct layout (size + GEP offsets).
    augmentPrivateFields(stmts)
    let newDecls Array<AstNode>: []
    let ctr Array<i64>: [0]
    let n i64: stmts.len()
    let i i64: 0
    while i.lt(n) {
        lowerObjectsStmt(state, stmts.at(i), newDecls, ctr, root, root, nsEntries)
        i: i.add(1)
    }
    let a i64: 0
    while a.lt(newDecls.len()) {
        stmts.add(newDecls.at(a))
        a: a.add(1)
    }
}

// analyzeModuleStatement — pass-3 dispatch for top-level statements.
fn analyzeModuleStatement(state AnalyzerState, stmt AstNode) AnalyzerState {
    match stmt {
        FnDeclNode:      { fns.analyzeFunctionDeclaration(state, stmt) }
        TypeDeclNode:    {}
        SumTypeDeclNode: {}
        _:               { semstmts.analyzeStatement(state, stmt) }
    }
    return state
}

// analyzeModuleStatements — iterates the module statement list.
export fn analyzeModuleStatements(state AnalyzerState, moduleStmts Array<AstNode>) AnalyzerState {
    let i i64: 0
    while i.lt(moduleStmts.len()) {
        analyzeModuleStatement(state, moduleStmts.at(i))
        i: i.add(1)
    }
    return state
}

// printErrorsFrom — prints each analysis error in rich diagnostic format.
// When line > 0:  path:line:col: error: message\n  N | sourceline\n      ^
// When line == 0: path: error: message  (no position info available)
fn printErrorsFrom(state AnalyzerState, path String) {
    let errors Array<AnalysisError>: state.errors
    let i i64: 0
    while i.lt(errors.len()) {
        let err AnalysisError: errors.at(i)
        let errPath String: match err.srcPath.equals("") { true: path, _: err.srcPath }
        if err.line.gt(0) {
            let header String: errPath.append(":").append(err.line.toString()).append(":").append(err.col.toString()).append(": error: ").append(err.message)
            printError(header)
            let src String: readFile(errPath)
            let srcLine String: extractSourceLine(src, err.line)
            let lineLabel String: "  ".append(err.line.toString()).append(" | ")
            printError(lineLabel.append(srcLine))
            let prefixLen i64: lineLabel.len().add(err.col.take(1))
            let caretLine String: buildSpaces(prefixLen).append("^")
            printError(caretLine)
        } else {
            printError(errPath.append(": error: ").append(err.message))
        }
        i: i.add(1)
    }
}

// ─── Own-declaration collectors ────────────────────────────────────────────────

// Collect the names of all FnDeclNode items in the raw parsed module statements.
fn collectFnNames(stmts Array<AstNode>) Array<String> {
    let names Array<String>: []
    let i i64: 0
    while i.lt(stmts.len()) {
        let s AstNode: stmts.at(i)
        match s {
            FnDeclNode: { names.add(s.name) }
            _: {}
        }
        i: i.add(1)
    }
    return names
}

// Collect the names of all TypeDeclNode and SumTypeDeclNode items in the raw
// parsed module statements (own types only, before include resolution).
fn collectTypeNames(stmts Array<AstNode>) Array<String> {
    let names Array<String>: []
    let i i64: 0
    while i.lt(stmts.len()) {
        let s AstNode: stmts.at(i)
        match s {
            TypeDeclNode:    { names.add(s.name) }
            SumTypeDeclNode: { names.add(s.name) }
            _: {}
        }
        i: i.add(1)
    }
    return names
}

// ─── Per-file compilation helper ───────────────────────────────────────────────

// Compile a single source file and write its .ll to outDir/<stem>.ll.
// Own functions get full definitions; functions from includes get declare stubs.
// Semantic *error reporting* is skipped — library files are validated by the
// root file — but the resolved-type annotation pass still runs so that every
// expression node carries its `resolvedType` for codegen to read. Without
// this, struct/array literals in included files would emit with an empty
// type name and crash the compiler.
export fn compileOneFile(sourcePath String, outDir String, reg NamespaceRegistry) {
    let src String: readFile(sourcePath)
    let tokens Array<Token>: lex.tokenize(src, sourcePath)
    let mod AstModule: parser.parse(tokens, sourcePath)
    let resolved ResolveResult: resolveIncludes(mod.stmts, dirName(sourcePath), sourcePath, reg)
    // Back-fill the registry with namespaces found via include directives so
    // that qualified-name codegen can mangle their symbols correctly.
    reg: nsReg.augmentRegistry(reg, resolved.srcNsEntries)
    let state AnalyzerState: semantic.makeAnalyzerState()
    state.currentSrcPath: sourcePath
    state.moduleImportRegistry: buildModuleImportRegistry(resolved.modules)
    passes.runPrePasses(state, resolved.stmts)
    semresolve.resolveModuleTypes(state, resolved.stmts)
    lowerObjects(state, resolved.stmts, sourcePath, resolved.srcNsEntries)
    // Filter generic templates (typeParams non-empty) from both the codegen
    // stmts and the own-name lists.  emitFunction decides to emit a full
    // definition based on fnDecl.srcPath == rootPath, so passing concreteStmts
    // prevents generic function bodies (e.g. some<T>) from being emitted in the
    // included file's IR.  Concrete instantiations are produced by the root
    // file's mono pass and emitted in the root file's IR only.
    let concreteStmts Array<AstNode>: monoPass.filterGenericDefs(resolved.stmts)
    let rewrittenStmts Array<AstNode>: qualNamePass.rewriteQualifiedCalls(concreteStmts, resolved.nsExports)
    let concreteOwnStmts Array<AstNode>: monoPass.filterGenericDefs(mod.stmts)
    let ownFnNames Array<String>: collectFnNames(concreteOwnStmts)
    let ownTypeNames Array<String>: collectTypeNames(concreteOwnStmts)
    let noMonoFns Array<String>: []
    let irText String: irCodegen.generate(rewrittenStmts, baseName(sourcePath), ownFnNames, ownTypeNames, noMonoFns, sourcePath, resolved.srcNsEntries)
    writeFile(outDir.append(fileNameStem(sourcePath)).append(".ll"), irText)
}

// ─── Mono grouping helpers ─────────────────────────────────────────────────────

// findGenericDeclSrcPath — return the source file path that declares the generic
// named `name`. For functions the path is stored on GenericFnDef; for types and
// sum types we scan the module list to find which file owns the declaration.
fn findGenericDeclSrcPath(name String, registry GenericRegistry, modules Array<Module>) String {
    let fi i64: registry.findFn(name)
    if not fi.equals(registry.fns.len()) {
        return registry.fns.at(fi).srcPath
    }
    let mi i64: 0
    while mi.lt(modules.len()) {
        let mod Module: modules.at(mi)
        let si i64: 0
        while si.lt(mod.stmts.len()) {
            match mod.stmts.at(si) {
                TypeDeclNode: {
                    let td TypeDeclNode: mod.stmts.at(si)
                    if td.name.equals(name) and td.typeParams.len().gt(0) { return mod.srcPath }
                }
                SumTypeDeclNode: {
                    let sd SumTypeDeclNode: mod.stmts.at(si)
                    if sd.name.equals(name) and sd.typeParams.len().gt(0) { return mod.srcPath }
                }
                _: {}
            }
            si: si.add(1)
        }
        mi: mi.add(1)
    }
    return ""
}

// groupRequestsByModule — partition requests into per-declaring-module groups.
// Each MonoGroup holds a declaringSrcPath and the requests whose generic was
// declared in that file.  Requests with unknown declaring modules are dropped.
fn groupRequestsByModule(requests Array<InstantiationRequest>, registry GenericRegistry, modules Array<Module>) Array<MonoGroup> {
    // First pass: collect unique declaring srcPaths.
    let srcPaths Array<String>: []
    let ri0 i64: 0
    while ri0.lt(requests.len()) {
        let req InstantiationRequest: requests.at(ri0)
        let sp String: findGenericDeclSrcPath(req.genericName, registry, modules)
        if not sp.equals("") {
            let found bool: false
            let si i64: 0
            while si.lt(srcPaths.len()) {
                if srcPaths.at(si).equals(sp) { found: true }
                si: si.add(1)
            }
            if not found { srcPaths.add(clone(sp)) }
        }
        ri0: ri0.add(1)
    }
    // Second pass: for each srcPath collect the matching requests.
    let groups Array<MonoGroup>: []
    let gi i64: 0
    while gi.lt(srcPaths.len()) {
        let sp String: srcPaths.at(gi)
        let groupReqs Array<InstantiationRequest>: []
        let ri i64: 0
        while ri.lt(requests.len()) {
            let req InstantiationRequest: requests.at(ri)
            let reqSp String: findGenericDeclSrcPath(req.genericName, registry, modules)
            if reqSp.equals(sp) {
                let cloned InstantiationRequest: { genericName: clone(req.genericName), concreteTypes: clone(req.concreteTypes) }
                groupReqs.add(cloned)
            }
            ri: ri.add(1)
        }
        let group MonoGroup: { declaringSrcPath: clone(sp), requests: groupReqs }
        groups.add(group)
        gi: gi.add(1)
    }
    drop(srcPaths)
    return groups
}

// compileOneFileWithRequests — compile a declaring module with a specific set of
// instantiation requests and write the concrete definitions to {stem}__mono.ll.
// This is Phase 2 of the shared-instantiation design: the declaring module's
// extern fn declarations (malloc, realloc, free, etc.) are naturally in scope,
// so the emitted IR is valid without any extern propagation hacks.
fn compileOneFileWithRequests(sourcePath String, outDir String, reg NamespaceRegistry, requests Array<InstantiationRequest>, globalRegistry GenericRegistry) {
    if requests.len().equals(0) { return }
    let src String: readFile(sourcePath)
    let tokens Array<Token>: lex.tokenize(src, sourcePath)
    let mod AstModule: parser.parse(tokens, sourcePath)
    let resolved ResolveResult: resolveIncludes(mod.stmts, dirName(sourcePath), sourcePath, reg)
    reg: nsReg.augmentRegistry(reg, resolved.srcNsEntries)
    let state AnalyzerState: semantic.makeAnalyzerState()
    state.currentSrcPath: sourcePath
    state.moduleImportRegistry: buildModuleImportRegistry(resolved.modules)
    passes.runPrePasses(state, resolved.stmts)
    // Pass 1: per-module type resolution (same as runPipelineFull).
    let p1mi i64: 0
    while p1mi.lt(resolved.modules.len()) {
        let p1Mod Module: resolved.modules.at(p1mi)
        state.currentModuleImports: p1Mod.importedNs
        semresolve.resolveModuleTypes(state, p1Mod.stmts)
        p1mi: p1mi.add(1)
    }
    // Instantiate using the provided requests (skip inference — requests come from Phase 1).
    // Use rootPath="" so that irCodegen.emitFunction never treats a function as "own"
    // via srcPath match.  Instead, only monoFnNames controls which functions get define
    // bodies — that is exactly the set of freshly-instantiated concrete functions.
    // Non-concrete functions (already defined in {module}.ll) are emitted as declare
    // stubs, which the linker resolves against the existing definitions.
    let newNodes Array<AstNode>: inst.instantiateAll(globalRegistry, requests)
    let ownFnNames Array<String>: []
    monoPass.extractFnNames(newNodes, ownFnNames)
    let ownTypeNames Array<String>: []
    // Concrete type names must be in ownTypeNames so irCodegen emits full
    // clone/drop define bodies (not declare stubs) in __mono.ll.
    monoPass.extractTypeNames(newNodes, ownTypeNames)
    let monoFnNames Array<String>: []
    monoPass.extractFnNames(newNodes, monoFnNames)
    let stmts Array<AstNode>: resolved.stmts
    let nni i64: 0
    while nni.lt(newNodes.len()) {
        stmts.add(newNodes.at(nni))
        nni: nni.add(1)
    }
    stmts: monoPass.filterGenericDefs(stmts)
    // Pass 2: fresh state over concrete stmts.
    state: semantic.makeAnalyzerState()
    state.currentSrcPath: sourcePath
    state.moduleImportRegistry: buildModuleImportRegistry(resolved.modules)
    passes.runPrePasses(state, stmts)
    semresolve.resolveModuleTypes(state, stmts)
    // Rewrite generic call sites and variant arm patterns.
    stmts: monoPass.rewriteCallSites(stmts, globalRegistry)
    stmts: monoPass.rewriteVariantArms(stmts)
    // Lower object literals to vtable + synthetic method FnDeclNodes.
    let preLowerLen i64: stmts.len()
    lowerObjects(state, stmts, sourcePath, resolved.srcNsEntries)
    // Synthetic methods for concrete types (e.g. $m_DynArray-i64_add_0) need
    // define bodies in __mono.ll.  Register them in monoFnNames so irCodegen
    // emits define (rootPath="" means srcPath match is never true).
    let li i64: preLowerLen
    while li.lt(stmts.len()) {
        match stmts.at(li) {
            FnDeclNode: {
                let fd FnDeclNode: stmts.at(li)
                if isMethodOfMonoType(fd.name, ownTypeNames) { monoFnNames.add(fd.name) }
            }
            _: {}
        }
        li: li.add(1)
    }
    // Rewrite qualified calls in the full merged stmts.
    let rewrittenStmts Array<AstNode>: qualNamePass.rewriteQualifiedCalls(stmts, resolved.nsExports)
    // rootPath="" disables the srcPath-based "own" check so non-concrete module
    // functions (already defined in {module}.ll) get declare stubs, not define bodies.
    let irText String: irCodegen.generate(rewrittenStmts, baseName(sourcePath), ownFnNames, ownTypeNames, monoFnNames, "", resolved.srcNsEntries)
    writeFile(outDir.append(fileNameStem(sourcePath)).append("__mono.ll"), irText)
}

// ─── Public pipeline entry points ──────────────────────────────────────────────

// MonoGroup — a set of instantiation requests that all belong to one declaring module.
// Used by runBuildDriver to dispatch compileOneFileWithRequests per declaring source file.
type MonoGroup: { declaringSrcPath String, requests Array<InstantiationRequest> }

// Carries the IR text for the main file, the list of resolved include paths,
// the NamespaceRegistry built during the run (reused by runBuildDriver when
// compiling each included file), the grouped mono requests for __mono.ll emission,
// and the generic registry (reused by compileOneFileWithRequests for instantiation).
type PipelineResult: { irText String, includedPaths Array<String>, builtReg NamespaceRegistry, monoGroups Array<MonoGroup>, genericRegistry GenericRegistry }

// Carries intermediate pipeline state for per-pass debugging.
// stmts is the statement list as it exists at the named stop point;
// state is the AnalyzerState populated up to that point.
export type DebugResult: { stmts Array<AstNode>, state AnalyzerState }

// injectMonoConcretes — common monomorphization fan-in.  Appends the new
// concrete nodes produced by monoPass.runMonoPass into stmts, strips the
// original generic templates via filterGenericDefs, and grows ownFnNames /
// ownTypeNames with the freshly-instantiated names so codegen will emit them
// as part of this file's IR.  Returns the filtered statement array.
fn injectMonoConcretes(stmts Array<AstNode>, ownFnNames Array<String>, ownTypeNames Array<String>, monoResult MonoResult) Array<AstNode> {
    let ni i64: 0
    while ni.lt(monoResult.newNodes.len()) {
        stmts.add(monoResult.newNodes.at(ni))
        ni: ni.add(1)
    }
    let filtered Array<AstNode>: monoPass.filterGenericDefs(stmts)
    let fi i64: 0
    while fi.lt(monoResult.newFnNames.len()) {
        ownFnNames.add(monoResult.newFnNames.at(fi))
        fi: fi.add(1)
    }
    let ti i64: 0
    while ti.lt(monoResult.newTypeNames.len()) {
        ownTypeNames.add(monoResult.newTypeNames.at(ti))
        ti: ti.add(1)
    }
    return filtered
}

// buildModuleImportRegistry — converts the Array<Module> produced by
// resolveIncludes into the lightweight Array<SrcModImports> stored in
// AnalyzerState.moduleImportRegistry.  Strips the stmts field so the
// semantic package does not need to import AstNode types.
fn buildModuleImportRegistry(modules Array<Module>) Array<SrcModImports> {
    let reg Array<SrcModImports>: []
    let i i64: 0
    while i.lt(modules.len()) {
        let m Module: modules.at(i)
        let entry SrcModImports: { srcPath: m.srcPath, importedNs: m.importedNs }
        reg.add(entry)
        i: i.add(1)
    }
    return reg
}

// isMethodOfMonoType — true when methodName is an object-literal method body
// (starts with "$m_") produced by lowerObjects from a mono-instantiated type.
// Checks whether any name in monoTypeNames is a prefix of the method's type segment.
// Example: "$m_DynArray-i64_add_0" matches "DynArray-i64" in monoTypeNames.
fn isMethodOfMonoType(methodName String, monoTypeNames Array<String>) bool {
    if methodName.len().lt(4) { return false }
    if not methodName.slice(0, 3).equals("$m_") { return false }
    let withoutPrefix String: methodName.slice(3, methodName.len())
    let ti i64: 0
    while ti.lt(monoTypeNames.len()) {
        let tname String: monoTypeNames.at(ti)
        let prefixLen i64: tname.len().add(1)
        if withoutPrefix.len().gte(prefixLen) {
            let segment String: withoutPrefix.slice(0, prefixLen)
            let expected String: tname.append("_")
            let matched bool: segment.equals(expected)
            if matched {
                drop(withoutPrefix)
                return true
            }
        }
        ti: ti.add(1)
    }
    drop(withoutPrefix)
    return false
}

// augmentMonoFnNamesFromLowered — after lowerObjects adds method FnDeclNodes
// from mono-instantiated types, register their names in monoResult.newFnNames
// so irCodegen.generate treats them as definitions (not external declarations).
// Only processes stmts[startIdx..] and only entries with srcPath != rootPath.
fn augmentMonoFnNamesFromLowered(stmts Array<AstNode>, startIdx i64, monoResult MonoResult, rootPath String) {
    let i i64: startIdx
    while i.lt(stmts.len()) {
        match stmts.at(i) {
            FnDeclNode: {
                let fd FnDeclNode: stmts.at(i)
                if not fd.srcPath.equals(rootPath) {
                    if isMethodOfMonoType(fd.name, monoResult.newTypeNames) {
                        monoResult.newFnNames.add(fd.name)
                    }
                }
            }
            _: {}
        }
        i: i.add(1)
    }
}

// runPipelineFull — lex→parse→semantic→codegen for sourcePath.
// Exits with code 1 if semantic analysis produces errors.
fn runPipelineFull(sourcePath String) PipelineResult {
    let source String: readFile(sourcePath)
    let tokens Array<Token>: lex.tokenize(source, sourcePath)
    let mod AstModule: parser.parse(tokens, sourcePath)
    let ownFnNames Array<String>: collectFnNames(mod.stmts)
    let ownTypeNames Array<String>: collectTypeNames(mod.stmts)
    let reg NamespaceRegistry: nsReg.buildNamespaceRegistryMulti(registryRootsFor(sourcePath))
    let resolved ResolveResult: resolveIncludes(mod.stmts, dirName(sourcePath), sourcePath, reg)
    // Back-fill the registry with namespaces found via include directives so
    // that qualified-name lookups work for files outside the initial scan dir.
    reg: nsReg.augmentRegistry(reg, resolved.srcNsEntries)
    let stmts Array<AstNode>: resolved.stmts
    // Build per-module import registry from the Module list returned by
    // resolveIncludes.  This replaces the old root-only boolean flags; every
    // module's import context is now tracked separately.
    let modImportReg Array<SrcModImports>: buildModuleImportRegistry(resolved.modules)
    let state AnalyzerState: semantic.makeAnalyzerState()
    state.currentSrcPath: sourcePath
    state.moduleImportRegistry: modImportReg
    passes.runPrePasses(state, stmts)
    // Pass 1: annotate every expression node with its resolvedType so that
    // monoInfer can read resolvedType fields from call-site arguments.
    // Run per-module so each function body is resolved with its owning file's
    // import context (modules are first-class compilation units).
    let p1mi i64: 0
    while p1mi.lt(resolved.modules.len()) {
        let p1Mod Module: resolved.modules.at(p1mi)
        state.currentModuleImports: p1Mod.importedNs
        semresolve.resolveModuleTypes(state, p1Mod.stmts)
        p1mi: p1mi.add(1)
    }

    // ─── Monomorphization pass ────────────────────────────────────────────────
    // Collect all generic defs and infer every instantiation request.
    // Split requests into two buckets:
    //   rootRequests  — declared in the root file itself → define in main.ll
    //   extRequests   — declared in an included module  → declare stub in main.ll,
    //                   define in {module}__mono.ll (Phase 2)
    let registry GenericRegistry: collect.collectGenericDefs(stmts)
    let requests Array<InstantiationRequest>: infer.collectInstantiations(stmts, registry)
    let rootRequests Array<InstantiationRequest>: []
    let extRequests Array<InstantiationRequest>: []
    let rqi i64: 0
    while rqi.lt(requests.len()) {
        let req InstantiationRequest: requests.at(rqi)
        let sp String: findGenericDeclSrcPath(req.genericName, registry, resolved.modules)
        if sp.equals(sourcePath) {
            let clonedReq InstantiationRequest: { genericName: clone(req.genericName), concreteTypes: clone(req.concreteTypes) }
            rootRequests.add(clonedReq)
        } else if not sp.equals("") {
            let clonedReq InstantiationRequest: { genericName: clone(req.genericName), concreteTypes: clone(req.concreteTypes) }
            extRequests.add(clonedReq)
        }
        rqi: rqi.add(1)
    }
    // External requests group into __mono.ll files; root requests go into main.ll defines.
    let monoGroups Array<MonoGroup>: groupRequestsByModule(extRequests, registry, resolved.modules)

    // Instantiate root-declared generics → inject as define in main.ll.
    let rootNewNodes Array<AstNode>: inst.instantiateAll(registry, rootRequests)
    let rni i64: 0
    while rni.lt(rootNewNodes.len()) {
        stmts.add(rootNewNodes.at(rni))
        rni: rni.add(1)
    }
    monoPass.extractFnNames(rootNewNodes, ownFnNames)
    monoPass.extractTypeNames(rootNewNodes, ownTypeNames)

    // Instantiate external-declared generics → inject nodes for pass-2 type resolution,
    // but omit from ownFnNames/ownTypeNames so codegen emits declare stubs in main.ll.
    let extNewNodes Array<AstNode>: inst.instantiateAll(registry, extRequests)
    let eni i64: 0
    while eni.lt(extNewNodes.len()) {
        stmts.add(extNewNodes.at(eni))
        eni: eni.add(1)
    }

    stmts: monoPass.filterGenericDefs(stmts)
    // Pass 2: fresh state sees only concrete types (no generic templates).
    // Concrete copies injected by mono inherit srcPath from their generic
    // template, so the per-FnDecl registry lookup in resolveModuleTypes
    // correctly resolves each function's import context.
    state: semantic.makeAnalyzerState()
    state.currentSrcPath: sourcePath
    state.moduleImportRegistry: modImportReg
    passes.runPrePasses(state, stmts)
    semresolve.resolveModuleTypes(state, stmts)
    // Rewrite generic call-site names to mangled forms now that pass-2
    // resolvedTypes are populated on all arg expressions.
    stmts: monoPass.rewriteCallSites(stmts, registry)
    // Rewrite match-arm pattern names from unmangled base names (e.g. "Some")
    // to the concrete mangled variant names (e.g. "Some-i64") so the codegen
    // can resolve the correct variant index for generic sum types.
    stmts: monoPass.rewriteVariantArms(stmts)
    // ─────────────────────────────────────────────────────────────────────────

    lowerObjects(state, stmts, sourcePath, resolved.srcNsEntries)
    // Intentionally skip augmentMonoFnNamesFromLowered: mono object-method bodies
    // live in __mono.ll (declaring module), not in the root IR.
    // Filter generic defs from ownStmts too: analyzeFunctionDeclaration would
    // emit false "unknown type" errors on typeParam-annotated bodies.
    let rawOwnStmts Array<AstNode>: collectNonInclude(mod.stmts)
    let ownStmts Array<AstNode>: monoPass.filterGenericDefs(rawOwnStmts)
    // Reset currentSrcPath: type resolution may update it to an included file's
    // path when processing that file's function bodies.  The own-file passes
    // (namespace, export, import, semantic) must attribute errors to the root.
    state.currentSrcPath: sourcePath
    nsPass.validateNamespaceDecl(state, ownStmts)
    exportPass.validateExports(state, ownStmts)
    ownStmts: importPass.desugarImports(state, ownStmts, resolved.nsExports)
    ownStmts: qualNamePass.rewriteQualifiedCalls(ownStmts, resolved.nsExports)
    stmts: importPass.rewriteCodegenStmts(ownStmts, stmts, sourcePath, resolved.nsExports)
    analyzeModuleStatements(state, ownStmts)
    printErrorsFrom(state, sourcePath)
    let errors Array<AnalysisError>: state.errors
    if errors.len().gt(0) { exit(1) }
    let noMonoFns Array<String>: []
    let irText String: irCodegen.generate(stmts, baseName(sourcePath), ownFnNames, ownTypeNames, noMonoFns, sourcePath, resolved.srcNsEntries)
    return { irText: irText, includedPaths: resolved.includedPaths, builtReg: reg, monoGroups: monoGroups, genericRegistry: registry }
}

// runPipelineDebug — run the pipeline for sourcePath and stop after the named
// pass, returning the intermediate AST and AnalyzerState for inspection.
//
// Valid pass names:
//   "resolve1"  — after first resolveModuleTypes (before monomorphization)
//   "mono"      — after mono: injected, filtered, callSites + variantArms rewritten
//   "resolve2"  — after second resolveModuleTypes
//   "semantic"  — after analyzeModuleStatements (full symbol table visible)
//
// Exits with code 1 for unknown pass names.
export fn runPipelineDebug(sourcePath String, stopPass String) DebugResult {
    let source String: readFile(sourcePath)
    let tokens Array<Token>: lex.tokenize(source, sourcePath)
    let mod AstModule: parser.parse(tokens, sourcePath)
    let ownFnNames Array<String>: collectFnNames(mod.stmts)
    let ownTypeNames Array<String>: collectTypeNames(mod.stmts)
    let reg NamespaceRegistry: nsReg.buildNamespaceRegistryMulti(registryRootsFor(sourcePath))
    let resolved ResolveResult: resolveIncludes(mod.stmts, dirName(sourcePath), sourcePath, reg)
    reg: nsReg.augmentRegistry(reg, resolved.srcNsEntries)
    let stmts Array<AstNode>: resolved.stmts
    let modImportRegDbg Array<SrcModImports>: buildModuleImportRegistry(resolved.modules)
    let state AnalyzerState: semantic.makeAnalyzerState()
    state.currentSrcPath: sourcePath
    state.moduleImportRegistry: modImportRegDbg
    passes.runPrePasses(state, stmts)
    let dbgP1mi i64: 0
    while dbgP1mi.lt(resolved.modules.len()) {
        let dbgP1Mod Module: resolved.modules.at(dbgP1mi)
        state.currentModuleImports: dbgP1Mod.importedNs
        semresolve.resolveModuleTypes(state, dbgP1Mod.stmts)
        dbgP1mi: dbgP1mi.add(1)
    }

    if stopPass.equals("resolve1") { return { stmts: stmts, state: state } }

    // ─── Monomorphization ─────────────────────────────────────────────────────
    let registry GenericRegistry: collect.collectGenericDefs(stmts)
    let monoResult MonoResult: monoPass.runMonoPass(stmts, registry)
    stmts: injectMonoConcretes(stmts, ownFnNames, ownTypeNames, monoResult)
    state: semantic.makeAnalyzerState()
    state.currentSrcPath: sourcePath
    state.moduleImportRegistry: modImportRegDbg
    passes.runPrePasses(state, stmts)
    semresolve.resolveModuleTypes(state, stmts)
    stmts: monoPass.rewriteCallSites(stmts, registry)
    stmts: monoPass.rewriteVariantArms(stmts)
    // ─────────────────────────────────────────────────────────────────────────

    if stopPass.equals("mono") { return { stmts: stmts, state: state } }

    lowerObjects(state, stmts, sourcePath, resolved.srcNsEntries)

    if stopPass.equals("resolve2") { return { stmts: stmts, state: state } }

    let rawOwnStmts Array<AstNode>: collectNonInclude(mod.stmts)
    let ownStmts Array<AstNode>: monoPass.filterGenericDefs(rawOwnStmts)
    state.currentSrcPath: sourcePath
    nsPass.validateNamespaceDecl(state, ownStmts)
    exportPass.validateExports(state, ownStmts)
    ownStmts: importPass.desugarImports(state, ownStmts, resolved.nsExports)
    ownStmts: qualNamePass.rewriteQualifiedCalls(ownStmts, resolved.nsExports)
    analyzeModuleStatements(state, ownStmts)

    if stopPass.equals("semantic") { return { stmts: stmts, state: state } }

    printError("error: unknown debug pass '".append(stopPass).append("'"))
    printError("Valid passes: resolve1, mono, resolve2, semantic")
    exit(1)
    return { stmts: stmts, state: state }
}

// generateIRText — run the full pipeline for sourcePath and return the LLVM IR
// string for the main file.  No files are written.
export fn generateIRText(sourcePath String) String {
    let result PipelineResult: runPipelineFull(sourcePath)
    return result.irText
}

// runBuildDriver — compile sourcePath to IR, write the main file's IR to
// outputPath, and compile each included file to a .ll in the same directory.
// This is the entry point used by bin/suru-build.
export fn runBuildDriver(sourcePath String, outputPath String) {
    let result PipelineResult: runPipelineFull(sourcePath)
    writeFile(outputPath, result.irText)
    let outDir String: dirName(outputPath)
    let pi i64: 0
    while pi.lt(result.includedPaths.len()) {
        compileOneFile(result.includedPaths.at(pi), outDir, result.builtReg)
        pi: pi.add(1)
    }
    // Phase 2: emit {stem}__mono.ll for each declaring module that has requests.
    let mgi i64: 0
    while mgi.lt(result.monoGroups.len()) {
        let mg MonoGroup: result.monoGroups.at(mgi)
        compileOneFileWithRequests(mg.declaringSrcPath, outDir, result.builtReg, mg.requests, result.genericRegistry)
        mgi: mgi.add(1)
    }
}

// compilePipeline — full pipeline for sourcePath: creates buildDir, writes
// all .ll files there, then links them with clang-18 into buildDir/main.
// The runtime is linked from precompiled C objects (runtime/*.o, built by the
// Docker scripts); the program's own modules are still IR (buildDir/*.ll).
export fn compilePipeline(sourcePath String, buildDir String) {
    exec("mkdir -p ".append(buildDir))
    let outputPath String: buildDir.append(fileNameStem(baseName(sourcePath))).append(".ll")
    runBuildDriver(sourcePath, outputPath)
    let runtime String: "/usr/local/lib/suru/runtime"
    exec("clang-18 ".append(buildDir).append("*.ll ").append(runtime).append("/*.o -o ").append(buildDir).append("main"))
}
