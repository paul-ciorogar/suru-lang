// pipeline.suru — Suru compilation pipeline library.
//
// All pipeline stages shared between the bootstrap driver (build.suru) and
// the user-facing CLI (src/cli/main.suru).
//
// Public entry points:
//   runBuildDriver(sourcePath, outputPath)  — full pipeline + write per-module .ll files
//   generateIRText(sourcePath)              — full pipeline, return IR string (no file I/O)
//   compilePipeline(sourcePath, buildDir)   — full pipeline + mkdir + clang link
//
// Utilities re-used by the CLI for lex/parse commands:
//   dirName, baseName, normalizePath, fileNameStem

include "lexer/lexer.suru"           as lex
include "parser/parser.suru"         as parser
include "codegen/irCodegen.suru"     as irCodegen
include "semantic/semantic.suru"     as semantic
include "semantic/passes.suru"       as passes
include "semantic/stmts.suru"        as semstmts
include "semantic/fns.suru"          as fns
include "semantic/resolveTypes.suru" as semresolve
include "semantic/monoPass.suru"     as monoPass

// ─── Path utilities ────────────────────────────────────────────────────────────

// Return the directory prefix of an absolute path (everything up to and
// including the last '/').  Used to resolve relative include paths.
fn dirName(path String) String {
    let i Int64: path.len().take(1)
    while i.gte(0) {
        match path.at(i).equals("/") { true: { return path.slice(0, i.add(1)) } _: {} }
        i: i.take(1)
    }
    return "./"
}

// Return the filename component of a path (everything after the last '/').
fn baseName(path String) String {
    let i Int64: path.len().take(1)
    while i.gte(0) {
        match path.at(i).equals("/") { true: { return path.slice(i.add(1), path.len()) } _: {} }
        i: i.take(1)
    }
    return path
}

// Normalize an absolute path by resolving all "/../" segments.
// Splits on "/" into a segment stack: pushes normal segments, pops on "..".
fn normalizePath(path String) String {
    let parts Array<String>: []
    let i Int64: 0
    let segStart Int64: 0
    while i.lte(path.len()) {
        let done Bool: i.equals(path.len())
        match done {
            true: {
                parts.add(path.slice(segStart, i))
                i: i.add(1)
            }
            _: {
                match path.at(i).equals("/") {
                    true: {
                        parts.add(path.slice(segStart, i))
                        segStart: i.add(1)
                        i: i.add(1)
                    }
                    _: { i: i.add(1) }
                }
            }
        }
    }
    let stack Array<String>: []
    let stackLen Int64: 0
    let j Int64: 0
    while j.lt(parts.len()) {
        let seg String: parts.at(j)
        match seg.equals("..") {
            true: {
                match stackLen.gt(0) {
                    true: { stackLen: stackLen.take(1) }
                    _: {}
                }
            }
            _: {
                match stackLen.lt(stack.len()) {
                    true: { stack.set(seg, stackLen) }
                    _: { stack.add(seg) }
                }
                stackLen: stackLen.add(1)
            }
        }
        j: j.add(1)
    }
    let result String: ""
    let k Int64: 0
    while k.lt(stackLen) {
        match k.equals(0) {
            true: { result: stack.at(k) }
            _: { result: result.append("/").append(stack.at(k)) }
        }
        k: k.add(1)
    }
    return result
}

// Strip the extension from a filename component (e.g. "lexer.suru" → "lexer").
// Scans backwards for the last '.'; if none found, returns the name unchanged.
fn fileNameStem(path String) String {
    let name String: baseName(path)
    let i Int64: name.len().take(1)
    while i.gte(0) {
        match name.at(i).equals(".") { true: { return name.slice(0, i) } _: {} }
        i: i.take(1)
    }
    return name
}

// ─── Include resolution ────────────────────────────────────────────────────────

// Carries accumulated declarations and the set of already-resolved absolute
// paths so transitive and diamond includes are handled without re-processing.
type ResolveState: { decls Array<AstNode>, resolved Array<String> }

// IncludeAlias (one `include "path" as ns` mapping) is defined in parserAst.suru
// so both this file and irCodegen.suru (an includee here) can name the type.

// Return value of resolveIncludes: merged statement list + ordered deduplicated
// list of included absolute source paths (in depth-first resolution order) +
// the root file's direct include-alias map.
type ResolveResult: { stmts Array<AstNode>, includedPaths Array<String>, aliases Array<IncludeAlias> }

// Linear scan: true if path already appears in the resolved list.
fn pathResolved(resolved Array<String>, path String) Bool {
    let i Int64: 0
    while i.lt(resolved.len()) {
        match resolved.at(i).equals(path) {
            true: { return true }
            _:    {}
        }
        i: i.add(1)
    }
    return false
}

// Depth-first recursive resolver.  For each IncludeNode in stmts:
//   - skip if the absolute path is already in state.resolved (diamond dedup)
//   - otherwise mark as resolved, recurse into that file's own includes first,
//     then add its FnDeclNode / TypeDeclNode / SumTypeDeclNode / scalar LetNode
//     to state.decls.
fn resolveIncludesRec(stmts Array<AstNode>, dir String, filePath String, state ResolveState) ResolveState {
    // Pass 1: add this file's own declarations first (pre-order DFS).
    let i Int64: 0
    while i.lt(stmts.len()) {
        let s AstNode: stmts.at(i)
        match s {
            FnDeclNode: {
                let fd FnDeclNode: s
                fd.srcPath: filePath
                state.decls.add(fd)
            }
            TypeDeclNode:    { state.decls.add(s) }
            SumTypeDeclNode: { state.decls.add(s) }
            LetNode: {
                match s.value {
                    IntLitNode:   { state.decls.add(s) }
                    BoolLitNode:  { state.decls.add(s) }
                    FloatLitNode: { state.decls.add(s) }
                    _: {}
                }
            }
            _: {}
        }
        i: i.add(1)
    }
    // Pass 2: recurse into sub-includes.
    let j Int64: 0
    while j.lt(stmts.len()) {
        let s AstNode: stmts.at(j)
        match s {
            IncludeNode: {
                let fullPath String: normalizePath(dir.append(s.path))
                match pathResolved(state.resolved, fullPath) {
                    false: {
                        state.resolved.add(fullPath)
                        let src String: readFile(fullPath)
                        let toks Array<Token>: lex.tokenize(src)
                        let mod AstModule: parser.parse(toks)
                        state: resolveIncludesRec(mod.stmts, dirName(fullPath), fullPath, state)
                    }
                    _: {}
                }
            }
            _: {}
        }
        j: j.add(1)
    }
    return state
}

// Resolve all transitive includes from mainStmts.  Returns the merged statement
// list (main file's own nodes FIRST, then transitive declarations) and the
// ordered deduplicated list of included absolute source paths.
fn resolveIncludes(mainStmts Array<AstNode>, dir String, rootPath String) ResolveResult {
    let state ResolveState: { decls: [], resolved: [] }
    let aliases Array<IncludeAlias>: []
    let i Int64: 0
    while i.lt(mainStmts.len()) {
        let s AstNode: mainStmts.at(i)
        match s {
            IncludeNode: {
                let fullPath String: normalizePath(dir.append(s.path))
                // Record the alias for the root file regardless of diamond
                // dedup: codegen needs `ns` → path even when the file's decls
                // were already merged via another include path.
                aliases.add({ ns: s.ns, srcPath: fullPath })
                match pathResolved(state.resolved, fullPath) {
                    false: {
                        state.resolved.add(fullPath)
                        let src String: readFile(fullPath)
                        let toks Array<Token>: lex.tokenize(src)
                        let mod AstModule: parser.parse(toks)
                        state: resolveIncludesRec(mod.stmts, dirName(fullPath), fullPath, state)
                    }
                    _: {}
                }
            }
            _: {}
        }
        i: i.add(1)
    }
    // Main file's own nodes FIRST, then transitive declarations.
    // Stamp the root file's own functions with rootPath so their symbols are
    // mangled consistently with the declares emitted in files that include it.
    let all Array<AstNode>: []
    let j Int64: 0
    while j.lt(mainStmts.len()) {
        let s AstNode: mainStmts.at(j)
        match s {
            IncludeNode: {}
            FnDeclNode: {
                let fd FnDeclNode: s
                fd.srcPath: rootPath
                all.add(fd)
            }
            _: { all.add(s) }
        }
        j: j.add(1)
    }
    let k Int64: 0
    while k.lt(state.decls.len()) {
        all.add(state.decls.at(k))
        k: k.add(1)
    }
    return { stmts: all, includedPaths: state.resolved, aliases: aliases }
}

// ─── Semantic analysis helpers ─────────────────────────────────────────────────

// Returns only the non-IncludeNode statements from stmts.
// Used to separate the main file's own declarations from resolved-include
// declarations so statement analysis does not re-analyze library code.
fn collectNonInclude(stmts Array<AstNode>) Array<AstNode> {
    let result Array<AstNode>: []
    let i Int64: 0
    while i.lt(stmts.len()) {
        match stmts.at(i) {
            IncludeNode: {}
            _: { result.add(stmts.at(i)) }
        }
        i: i.add(1)
    }
    return result
}

// ─── Object method lambda-lift ─────────────────────────────────────────────────
//
// Runs after resolveModuleTypes (so every StructLitNode.resolvedType and every
// method-body expression is type-annotated) and before codegen. For each
// struct literal of a type that declares methods it:
//   • synthesises one top-level FnDeclNode per declared method, with an
//     implicit leading `this` param, body = the per-instance method body;
//   • builds a constant vtable reference listing those functions in the type's
//     declared-method order;
//   • rewrites the literal's members to a single leading `__vtable` data field
//     (value = VtableRefNode) followed by the original data fields.
// Synthetic FnDeclNodes are appended to the module statement list so the normal
// codegen function loop emits them.

fn loSrcPathOr(fnSrc String, root String) String {
    return match fnSrc.equals("") { true: root, _: fnSrc }
}

// Declared methods of a type (in declaration order), from the analyzer state.
fn loTypeMethods(state AnalyzerState, typeName String) Array<SemMethodEntry> {
    let decls Array<SemTypeEntry>: state.typeDecls
    let i Int64: 0
    while i.lt(decls.len()) {
        match decls.at(i).name.equals(typeName) {
            true: { return decls.at(i).methods }
            _: {}
        }
        i: i.add(1)
    }
    let empty Array<SemMethodEntry>: []
    return empty
}

fn loHasMethodMembers(fields Array<StructFieldNode>) Bool {
    let i Int64: 0
    while i.lt(fields.len()) {
        match fields.at(i).isMethod { true: { return true } _: {} }
        i: i.add(1)
    }
    return false
}

// Find the method member named `name` in a literal, or a sentinel whose
// name is "" when absent (strict-contract violation).
fn loFindMethodMember(fields Array<StructFieldNode>, name String) StructFieldNode {
    let i Int64: 0
    while i.lt(fields.len()) {
        let f StructFieldNode: fields.at(i)
        match f.isMethod {
            true: { match f.name.equals(name) { true: { return f } _: {} } }
            _: {}
        }
        i: i.add(1)
    }
    let dummy WildcardNode: {}
    let none StructFieldNode: { name: "", value: dummy, isMethod: false, methodParams: [], methodRet: "", methodBody: [] }
    return none
}

fn lowerObjectsBody(state AnalyzerState, stmts Array<AstNode>, newDecls Array<AstNode>, ctr Array<Int64>, srcPath String, root String) {
    let i Int64: 0
    while i.lt(stmts.len()) {
        lowerObjectsStmt(state, stmts.at(i), newDecls, ctr, srcPath, root)
        i: i.add(1)
    }
}

fn lowerObjectsStmt(state AnalyzerState, stmt AstNode, newDecls Array<AstNode>, ctr Array<Int64>, srcPath String, root String) {
    match stmt {
        FnDeclNode: {
            let f FnDeclNode: stmt
            let sp String: loSrcPathOr(f.srcPath, root)
            lowerObjectsBody(state, f.body, newDecls, ctr, sp, root)
        }
        LetNode: {
            let l LetNode: stmt
            lowerObjectsExpr(state, l.value, newDecls, ctr, srcPath, root)
        }
        AssignNode: {
            let a AssignNode: stmt
            lowerObjectsExpr(state, a.value, newDecls, ctr, srcPath, root)
        }
        FieldAssignNode: {
            let fa FieldAssignNode: stmt
            lowerObjectsExpr(state, fa.receiver, newDecls, ctr, srcPath, root)
            lowerObjectsExpr(state, fa.value, newDecls, ctr, srcPath, root)
        }
        ReturnNode: {
            let r ReturnNode: stmt
            match r.hasValue {
                true: { lowerObjectsExpr(state, r.value, newDecls, ctr, srcPath, root) }
                _: {}
            }
        }
        WhileNode: {
            let w WhileNode: stmt
            lowerObjectsExpr(state, w.condition, newDecls, ctr, srcPath, root)
            lowerObjectsBody(state, w.body, newDecls, ctr, srcPath, root)
        }
        IfNode: {
            let n IfNode: stmt
            lowerObjectsExpr(state, n.condition, newDecls, ctr, srcPath, root)
            let tb BlockNode: n.thenBranch
            lowerObjectsBody(state, tb.stmts, newDecls, ctr, srcPath, root)
            let eb BlockNode: n.elseBranch
            lowerObjectsBody(state, eb.stmts, newDecls, ctr, srcPath, root)
        }
        MatchStmtNode: {
            let ms MatchStmtNode: stmt
            lowerObjectsExpr(state, ms.condition, newDecls, ctr, srcPath, root)
            let arms Array<MatchStmtArm>: ms.arms
            let ai Int64: 0
            while ai.lt(arms.len()) {
                lowerObjectsBody(state, arms.at(ai).stmts, newDecls, ctr, srcPath, root)
                ai: ai.add(1)
            }
        }
        BlockNode: {
            let b BlockNode: stmt
            lowerObjectsBody(state, b.stmts, newDecls, ctr, srcPath, root)
        }
        ExprStmtNode: {
            let e ExprStmtNode: stmt
            lowerObjectsExpr(state, e.expr, newDecls, ctr, srcPath, root)
        }
        _: {}
    }
}

fn lowerObjectsExprList(state AnalyzerState, xs Array<AstNode>, newDecls Array<AstNode>, ctr Array<Int64>, srcPath String, root String) {
    let i Int64: 0
    while i.lt(xs.len()) {
        lowerObjectsExpr(state, xs.at(i), newDecls, ctr, srcPath, root)
        i: i.add(1)
    }
}

fn lowerObjectsExpr(state AnalyzerState, expr AstNode, newDecls Array<AstNode>, ctr Array<Int64>, srcPath String, root String) {
    match expr {
        StructLitNode: {
            let lit StructLitNode: expr
            lowerObjectsStructLit(state, lit, newDecls, ctr, srcPath, root)
        }
        ArrayLitNode: {
            let a ArrayLitNode: expr
            lowerObjectsExprList(state, a.elems, newDecls, ctr, srcPath, root)
        }
        CallNode: {
            let c CallNode: expr
            lowerObjectsExprList(state, c.args, newDecls, ctr, srcPath, root)
        }
        MethodCallNode: {
            let mc MethodCallNode: expr
            lowerObjectsExpr(state, mc.receiver, newDecls, ctr, srcPath, root)
            lowerObjectsExprList(state, mc.args, newDecls, ctr, srcPath, root)
        }
        FieldAccessNode: {
            let fa FieldAccessNode: expr
            lowerObjectsExpr(state, fa.receiver, newDecls, ctr, srcPath, root)
        }
        MatchExprNode: {
            let me MatchExprNode: expr
            lowerObjectsExpr(state, me.condition, newDecls, ctr, srcPath, root)
            let arms Array<MatchArm>: me.arms
            let ai Int64: 0
            while ai.lt(arms.len()) {
                lowerObjectsExpr(state, arms.at(ai).body, newDecls, ctr, srcPath, root)
                ai: ai.add(1)
            }
        }
        UnaryNode: {
            let u UnaryNode: expr
            lowerObjectsExpr(state, u.operand, newDecls, ctr, srcPath, root)
        }
        BinaryNode: {
            let b BinaryNode: expr
            lowerObjectsExpr(state, b.left, newDecls, ctr, srcPath, root)
            lowerObjectsExpr(state, b.right, newDecls, ctr, srcPath, root)
        }
        _: {}
    }
}

fn lowerObjectsStructLit(state AnalyzerState, lit StructLitNode, newDecls Array<AstNode>, ctr Array<Int64>, srcPath String, root String) {
    let typeName String: lit.resolvedType
    let fields Array<StructFieldNode>: lit.fields
    let methods Array<SemMethodEntry>: loTypeMethods(state, typeName)
    let hasM Bool: loHasMethodMembers(fields)
    match hasM and methods.len().equals(0) {
        true: {
            printLn("error: struct literal supplies a method body but type '".append(typeName).append("' declares no methods"))
            exit(1)
        }
        _: {}
    }
    match methods.len().equals(0) {
        true: {
            // Plain data struct — just recurse field values for nested objects.
            let d Int64: 0
            while d.lt(fields.len()) {
                lowerObjectsExpr(state, fields.at(d).value, newDecls, ctr, srcPath, root)
                d: d.add(1)
            }
            return
        }
        _: {}
    }
    let site Int64: ctr.at(0)
    ctr.set(site.add(1), 0)
    let siteStr String: site.toString()
    let entrySyms Array<String>: []
    let j Int64: 0
    while j.lt(methods.len()) {
        let m SemMethodEntry: methods.at(j)
        let member StructFieldNode: loFindMethodMember(fields, m.name)
        match member.name.equals("") {
            true: {
                printLn("error: type '".append(typeName).append("' requires an implementation of method '").append(m.name).append("'"))
                exit(1)
            }
            _: {}
        }
        let synth String: "__m_".append(typeName).append("_").append(m.name).append("_").append(siteStr)
        let params Array<Param>: []
        params.add({ name: "this", typeName: typeName })
        let mp Array<Param>: member.methodParams
        let k Int64: 0
        while k.lt(mp.len()) {
            params.add(mp.at(k))
            k: k.add(1)
        }
        let body Array<AstNode>: member.methodBody
        // Lift nested object literals inside the method body too.
        lowerObjectsBody(state, body, newDecls, ctr, srcPath, root)
        let fnDecl FnDeclNode: { name: synth, params: params, returnType: member.methodRet, body: body, srcPath: srcPath, typeParams: [] }
        newDecls.add(fnDecl)
        entrySyms.add(irCodegen.mangleSym(srcPath, synth))
        j: j.add(1)
    }
    // Include the owning file in the vtable global's symbol so two files that
    // each declare a literal of the same type at the same site index don't
    // mint colliding `@vtable.<Type>.<n>` definitions. Each .ll only emits its
    // own vtable globals (codegen of an included file's literal is skipped in
    // the root compilation), so this naming guarantees link-time uniqueness.
    let vtsym String: "@vtable.".append(irCodegen.sanitizePath(srcPath)).append(".").append(typeName).append(".").append(siteStr)
    let newFields Array<StructFieldNode>: []
    let vr VtableRefNode: { sym: vtsym, entries: entrySyms, resolvedType: typeName }
    let noP Array<Param>: []
    let noB Array<AstNode>: []
    newFields.add({ name: "__vtable", value: vr, isMethod: false, methodParams: noP, methodRet: "", methodBody: noB })
    let d Int64: 0
    while d.lt(fields.len()) {
        let f StructFieldNode: fields.at(d)
        match f.isMethod {
            true: {}
            _: {
                newFields.add(f)
                lowerObjectsExpr(state, f.value, newDecls, ctr, srcPath, root)
            }
        }
        d: d.add(1)
    }
    lit.fields: newFields
}

// lowerObjects — module driver. Walks `stmts`, lifts object methods, and
// appends every synthesised FnDeclNode to `stmts`.
fn lowerObjects(state AnalyzerState, stmts Array<AstNode>, root String) {
    let newDecls Array<AstNode>: []
    let ctr Array<Int64>: [0]
    let n Int64: stmts.len()
    let i Int64: 0
    while i.lt(n) {
        lowerObjectsStmt(state, stmts.at(i), newDecls, ctr, root, root)
        i: i.add(1)
    }
    let a Int64: 0
    while a.lt(newDecls.len()) {
        stmts.add(newDecls.at(a))
        a: a.add(1)
    }
}

// analyzeModuleStatement — pass-3 dispatch for top-level statements.
fn analyzeModuleStatement(state AnalyzerState, stmt AstNode) AnalyzerState {
    match stmt {
        FnDeclNode:      { fns.analyzeFunctionDeclaration(state, stmt) }
        TypeDeclNode:    {}
        SumTypeDeclNode: {}
        _:               { semstmts.analyzeStatement(state, stmt) }
    }
    return state
}

// analyzeModuleStatements — iterates the module statement list.
fn analyzeModuleStatements(state AnalyzerState, moduleStmts Array<AstNode>) AnalyzerState {
    let i Int64: 0
    while i.lt(moduleStmts.len()) {
        analyzeModuleStatement(state, moduleStmts.at(i))
        i: i.add(1)
    }
    return state
}

// printErrorsFrom — prints each analysis error prefixed with the source path.
fn printErrorsFrom(state AnalyzerState, path String, i Int64) {
    let errors Array<AnalysisError>: state.errors
    match i.lt(errors.len()) {
        true: {
            let err AnalysisError: errors.at(i)
            let line String: path.append(": ").append(err.message)
            printLn(line)
            printErrorsFrom(state, path, i.add(1))
        }
        _: {}
    }
}

// ─── Own-declaration collectors ────────────────────────────────────────────────

// Collect the names of all FnDeclNode items in the raw parsed module statements.
fn collectFnNames(stmts Array<AstNode>) Array<String> {
    let names Array<String>: []
    let i Int64: 0
    while i.lt(stmts.len()) {
        let s AstNode: stmts.at(i)
        match s {
            FnDeclNode: { names.add(s.name) }
            _: {}
        }
        i: i.add(1)
    }
    return names
}

// Collect the names of all TypeDeclNode and SumTypeDeclNode items in the raw
// parsed module statements (own types only, before include resolution).
fn collectTypeNames(stmts Array<AstNode>) Array<String> {
    let names Array<String>: []
    let i Int64: 0
    while i.lt(stmts.len()) {
        let s AstNode: stmts.at(i)
        match s {
            TypeDeclNode:    { names.add(s.name) }
            SumTypeDeclNode: { names.add(s.name) }
            _: {}
        }
        i: i.add(1)
    }
    return names
}

// stampConcreteFnSrcPath — walk newNodes and set srcPath = rootPath on every
// FnDeclNode.  Concrete instantiations inherit the generic template's srcPath
// (the included file), but they are emitted in the root file's IR, so they
// must carry the root file's path so emitFunction emits a full definition.
fn stampConcreteFnSrcPath(newNodes Array<AstNode>, rootPath String, i Int64) {
    if not i.lt(newNodes.len()) { return }
    match newNodes.at(i) {
        FnDeclNode: {
            let fd FnDeclNode: newNodes.at(i)
            fd.srcPath: rootPath
        }
        _: {}
    }
    stampConcreteFnSrcPath(newNodes, rootPath, i.add(1))
}

// ─── Per-file compilation helper ───────────────────────────────────────────────

// Compile a single source file and write its .ll to outDir/<stem>.ll.
// Own functions get full definitions; functions from includes get declare stubs.
// Semantic *error reporting* is skipped — library files are validated by the
// root file — but the resolved-type annotation pass still runs so that every
// expression node carries its `resolvedType` for codegen to read. Without
// this, struct/array literals in included files would emit with an empty
// type name and crash the compiler.
fn compileOneFile(sourcePath String, outDir String) {
    let src String: readFile(sourcePath)
    let tokens Array<Token>: lex.tokenize(src)
    let mod AstModule: parser.parse(tokens)
    let resolved ResolveResult: resolveIncludes(mod.stmts, dirName(sourcePath), sourcePath)
    let state AnalyzerState: semantic.makeAnalyzerState()
    passes.runPrePasses(state, resolved.stmts)
    semresolve.resolveModuleTypes(state, resolved.stmts)
    lowerObjects(state, resolved.stmts, sourcePath)
    // Filter generic templates (typeParams non-empty) from both the codegen
    // stmts and the own-name lists.  emitFunction decides to emit a full
    // definition based on fnDecl.srcPath == rootPath, so passing concreteStmts
    // prevents generic function bodies (e.g. some<T>) from being emitted in the
    // included file's IR.  Concrete instantiations are produced by the root
    // file's mono pass and emitted in the root file's IR only.
    let concreteStmts Array<AstNode>: monoPass.filterGenericDefs(resolved.stmts)
    let concreteOwnStmts Array<AstNode>: monoPass.filterGenericDefs(mod.stmts)
    let ownFnNames Array<String>: collectFnNames(concreteOwnStmts)
    let ownTypeNames Array<String>: collectTypeNames(concreteOwnStmts)
    let noMonoFns Array<String>: []
    let irText String: irCodegen.generate(concreteStmts, baseName(sourcePath), ownFnNames, ownTypeNames, noMonoFns, resolved.aliases, sourcePath)
    writeFile(outDir.append(fileNameStem(sourcePath)).append(".ll"), irText)
}

// ─── Public pipeline entry points ──────────────────────────────────────────────

// Carries the IR text for the main file and the list of resolved include paths.
type PipelineResult: { irText String, includedPaths Array<String> }

// runPipelineFull — lex→parse→semantic→codegen for sourcePath.
// Exits with code 1 if semantic analysis produces errors.
fn runPipelineFull(sourcePath String) PipelineResult {
    let source String: readFile(sourcePath)
    let tokens Array<Token>: lex.tokenize(source)
    let mod AstModule: parser.parse(tokens)
    let ownFnNames Array<String>: collectFnNames(mod.stmts)
    let ownTypeNames Array<String>: collectTypeNames(mod.stmts)
    let resolved ResolveResult: resolveIncludes(mod.stmts, dirName(sourcePath), sourcePath)
    let stmts Array<AstNode>: resolved.stmts
    let state AnalyzerState: semantic.makeAnalyzerState()
    passes.runPrePasses(state, stmts)
    // Pass 1: annotate every expression node with its resolvedType so that
    // monoInfer can read resolvedType fields from call-site arguments.
    semresolve.resolveModuleTypes(state, stmts)

    // ─── Monomorphization pass ────────────────────────────────────────────────
    // Collect all generic definitions, infer every instantiation site, produce
    // concrete copies, inject them, then remove the original generic templates.
    // After injection ownFnNames / ownTypeNames are augmented so codegen emits
    // the concrete nodes as part of this file's IR.
    let registry GenericRegistry: collect.collectGenericDefs(stmts)
    let monoResult MonoResult: monoPass.runMonoPass(stmts, registry)
    let ni Int64: 0
    while ni.lt(monoResult.newNodes.len()) {
        stmts.add(monoResult.newNodes.at(ni))
        ni: ni.add(1)
    }
    stmts: monoPass.filterGenericDefs(stmts)
    let fi Int64: 0
    while fi.lt(monoResult.newFnNames.len()) {
        ownFnNames.add(monoResult.newFnNames.at(fi))
        fi: fi.add(1)
    }
    let ti Int64: 0
    while ti.lt(monoResult.newTypeNames.len()) {
        ownTypeNames.add(monoResult.newTypeNames.at(ti))
        ti: ti.add(1)
    }
    // Pass 2: fresh state sees only concrete types (no generic templates).
    state: semantic.makeAnalyzerState()
    passes.runPrePasses(state, stmts)
    semresolve.resolveModuleTypes(state, stmts)
    // Rewrite generic call-site names to mangled forms now that pass-2
    // resolvedTypes are populated on all arg expressions.
    stmts: monoPass.rewriteCallSites(stmts, registry)
    // Rewrite match-arm pattern names from unmangled base names (e.g. "Some")
    // to the concrete mangled variant names (e.g. "Some__Int64") so the codegen
    // can resolve the correct variant index for generic sum types.
    stmts: monoPass.rewriteVariantArms(stmts)
    // ─────────────────────────────────────────────────────────────────────────

    lowerObjects(state, stmts, sourcePath)
    // Filter generic defs from ownStmts too: analyzeFunctionDeclaration would
    // emit false "unknown type" errors on typeParam-annotated bodies.
    let rawOwnStmts Array<AstNode>: collectNonInclude(mod.stmts)
    let ownStmts Array<AstNode>: monoPass.filterGenericDefs(rawOwnStmts)
    analyzeModuleStatements(state, ownStmts)
    printErrorsFrom(state, sourcePath, 0)
    let errors Array<AnalysisError>: state.errors
    match errors.len().gt(0) {
        true: exit(1)
        _:    {}
    }
    let irText String: irCodegen.generate(stmts, baseName(sourcePath), ownFnNames, ownTypeNames, monoResult.newFnNames, resolved.aliases, sourcePath)
    return { irText: irText, includedPaths: resolved.includedPaths }
}

// generateIRText — run the full pipeline for sourcePath and return the LLVM IR
// string for the main file.  No files are written.
fn generateIRText(sourcePath String) String {
    let result PipelineResult: runPipelineFull(sourcePath)
    return result.irText
}

// runBuildDriver — compile sourcePath to IR, write the main file's IR to
// outputPath, and compile each included file to a .ll in the same directory.
// This is the entry point used by bin/suru-build.
fn runBuildDriver(sourcePath String, outputPath String) {
    let result PipelineResult: runPipelineFull(sourcePath)
    writeFile(outputPath, result.irText)
    let outDir String: dirName(outputPath)
    let pi Int64: 0
    while pi.lt(result.includedPaths.len()) {
        compileOneFile(result.includedPaths.at(pi), outDir)
        pi: pi.add(1)
    }
}

// compilePipeline — full pipeline for sourcePath: creates buildDir, writes
// all .ll files there, then links them with clang-18 into buildDir/main.
fn compilePipeline(sourcePath String, buildDir String) {
    exec("mkdir -p ".append(buildDir))
    let outputPath String: buildDir.append(fileNameStem(baseName(sourcePath))).append(".ll")
    runBuildDriver(sourcePath, outputPath)
    let runtime String: "/usr/local/lib/suru/runtime"
    exec("clang-18 ".append(buildDir).append("*.ll ").append(runtime).append("/*.ll -o ").append(buildDir).append("main"))
}
