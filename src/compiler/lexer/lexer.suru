namespace Suru.Compiler.Lexer

import {
    [extractSourceLine, buildSpaces]: Suru.Compiler.DiagUtils
    [isHexDigit, hexCharToVal, hexDigitsToI64]: Suru.Compiler.Lexer.Hex
}

export {
    Token
    Lexer
    TOK_EOF
    TOK_IDENT
    TOK_TRUE
    TOK_FALSE
    TOK_INT
    TOK_FLOAT
    TOK_STRING
    TOK_LPAREN
    TOK_RPAREN
    TOK_LBRACE
    TOK_RBRACE
    TOK_LBRACKET
    TOK_RBRACKET
    TOK_COMMA
    TOK_DOT
    TOK_COLON
    TOK_MINUS
    TOK_LT
    TOK_GT
    TOK_LET
    TOK_NOT
    TOK_AND
    TOK_OR
    TOK_MATCH
    TOK_WILDCARD
    TOK_FN
    TOK_RETURN
    TOK_VOID
    TOK_WHILE
    TOK_TYPE
    TOK_AS
    TOK_IF
    TOK_ELSE
    TOK_CHAR
    TOK_THIS
    TOK_EXTERN
    TOK_BREAK
    TOK_CONTINUE
    TOK_NAMESPACE
    TOK_IMPORT
    TOK_EXPORT
    TOK_CTYPE
    TOK_SIZE
    isDigit
    isLetter
    isLetterDigitUnderscore
    isWhitespace
    makeToken
    keywordKind
    escapeChar
    singleCharKind
    tokenKindName
    toString
    tokenize
    newLexer
}

// Token kind constants — values must be unique; after any addition or removal run bootstrap.
let TOK_EOF      i64: 0
let TOK_IDENT    i64: 1
let TOK_TRUE     i64: 2
let TOK_FALSE    i64: 3
let TOK_INT      i64: 4
let TOK_FLOAT    i64: 5
let TOK_STRING   i64: 6
let TOK_LPAREN   i64: 7
let TOK_RPAREN   i64: 8
let TOK_LBRACE   i64: 9
let TOK_RBRACE   i64: 10
let TOK_LBRACKET i64: 11
let TOK_RBRACKET i64: 12
let TOK_COMMA    i64: 13
let TOK_DOT      i64: 14
let TOK_COLON    i64: 15
let TOK_MINUS    i64: 16
let TOK_LT       i64: 17
let TOK_GT       i64: 18
let TOK_LET      i64: 19
let TOK_NOT      i64: 20
let TOK_AND      i64: 21
let TOK_OR       i64: 22
let TOK_MATCH    i64: 23
let TOK_WILDCARD i64: 24
let TOK_FN       i64: 25
let TOK_RETURN   i64: 26
let TOK_VOID     i64: 27
let TOK_WHILE    i64: 28
let TOK_TYPE     i64: 29
let TOK_AS       i64: 30
let TOK_IF       i64: 32
let TOK_ELSE     i64: 33
let TOK_CHAR     i64: 34
let TOK_THIS     i64: 35
let TOK_EXTERN   i64: 36
let TOK_BREAK    i64: 37
let TOK_CONTINUE  i64: 38
let TOK_NAMESPACE i64: 39
let TOK_IMPORT    i64: 40
let TOK_EXPORT    i64: 41
let TOK_CTYPE     i64: 42
let TOK_SIZE      i64: 43 // TODO remove this

type Token: { kind i64, text String, line i64, col i64 }


// Mutable lexer state. Methods mutate fields in place — Suru structs are
// heap-allocated, so field assignment mutates the shared allocation.
type Lexer: {
    source String
    pos i64
    line i64
    col i64
    tokens Array<Token>
    srcPath String
    fn current() char
    fn advance() void
    fn notEOF() bool
    fn peek() char
    fn peekN(n i64) char
    fn addToken(kind i64, text String, line i64, col i64) void
    fn consumeWhitespace() void
    fn consumeLineComment() void
    fn isLineComment() bool
    fn processNonWhitespace() void
    fn readIdentOrKeyword() void
    fn readNumber() void
    fn readHexLiteral(startCol i64) void
    fn checkFloat() bool
    fn makeFloatToken(intText String, startCol i64) void
    fn readIdent() String
    fn readDigits() String
    fn readString() void
    fn readChar() void
    fn processSingleChar() void
    fn processSymbolOrString() void
}

let CHAR_DIGIT_0 i64: 48
let CHAR_DIGIT_9 i64: 57
let CHAR_LOWER_A i64: 97
let CHAR_LOWER_Z i64: 122
let CHAR_UPPER_A     i64: 65
let CHAR_UPPER_Z     i64: 90

fn isDigit(ch char) bool {
    let c i64: ch.ord()
    return c.gte(CHAR_DIGIT_0) and c.lte(CHAR_DIGIT_9)
}

fn isLetter(ch char) bool {
    let c i64: ch.ord()
    let lower bool: c.gte(CHAR_LOWER_A) and c.lte(CHAR_LOWER_Z)
    let upper bool: c.gte(CHAR_UPPER_A) and c.lte(CHAR_UPPER_Z)
    return lower or upper
}

fn isLetterDigitUnderscore(ch char) bool {
    return isLetter(ch) or isDigit(ch) or ch.equals('_')
}

fn isWhitespace(ch char) bool {
    return ch.equals(' ') or ch.equals('\n') or ch.equals('\t')
}

fn makeToken(kind i64, text String, line i64, col i64) Token {
    return { kind: kind, text: text, line: line, col: col }
}

fn keywordKind(text String) i64 {
    return match text {
        "true":    TOK_TRUE
        "false":   TOK_FALSE
        "let":     TOK_LET
        "not":     TOK_NOT
        "and":     TOK_AND
        "or":      TOK_OR
        "match":   TOK_MATCH
        "_":       TOK_WILDCARD
        "fn":      TOK_FN
        "return":  TOK_RETURN
        "void":    TOK_VOID
        "while":   TOK_WHILE
        "type":    TOK_TYPE
        "as":      TOK_AS
        "if":      TOK_IF
        "else":    TOK_ELSE
        "this":     TOK_THIS
        "extern":   TOK_EXTERN
        "break":    TOK_BREAK
        "continue":  TOK_CONTINUE
        "namespace": TOK_NAMESPACE
        "import":    TOK_IMPORT
        "export":    TOK_EXPORT
        "cType":     TOK_CTYPE
        _:           TOK_IDENT
    }
}

fn escapeChar(esc char) char {
    return match esc {
        'n':  '\n'
        't':  '\t'
        _:    esc
    }
}

fn singleCharKind(ch char) i64 {
    return match ch {
        '(':  TOK_LPAREN
        ')':  TOK_RPAREN
        '{':  TOK_LBRACE
        '}':  TOK_RBRACE
        '[':  TOK_LBRACKET
        ']':  TOK_RBRACKET
        ',':  TOK_COMMA
        '.':  TOK_DOT
        ':':  TOK_COLON
        '-':  TOK_MINUS
        '<':  TOK_LT
        '>':  TOK_GT
        _:    TOK_EOF
    }
}





// Map a token kind ordinal to its display name.
fn tokenKindName(kind i64) String {
    return match kind {
        TOK_EOF      : "EOF"
        TOK_IDENT    : "IDENT"
        TOK_TRUE     : "TRUE"
        TOK_FALSE    : "FALSE"
        TOK_INT      : "INT"
        TOK_FLOAT    : "FLOAT"
        TOK_STRING   : "STRING"
        TOK_LPAREN   : "LPAREN"
        TOK_RPAREN   : "RPAREN"
        TOK_LBRACE   : "LBRACE"
        TOK_RBRACE   : "RBRACE"
        TOK_LBRACKET : "LBRACKET"
        TOK_RBRACKET : "RBRACKET"
        TOK_COMMA    : "COMMA"
        TOK_DOT      : "DOT"
        TOK_COLON    : "COLON"
        TOK_MINUS    : "MINUS"
        TOK_LT       : "LT"
        TOK_GT       : "GT"
        TOK_LET      : "LET"
        TOK_NOT      : "NOT"
        TOK_AND      : "AND"
        TOK_OR       : "OR"
        TOK_MATCH    : "MATCH"
        TOK_WILDCARD : "WILDCARD"
        TOK_FN       : "FN"
        TOK_RETURN   : "RETURN"
        TOK_VOID     : "VOID"
        TOK_WHILE    : "WHILE"
        TOK_TYPE     : "TYPE"
        TOK_AS       : "AS"
        TOK_IF       : "IF"
        TOK_ELSE     : "ELSE"
        TOK_CHAR     : "CHAR"
        TOK_THIS     : "THIS"
        TOK_EXTERN   : "EXTERN"
        TOK_BREAK     : "BREAK"
        TOK_CONTINUE  : "CONTINUE"
        TOK_NAMESPACE : "NAMESPACE"
        TOK_IMPORT    : "IMPORT"
        TOK_EXPORT    : "EXPORT"
        TOK_CTYPE     : "CTYPE"
        TOK_SIZE      : "SIZE"
        _             : "UNKNOWN"
    }
}

// Tokenize source and format all non-EOF tokens as "KIND text line:col\n" lines.
fn toString(source String) String {
    let tokens Array<Token>: tokenize(move(source), "")
    let result String: ""
    let i i64: 0
    while i.lt(tokens.len()) {
        let tok Token: tokens.at(i)
        if tok.kind.equals(TOK_EOF) { break }
        let line String: tokenKindName(tok.kind)
            .append(" ")
            .append(tok.text)
            .append(" ")
            .append(tok.line.toString())
            .append(":")
            .append(tok.col.toString())
            .append("\n")
        result.__append(line)
        drop(line)
        i: i.add(1)
    }
    drop(tokens)
    return result
}

fn tokenize(source String, srcPath String) Array<Token> {
    let lx Lexer: newLexer(source, srcPath)

    while lx.notEOF() {
        if isWhitespace(lx.current()) {
            lx.consumeWhitespace()
        } else if lx.isLineComment() {
            lx.consumeLineComment()
        } else {
            lx.processNonWhitespace()
        }
    }

    lx.addToken(TOK_EOF, "", lx.line, lx.col)

    let result Array<Token>: clone(lx.tokens)
    drop(lx)

    return result
}

fn newLexer(source String, srcPath String) Lexer {
    return {
        source: source
        pos: 0
        line: 1
        col: 1
        tokens: []
        srcPath: clone(srcPath)


        fn current() char {
            return this.source.__at(this.pos)
        }
        
        fn advance() {
            this.pos: this.pos.add(1)
            this.col: this.col.add(1)
        }

        fn notEOF() bool {
            return this.pos.lt(this.source.len())
        }

        fn peekN(n i64) char {
            return this.source.__at(this.pos.add(n))
        }

        fn peek() char {
            let next i64: this.pos.add(1)
            if next.lt(this.source.len()) { return this.peekN(1) }
            return '\0'
        }

        fn addToken(kind i64, text String, line i64, col i64) {
            this.tokens.add(makeToken(kind, text, line, col))
        }

        fn consumeWhitespace() {
            if this.current().equals('\n') {
                this.pos: this.pos.add(1)
                this.line: this.line.add(1)
                this.col: 1
                return
            }
            this.advance()
        }

        fn consumeLineComment() {
            // Advance past '//' to end of line; the '\n' itself is left for the
            // whitespace handler so line/col accounting stays identical.
            while this.notEOF() and not this.current().equals('\n') {
                this.advance()
            }
        }

        fn isLineComment() bool {
            return this.notEOF() and this.current().equals('/') and this.peek().equals('/')
        }

        fn processNonWhitespace() {
            let ch char: this.current()

            if isLetter(ch) or ch.equals('_') {
                return this.readIdentOrKeyword()
            }

            if isDigit(ch) { return this.readNumber() }

            this.processSymbolOrString()
        }

        fn readIdentOrKeyword() {
            let startCol i64: this.col
            let text String: this.readIdent()
            let kind i64: keywordKind(text)
            this.addToken(kind, text, this.line, startCol)
        }

        fn readNumber() {
            let startCol i64: this.col

            // Hex literal: '0' followed by 'x' or 'X'. Handled separately because
            // the digit set and base differ; the result is still a TOK_INT.
            let isZero bool: this.current().equals('0')
            let isXMark bool: this.peek().equals('x') or this.peek().equals('X')
            if isZero and isXMark {
                return this.readHexLiteral(startCol)
            }

            let intText String: this.readDigits()

            if this.checkFloat() {
                return this.makeFloatToken(intText, startCol)
            }

            this.addToken(TOK_INT, intText, this.line, startCol)
        }

        // Read a hexadecimal integer literal: '0x' / '0X' followed by one or more
        // [0-9a-fA-F] digits. The decoded value is emitted as a decimal TOK_INT so
        // every downstream stage treats it identically to a decimal literal. A bare
        // '0x' with no digits is a fatal lex error (caret diagnostic, mirroring
        // readChar's unterminated-char-literal report).
        fn readHexLiteral(startCol i64) {
            this.advance()  // consume '0'
            this.advance()  // consume 'x' / 'X'

            let start i64: this.pos
            while this.notEOF() and isHexDigit(this.current()) {
                this.advance()
            }
            let digits String: this.source.slice(start, this.pos)

            if digits.len().equals(0) {
                let errHeader String: this.srcPath
                    .append(":").append(this.line.toString())
                    .append(":").append(startCol.toString())
                    .append(": error: invalid hex literal — expected hex digits after '0x'")
                printError(errHeader)
                let srcLine String: extractSourceLine(this.source, this.line)
                let lineLabel String: "  ".append(this.line.toString()).append(" | ")
                printError(lineLabel.append(srcLine))
                let prefixLen i64: lineLabel.len().add(startCol.take(1))
                printError(buildSpaces(prefixLen).append("^"))
                exit(1)
            }

            this.addToken(TOK_INT, hexDigitsToI64(digits).toString(), this.line, startCol)
        }

        fn checkFloat() bool {
            return this.notEOF() and this.current().equals('.') and isDigit(this.peek())
        }

        fn makeFloatToken(intText String, startCol i64) {
            // Consume the '.' then the fractional digits.
            this.advance()

            let fracText String: this.readDigits()

            this.addToken(TOK_FLOAT, intText.append(".").append(fracText), this.line, startCol)
        }

        // Read an identifier, advancing pos/col; return the identifier text.
        fn readIdent() String {
            let start i64: this.pos
            while this.notEOF() and isLetterDigitUnderscore(this.current()) {
                this.advance()
            }
            return this.source.slice(start, this.pos)
        }

        // Read a run of digits, advancing pos/col; return the digit text.
        fn readDigits() String {
            let start i64: this.pos
            while this.notEOF() and isDigit(this.current()) {
                this.advance()
            }
            return this.source.slice(start, this.pos)
        }

        fn readString() {
            let startCol i64: this.col
            this.advance()
            let text String: ""
            while this.notEOF() and not this.current().equals('"') {
                let isEscape bool: this.current().equals('\\') and not this.peek().equals('\0')
                if isEscape {
                    this.advance()
                    text.__append(escapeChar(this.current()).toString())
                } else {
                    text.__append(this.current().toString())
                }
                this.advance()
            }
            this.advance()
            this.addToken(TOK_STRING, text, this.line, startCol)
        }

        // Read a single-quoted char literal: 'x' or an escape '\n' '\t' '\\' '\''.
        // The token text holds the decoded byte as a 1-char string (or "" for '\0').
        // Codegen folds it to an i8 immediate via .ord(); "" → 0 (null byte).
        fn readChar() {
            let startCol i64: this.col
            this.advance() // consume '

            let isEscape bool: this.current().equals('\\') and not this.peek().equals('\0')
            let tokenText String: ""
            if isEscape {
                this.advance()  // consume \
                if this.current().equals('0') {
                    tokenText: ""
                } else {
                    tokenText: escapeChar(this.current()).toString()
                }
            } else {
                tokenText: this.current().toString()
            }

            this.advance()

            if not this.current().equals('\'') {
                let errHeader String: this.srcPath
                    .append(":").append(this.line.toString())
                    .append(":").append(startCol.toString())
                    .append(": error: unterminated char literal")
                printError(errHeader)
                let srcLine String: extractSourceLine(this.source, this.line)
                let lineLabel String: "  ".append(this.line.toString()).append(" | ")
                printError(lineLabel.append(srcLine))
                let prefixLen i64: lineLabel.len().add(startCol.take(1))
                printError(buildSpaces(prefixLen).append("^"))
                exit(1)
            }

            this.advance()

            this.addToken(TOK_CHAR, tokenText, this.line, startCol)
        }

        fn processSingleChar() {
            let ch char: this.current()
            let kind i64: singleCharKind(ch)
            this.addToken(kind, ch.toString(), this.line, this.col)
            this.advance()
        }

        fn processSymbolOrString() {
            let ch char: this.current()
            if ch.equals('"') { return this.readString() }
            if ch.equals('\'') { return this.readChar() }
            this.processSingleChar()
        }
    }
}
