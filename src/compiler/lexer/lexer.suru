include "../diagUtils.suru" as diagUtils

// Token kind constants — ordinals must stay in sync with the bootstrap binary's token kind encoding.
let TOK_EOF      Int64: 0
let TOK_IDENT    Int64: 1
let TOK_TRUE     Int64: 2
let TOK_FALSE    Int64: 3
let TOK_INT      Int64: 4
let TOK_FLOAT    Int64: 5
let TOK_STRING   Int64: 6
let TOK_LPAREN   Int64: 7
let TOK_RPAREN   Int64: 8
let TOK_LBRACE   Int64: 9
let TOK_RBRACE   Int64: 10
let TOK_LBRACKET Int64: 11
let TOK_RBRACKET Int64: 12
let TOK_COMMA    Int64: 13
let TOK_DOT      Int64: 14
let TOK_COLON    Int64: 15
let TOK_MINUS    Int64: 16
let TOK_LT       Int64: 17
let TOK_GT       Int64: 18
let TOK_LET      Int64: 19
let TOK_NOT      Int64: 20
let TOK_AND      Int64: 21
let TOK_OR       Int64: 22
let TOK_MATCH    Int64: 23
let TOK_WILDCARD Int64: 24
let TOK_FN       Int64: 25
let TOK_RETURN   Int64: 26
let TOK_VOID     Int64: 27
let TOK_WHILE    Int64: 28
let TOK_INCLUDE  Int64: 29
let TOK_TYPE     Int64: 30
let TOK_AS       Int64: 31
let TOK_IF       Int64: 32
let TOK_ELSE     Int64: 33
let TOK_CHAR     Int64: 34
let TOK_THIS     Int64: 35
let TOK_EXTERN   Int64: 36
let TOK_BREAK    Int64: 37
let TOK_CONTINUE Int64: 38

type Token: { kind Int64, text String, line Int64, col Int64 }


// Mutable lexer state. Methods mutate fields in place — Suru structs are
// heap-allocated, so field assignment mutates the shared allocation.
type Lexer: {
    source String
    pos Int64
    line Int64
    col Int64
    tokens Array<Token>
    srcPath String
    fn current() Char
    fn advance() void
    fn notEOF() Bool
    fn peek() Char
    fn peekN(n Int64) Char
    fn addToken(kind Int64, text String, line Int64, col Int64) void
    fn consumeWhitespace() void
    fn consumeLineComment() void
    fn isLineComment() Bool
    fn processNonWhitespace() void
    fn readIdentOrKeyword() void
    fn readNumber() void
    fn checkFloat() Bool
    fn makeFloatToken(intText String, startCol Int64) void
    fn readIdent() String
    fn readDigits() String
    fn readString() void
    fn readChar() void
    fn processSingleChar() void
    fn processSymbolOrString() void
}

let CHAR_DIGIT_0 Int64: 48
let CHAR_DIGIT_9 Int64: 57
let CHAR_LOWER_A Int64: 97
let CHAR_LOWER_Z Int64: 122
let CHAR_UPPER_A     Int64: 65
let CHAR_UPPER_Z     Int64: 90

fn isDigit(ch Char) Bool {
    let c Int64: ch.ord()
    return c.gte(CHAR_DIGIT_0) and c.lte(CHAR_DIGIT_9)
}

fn isLetter(ch Char) Bool {
    let c Int64: ch.ord()
    let lower Bool: c.gte(CHAR_LOWER_A) and c.lte(CHAR_LOWER_Z)
    let upper Bool: c.gte(CHAR_UPPER_A) and c.lte(CHAR_UPPER_Z)
    return lower or upper
}

fn isLetterDigitUnderscore(ch Char) Bool {
    return isLetter(ch) or isDigit(ch) or ch.equals('_')
}

fn isWhitespace(ch Char) Bool {
    return ch.equals(' ') or ch.equals('\n') or ch.equals('\t')
}

fn makeToken(kind Int64, text String, line Int64, col Int64) Token {
    return { kind: kind, text: text, line: line, col: col }
}

fn keywordKind(text String) Int64 {
    return match text {
        "true":    TOK_TRUE
        "false":   TOK_FALSE
        "let":     TOK_LET
        "not":     TOK_NOT
        "and":     TOK_AND
        "or":      TOK_OR
        "match":   TOK_MATCH
        "_":       TOK_WILDCARD
        "fn":      TOK_FN
        "return":  TOK_RETURN
        "void":    TOK_VOID
        "while":   TOK_WHILE
        "include": TOK_INCLUDE
        "type":    TOK_TYPE
        "as":      TOK_AS
        "if":      TOK_IF
        "else":    TOK_ELSE
        "this":     TOK_THIS
        "extern":   TOK_EXTERN
        "break":    TOK_BREAK
        "continue": TOK_CONTINUE
        _:          TOK_IDENT
    }
}

fn escapeChar(esc Char) Char {
    return match esc {
        'n':  '\n'
        't':  '\t'
        _:    esc
    }
}

fn singleCharKind(ch Char) Int64 {
    return match ch {
        '(':  TOK_LPAREN
        ')':  TOK_RPAREN
        '{':  TOK_LBRACE
        '}':  TOK_RBRACE
        '[':  TOK_LBRACKET
        ']':  TOK_RBRACKET
        ',':  TOK_COMMA
        '.':  TOK_DOT
        ':':  TOK_COLON
        '-':  TOK_MINUS
        '<':  TOK_LT
        '>':  TOK_GT
        _:    TOK_EOF
    }
}





// Map a token kind ordinal to its display name.
fn tokenKindName(kind Int64) String {
    return match kind {
        TOK_EOF      : "EOF"
        TOK_IDENT    : "IDENT"
        TOK_TRUE     : "TRUE"
        TOK_FALSE    : "FALSE"
        TOK_INT      : "INT"
        TOK_FLOAT    : "FLOAT"
        TOK_STRING   : "STRING"
        TOK_LPAREN   : "LPAREN"
        TOK_RPAREN   : "RPAREN"
        TOK_LBRACE   : "LBRACE"
        TOK_RBRACE   : "RBRACE"
        TOK_LBRACKET : "LBRACKET"
        TOK_RBRACKET : "RBRACKET"
        TOK_COMMA    : "COMMA"
        TOK_DOT      : "DOT"
        TOK_COLON    : "COLON"
        TOK_MINUS    : "MINUS"
        TOK_LT       : "LT"
        TOK_GT       : "GT"
        TOK_LET      : "LET"
        TOK_NOT      : "NOT"
        TOK_AND      : "AND"
        TOK_OR       : "OR"
        TOK_MATCH    : "MATCH"
        TOK_WILDCARD : "WILDCARD"
        TOK_FN       : "FN"
        TOK_RETURN   : "RETURN"
        TOK_VOID     : "VOID"
        TOK_WHILE    : "WHILE"
        TOK_INCLUDE  : "INCLUDE"
        TOK_TYPE     : "TYPE"
        TOK_AS       : "AS"
        TOK_IF       : "IF"
        TOK_ELSE     : "ELSE"
        TOK_CHAR     : "CHAR"
        TOK_THIS     : "THIS"
        TOK_EXTERN   : "EXTERN"
        TOK_BREAK    : "BREAK"
        TOK_CONTINUE : "CONTINUE"
        _            : "UNKNOWN"
    }
}

// Tokenize source and format all non-EOF tokens as "KIND text line:col\n" lines.
fn toString(source String) String {
    let tokens Array<Token>: tokenize(move(source), "")
    let result String: ""
    let i Int64: 0
    while i.lt(tokens.len()) {
        let tok Token: tokens.at(i)
        if tok.kind.equals(TOK_EOF) { break }
        let line String: tokenKindName(tok.kind)
            .append(" ")
            .append(tok.text)
            .append(" ")
            .append(tok.line.toString())
            .append(":")
            .append(tok.col.toString())
            .append("\n")
        result.__append(line)
        drop(line)
        i: i.add(1)
    }
    drop(tokens)
    return result
}

fn tokenize(source String, srcPath String) Array<Token> {
    let lx Lexer: newLexer(source, srcPath)

    while lx.notEOF() {
        if isWhitespace(lx.current()) {
            lx.consumeWhitespace()
        } else if lx.isLineComment() {
            lx.consumeLineComment()
        } else {
            lx.processNonWhitespace()
        }
    }

    lx.addToken(TOK_EOF, "", lx.line, lx.col)

    let result Array<Token>: clone(lx.tokens)
    drop(lx)

    return result
}

fn newLexer(source String, srcPath String) Lexer {
    return {
        source: source
        pos: 0
        line: 1
        col: 1
        tokens: []
        srcPath: clone(srcPath)


        fn current() Char {
            return this.source.__at(this.pos)
        }
        
        fn advance() {
            this.pos: this.pos.add(1)
            this.col: this.col.add(1)
        }

        fn notEOF() Bool {
            return this.pos.lt(this.source.len())
        }

        fn peekN(n Int64) Char {
            return this.source.__at(this.pos.add(n))
        }

        fn peek() Char {
            let next Int64: this.pos.add(1)
            if next.lt(this.source.len()) { return this.peekN(1) }
            return '\0'
        }

        fn addToken(kind Int64, text String, line Int64, col Int64) {
            this.tokens.add(makeToken(kind, text, line, col))
        }

        fn consumeWhitespace() {
            if this.source.at(this.pos).equals("\n") {
                this.pos: this.pos.add(1)
                this.line: this.line.add(1)
                this.col: 1
                return
            }
            this.advance()
        }

        fn consumeLineComment() {
            // Advance past '//' to end of line; the '\n' itself is left for the
            // whitespace handler so line/col accounting stays identical.
            while this.notEOF() and not this.current().equals('\n') {
                this.advance()
            }
        }

        fn isLineComment() Bool {
            return this.notEOF() and this.current().equals('/') and this.peek().equals('/')
        }

        fn processNonWhitespace() {
            let ch Char: this.current()

            if isLetter(ch) or ch.equals('_') {
                return this.readIdentOrKeyword()
            }

            if isDigit(ch) { return this.readNumber() }

            this.processSymbolOrString()
        }

        fn readIdentOrKeyword() {
            let startCol Int64: this.col
            let text String: this.readIdent()
            let kind Int64: keywordKind(text)
            this.addToken(kind, text, this.line, startCol)
        }

        fn readNumber() {
            let startCol Int64: this.col
            let intText String: this.readDigits()

            if this.checkFloat() {
                return this.makeFloatToken(intText, startCol)
            }

            this.addToken(TOK_INT, intText, this.line, startCol)
        }

        fn checkFloat() Bool {
            return this.notEOF() and this.current().equals('.') and isDigit(this.peek())
        }

        fn makeFloatToken(intText String, startCol Int64) {
            // Consume the '.' then the fractional digits.
            this.advance()

            let fracText String: this.readDigits()

            this.addToken(TOK_FLOAT, intText.append(".").append(fracText), this.line, startCol)
        }

        // Read an identifier, advancing pos/col; return the identifier text.
        fn readIdent() String {
            let start Int64: this.pos
            while this.notEOF() and isLetterDigitUnderscore(this.current()) {
                this.advance()
            }
            return this.source.slice(start, this.pos)
        }

        // Read a run of digits, advancing pos/col; return the digit text.
        fn readDigits() String {
            let start Int64: this.pos
            while this.notEOF() and isDigit(this.current()) {
                this.advance()
            }
            return this.source.slice(start, this.pos)
        }

        fn readString() {
            let startCol Int64: this.col
            this.advance()
            let text String: ""
            while this.notEOF() and not this.current().equals('"') {
                let isEscape Bool: this.current().equals('\\') and not this.peek().equals('\0')
                if isEscape {
                    this.advance()
                    text.__append(escapeChar(this.current()).toString())
                } else {
                    text.__append(this.current().toString())
                }
                this.advance()
            }
            this.advance()
            this.addToken(TOK_STRING, text, this.line, startCol)
        }

        // Read a single-quoted char literal: 'x' or an escape '\n' '\t' '\\' '\''.
        // The token text holds the decoded byte as a 1-char string (or "" for '\0').
        // Codegen folds it to an i8 immediate via .ord(); "" → 0 (null byte).
        fn readChar() {
            let startCol Int64: this.col
            this.advance() // consume '

            let isEscape Bool: this.current().equals('\\') and not this.peek().equals('\0')
            let tokenText String: ""
            if isEscape {
                this.advance()  // consume \
                if this.current().equals('0') {
                    tokenText: ""
                } else {
                    tokenText: escapeChar(this.current()).toString()
                }
            } else {
                tokenText: this.current().toString()
            }

            this.advance()

            if not this.current().equals('\'') {
                let errHeader String: this.srcPath
                    .append(":").append(this.line.toString())
                    .append(":").append(startCol.toString())
                    .append(": error: unterminated char literal")
                printError(errHeader)
                let srcLine String: extractSourceLine(this.source, this.line)
                let lineLabel String: "  ".append(this.line.toString()).append(" | ")
                printError(lineLabel.append(srcLine))
                let prefixLen Int64: lineLabel.len().add(startCol.take(1))
                printError(buildSpaces(prefixLen).append("^"))
                exit(1)
            }

            this.advance()

            this.addToken(TOK_CHAR, tokenText, this.line, startCol)
        }

        fn processSingleChar() {
            let ch Char: this.current()
            let kind Int64: singleCharKind(ch)
            this.addToken(kind, ch.toString(), this.line, this.col)
            this.advance()
        }

        fn processSymbolOrString() {
            let ch Char: this.current()
            if ch.equals('"') { return this.readString() }
            if ch.equals('\'') { return this.readChar() }
            this.processSingleChar()
        }
    }
}
