// Token kind constants — ordinals must stay in sync with the bootstrap binary's token kind encoding.
let TOK_EOF      Int64: 0
let TOK_IDENT    Int64: 1
let TOK_TRUE     Int64: 2
let TOK_FALSE    Int64: 3
let TOK_INT      Int64: 4
let TOK_FLOAT    Int64: 5
let TOK_STRING   Int64: 6
let TOK_LPAREN   Int64: 7
let TOK_RPAREN   Int64: 8
let TOK_LBRACE   Int64: 9
let TOK_RBRACE   Int64: 10
let TOK_LBRACKET Int64: 11
let TOK_RBRACKET Int64: 12
let TOK_COMMA    Int64: 13
let TOK_DOT      Int64: 14
let TOK_COLON    Int64: 15
let TOK_MINUS    Int64: 16
let TOK_LT       Int64: 17
let TOK_GT       Int64: 18
let TOK_LET      Int64: 19
let TOK_NOT      Int64: 20
let TOK_AND      Int64: 21
let TOK_OR       Int64: 22
let TOK_MATCH    Int64: 23
let TOK_WILDCARD Int64: 24
let TOK_FN       Int64: 25
let TOK_RETURN   Int64: 26
let TOK_VOID     Int64: 27
let TOK_WHILE    Int64: 28
let TOK_INCLUDE  Int64: 29
let TOK_TYPE     Int64: 30
let TOK_AS       Int64: 31
let TOK_IF       Int64: 32
let TOK_ELSE     Int64: 33
let TOK_CHAR     Int64: 34

type Token: { kind Int64, text String, line Int64, col Int64 }

// Mutable lexer state, threaded the same way the parser threads `Parser`
// (see parserUtil.suru): each function mutates `lx`'s fields in place — Suru
// structs are heap-allocated, so field assignment mutates the shared
// allocation — and returns the same `lx`, so callers write `lx: f(lx)`.
type Lexer: { source String, pos Int64, line Int64, col Int64, tokens Array<Token> }

fn isDigit(ch String) Bool {
    let c Int64: ch.ord()
    return c.gte(48) and c.lt(58)
}

fn isLetter(ch String) Bool {
    let c Int64: ch.ord()
    let lower Bool: c.gte(97) and c.lt(123)
    let upper Bool: c.gte(65) and c.lt(91)
    return lower or upper
}

fn isLetterDigitUnderscore(ch String) Bool {
    return isLetter(ch) or isDigit(ch) or ch.equals("_")
}

fn isWhitespace(ch String) Bool {
    return ch.equals(" ") or ch.equals("\n") or ch.equals("\t")
}

fn isLineComment(source String, pos Int64) Bool {
    let next Int64: pos.add(1)
    return source.at(pos).equals("/") and next.lt(source.len()) and source.at(next).equals("/")
}

fn makeToken(kind Int64, text String, line Int64, col Int64) Token {
    return { kind: kind, text: text, line: line, col: col }
}

fn keywordKind(text String) Int64 {
    return match text {
        "true":    TOK_TRUE
        "false":   TOK_FALSE
        "let":     TOK_LET
        "not":     TOK_NOT
        "and":     TOK_AND
        "or":      TOK_OR
        "match":   TOK_MATCH
        "_":       TOK_WILDCARD
        "fn":      TOK_FN
        "return":  TOK_RETURN
        "void":    TOK_VOID
        "while":   TOK_WHILE
        "include": TOK_INCLUDE
        "type":    TOK_TYPE
        "as":      TOK_AS
        "if":      TOK_IF
        "else":    TOK_ELSE
        _:         TOK_IDENT
    }
}

fn escapeChar(esc String) String {
    return match esc {
        "n":  "\n"
        "t":  "\t"
        "\\": "\\"
        "\"": "\""
        "'":  "'"
        _:    esc
    }
}

fn singleCharKind(ch String) Int64 {
    return match ch {
        "(":  TOK_LPAREN
        ")":  TOK_RPAREN
        "{":  TOK_LBRACE
        "}":  TOK_RBRACE
        "[":  TOK_LBRACKET
        "]":  TOK_RBRACKET
        ",":  TOK_COMMA
        ".":  TOK_DOT
        ":":  TOK_COLON
        "-":  TOK_MINUS
        "<":  TOK_LT
        ">":  TOK_GT
        _:    TOK_EOF
    }
}

fn checkFloat(source String, pos Int64) Bool {
    let next Int64: pos.add(1)
    return pos.lt(source.len()) and source.at(pos).equals(".") and next.lt(source.len()) and isDigit(source.at(next))
}

// Read an identifier, advancing lx.pos/lx.col; return the identifier text.
fn readIdent(lx Lexer) String {
    let text String: ""
    let char String: lx.source.at(lx.pos)
    while lx.pos.lt(lx.source.len()) and isLetterDigitUnderscore(char) {
        let charTmp String: char
        let textTmp String: text

        text: text.append(char)
        lx.pos: lx.pos.add(1)
        lx.col: lx.col.add(1)
        char: lx.source.at(lx.pos)

        drop(charTmp)
        drop(textTmp)
    }
    drop(char)
    return text
}

fn readIdentOrKeyword(lx Lexer) Lexer {
    let startCol Int64: lx.col
    let text String: readIdent(lx)
    let kind Int64: keywordKind(text)
    lx.tokens.add(makeToken(kind, text, lx.line, startCol))
    return lx
}

// Read a run of digits, advancing lx.pos/lx.col; return the digit text.
fn readDigits(lx Lexer) String {
    let text String: ""
    while lx.pos.lt(lx.source.len()) and isDigit(lx.source.at(lx.pos)) {
        let textTmp String: text
        text: text.append(lx.source.at(lx.pos))
        lx.pos: lx.pos.add(1)
        lx.col: lx.col.add(1)
        drop(textTmp)
    }
    return text
}

fn makeFloatToken(lx Lexer, intText String, startCol Int64) Lexer {
    // Consume the '.' then the fractional digits.
    lx.pos: lx.pos.add(1)
    lx.col: lx.col.add(1)
    let fracText String: readDigits(lx)
    lx.tokens.add(makeToken(TOK_FLOAT, intText.append(".").append(fracText), lx.line, startCol))
    return lx
}

fn makeIntToken(lx Lexer, intText String, startCol Int64) Lexer {
    lx.tokens.add(makeToken(TOK_INT, intText, lx.line, startCol))
    return lx
}

fn readNumber(lx Lexer) Lexer {
    let startCol Int64: lx.col
    let intText String: readDigits(lx)
    return match checkFloat(lx.source, lx.pos) {
        true: makeFloatToken(lx, intText, startCol)
        _:    makeIntToken(lx, intText, startCol)
    }
}

fn readString(lx Lexer) Lexer {
    let startCol Int64: lx.col
    lx.pos: lx.pos.add(1)
    lx.col: lx.col.add(1)
    let text String: ""
    while lx.pos.lt(lx.source.len()) and not lx.source.at(lx.pos).equals("\"") {
        let isEscape Bool: lx.source.at(lx.pos).equals("\\") and lx.pos.add(1).lt(lx.source.len())
        let ch String: match isEscape { true: escapeChar(lx.source.at(lx.pos.add(1))), _: lx.source.at(lx.pos) }
        let skip Int64: match isEscape { true: 2, _: 1 }
        let textTmp String: text
        text: text.append(ch)
        lx.pos: lx.pos.add(skip)
        lx.col: lx.col.add(skip)
        drop(textTmp)
    }
    let advanced Int64: match lx.pos.lt(lx.source.len()) { true: 1, _: 0 }
    lx.pos: lx.pos.add(advanced)
    lx.col: lx.col.add(advanced)
    lx.tokens.add(makeToken(TOK_STRING, text, lx.line, startCol))
    return lx
}

// Read a single-quoted char literal: 'x' or an escape '\n' '\t' '\\' '\''.
// The token text holds the one decoded character, same shape as a 1-char
// string token — codegen folds it to an i8 immediate via .ord().
fn readChar(lx Lexer) Lexer {
    let startCol Int64: lx.col
    lx.pos: lx.pos.add(1)
    lx.col: lx.col.add(1)
    let isEscape Bool: lx.source.at(lx.pos).equals("\\") and lx.pos.add(1).lt(lx.source.len())
    let ch String: match isEscape { true: escapeChar(lx.source.at(lx.pos.add(1))), _: lx.source.at(lx.pos) }
    let skip Int64: match isEscape { true: 2, _: 1 }
    lx.pos: lx.pos.add(skip)
    lx.col: lx.col.add(skip)
    let advanced Int64: match lx.pos.lt(lx.source.len()) and lx.source.at(lx.pos).equals("'") { true: 1, _: 0 }
    lx.pos: lx.pos.add(advanced)
    lx.col: lx.col.add(advanced)
    lx.tokens.add(makeToken(TOK_CHAR, ch, lx.line, startCol))
    return lx
}

fn processSingleChar(lx Lexer, ch String) Lexer {
    let kind Int64: singleCharKind(ch)
    lx.tokens.add(makeToken(kind, ch, lx.line, lx.col))
    lx.pos: lx.pos.add(1)
    lx.col: lx.col.add(1)
    return lx
}

fn processSymbolOrString(lx Lexer, ch String) Lexer {
    match ch.equals("\"") { true: { return readString(lx) } _: {} }
    match ch.equals("'")  { true: { return readChar(lx) }   _: {} }
    return processSingleChar(lx, ch)
}

fn processNonWhitespace(lx Lexer, ch String) Lexer {
    match isLetter(ch) or ch.equals("_") {
        true: { return readIdentOrKeyword(lx) }
        _: {
            match isDigit(ch) {
                true: { return readNumber(lx) }
                _: { return processSymbolOrString(lx, ch) }
            }
        }
    }
}

fn advanceWhitespace(lx Lexer, ch String) Lexer {
    match ch.equals("\n") {
        true: {
            lx.pos: lx.pos.add(1)
            lx.line: lx.line.add(1)
            lx.col: 1
            return lx
        }
        _: {
            lx.pos: lx.pos.add(1)
            lx.col: lx.col.add(1)
            return lx
        }
    }
}

fn skipLineComment(lx Lexer) Lexer {
    // Advance past '//' to end of line; the '\n' itself is left for the
    // whitespace handler so line/col accounting stays identical.
    while lx.pos.lt(lx.source.len()) and not lx.source.at(lx.pos).equals("\n") {
        lx.pos: lx.pos.add(1)
        lx.col: lx.col.add(1)
    }
    return lx
}

// Map a token kind ordinal to its display name.
fn tokenKindName(kind Int64) String {
    match kind.equals(0)  { true: { return "EOF"      } _: {} }
    match kind.equals(1)  { true: { return "IDENT"    } _: {} }
    match kind.equals(2)  { true: { return "TRUE"     } _: {} }
    match kind.equals(3)  { true: { return "FALSE"    } _: {} }
    match kind.equals(4)  { true: { return "INT"      } _: {} }
    match kind.equals(5)  { true: { return "FLOAT"    } _: {} }
    match kind.equals(6)  { true: { return "STRING"   } _: {} }
    match kind.equals(7)  { true: { return "LPAREN"   } _: {} }
    match kind.equals(8)  { true: { return "RPAREN"   } _: {} }
    match kind.equals(9)  { true: { return "LBRACE"   } _: {} }
    match kind.equals(10) { true: { return "RBRACE"   } _: {} }
    match kind.equals(11) { true: { return "LBRACKET" } _: {} }
    match kind.equals(12) { true: { return "RBRACKET" } _: {} }
    match kind.equals(13) { true: { return "COMMA"    } _: {} }
    match kind.equals(14) { true: { return "DOT"      } _: {} }
    match kind.equals(15) { true: { return "COLON"    } _: {} }
    match kind.equals(16) { true: { return "MINUS"    } _: {} }
    match kind.equals(17) { true: { return "LT"       } _: {} }
    match kind.equals(18) { true: { return "GT"       } _: {} }
    match kind.equals(19) { true: { return "LET"      } _: {} }
    match kind.equals(20) { true: { return "NOT"      } _: {} }
    match kind.equals(21) { true: { return "AND"      } _: {} }
    match kind.equals(22) { true: { return "OR"       } _: {} }
    match kind.equals(23) { true: { return "MATCH"    } _: {} }
    match kind.equals(24) { true: { return "WILDCARD" } _: {} }
    match kind.equals(25) { true: { return "FN"       } _: {} }
    match kind.equals(26) { true: { return "RETURN"   } _: {} }
    match kind.equals(27) { true: { return "VOID"     } _: {} }
    match kind.equals(28) { true: { return "WHILE"    } _: {} }
    match kind.equals(29) { true: { return "INCLUDE"  } _: {} }
    match kind.equals(30) { true: { return "TYPE"     } _: {} }
    match kind.equals(31) { true: { return "AS"       } _: {} }
    match kind.equals(32) { true: { return "IF"       } _: {} }
    match kind.equals(33) { true: { return "ELSE"     } _: {} }
    match kind.equals(34) { true: { return "CHAR"     } _: {} }
    return "UNKNOWN"
}

// Tokenize source and format all non-EOF tokens as "KIND text line:col\n" lines.
fn toString(source String) String {
    let tokens Array<Token>: tokenize(source)
    let result String: ""
    let i Int64: 0
    while i.lt(tokens.len()) {
        let tok Token: tokens.at(i)
        match tok.kind.equals(TOK_EOF) {
            true: {}
            _: {
                let line String: tokenKindName(tok.kind)
                    .append(" ")
                    .append(tok.text)
                    .append(" ")
                    .append(tok.line.toString())
                    .append(":")
                    .append(tok.col.toString())
                    .append("\n")
                result: result.append(line)
                drop(line)
            }
        }
        i: i.add(1)
    }
    drop(tokens)
    return result
}

fn tokenize(source String) Array<Token> {
    let lx Lexer: { source: source, pos: 0, line: 1, col: 1, tokens: [] }

    while lx.pos.lt(lx.source.len()) {
        let ch String: lx.source.at(lx.pos)
        lx: match isWhitespace(ch) {
            true: advanceWhitespace(lx, ch)
            _: match isLineComment(lx.source, lx.pos) {
                true: skipLineComment(lx)
                _:    processNonWhitespace(lx, ch)
            }
        }
    }

    lx.tokens.add(makeToken(TOK_EOF, "", lx.line, lx.col))
    return lx.tokens
}
