// parser.suru — Recursive descent parsing: statements, expressions, and the
// top-level parse() entry point. Also contains newParser(), the Parser
// constructor.
//
// Expression and statement parsing live in ONE file because they are mutually
// recursive: statements contain expressions (let/return/conditions) AND
// expressions contain statements (method bodies inside struct literals —
// `{ field: v, fn m(p) R { stmts } }`). Suru's per-file compilation cannot
// split mutually recursive functions across an acyclic include DAG.

namespace Suru.Compiler.Parser

export {
    parse
    newParser
}

import {
    Suru.Compiler.Parser.Ast
    Suru.Compiler.Parser.Print
    Suru.Compiler.Parser.Nodes
}

fn parse(tokens Array<Token>, srcPath String) AstModule {
    let p Parser: newParser(move(tokens), srcPath)
    let stmts Array<AstNode>: []
    // Module header: optional namespace declaration then zero or more export blocks.
    if p.currentTokenIs(TOK_NAMESPACE) {
        stmts.add(p.parseNamespaceDecl())
    }
    while p.currentTokenIs(TOK_EXPORT) {
        stmts.add(p.parseExportBlock())
    }
    while p.currentTokenIs(TOK_IMPORT) {
        stmts.add(p.parseImportBlock())
    }
    while not p.currentTokenIs(TOK_EOF) {
        stmts.add(p.parseStatement())
    }
    return { stmts: stmts }
}

fn newParser(tokens Array<Token>, srcPath String) Parser {
    let p Parser: {
        _ pos     i64:         0
        _ tokens  Array<Token>: move(tokens)
        _ srcPath String:       clone(srcPath)

        fn advance() { this.pos: this.pos.add(1) }

        fn currentToken() Token { return this.tokens.at(this.pos) }

        fn currentTokenIs(kind i64) bool {
            return this.tokens.at(this.pos).kind.equals(kind)
        }

        fn peekToken() Token {
            let next i64: this.pos.add(1)
            return match next.lt(this.tokens.len()) {
                true: this.tokens.at(next)
                _:    { kind: TOK_EOF, text: "", line: 0, col: 0 }
            }
        }

        fn peekIs(kind i64) bool {
            return this.peekToken().kind.equals(kind)
        }

        fn peekToken2() Token {
            let next i64: this.pos.add(2)
            return match next.lt(this.tokens.len()) {
                true: this.tokens.at(next)
                _:    { kind: TOK_EOF, text: "", line: 0, col: 0 }
            }
        }

        fn peekIs2(kind i64) bool {
            return this.peekToken2().kind.equals(kind)
        }

        fn consume(expectedKind i64) {
            if not this.currentTokenIs(expectedKind) {
                this.error("expected token kind ".append(expectedKind.toString())
                .append(" got ")
                .append(this.currentToken().kind.toString())
                .append(" '")
                .append(this.currentToken().text)
                .append("'"))
            }
            this.advance()
        }

        fn consumeIf(kind i64) {
            if this.currentTokenIs(kind) { this.advance() }
        }

        fn error(msg String) {
            let tok Token: this.currentToken()
            let header String: this.srcPath
                .append(":").append(tok.line.toString())
                .append(":").append(tok.col.toString())
                .append(": error: ").append(msg)
            printError(header)
            let src String: readFile(this.srcPath)
            let srcLine String: extractSourceLine(src, tok.line)
            let lineLabel String: "  ".append(tok.line.toString()).append(" | ")
            printError(lineLabel.append(srcLine))
            let prefixLen i64: lineLabel.len().add(tok.col.take(1))
            printError(buildSpaces(prefixLen).append("^"))
            exit(1)
        }

        fn parseTypeAnnotation() String {
            let tok Token: this.currentToken()

            if not tok.kind.equals(TOK_IDENT) { this.error("expected type name") }

            let name String: tok.text
            this.advance()

            // Support qualified type names: MyApp.Ns.Type
            while this.currentTokenIs(TOK_DOT) {
                this.advance()
                if not this.currentTokenIs(TOK_IDENT) { this.error("expected type name after '.'") }
                let seg Token: this.currentToken()
                this.advance()
                name: name.append(".").append(seg.text)
            }

            if not this.currentTokenIs(TOK_LT) { return name }

            // Generic: consume '<', parse args, consume '>'
            this.advance()

            let args String: this.parseTypeAnnotation()
            while this.currentTokenIs(TOK_COMMA) {
                this.advance()
                args: args.append(", ").append(this.parseTypeAnnotation())
            }
            this.consume(TOK_GT)
            return name.append("<").append(args).append(">")
        }

        fn parseStatement() AstNode {
            let k i64: this.currentToken().kind
            return match k {
                TOK_NAMESPACE: this.parseNamespaceDecl()
                TOK_EXPORT:    this.parseExportBlock()
                TOK_IMPORT:    this.parseImportBlock()
                TOK_FN:        this.parseFnDecl()
                TOK_EXTERN:    this.parseExternDecl()
                TOK_WHILE:     this.parseWhileStmt()
                TOK_IF:        this.parseIfStmt()
                TOK_RETURN:    this.parseReturnStmt()
                TOK_BREAK:     this.parseBreakStmt()
                TOK_CONTINUE:  this.parseContinueStmt()
                TOK_LET:       this.parseLetStmt()
                TOK_TYPE:      this.parseTypeDeclaration()
                TOK_CTYPE:     this.parseCTypeDeclaration()
                TOK_MATCH:     this.parseMatchStatement()
                TOK_IDENT:     this.parseIdentStmt()
                TOK_THIS:      this.parseIdentStmt()
                _:             this.parseExprStmt()
            }
        }

        fn parseNamespaceDecl() AstNode {
            let tok Token: this.currentToken()
            this.consume(TOK_NAMESPACE)
            let nameTok Token: this.currentToken()
            this.consume(TOK_IDENT)
            let name String: nameTok.text
            while this.currentTokenIs(TOK_DOT) {
                this.advance()
                if not this.currentTokenIs(TOK_IDENT) {
                    this.error("invalid namespace: trailing dot")
                }
                let segTok Token: this.currentToken()
                this.advance()
                name: name.append(".").append(segTok.text)
            }
            let n NamespaceDeclNode: { name: name, line: tok.line, col: tok.col }
            return n
        }

        // parseExportBlock — `export { name1, alias: localName2, ... }`
        //
        // Each entry is either a plain identifier (exportedAs == localName) or an
        // alias form `publicName: localName` where the function/type is defined
        // internally as localName but exported under publicName.
        // Commas between entries are optional (consumeIf).
        fn parseExportBlock() AstNode {
            let tok Token: this.currentToken()
            this.consume(TOK_EXPORT)
            this.consume(TOK_LBRACE)
            let entries Array<ExportEntry>: []
            while not this.currentTokenIs(TOK_RBRACE) and not this.currentTokenIs(TOK_EOF) {
                let nameTok Token: this.currentToken()
                this.consume(TOK_IDENT)
                let exportedAs String: nameTok.text
                let localName String: nameTok.text
                if this.currentTokenIs(TOK_COLON) {
                    this.advance()
                    let localTok Token: this.currentToken()
                    this.consume(TOK_IDENT)
                    localName: localTok.text
                }
                entries.add({ exportedAs: exportedAs, localName: localName })
                this.consumeIf(TOK_COMMA)
            }
            this.consume(TOK_RBRACE)
            let n ExportNode: { entries: entries, line: tok.line, col: tok.col }
            return n
        }

        // parseQualifiedNsPath — parse a dot-separated identifier chain and return
        // it as a string, e.g. "MyApp.CoolService". Used inside import entries for
        // the namespace portion of each import form.
        fn parseQualifiedNsPath() String {
            let tok Token: this.currentToken()
            this.consume(TOK_IDENT)
            let result String: tok.text
            while this.currentTokenIs(TOK_DOT) {
                this.advance()
                if not this.currentTokenIs(TOK_IDENT) { this.error("expected identifier after '.'") }
                let seg Token: this.currentToken()
                this.advance()
                result: result.append(".").append(seg.text)
            }
            return result
        }

        // parseImportEntry — parse one entry inside an `import { ... }` block.
        //
        // Four forms are supported:
        //   FullNs:           MyApp.CoolService
        //   AliasNs:          svc: MyApp.CoolService
        //   SelectiveNames:   [greet, add]: MyApp.Lib
        //   SelectiveAliased: {hello: greet, go: add}: MyApp.Lib
        //
        // The first token disambiguates: `[` → SelectiveNames, `{` → SelectiveAliased,
        // ident followed by `:` → AliasNs, ident followed by `.` → FullNs.
        fn parseImportEntry() ImportEntry {
            // SelectiveNames: [name1, name2]: Ns.Path
            if this.currentTokenIs(TOK_LBRACKET) {
                this.advance()
                let names Array<String>: []
                while not this.currentTokenIs(TOK_RBRACKET) and not this.currentTokenIs(TOK_EOF) {
                    let t Token: this.currentToken()
                    this.consume(TOK_IDENT)
                    names.add(t.text)
                    this.consumeIf(TOK_COMMA)
                }
                this.consume(TOK_RBRACKET)
                this.consume(TOK_COLON)
                let ns String: this.parseQualifiedNsPath()
                let k SelectiveNames: {}
                return { kind: k, ns: ns, alias: "", names: names, nameAliases: [] }
            }
            // SelectiveAliased: {localName: exportedName, ...}: Ns.Path
            // ExportEntry reused: exportedAs = name in the namespace, localName = local alias.
            if this.currentTokenIs(TOK_LBRACE) {
                this.advance()
                let nameAliases Array<ExportEntry>: []
                while not this.currentTokenIs(TOK_RBRACE) and not this.currentTokenIs(TOK_EOF) {
                    let localTok Token: this.currentToken()
                    this.consume(TOK_IDENT)
                    this.consume(TOK_COLON)
                    let exportedTok Token: this.currentToken()
                    this.consume(TOK_IDENT)
                    nameAliases.add({ exportedAs: exportedTok.text, localName: localTok.text })
                    this.consumeIf(TOK_COMMA)
                }
                this.consume(TOK_RBRACE)
                this.consume(TOK_COLON)
                let ns String: this.parseQualifiedNsPath()
                let k SelectiveAliased: {}
                return { kind: k, ns: ns, alias: "", names: [], nameAliases: nameAliases }
            }
            // AliasNs or FullNs — both start with an identifier.
            let firstTok Token: this.currentToken()
            this.consume(TOK_IDENT)
            // AliasNs: first ident followed by ':' is the local alias.
            if this.currentTokenIs(TOK_COLON) {
                this.advance()
                let ns String: this.parseQualifiedNsPath()
                let k AliasNs: {}
                return { kind: k, ns: ns, alias: firstTok.text, names: [], nameAliases: [] }
            }
            // FullNs: first ident is the start of a dot-separated namespace path.
            let ns String: firstTok.text
            while this.currentTokenIs(TOK_DOT) {
                this.advance()
                if not this.currentTokenIs(TOK_IDENT) { this.error("expected identifier after '.'") }
                let seg Token: this.currentToken()
                this.advance()
                ns: ns.append(".").append(seg.text)
            }
            let k FullNs: {}
            return { kind: k, ns: ns, alias: "", names: [], nameAliases: [] }
        }

        // parseImportBlock — `import { entry1, entry2, ... }`
        //
        // Entries are separated by optional commas (consumeIf). Each entry is
        // dispatched to parseImportEntry(). The resulting ImportNode is semantically
        // inert until the import-desugaring pass (Task 6).
        fn parseImportBlock() AstNode {
            let tok Token: this.currentToken()
            this.consume(TOK_IMPORT)
            this.consume(TOK_LBRACE)
            let entries Array<ImportEntry>: []
            while not this.currentTokenIs(TOK_RBRACE) and not this.currentTokenIs(TOK_EOF) {
                entries.add(this.parseImportEntry())
                this.consumeIf(TOK_COMMA)
            }
            this.consume(TOK_RBRACE)
            let n ImportNode: { entries: entries, line: tok.line, col: tok.col }
            return n
        }

        // parseTypeParamList peeks for `<T, U, ...>` after a fn/type name.
        // Returns an empty array if no `<` is present.
        fn parseTypeParamList() Array<String> {
            let typeParams Array<String>: []
            if this.currentTokenIs(TOK_LT) {
                this.advance()
                let tok Token: this.currentToken()
                this.consume(TOK_IDENT)
                typeParams.add(tok.text)
                while this.currentTokenIs(TOK_COMMA) {
                    this.advance()
                    let tok2 Token: this.currentToken()
                    this.consume(TOK_IDENT)
                    typeParams.add(tok2.text)
                }
                this.consume(TOK_GT)
            }
            return typeParams
        }

        // parseParenParamList — consume tokens until TOK_RPAREN/EOF, parsing
        // `name Type` pairs separated by optional commas. The caller is
        // expected to have already consumed TOK_LPAREN; the closing TOK_RPAREN
        // is left for the caller to consume so the cursor is positioned for
        // a following return-type annotation.
        fn parseParenParamList() Array<Param> {
            let params Array<Param>: []
            while not this.currentTokenIs(TOK_RPAREN) and not this.currentTokenIs(TOK_EOF) {
                let pNameTok Token: this.currentToken()
                this.consume(TOK_IDENT)
                let pType String: this.parseTypeAnnotation()
                params.add({ name: pNameTok.text, typeName: pType })
                this.consumeIf(TOK_COMMA)
            }
            return params
        }

        fn parseFnDecl() AstNode {
            this.consume(TOK_FN)
            let nameTok Token: this.currentToken()
            this.consume(TOK_IDENT)
            let typeParams Array<String>: this.parseTypeParamList()
            this.consume(TOK_LPAREN)
            let params Array<Param>: this.parseParenParamList()
            this.consume(TOK_RPAREN)
            let returnType String: this.parseFnReturnType()
            this.consume(TOK_LBRACE)
            let body Array<AstNode>: []
            while not this.currentTokenIs(TOK_RBRACE) and not this.currentTokenIs(TOK_EOF) {
                body.add(this.parseStatement())
            }
            this.consume(TOK_RBRACE)
            let n FnDeclNode: { name: nameTok.text, params: params, returnType: returnType, body: body, srcPath: "", typeParams: typeParams, line: nameTok.line, col: nameTok.col }
            return n
        }

        // parseExternDecl — dispatch `extern fn ...` vs `extern type ...` by peeking
        // at the token after `extern`.
        fn parseExternDecl() AstNode {
            if this.peekIs(TOK_TYPE) { return this.parseExternTypeDecl() }
            return this.parseExternFnDecl()
        }

        // parseExternTypeDecl — parse `extern type Name` (no body, no fields).
        // Declares an opaque C handle type erased to `ptr` in codegen.
        fn parseExternTypeDecl() AstNode {
            this.consume(TOK_EXTERN)
            this.consume(TOK_TYPE)
            let nameTok Token: this.currentToken()
            this.consume(TOK_IDENT)
            let n ExternTypeNode: { name: nameTok.text, line: nameTok.line, col: nameTok.col }
            return n
        }

        // parseExternFnDecl — parse `extern fn name(params) ReturnType` with no body.
        // No typeParams: extern fns are always monomorphic IR declarations.
        fn parseExternFnDecl() AstNode {
            this.consume(TOK_EXTERN)
            this.consume(TOK_FN)
            let nameTok Token: this.currentToken()
            this.consume(TOK_IDENT)
            this.consume(TOK_LPAREN)
            let params Array<Param>: this.parseParenParamList()
            this.consume(TOK_RPAREN)
            let returnType String: this.parseFnReturnType()
            let n ExternFnNode: { name: nameTok.text, params: params, returnType: returnType }
            return n
        }

        fn parseFnReturnType() String {
            if this.currentTokenIs(TOK_VOID) { this.advance() return "void" }
            if this.currentTokenIs(TOK_LBRACE) { return "void" }
            return this.parseTypeAnnotation()
        }

        fn parseTypeDeclaration() AstNode {
            this.consume(TOK_TYPE)
            let nameTok Token: this.currentToken()
            this.consume(TOK_IDENT)
            let typeParams Array<String>: this.parseTypeParamList()
            this.consume(TOK_COLON)
            if this.currentTokenIs(TOK_LBRACE) { return this.parseStructTypeBody(nameTok.text, typeParams, nameTok.line, nameTok.col) }
            return this.parseSumTypeBody(nameTok.text, typeParams, nameTok.line, nameTok.col)
        }

        fn parseStructTypeBody(typeName String, typeParams Array<String>, line i64, col i64) AstNode {
            this.consume(TOK_LBRACE)
            let fields Array<Param>: []
            let methods Array<MethodSig>: []
            while not this.currentTokenIs(TOK_RBRACE) and not this.currentTokenIs(TOK_EOF) {
                this.parseStructTypeMemberInto(fields, methods)
                this.consumeIf(TOK_COMMA)
            }
            this.consume(TOK_RBRACE)
            let n TypeDeclNode: { name: typeName, fields: fields, methods: methods, typeParams: typeParams, isCType: false, line: line, col: col }
            return n
        }

        // Parse a `cType Foo: { f1 T, f2 U }` declaration — a header-less, C-ABI
        // struct for FFI. Only data fields are allowed (no methods, no generics);
        // a method member is a parse error since a cType is data-only.
        fn parseCTypeDeclaration() AstNode {
            this.consume(TOK_CTYPE)
            let nameTok Token: this.currentToken()
            this.consume(TOK_IDENT)
            this.consume(TOK_COLON)
            this.consume(TOK_LBRACE)
            let fields Array<Param>: []
            while not this.currentTokenIs(TOK_RBRACE) and not this.currentTokenIs(TOK_EOF) {
                if this.currentTokenIs(TOK_FN) {
                    this.error("cType '".append(nameTok.text).append("' cannot declare methods (it is data-only)"))
                }
                this.parseDataFieldInto(fields)
                this.consumeIf(TOK_COMMA)
            }
            this.consume(TOK_RBRACE)
            let methods Array<MethodSig>: []
            let typeParams Array<String>: []
            let n TypeDeclNode: { name: nameTok.text, fields: fields, methods: methods, typeParams: typeParams, isCType: true, line: nameTok.line, col: nameTok.col }
            return n
        }

        fn parseStructTypeMemberInto(fields Array<Param>, methods Array<MethodSig>) {
            if this.currentTokenIs(TOK_FN) { return this.parseMethodSigInto(methods) }
            this.parseDataFieldInto(fields)
        }

        fn parseDataFieldInto(fields Array<Param>) {
            let fieldNameTok Token: this.currentToken()
            this.consume(TOK_IDENT)
            let fType String: this.parseTypeAnnotation()
            fields.add({ name: fieldNameTok.text, typeName: fType })
        }

        // Parse a signature-only method member in a `type` body: `fn name(params) Ret`
        // (no body — the body is supplied per-instance in the struct literal).
        fn parseMethodSigInto(methods Array<MethodSig>) {
            this.consume(TOK_FN)
            let mNameTok Token: this.currentToken()
            this.consume(TOK_IDENT)
            this.consume(TOK_LPAREN)
            let mparams Array<Param>: this.parseParenParamList()
            this.consume(TOK_RPAREN)
            let mret String: this.parseMethodSigReturn()
            methods.add({ name: mNameTok.text, params: mparams, returnType: mret })
        }

        // Return type for a signature-only method. Unlike parseFnReturnType there is
        // no `{` body to mark the end, so an absent return type is signalled by the
        // member separator/terminator (`,`, `}`, next `fn`, or EOF) → "void".
        fn parseMethodSigReturn() String {
            if this.currentTokenIs(TOK_VOID) { this.advance() return "void" }
            let noRet bool: this.currentTokenIs(TOK_COMMA) or this.currentTokenIs(TOK_RBRACE) or this.currentTokenIs(TOK_FN) or this.currentTokenIs(TOK_EOF)
            if noRet { return "void" }
            return this.parseTypeAnnotation()
        }

        // parseSumTypeBody — parse a comma-separated list of variant type expressions
        // after the colon in a sum-type declaration. Each variant is parsed as a full
        // type annotation (e.g. "Some<T>" or "None") so generic sum types like
        // `type Option<T>: Some<T>, None` are correctly captured.
        fn parseSumTypeBody(typeName String, typeParams Array<String>, line i64, col i64) AstNode {
            let variants Array<String>: []
            variants.add(this.parseTypeAnnotation())
            while this.currentTokenIs(TOK_COMMA) {
                this.advance()
                variants.add(this.parseTypeAnnotation())
            }
            let n SumTypeDeclNode: { name: typeName, variants: variants, typeParams: typeParams, line: line, col: col }
            return n
        }

        fn parseMatchStatement() AstNode {
            this.consume(TOK_MATCH)
            let cond AstNode: this.parseExpr()
            this.consume(TOK_LBRACE)
            let arms Array<MatchStmtArm>: []
            while not this.currentTokenIs(TOK_RBRACE) and not this.currentTokenIs(TOK_EOF) {
                arms.add(this.parseMatchStmtArm())
                this.consumeIf(TOK_COMMA)
            }
            this.consume(TOK_RBRACE)
            let n MatchStmtNode: { condition: cond, arms: arms }
            return n
        }

        fn parseMatchStmtArm() MatchStmtArm {
            let pat AstNode: this.parseMatchPattern()
            this.consume(TOK_COLON)
            let stmts Array<AstNode>: []
            if this.currentTokenIs(TOK_LBRACE) { return this.parseMatchStmtArmBlock(pat, stmts) }
            return this.parseMatchStmtArmSimple(pat, stmts)
        }

        fn parseMatchStmtArmBlock(pat AstNode, stmts Array<AstNode>) MatchStmtArm {
            this.advance()
            while not this.currentTokenIs(TOK_RBRACE) and not this.currentTokenIs(TOK_EOF) {
                stmts.add(this.parseStatement())
            }
            this.consume(TOK_RBRACE)
            let isWc bool: match pat { WildcardNode: true, _: false }
            let arm MatchStmtArm: { isWildcard: isWc, pattern: pat, stmts: stmts }
            return arm
        }

        fn parseMatchStmtArmSimple(pat AstNode, stmts Array<AstNode>) MatchStmtArm {
            let isWc bool: match pat { WildcardNode: true, _: false }
            if this.currentTokenIs(TOK_RBRACE) { return { isWildcard: isWc, pattern: pat, stmts: stmts } }
            return this.parseMatchStmtArmExprBody(pat, stmts, isWc)
        }

        fn parseMatchStmtArmExprBody(pat AstNode, stmts Array<AstNode>, isWc bool) MatchStmtArm {
            let val AstNode: this.parseExpr()
            let exprStmt ExprStmtNode: { expr: val }
            stmts.add(exprStmt)
            let arm MatchStmtArm: { isWildcard: isWc, pattern: pat, stmts: stmts }
            return arm
        }

        fn parseWhileStmt() AstNode {
            let whileTok Token: this.currentToken()
            this.consume(TOK_WHILE)
            let cond AstNode: this.parseExpr()
            this.consume(TOK_LBRACE)
            let body Array<AstNode>: []
            while not this.currentTokenIs(TOK_RBRACE) and not this.currentTokenIs(TOK_EOF) {
                body.add(this.parseStatement())
            }
            this.consume(TOK_RBRACE)
            let n WhileNode: { condition: cond, body: body, line: whileTok.line, col: whileTok.col }
            return n
        }

        // Parse a brace-delimited block: { stmt* }
        fn parseBlock() BlockNode {
            this.consume(TOK_LBRACE)
            let stmts Array<AstNode>: []
            while not this.currentTokenIs(TOK_RBRACE) and not this.currentTokenIs(TOK_EOF) {
                stmts.add(this.parseStatement())
            }
            this.consume(TOK_RBRACE)
            let block BlockNode: { stmts: stmts }
            return block
        }

        // Parse the optional else / else-if tail of an if statement.
        // Returns an empty BlockNode when there is no else clause.
        fn parseElseBranch() BlockNode {
            if this.currentTokenIs(TOK_ELSE) { return this.parseElseBranchPresent() }
            let empty Array<AstNode>: []
            let noElse BlockNode: { stmts: empty }
            return noElse
        }

        // Consume the `else` token and dispatch to else-if or plain else block.
        fn parseElseBranchPresent() BlockNode {
            this.consume(TOK_ELSE)
            if this.currentTokenIs(TOK_IF) { return this.parseElseIfBranch() }
            return this.parseBlock()
        }

        // Parse `else if <cond> <block> [else ...]` — wraps the recursive IfNode in a BlockNode.
        fn parseElseIfBranch() BlockNode {
            let nestedStmt AstNode: this.parseIfStmt()
            let elseStmts Array<AstNode>: []
            elseStmts.add(nestedStmt)
            let block BlockNode: { stmts: elseStmts }
            return block
        }

        // Parse `if <condition> <thenBlock> [else [if ...] <elseBlock>]`
        fn parseIfStmt() AstNode {
            let ifTok Token: this.currentToken()
            this.consume(TOK_IF)
            let cond AstNode: this.parseExpr()
            let thenBranch BlockNode: this.parseBlock()
            let elseBranch BlockNode: this.parseElseBranch()
            let n IfNode: { condition: cond, thenBranch: thenBranch, elseBranch: elseBranch, line: ifTok.line, col: ifTok.col }
            return n
        }

        fn parseReturnStmt() AstNode {
            let retTok Token: this.currentToken()
            this.consume(TOK_RETURN)
            let atEnd bool: this.currentTokenIs(TOK_RBRACE) or this.currentTokenIs(TOK_EOF)
            if atEnd {
                let dummy WildcardNode: {}
                let n ReturnNode: { hasValue: false, value: dummy, line: retTok.line, col: retTok.col }
                return n
            }
            return this.parseReturnValue(retTok)
        }

        fn parseReturnValue(retTok Token) AstNode {
            let val AstNode: this.parseExpr()
            let n ReturnNode: { hasValue: true, value: val, line: retTok.line, col: retTok.col }
            return n
        }

        fn parseBreakStmt() AstNode {
            let breakTok Token: this.currentToken()
            this.consume(TOK_BREAK)
            let n BreakNode: { line: breakTok.line, col: breakTok.col }
            return n
        }

        fn parseContinueStmt() AstNode {
            let contTok Token: this.currentToken()
            this.consume(TOK_CONTINUE)
            let n ContinueNode: { line: contTok.line, col: contTok.col }
            return n
        }

        fn parseLetStmt() AstNode {
            this.consume(TOK_LET)
            let nameTok Token: this.currentToken()
            this.consume(TOK_IDENT)
            let typeName String: this.parseTypeAnnotation()
            this.consume(TOK_COLON)
            let val AstNode: this.parseExpr()
            let n LetNode: { name: nameTok.text, typeName: typeName, value: val, line: nameTok.line, col: nameTok.col, srcPath: "" }
            return n
        }

        fn parseIdentStmt() AstNode {
            let isAssign bool: this.peekIs(TOK_COLON)
            if isAssign { return this.parseAssignStmt() }
            return this.parseIdentExprOrFieldAssign()
        }

        fn parseAssignStmt() AstNode {
            let assignTok Token: this.currentToken()
            let name String: assignTok.text
            this.advance()
            this.consume(TOK_COLON)
            let val AstNode: this.parseExpr()
            let n AssignNode: { name: name, value: val, line: assignTok.line, col: assignTok.col }
            return n
        }

        fn parseIdentExprOrFieldAssign() AstNode {
            let e AstNode: this.parsePostfixChain(this.parsePrimary())
            let isFA bool: match e { FieldAccessNode: true, _: false }
            let isAssign bool: isFA and this.currentTokenIs(TOK_COLON)
            if isAssign { return this.parseFieldAssignStmt(e) }
            let n ExprStmtNode: { expr: e }
            return n
        }

        fn parseFieldAssignStmt(fieldExpr AstNode) AstNode {
            this.consume(TOK_COLON)
            let val AstNode: this.parseExpr()
            match fieldExpr {
                FieldAccessNode: {
                    let n FieldAssignNode: { receiver: fieldExpr.receiver, fieldName: fieldExpr.fieldName, value: val, line: fieldExpr.line, col: fieldExpr.col }
                    return n
                }
                _: {
                    this.error("expected field access before ':'")
                    let n ExprStmtNode: { expr: fieldExpr }
                    return n
                }
            }
        }

        fn parseExprStmt() AstNode {
            let val AstNode: this.parseExpr()
            let n ExprStmtNode: { expr: val }
            return n
        }

        // ─── Expression layer ─────────────────────────────────────────────────────

        fn parseExpr() AstNode {
            return this.parseOrExpr()
        }

        fn parseOrExpr() AstNode {
            let left AstNode: this.parseAndExpr()
            while this.currentTokenIs(TOK_OR) {
                this.advance()
                let right AstNode: this.parseAndExpr()
                let n BinaryNode: { op: OP_OR, left: left, right: right, resolvedType: "" }
                left: n
            }
            return left
        }

        fn parseAndExpr() AstNode {
            let left AstNode: this.parseNotExpr()
            while this.currentTokenIs(TOK_AND) {
                this.advance()
                let right AstNode: this.parseNotExpr()
                let n BinaryNode: { op: OP_AND, left: left, right: right, resolvedType: "" }
                left: n
            }
            return left
        }

        fn parseNotExpr() AstNode {
            if this.currentTokenIs(TOK_NOT) { this.advance() return this.parseNotExprBody() }
            return this.parsePostfixChain(this.parsePrimary())
        }

        fn parseNotExprBody() AstNode {
            let inner AstNode: this.parseNotExpr()
            let n UnaryNode: { op: OP_NOT, operand: inner, resolvedType: "" }
            return n
        }

        fn parsePostfixChain(initial AstNode) AstNode {
            let expr AstNode: initial
            while this.currentTokenIs(TOK_DOT) {
                expr: this.processPostfixStep(expr)
            }
            return expr
        }

        fn processPostfixStep(expr AstNode) AstNode {
            this.advance()
            let nameTok Token: this.currentToken()
            this.consume(TOK_IDENT)
            let memberName String: nameTok.text
            if this.currentTokenIs(TOK_LPAREN) { return this.parseMethodCallPart(expr, memberName, nameTok) }
            let n FieldAccessNode: { receiver: expr, fieldName: memberName, line: nameTok.line, col: nameTok.col, resolvedType: "" }
            return n
        }

        fn parseMethodCallPart(expr AstNode, memberName String, nameTok Token) AstNode {
            this.advance()
            let args Array<AstNode>: this.parseArgs()
            this.consume(TOK_RPAREN)
            let n MethodCallNode: { receiver: expr, methodName: memberName, args: args, line: nameTok.line, col: nameTok.col, resolvedType: "" }
            return n
        }

        fn parsePrimary() AstNode {
            let tok Token: this.currentToken()
            let k i64: tok.kind
            match k {
                TOK_LBRACKET: { return this.parsePrimaryArray() }
                TOK_LBRACE:   { return this.parsePrimaryStruct() }
                TOK_MATCH:    { return this.parsePrimaryMatch() }
                TOK_IDENT: {
                    // `typeSize` is a contextual keyword: treat it as `typeSize(T)` only
                    // when the very next token is `(`. Import from stdlib.ffi before use.
                    if tok.text.equals("typeSize") and this.peekIs(TOK_LPAREN) {
                        return this.parsePrimaryTypeSize(tok)
                    }
                    return this.parsePrimaryIdent(tok)
                }
                TOK_MINUS:    { return this.parsePrimaryMinus() }
                TOK_THIS: {
                    let n VarRefNode: { name: "this", line: tok.line, col: tok.col, resolvedType: "" }
                    this.advance() return n
                }
                TOK_TRUE: {
                    let n BoolLitNode: { boolVal: true, resolvedType: "" }
                    this.advance() return n
                }
                TOK_FALSE: {
                    let n BoolLitNode: { boolVal: false, resolvedType: "" }
                    this.advance() return n
                }
                TOK_INT: {
                    let n IntLitNode: { text: tok.text, resolvedType: "" }
                    this.advance() return n
                }
                TOK_FLOAT: {
                    let n FloatLitNode: { text: tok.text, resolvedType: "" }
                    this.advance() return n
                }
                TOK_STRING: {
                    let n StrLitNode: { text: tok.text, resolvedType: "" }
                    this.advance() return n
                }
                TOK_CHAR: {
                    let n CharLitNode: { text: tok.text, resolvedType: "" }
                    this.advance() return n
                }
                _: {
                    this.error("unexpected token in expression")
                    let n BoolLitNode: { boolVal: false, resolvedType: "" }
                    this.advance() return n
                }
            }
        }

        fn parsePrimaryArray() AstNode {
            this.advance()
            let elems Array<AstNode>: []
            while not this.currentTokenIs(TOK_RBRACKET) and not this.currentTokenIs(TOK_EOF) {
                elems.add(this.parseExpr())
                this.consumeIf(TOK_COMMA)
            }
            this.consume(TOK_RBRACKET)
            let n ArrayLitNode: { elems: elems, resolvedType: "" }
            return n
        }

        // Struct/object literal: `{ field: expr, ..., fn name(params) Ret { stmts } }`.
        // Data fields and method definitions may interleave; methods are recognized by
        // a leading `fn` and carry their parsed body (statement list). The method
        // lambda-lift in pipeline.suru later rewrites method members into a single
        // synthetic `__vtable` data field.
        fn parsePrimaryStruct() AstNode {
            let lbraceTok Token: this.currentToken()
            this.advance()
            let fields Array<StructFieldNode>: []
            while not this.currentTokenIs(TOK_RBRACE) and not this.currentTokenIs(TOK_EOF) {
                this.parseStructLitMemberInto(fields)
                this.consumeIf(TOK_COMMA)
            }
            this.consume(TOK_RBRACE)
            let n StructLitNode: { fields: fields, resolvedType: "", line: lbraceTok.line, col: lbraceTok.col }
            return n
        }

        // parseStructLitMemberInto — dispatch to the right parser based on the leading token:
        //   TOK_FN                → public method
        //   TOK_WILDCARD TOK_FN   → private method (`_ fn name ...`)
        //   TOK_WILDCARD          → private data field (`_ name Type: value`)
        //   TOK_IDENT             → public data field (`name: value`)
        fn parseStructLitMemberInto(fields Array<StructFieldNode>) {
            if this.currentTokenIs(TOK_FN) { return this.parseStructLitMethodInto(fields) }
            if this.currentTokenIs(TOK_WILDCARD) {
                if this.peekIs(TOK_FN) { return this.parseStructLitPrivateMethodInto(fields) }
                return this.parseStructLitPrivateFieldInto(fields)
            }
            this.parseStructLitFieldInto(fields)
        }

        fn parseStructLitFieldInto(fields Array<StructFieldNode>) {
            let fieldNameTok Token: this.currentToken()
            this.consume(TOK_IDENT)
            this.consume(TOK_COLON)
            let val AstNode: this.parseExpr()
            let noParams Array<Param>: []
            let noBody Array<AstNode>: []
            let f StructFieldNode: { name: fieldNameTok.text, value: val, isMethod: false, isPrivate: false, privateTypeName: "", methodParams: noParams, methodRet: "", methodBody: noBody }
            fields.add(f)
        }

        // parseStructLitPrivateFieldInto — parses `_ fieldName TypeAnnotation: value`.
        // The `_` is a standalone privacy modifier; the stored field name has no underscore.
        // Type annotation is mandatory for private data fields.
        fn parseStructLitPrivateFieldInto(fields Array<StructFieldNode>) {
            this.consume(TOK_WILDCARD)
            let fieldNameTok Token: this.currentToken()
            this.consume(TOK_IDENT)
            let fType String: this.parseTypeAnnotation()
            this.consume(TOK_COLON)
            let val AstNode: this.parseExpr()
            let noParams Array<Param>: []
            let noBody Array<AstNode>: []
            let f StructFieldNode: { name: fieldNameTok.text, value: val, isMethod: false, isPrivate: true, privateTypeName: fType, methodParams: noParams, methodRet: "", methodBody: noBody }
            fields.add(f)
        }

        fn parseStructLitMethodInto(fields Array<StructFieldNode>) {
            this.parseStructLitMethodBase(fields, false)
        }

        // parseStructLitPrivateMethodInto — parses `_ fn methodName(params) RetType { body }`.
        // The `_` marks the method as private; the stored name has no underscore.
        fn parseStructLitPrivateMethodInto(fields Array<StructFieldNode>) {
            this.parseStructLitMethodBase(fields, true)
        }

        // parseStructLitMethodBase — shared implementation for public and
        // private struct-literal method members. When isPrivate is true the
        // leading TOK_WILDCARD is consumed first.
        fn parseStructLitMethodBase(fields Array<StructFieldNode>, isPrivate bool) {
            if isPrivate { this.consume(TOK_WILDCARD) }
            this.consume(TOK_FN)
            let mNameTok Token: this.currentToken()
            this.consume(TOK_IDENT)
            this.consume(TOK_LPAREN)
            let mparams Array<Param>: this.parseParenParamList()
            this.consume(TOK_RPAREN)
            let mret String: this.parseFnReturnType()
            let bodyBlock BlockNode: this.parseBlock()
            let dummy WildcardNode: {}
            let m StructFieldNode: { name: mNameTok.text, value: dummy, isMethod: true, isPrivate: isPrivate, privateTypeName: "", methodParams: mparams, methodRet: mret, methodBody: bodyBlock.stmts }
            fields.add(m)
        }

        fn parsePrimaryMatch() AstNode {
            let matchTok Token: this.currentToken()
            this.advance()
            let cond AstNode: this.parseExpr()
            this.consume(TOK_LBRACE)
            let arms Array<MatchArm>: []
            while not this.currentTokenIs(TOK_RBRACE) and not this.currentTokenIs(TOK_EOF) {
                arms.add(this.parseMatchArm())
                this.consumeIf(TOK_COMMA)
            }
            this.consume(TOK_RBRACE)
            let n MatchExprNode: { condition: cond, arms: arms, line: matchTok.line, col: matchTok.col, resolvedType: "" }
            return n
        }

        fn parsePrimaryIdent(tok Token) AstNode {
            let name String: tok.text
            this.advance()
            if this.currentTokenIs(TOK_LPAREN) { return this.parsePrimaryCall(name, tok) }
            let n VarRefNode: { name: name, line: tok.line, col: tok.col, resolvedType: "" }
            return n
        }

        fn parsePrimaryCall(name String, tok Token) AstNode {
            this.advance()
            let args Array<AstNode>: this.parseArgs()
            this.consume(TOK_RPAREN)
            let n CallNode: { name: name, args: args, line: tok.line, col: tok.col, resolvedType: "" }
            return n
        }

        fn parsePrimaryMinus() AstNode {
            this.advance()
            let numTok Token: this.currentToken()
            let k i64: numTok.kind
            match k {
                TOK_INT: {
                    let n IntLitNode: { text: "-".append(numTok.text), resolvedType: "" }
                    this.advance() return n
                }
                TOK_FLOAT: {
                    let n FloatLitNode: { text: "-".append(numTok.text), resolvedType: "" }
                    this.advance() return n
                }
                _: {
                    this.error("expected number after '-'")
                    let n IntLitNode: { text: "0", resolvedType: "" }
                    this.advance() return n
                }
            }
        }

        // parsePrimaryTypeSize — parse a `typeSize(T)` compiler intrinsic.
        // `typeSize` is a contextual keyword: only triggered when followed by `(`.
        // The argument position is a type name, not a value expression.
        // Import from stdlib.ffi before use.
        fn parsePrimaryTypeSize(tok Token) AstNode {
            this.advance()
            this.consume(TOK_LPAREN)
            let typeName String: this.parseTypeAnnotation()
            this.consume(TOK_RPAREN)
            let n SizeNode: { typeName: typeName, line: tok.line, col: tok.col, resolvedType: "" }
            return n
        }

        fn parseMatchArm() MatchArm {
            let pat AstNode: this.parseMatchPattern()
            this.consume(TOK_COLON)
            let body AstNode: this.parseExpr()
            let isWc bool: match pat { WildcardNode: true, _: false }
            let arm MatchArm: { isWildcard: isWc, pattern: pat, body: body }
            return arm
        }

        fn parseMatchPattern() AstNode {
            let tok Token: this.currentToken()
            let k i64: tok.kind
            match k {
                TOK_WILDCARD: {
                    let n WildcardNode: {}
                    this.advance() return n
                }
                TOK_TRUE: {
                    let n BoolLitNode: { boolVal: true, resolvedType: "" }
                    this.advance() return n
                }
                TOK_FALSE: {
                    let n BoolLitNode: { boolVal: false, resolvedType: "" }
                    this.advance() return n
                }
                TOK_INT: {
                    let n IntLitNode: { text: tok.text, resolvedType: "" }
                    this.advance() return n
                }
                TOK_FLOAT: {
                    let n FloatLitNode: { text: tok.text, resolvedType: "" }
                    this.advance() return n
                }
                TOK_STRING: {
                    let n StrLitNode: { text: tok.text, resolvedType: "" }
                    this.advance() return n
                }
                TOK_CHAR: {
                    let n CharLitNode: { text: tok.text, resolvedType: "" }
                    this.advance() return n
                }
                TOK_MINUS: { return this.parseNegativePattern() }
                TOK_IDENT: {
                    let n VarRefNode: { name: tok.text, line: tok.line, col: tok.col, resolvedType: "" }
                    this.advance() return n
                }
                _: {
                    this.error("expected match pattern")
                    let n WildcardNode: {}
                    this.advance() return n
                }
            }
        }

        fn parseNegativePattern() AstNode {
            this.advance()
            let num Token: this.currentToken()
            let k i64: num.kind
            match k {
                TOK_INT: {
                    let n IntLitNode: { text: "-".append(num.text), resolvedType: "" }
                    this.advance() return n
                }
                TOK_FLOAT: {
                    let n FloatLitNode: { text: "-".append(num.text), resolvedType: "" }
                    this.advance() return n
                }
                _: {
                    this.error("expected number after '-' in match pattern")
                    let n WildcardNode: {}
                    this.advance() return n
                }
            }
        }

        fn parseArgs() Array<AstNode> {
            if this.currentTokenIs(TOK_RPAREN) { return [] }
            return this.parseArgsList()
        }

        fn parseArgsList() Array<AstNode> {
            let args Array<AstNode>: []
            args.add(this.parseExpr())
            while this.currentTokenIs(TOK_COMMA) {
                this.advance()
                args.add(this.parseExpr())
            }
            return args
        }
    }
    return p
}
