// parser.suru — Statement-level recursive descent parsing and the top-level
// parse() entry point.
//
// Include DAG:
//   parserAst.suru       — AST type definitions (leaf)
//   parserUtil.suru      — token cursor + type-annotation parsing (depends on ast)
//   parserExpr.suru      — expression parsing (depends on ast + util)
//   parserPrint.suru     — AST pretty-printer (depends on ast)
//   parser.suru          — this file, statement layer + parse() (depends on all above)
//
// Why this layering: expression parsing is self-contained — primary forms like
// match expressions, struct literals, array literals only call back into parseExpr.
// Statement parsing depends on expressions (let bindings, return values, match
// conditions, while/if conditions) but not vice versa. Putting expressions in
// their own file before statements keeps the include DAG acyclic.

include "parserAst.suru" as ast
include "parserUtil.suru" as util
include "parserExpr.suru" as expr
include "parserPrint.suru" as pprint

fn parseStatement(parser Parser) StmtResult {
    let k Int64: util.currentToken(parser).kind
    return match k {
        TOK_INCLUDE: parseIncludeDirective(parser)
        TOK_FN:      parseFnDecl(parser)
        TOK_WHILE:   parseWhileStmt(parser)
        TOK_IF:      parseIfStmt(parser)
        TOK_RETURN:  parseReturnStmt(parser)
        TOK_LET:     parseLetStmt(parser)
        TOK_TYPE:    parseTypeDeclaration(parser)
        TOK_MATCH:   parseMatchStatement(parser)
        TOK_IDENT:   parseIdentStmt(parser)
        _:           parseExprStmt(parser)
    }
}

fn parseIncludeDirective(parser Parser) StmtResult {
    parser: util.consume(parser, TOK_INCLUDE)
    let pathTok Token: util.currentToken(parser)
    parser: util.consume(parser, TOK_STRING)
    parser: util.consume(parser, TOK_AS)
    let nsTok Token: util.currentToken(parser)
    parser: util.consume(parser, TOK_IDENT)
    let n IncludeNode: { path: clone(pathTok.text), ns: clone(nsTok.text) }
    return { parser: parser, stmt: n }
}

fn parseFnDecl(parser Parser) StmtResult {
    parser: util.consume(parser, TOK_FN)
    let nameTok Token: util.currentToken(parser)
    parser: util.consume(parser, TOK_IDENT)
    parser: util.consume(parser, TOK_LPAREN)
    let params Array<Param>: []
    while not util.currentTokenIs(parser, TOK_RPAREN) and not util.currentTokenIs(parser, TOK_EOF) {
        let pNameTok Token: util.currentToken(parser)
        parser: util.consume(parser, TOK_IDENT)
        let tr TypeAnnResult: util.parseTypeAnnotation(parser)
        parser: tr.parser
        let pType String: tr.typeName
        tr.parser:   {}
        tr.typeName: ""
        drop(tr)
        params.add({ name: pNameTok.text, typeName: pType })
        parser: util.consumeIf(parser, TOK_COMMA)
    }
    parser: util.consume(parser, TOK_RPAREN)
    let rtr RetTypeResult: parseFnReturnType(parser)
    parser: rtr.parser
    let returnType String: rtr.returnType
    rtr.parser:     {}
    rtr.returnType: ""
    drop(rtr)
    parser: util.consume(parser, TOK_LBRACE)
    let body Array<AstNode>: []
    while not util.currentTokenIs(parser, TOK_RBRACE) and not util.currentTokenIs(parser, TOK_EOF) {
        let r StmtResult: parseStatement(parser)
        body.add(r.stmt)
        parser: r.parser
        r.stmt:   {}
        r.parser: {}
        drop(r)
    }
    parser: util.consume(parser, TOK_RBRACE)
    let n FnDeclNode: { name: nameTok.text, params: params, returnType: returnType, body: body }
    return { parser: parser, stmt: n }
}

fn parseFnReturnType(parser Parser) RetTypeResult {
    return match util.currentTokenIs(parser, TOK_VOID) {
        true: { parser: util.advance(parser), returnType: "void" }
        _:    match util.currentTokenIs(parser, TOK_LBRACE) {
            true: { parser: parser, returnType: "void" }
            _:    parseFnReturnTypeAnnotation(parser)
        }
    }
}

fn parseFnReturnTypeAnnotation(parser Parser) RetTypeResult {
    let tr TypeAnnResult: util.parseTypeAnnotation(parser)
    parser: tr.parser
    let t String: tr.typeName
    tr.parser:   {}
    tr.typeName: ""
    drop(tr)
    return { parser: parser, returnType: t }
}

fn parseTypeDeclaration(parser Parser) StmtResult {
    parser: util.consume(parser, TOK_TYPE)
    let nameTok Token: util.currentToken(parser)
    parser: util.consume(parser, TOK_IDENT)
    parser: util.consume(parser, TOK_COLON)
    return match util.currentTokenIs(parser, TOK_LBRACE) {
        true: parseStructTypeBody(parser, nameTok.text)
        _:    parseSumTypeBody(parser, nameTok.text)
    }
}

fn parseStructTypeBody(parser Parser, typeName String) StmtResult {
    parser: util.consume(parser, TOK_LBRACE)
    let fields Array<Param>: []
    while not util.currentTokenIs(parser, TOK_RBRACE) and not util.currentTokenIs(parser, TOK_EOF) {
        let fieldNameTok Token: util.currentToken(parser)
        parser: util.consume(parser, TOK_IDENT)
        let tr TypeAnnResult: util.parseTypeAnnotation(parser)
        parser: tr.parser
        let fType String: tr.typeName
        tr.parser:   {}
        tr.typeName: ""
        drop(tr)
        fields.add({ name: fieldNameTok.text, typeName: fType })
        parser: util.consumeIf(parser, TOK_COMMA)
    }
    parser: util.consume(parser, TOK_RBRACE)
    let n TypeDeclNode: { name: typeName, fields: fields }
    return { parser: parser, stmt: n }
}

fn parseSumTypeBody(parser Parser, typeName String) StmtResult {
    let variants Array<String>: []
    let vtok Token: util.currentToken(parser)
    parser: util.consume(parser, TOK_IDENT)
    variants.add(vtok.text)
    while util.currentTokenIs(parser, TOK_COMMA) {
        parser: util.advance(parser)
        let vtok2 Token: util.currentToken(parser)
        parser: util.consume(parser, TOK_IDENT)
        variants.add(vtok2.text)
    }
    let n SumTypeDeclNode: { name: typeName, variants: variants }
    return { parser: parser, stmt: n }
}

fn parseMatchStatement(parser Parser) StmtResult {
    parser: util.consume(parser, TOK_MATCH)
    let cr ParseResult: expr.parseExpr(parser)
    parser: cr.parser
    let cond AstNode: cr.expr
    cr.parser: {}
    cr.expr:   {}
    drop(cr)
    parser: util.consume(parser, TOK_LBRACE)
    let arms Array<MatchStmtArm>: []
    while not util.currentTokenIs(parser, TOK_RBRACE) and not util.currentTokenIs(parser, TOK_EOF) {
        let ar StmtArmResult: parseMatchStmtArm(parser)
        parser: ar.parser
        arms.add(ar.arm)
        ar.parser: {}
        ar.arm:    {}
        drop(ar)
        parser: util.consumeIf(parser, TOK_COMMA)
    }
    parser: util.consume(parser, TOK_RBRACE)
    let n MatchStmtNode: { condition: cond, arms: arms }
    return { parser: parser, stmt: n }
}

fn parseMatchStmtArm(parser Parser) StmtArmResult {
    let patR PatResult: expr.parseMatchPattern(parser)
    parser: patR.parser
    let pat AstNode: patR.pat
    patR.parser: {}
    patR.pat:    {}
    drop(patR)
    parser: util.consume(parser, TOK_COLON)
    let stmts Array<AstNode>: []
    return match util.currentTokenIs(parser, TOK_LBRACE) {
        true: parseMatchStmtArmBlock(parser, pat, stmts)
        _:    parseMatchStmtArmSimple(parser, pat, stmts)
    }
}

fn parseMatchStmtArmBlock(parser Parser, pat AstNode, stmts Array<AstNode>) StmtArmResult {
    parser: util.advance(parser)
    while not util.currentTokenIs(parser, TOK_RBRACE) and not util.currentTokenIs(parser, TOK_EOF) {
        let r StmtResult: parseStatement(parser)
        stmts.add(r.stmt)
        parser: r.parser
        r.stmt:   {}
        r.parser: {}
        drop(r)
    }
    parser: util.consume(parser, TOK_RBRACE)
    let isWc Bool: match pat { WildcardNode: true, _: false }
    let arm MatchStmtArm: { isWildcard: isWc, pattern: pat, stmts: stmts }
    return { parser: parser, arm: arm }
}

fn parseMatchStmtArmSimple(parser Parser, pat AstNode, stmts Array<AstNode>) StmtArmResult {
    let isWc Bool: match pat { WildcardNode: true, _: false }
    return match util.currentTokenIs(parser, TOK_RBRACE) {
        true: { parser: parser, arm: { isWildcard: isWc, pattern: pat, stmts: stmts } }
        _:    parseMatchStmtArmExprBody(parser, pat, stmts, isWc)
    }
}

fn parseMatchStmtArmExprBody(parser Parser, pat AstNode, stmts Array<AstNode>, isWc Bool) StmtArmResult {
    let er ParseResult: expr.parseExpr(parser)
    parser: er.parser
    let val AstNode: er.expr
    er.parser: {}
    er.expr:   {}
    drop(er)
    let exprStmt ExprStmtNode: { expr: val }
    stmts.add(exprStmt)
    let arm MatchStmtArm: { isWildcard: isWc, pattern: pat, stmts: stmts }
    return { parser: parser, arm: arm }
}

fn parseWhileStmt(parser Parser) StmtResult {
    parser: util.consume(parser, TOK_WHILE)
    let cr ParseResult: expr.parseExpr(parser)
    parser: cr.parser
    let cond AstNode: cr.expr
    cr.parser: {}
    cr.expr:   {}
    drop(cr)
    parser: util.consume(parser, TOK_LBRACE)
    let body Array<AstNode>: []
    while not util.currentTokenIs(parser, TOK_RBRACE) and not util.currentTokenIs(parser, TOK_EOF) {
        let r StmtResult: parseStatement(parser)
        body.add(r.stmt)
        parser: r.parser
        r.stmt:   {}
        r.parser: {}
        drop(r)
    }
    parser: util.consume(parser, TOK_RBRACE)
    let n WhileNode: { condition: cond, body: body }
    return { parser: parser, stmt: n }
}

// Parse a brace-delimited block: { stmt* }
fn parseBlock(parser Parser) BlockResult {
    parser: util.consume(parser, TOK_LBRACE)
    let stmts Array<AstNode>: []
    while not util.currentTokenIs(parser, TOK_RBRACE) and not util.currentTokenIs(parser, TOK_EOF) {
        let r StmtResult: parseStatement(parser)
        stmts.add(r.stmt)
        parser: r.parser
        r.stmt:   {}
        r.parser: {}
        drop(r)
    }
    parser: util.consume(parser, TOK_RBRACE)
    let block BlockNode: { stmts: stmts }
    return { parser: parser, block: block }
}

// Parse the optional else / else-if tail of an if statement.
// Returns a BlockResult whose block is empty when there is no else clause.
fn parseElseBranch(parser Parser) BlockResult {
    match util.currentTokenIs(parser, TOK_ELSE) {
        true:  { return parseElseBranchPresent(parser) }
        _:     {
            let empty Array<AstNode>: []
            let noElse BlockNode: { stmts: empty }
            return { parser: parser, block: noElse }
        }
    }
}

// Consume the `else` token and dispatch to else-if or plain else block.
fn parseElseBranchPresent(parser Parser) BlockResult {
    parser: util.consume(parser, TOK_ELSE)
    match util.currentTokenIs(parser, TOK_IF) {
        true:  { return parseElseIfBranch(parser) }
        _:     { return parseBlock(parser) }
    }
}

// Parse `else if <cond> <block> [else ...]` — wraps the recursive IfNode in a BlockNode.
fn parseElseIfBranch(parser Parser) BlockResult {
    let nested StmtResult: parseIfStmt(parser)
    parser: nested.parser
    let nestedStmt AstNode: nested.stmt
    nested.parser: {}
    nested.stmt:   {}
    drop(nested)
    let elseStmts Array<AstNode>: []
    elseStmts.add(nestedStmt)
    let block BlockNode: { stmts: elseStmts }
    return { parser: parser, block: block }
}

// Parse `if <condition> <thenBlock> [else [if ...] <elseBlock>]`
fn parseIfStmt(parser Parser) StmtResult {
    parser: util.consume(parser, TOK_IF)
    // Parse condition expression
    let cr ParseResult: expr.parseExpr(parser)
    parser: cr.parser
    let cond AstNode: cr.expr
    cr.parser: {}
    cr.expr:   {}
    drop(cr)
    // Parse then branch
    let tbr BlockResult: parseBlock(parser)
    parser: tbr.parser
    let thenBranch BlockNode: tbr.block
    tbr.parser: {}
    tbr.block:  {}
    drop(tbr)
    // Parse optional else / else-if branch
    let ebr BlockResult: parseElseBranch(parser)
    parser: ebr.parser
    let elseBranch BlockNode: ebr.block
    ebr.parser: {}
    ebr.block:  {}
    drop(ebr)
    let n IfNode: { condition: cond, thenBranch: thenBranch, elseBranch: elseBranch }
    return { parser: parser, stmt: n }
}

fn parseReturnStmt(parser Parser) StmtResult {
    parser: util.consume(parser, TOK_RETURN)
    let atEnd Bool: util.currentTokenIs(parser, TOK_RBRACE) or util.currentTokenIs(parser, TOK_EOF)
    match atEnd {
        true: {
            let dummy WildcardNode: {}
            let n ReturnNode: { hasValue: false, value: dummy }
            return { parser: parser, stmt: n }
        }
        _: { return parseReturnValue(parser) }
    }
}

fn parseReturnValue(parser Parser) StmtResult {
    let er ParseResult: expr.parseExpr(parser)
    parser: er.parser
    let val AstNode: er.expr
    er.parser: {}
    er.expr:   {}
    drop(er)
    let n ReturnNode: { hasValue: true, value: val }
    return { parser: parser, stmt: n }
}

fn parseLetStmt(parser Parser) StmtResult {
    parser: util.consume(parser, TOK_LET)
    let nameTok Token: util.currentToken(parser)
    parser: util.consume(parser, TOK_IDENT)
    let tr TypeAnnResult: util.parseTypeAnnotation(parser)
    parser: tr.parser
    let typeName String: tr.typeName
    tr.parser:   {}
    tr.typeName: ""
    drop(tr)
    parser: util.consume(parser, TOK_COLON)
    let er ParseResult: expr.parseExpr(parser)
    parser: er.parser
    let val AstNode: er.expr
    er.parser: {}
    er.expr:   {}
    drop(er)
    let n LetNode: { name: nameTok.text, typeName: typeName, value: val }
    return { parser: parser, stmt: n }
}

fn parseIdentStmt(parser Parser) StmtResult {
    let isAssign Bool: util.peekIs(parser, TOK_COLON)
    return match isAssign {
        true: parseAssignStmt(parser)
        _:    parseIdentExprOrFieldAssign(parser)
    }
}

fn parseAssignStmt(parser Parser) StmtResult {
    let name String: util.currentToken(parser).text
    parser: util.advance(parser)
    parser: util.consume(parser, TOK_COLON)
    let er ParseResult: expr.parseExpr(parser)
    parser: er.parser
    let val AstNode: er.expr
    er.parser: {}
    er.expr:   {}
    drop(er)
    let n AssignNode: { name: name, value: val }
    return { parser: parser, stmt: n }
}

fn parseIdentExprOrFieldAssign(parser Parser) StmtResult {
    let pr ParseResult: expr.parsePostfixChain(parser, expr.parsePrimary(parser))
    parser: pr.parser
    let e AstNode: pr.expr
    pr.parser: {}
    pr.expr:   {}
    drop(pr)
    let isFA Bool: match e { FieldAccessNode: true, _: false }
    let isAssign Bool: isFA and util.currentTokenIs(parser, TOK_COLON)
    match isAssign {
        true: { return parseFieldAssignStmt(parser, e) }
        _: {
            let n ExprStmtNode: { expr: e }
            return { parser: parser, stmt: n }
        }
    }
}

fn parseFieldAssignStmt(parser Parser, fieldExpr AstNode) StmtResult {
    parser: util.consume(parser, TOK_COLON)
    let er ParseResult: expr.parseExpr(parser)
    parser: er.parser
    let val AstNode: er.expr
    er.parser: {}
    er.expr:   {}
    drop(er)
    match fieldExpr {
        FieldAccessNode: {
            let n FieldAssignNode: { receiver: fieldExpr.receiver, fieldName: fieldExpr.fieldName, value: val }
            return { parser: parser, stmt: n }
        }
        _: {
            util.error(parser, "expected field access before ':'")
            let n ExprStmtNode: { expr: fieldExpr }
            return { parser: parser, stmt: n }
        }
    }
}

fn parseExprStmt(parser Parser) StmtResult {
    let er ParseResult: expr.parseExpr(parser)
    parser: er.parser
    let val AstNode: er.expr
    er.parser: {}
    er.expr:   {}
    drop(er)
    let n ExprStmtNode: { expr: val }
    return { parser: parser, stmt: n }
}

fn parse(tokens Array<Token>) AstModule {
    let parser Parser: { pos: 0, tokens: tokens }
    let stmts Array<AstNode>: []
    while not util.currentTokenIs(parser, TOK_EOF) {
        let r StmtResult: parseStatement(parser)
        stmts.add(r.stmt)
        parser: r.parser
        r.stmt:   {}
        r.parser: {}
        drop(r)
    }
    return { stmts: stmts }
}
