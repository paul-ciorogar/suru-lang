// suru-parser-ast.suru — AST node type declarations for the Suru parser.
//
// Provides all struct types and the AstNode sum type used throughout the parser
// and semantic analyzer.  No functions — import this file for type definitions;
// import suru-parser.suru for the parse() entry point.
//
// AstNode variant indices (0-based, in declaration order):
//   Statements:
//   0  FnDeclNode      1  LetNode         2  AssignNode
//   3  FieldAssignNode 4  ReturnNode      5  WhileNode
//   6  ExprStmtNode    7  TypeDeclNode    8  SumTypeDeclNode
//   9  MatchStmtNode   10 BlockNode       11 IfNode
//   Expressions:
//  12  BoolLitNode     13 IntLitNode      14 FloatLitNode
//  15  StrLitNode      16 WildcardNode    17 VarRefNode
//  18  CallNode        19 MethodCallNode  20 FieldAccessNode
//  21  ArrayLitNode    22 StructLitNode   23 MatchExprNode
//  24  UnaryNode       25 BinaryNode      26 CharLitNode
//  27  VtableRefNode   28 ExternFnNode    29 BreakNode
//  30  ContinueNode
//   Namespace/module:
//  31  NamespaceDeclNode  32 ExportNode   33 ImportNode
//  34  QualifiedNameNode
//
// CharLitNode (26), VtableRefNode (27), ExternFnNode (28), BreakNode (29),
// ContinueNode (30), NamespaceDeclNode (31), ExportNode (32), ImportNode (33),
// QualifiedNameNode (34), ExternTypeNode (35), and SizeNode (36) are appended
// LAST: variant tags are derived from declaration order, so appending keeps
// earlier indices stable and the bootstrap fixed point intact. Never insert a
// variant mid-list.
//
// `this` is NOT a distinct variant — the parser emits VarRefNode{name:"this"};
// the method lambda-lift (pipeline.suru) introduces a real `this` param so it
// resolves like any other variable.
//
// Every expression variant (indices 13–27 except WildcardNode, which is
// pattern-only and carries no value) has a trailing `resolvedType String`
// field. The parser writes "" as a sentinel meaning "not yet resolved";
// semantic analysis fills it in via top-down expected-type propagation
// combined with bottom-up inference. Codegen reads `resolvedType` directly
// instead of recomputing types or relying on the surrounding return-type
// context. WildcardNode is intentionally excluded — wildcards are only
// valid as match patterns and never appear in value position.

namespace Suru.Compiler.Parser.Ast

export {
    OP_NOT
    OP_AND
    OP_OR
    Parser
    Param
    MethodSig
    StructFieldNode
    MatchArm
    MatchStmtArm
    ExportEntry
    FullNs
    AliasNs
    SelectiveNames
    SelectiveAliased
    ImportKind
    ImportEntry
    SrcNsEntry
    FnDeclNode
    LetNode
    AssignNode
    FieldAssignNode
    ReturnNode
    WhileNode
    ExprStmtNode
    TypeDeclNode
    SumTypeDeclNode
    MatchStmtNode
    BlockNode
    IfNode
    BoolLitNode
    IntLitNode
    FloatLitNode
    StrLitNode
    WildcardNode
    VarRefNode
    CallNode
    MethodCallNode
    FieldAccessNode
    ArrayLitNode
    StructLitNode
    MatchExprNode
    UnaryNode
    BinaryNode
    CharLitNode
    VtableRefNode
    ExternFnNode
    BreakNode
    ContinueNode
    NamespaceDeclNode
    ExportNode
    ImportNode
    QualifiedNameNode
    SizeNode
    AstNode
    AstModule
}

import {
    Suru.Compiler.Lexer
}

// Operator constants for UnaryNode.op and BinaryNode.op.
let OP_NOT i64: 1
let OP_AND i64: 2
let OP_OR  i64: 3

// ─── Parser state ─────────────────────────────────────────────────────────────

type Parser: {
    fn advance()
    fn currentToken() Token
    fn currentTokenIs(kind i64) bool
    fn peekToken() Token
    fn peekIs(kind i64) bool
    fn peekToken2() Token
    fn peekIs2(kind i64) bool
    fn consume(expectedKind i64)
    fn consumeIf(kind i64)
    fn error(msg String)
    fn parseTypeAnnotation() String
    fn parseStatement() AstNode
    fn parseNamespaceDecl() AstNode
    fn parseExportBlock() AstNode
    fn parseImportBlock() AstNode
    fn parseImportEntry() ImportEntry
    fn parseQualifiedNsPath() String
    fn parseTypeParamList() Array<String>
    fn parseParenParamList() Array<Param>
    fn parseFnDecl() AstNode
    fn parseExternDecl() AstNode
    fn parseExternTypeDecl() AstNode
    fn parseExternFnDecl() AstNode
    fn parseFnReturnType() String
    fn parseTypeDeclaration() AstNode
    fn parseCTypeDeclaration() AstNode
    fn parseStructTypeBody(typeName String, typeParams Array<String>, line i64, col i64) AstNode
    fn parseStructTypeMemberInto(fields Array<Param>, methods Array<MethodSig>)
    fn parseDataFieldInto(fields Array<Param>)
    fn parseMethodSigInto(methods Array<MethodSig>)
    fn parseMethodSigReturn() String
    fn parseSumTypeBody(typeName String, typeParams Array<String>, line i64, col i64) AstNode
    fn parseMatchStatement() AstNode
    fn parseMatchStmtArm() MatchStmtArm
    fn parseMatchStmtArmBlock(pat AstNode, stmts Array<AstNode>) MatchStmtArm
    fn parseMatchStmtArmSimple(pat AstNode, stmts Array<AstNode>) MatchStmtArm
    fn parseMatchStmtArmExprBody(pat AstNode, stmts Array<AstNode>, isWc bool) MatchStmtArm
    fn parseWhileStmt() AstNode
    fn parseBlock() BlockNode
    fn parseElseBranch() BlockNode
    fn parseElseBranchPresent() BlockNode
    fn parseElseIfBranch() BlockNode
    fn parseIfStmt() AstNode
    fn parseReturnStmt() AstNode
    fn parseReturnValue(retTok Token) AstNode
    fn parseBreakStmt() AstNode
    fn parseContinueStmt() AstNode
    fn parseLetStmt() AstNode
    fn parseIdentStmt() AstNode
    fn parseAssignStmt() AstNode
    fn parseIdentExprOrFieldAssign() AstNode
    fn parseFieldAssignStmt(fieldExpr AstNode) AstNode
    fn parseExprStmt() AstNode
    fn parseExpr() AstNode
    fn parseOrExpr() AstNode
    fn parseAndExpr() AstNode
    fn parseNotExpr() AstNode
    fn parseNotExprBody() AstNode
    fn parsePostfixChain(initial AstNode) AstNode
    fn processPostfixStep(expr AstNode) AstNode
    fn parseMethodCallPart(expr AstNode, memberName String, nameTok Token) AstNode
    fn parsePrimary() AstNode
    fn parsePrimaryArray() AstNode
    fn parsePrimaryStruct() AstNode
    fn parseStructLitMemberInto(fields Array<StructFieldNode>)
    fn parseStructLitFieldInto(fields Array<StructFieldNode>)
    fn parseStructLitPrivateFieldInto(fields Array<StructFieldNode>)
    fn parseStructLitMethodInto(fields Array<StructFieldNode>)
    fn parseStructLitPrivateMethodInto(fields Array<StructFieldNode>)
    fn parseStructLitMethodBase(fields Array<StructFieldNode>, isPrivate bool)
    fn parsePrimaryMatch() AstNode
    fn parsePrimaryIdent(tok Token) AstNode
    fn parsePrimaryCall(name String, tok Token) AstNode
    fn parsePrimaryMinus() AstNode
    fn parsePrimaryTypeSize(tok Token) AstNode
    fn parseMatchArm() MatchArm
    fn parseMatchPattern() AstNode
    fn parseNegativePattern() AstNode
    fn parseArgs() Array<AstNode>
    fn parseArgsList() Array<AstNode>
}

// ─── Helper types (not AstNode variants) ──────────────────────────────────────

type Param:          { name String, typeName String }
// MethodSig: a method signature in a `type` body (`fn name(params) Ret`, no body).
type MethodSig:      { name String, params Array<Param>, returnType String }
// StructFieldNode: one member of a `{ ... }` literal.
// Data field: isMethod=false, `value` holds the field expression.
// Method def:  isMethod=true, `name`/`methodParams`/`methodRet`/`methodBody`
//   hold the supplied implementation; `value` is unused until the method
//   lambda-lift (pipeline.suru) rewrites the whole member into a single
//   synthetic `__vtable` data field whose `value` is a VtableRefNode.
// Private member: isPrivate=true means the member is declared with `_ name ...`
//   syntax; it is inaccessible outside the object literal's own method bodies.
//   privateTypeName holds the mandatory type annotation for private data fields
//   (e.g. "i64") so the codegen/semantic layers can add it to the struct layout.
type StructFieldNode: { name String, value AstNode, isMethod bool, isPrivate bool, privateTypeName String, methodParams Array<Param>, methodRet String, methodBody Array<AstNode> }
type MatchArm:       { isWildcard bool, pattern AstNode, body AstNode }
type MatchStmtArm:   { isWildcard bool, pattern AstNode, stmts Array<AstNode> }

// ─── Namespace / export / import helper types ──────────────────────────────────

// ExportEntry: one entry in an `export { ... }` block.
// Plain `name` → both fields equal; `alias: localName` → exportedAs differs.
type ExportEntry: { exportedAs String, localName String }

// ImportKind discriminates the four import syntaxes.
type FullNs:           { }
type AliasNs:          { }
type SelectiveNames:   { }
type SelectiveAliased: { }
type ImportKind: FullNs, AliasNs, SelectiveNames, SelectiveAliased

// ImportEntry: one namespace reference inside an `import { ... }` block.
type ImportEntry: { kind ImportKind, ns String, alias String, names Array<String>, nameAliases Array<ExportEntry> }

// ─── Statement node types (AstNode variants 0–9) ──────────────────────────────

// SrcNsEntry: maps a source file path to its declared namespace.
// Threaded through the pipeline so codegen can namespace-mangle symbols without
// storing a srcPath on every AST node type.
type SrcNsEntry:      { srcPath String, ns String }
type FnDeclNode:      { name String, params Array<Param>, returnType String, body Array<AstNode>, srcPath String, typeParams Array<String>, line i64, col i64 }
// srcPath is "" for local variables; set to the enclosing file path for module-level
// scalar constants by resolveIncludesRec so codegen can namespace-mangle global names.
type LetNode:         { name String, typeName String, value AstNode, line i64, col i64, srcPath String }
type AssignNode:      { name String, value AstNode, line i64, col i64 }
type FieldAssignNode: { receiver AstNode, fieldName String, value AstNode, line i64, col i64 }
type ReturnNode:      { hasValue bool, value AstNode, line i64, col i64 }
type WhileNode:       { condition AstNode, body Array<AstNode>, line i64, col i64 }
type ExprStmtNode:    { expr AstNode }
// TypeDeclNode: a struct/interface type. `fields` are data members; `methods`
// are declared method signatures (empty for a plain data record). `isCType` is
// true for `cType` declarations — header-less, C-ABI-laid-out structs for FFI.
type TypeDeclNode:    { name String, fields Array<Param>, methods Array<MethodSig>, typeParams Array<String>, isCType bool, line i64, col i64 }
type SumTypeDeclNode: { name String, variants Array<String>, typeParams Array<String>, line i64, col i64 }
type MatchStmtNode:   { condition AstNode, arms Array<MatchStmtArm> }
// BlockNode: a brace-delimited sequence of statements.
// Used as the then/else branches of IfNode; stmts empty means the branch is absent.
type BlockNode:       { stmts Array<AstNode> }
// IfNode: if/else if/else statement.
// elseBranch.stmts empty    → no else clause.
// elseBranch.stmts = [IfNode] → else-if chain (recursive).
type IfNode:          { condition AstNode, thenBranch BlockNode, elseBranch BlockNode, line i64, col i64 }
// ExternFnNode: an `extern fn` declaration — a function signature with no body.
// Declares a raw IR function (defined in runtime/*.ll) so Suru call sites can
// resolve its name and type. No typeParams: extern fns are never generic.
// Appended LAST (index 29) — see the header comment on variant ordering.
type ExternFnNode:    { name String, params Array<Param>, returnType String }
// BreakNode / ContinueNode: control flow in while loops. No fields — the keyword
// is the entire statement. Appended LAST (indices 30, 31) to keep prior indices stable.
type BreakNode:       { line i64, col i64 }
type ContinueNode:    { line i64, col i64 }
// ExternTypeNode: `extern type Foo` — an opaque handle type backed by a C pointer.
// No fields or methods; the name is used only for compile-time call-site checking
// and is erased to `ptr` in codegen. Appended LAST (index 36).
type ExternTypeNode:  { name String, line i64, col i64 }

// ─── Expression node types (AstNode variants 13–26) ───────────────────────────

// Each expression node ends with `resolvedType String`.
// Parser initializes it to "" (sentinel for "not resolved"); semantic
// analysis writes the canonical Suru type name (e.g. "i64", "String",
// "Array:Foo", a struct name, or a sum-type name). Codegen reads it
// directly. See the header comment for the rationale.
type BoolLitNode:     { boolVal bool, resolvedType String }
type IntLitNode:      { text String, resolvedType String }
type FloatLitNode:    { text String, resolvedType String }
type StrLitNode:      { text String, resolvedType String }
// WildcardNode is pattern-only and has no value, so no resolvedType.
type WildcardNode:    { }
type VarRefNode:      { name String, line i64, col i64, resolvedType String }
type CallNode:        { name String, args Array<AstNode>, line i64, col i64, resolvedType String }
type MethodCallNode:  { receiver AstNode, methodName String, args Array<AstNode>, line i64, col i64, resolvedType String }
type FieldAccessNode: { receiver AstNode, fieldName String, line i64, col i64, resolvedType String }
type ArrayLitNode:    { elems Array<AstNode>, resolvedType String }
type StructLitNode:   { fields Array<StructFieldNode>, resolvedType String, line i64, col i64 }
type MatchExprNode:   { condition AstNode, arms Array<MatchArm>, line i64, col i64, resolvedType String }
type UnaryNode:       { op i64, operand AstNode, resolvedType String }
type BinaryNode:      { op i64, left AstNode, right AstNode, resolvedType String }
// CharLitNode: a single-quoted char literal. `text` holds the one decoded
// character (same shape as a 1-char StrLitNode); codegen folds it to an i8.
// Declared/appended LAST — see the header comment on variant ordering.
type CharLitNode:     { text String, resolvedType String }
// VtableRefNode: a reference to a module-level vtable constant. Produced only
// by the method lambda-lift (pipeline.suru) as the value of the synthetic
// `__vtable` struct field. `sym` is the LLVM global name (e.g.
// "@vtable.Greeter.0"); `entries` are the mangled lifted-method symbols in the
// type's declared-method order. Codegen emits
// `<sym> = constant [N x ptr] [ptr <e0>, ...]` and stores
// `ptrtoint (ptr <sym> to i64)` into the slot.
// Appended LAST — see the header comment on variant ordering.
type VtableRefNode:   { sym String, entries Array<String>, resolvedType String }

// NamespaceDeclNode: `namespace MyApp.CoolService` declaration.
// Must be the first statement in a file; validated in semantic pass (Task 4).
// Appended LAST (index 32) — see header comment on variant ordering.
type NamespaceDeclNode: { name String, line i64, col i64 }

// ExportNode: `export { Name, alias: LocalName }` block.
// Appended LAST (index 33).
type ExportNode: { entries Array<ExportEntry>, line i64, col i64 }

// ImportNode: `import { … }` block; entries are the parsed ImportEntry list.
// Appended LAST (index 34).
type ImportNode: { entries Array<ImportEntry>, line i64, col i64 }

// QualifiedNameNode: `MyApp.CoolService.doSomething` in expression / type position.
// parts = ["MyApp", "CoolService", "doSomething"].
// Carries resolvedType (expression variant convention).
// Appended LAST (index 35).
type QualifiedNameNode: { parts Array<String>, line i64, col i64, resolvedType String }

// SizeNode: `typeSize(T)` compiler intrinsic returning the element storage size
// of type T as an i64 constant (bool/char=1, i32=4, everything else=8).
// Used in FFI/memory code to compute buffer byte sizes (e.g. malloc(n * typeSize(T))).
// Import from stdlib.ffi before use.
// typeName is the raw parsed type string; monoSubst rewrites it to the concrete
// type during monomorphization so generic functions get the right constant.
// Appended LAST (index 36) — do NOT move or remove (bootstrap stability).
type SizeNode: { typeName String, line i64, col i64, resolvedType String }

// ─── Sum type ──────────────────────────────────────────────────────────────────

type AstNode: FnDeclNode, LetNode, AssignNode, FieldAssignNode, ReturnNode, WhileNode, ExprStmtNode, TypeDeclNode, SumTypeDeclNode, MatchStmtNode, BlockNode, IfNode, BoolLitNode, IntLitNode, FloatLitNode, StrLitNode, WildcardNode, VarRefNode, CallNode, MethodCallNode, FieldAccessNode, ArrayLitNode, StructLitNode, MatchExprNode, UnaryNode, BinaryNode, CharLitNode, VtableRefNode, ExternFnNode, BreakNode, ContinueNode, NamespaceDeclNode, ExportNode, ImportNode, QualifiedNameNode, ExternTypeNode, SizeNode

// ─── Module type ───────────────────────────────────────────────────────────────

type AstModule: { stmts Array<AstNode> }
