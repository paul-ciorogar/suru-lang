// suru-parser-ast.suru — AST node type declarations for the Suru parser.
//
// Provides all struct types and the AstNode sum type used throughout the parser
// and semantic analyzer.  No functions — import this file for type definitions;
// import suru-parser.suru for the parse() entry point.
//
// AstNode variant indices (0-based, in declaration order):
//   Statements:
//   0  IncludeNode     1  FnDeclNode      2  LetNode
//   3  AssignNode      4  FieldAssignNode 5  ReturnNode
//   6  WhileNode       7  ExprStmtNode    8  TypeDeclNode
//   9  SumTypeDeclNode 10 MatchStmtNode   11 BlockNode
//  12  IfNode
//   Expressions:
//  13  BoolLitNode     14 IntLitNode      15 FloatLitNode
//  16  StrLitNode      17 WildcardNode    18 VarRefNode
//  19  CallNode        20 MethodCallNode  21 FieldAccessNode
//  22  ArrayLitNode    23 StructLitNode   24 MatchExprNode
//  25  UnaryNode       26 BinaryNode      27 CharLitNode
//  28  VtableRefNode
//
// CharLitNode (27) then VtableRefNode (28) are appended LAST: variant tags
// are derived from declaration order, so appending keeps indices 0–27 stable
// and the bootstrap fixed point intact. Never insert a variant mid-list.
//
// `this` is NOT a distinct variant — the parser emits VarRefNode{name:"this"};
// the method lambda-lift (pipeline.suru) introduces a real `this` param so it
// resolves like any other variable.
//
// Every expression variant (indices 13–27 except WildcardNode, which is
// pattern-only and carries no value) has a trailing `resolvedType String`
// field. The parser writes "" as a sentinel meaning "not yet resolved";
// semantic analysis fills it in via top-down expected-type propagation
// combined with bottom-up inference. Codegen reads `resolvedType` directly
// instead of recomputing types or relying on the surrounding return-type
// context. WildcardNode is intentionally excluded — wildcards are only
// valid as match patterns and never appear in value position.

include "../lexer/lexer.suru" as lexer

// Operator constants for UnaryNode.op and BinaryNode.op.
let OP_NOT Int64: 1
let OP_AND Int64: 2
let OP_OR  Int64: 3

// ─── Parser state ─────────────────────────────────────────────────────────────

type Parser: { pos Int64, tokens Array<Token> }

// ─── Helper types (not AstNode variants) ──────────────────────────────────────

type Param:          { name String, typeName String }
// MethodSig: a method signature in a `type` body (`fn name(params) Ret`, no body).
type MethodSig:      { name String, params Array<Param>, returnType String }
// StructFieldNode: one member of a `{ ... }` literal.
// Data field: isMethod=false, `value` holds the field expression.
// Method def:  isMethod=true, `name`/`methodParams`/`methodRet`/`methodBody`
//   hold the supplied implementation; `value` is unused until the method
//   lambda-lift (pipeline.suru) rewrites the whole member into a single
//   synthetic `__vtable` data field whose `value` is a VtableRefNode.
type StructFieldNode: { name String, value AstNode, isMethod Bool, methodParams Array<Param>, methodRet String, methodBody Array<AstNode> }
type MatchArm:       { isWildcard Bool, pattern AstNode, body AstNode }
type MatchStmtArm:   { isWildcard Bool, pattern AstNode, stmts Array<AstNode> }

// ─── Statement node types (AstNode variants 0–10) ─────────────────────────────

type IncludeNode:     { path String, ns String }
// One `include "path" as ns` mapping resolved to an absolute path. Shared by
// the include resolver (pipeline.suru) and codegen (irCodegen.suru) so `ns.fn()`
// can be mangled to the callee file's symbol.
type IncludeAlias:    { ns String, srcPath String }
type FnDeclNode:      { name String, params Array<Param>, returnType String, body Array<AstNode>, srcPath String, typeParams Array<String> }
type LetNode:         { name String, typeName String, value AstNode }
type AssignNode:      { name String, value AstNode }
type FieldAssignNode: { receiver AstNode, fieldName String, value AstNode }
type ReturnNode:      { hasValue Bool, value AstNode }
type WhileNode:       { condition AstNode, body Array<AstNode> }
type ExprStmtNode:    { expr AstNode }
// TypeDeclNode: a struct/interface type. `fields` are data members; `methods`
// are declared method signatures (empty for a plain data record).
type TypeDeclNode:    { name String, fields Array<Param>, methods Array<MethodSig>, typeParams Array<String> }
type SumTypeDeclNode: { name String, variants Array<String> }
type MatchStmtNode:   { condition AstNode, arms Array<MatchStmtArm> }
// BlockNode: a brace-delimited sequence of statements.
// Used as the then/else branches of IfNode; stmts empty means the branch is absent.
type BlockNode:       { stmts Array<AstNode> }
// IfNode: if/else if/else statement.
// elseBranch.stmts empty    → no else clause.
// elseBranch.stmts = [IfNode] → else-if chain (recursive).
type IfNode:          { condition AstNode, thenBranch BlockNode, elseBranch BlockNode }

// ─── Expression node types (AstNode variants 13–26) ───────────────────────────

// Each expression node ends with `resolvedType String`.
// Parser initializes it to "" (sentinel for "not resolved"); semantic
// analysis writes the canonical Suru type name (e.g. "Int64", "String",
// "Array:Foo", a struct name, or a sum-type name). Codegen reads it
// directly. See the header comment for the rationale.
type BoolLitNode:     { boolVal Bool, resolvedType String }
type IntLitNode:      { text String, resolvedType String }
type FloatLitNode:    { text String, resolvedType String }
type StrLitNode:      { text String, resolvedType String }
// WildcardNode is pattern-only and has no value, so no resolvedType.
type WildcardNode:    { }
type VarRefNode:      { name String, resolvedType String }
type CallNode:        { name String, args Array<AstNode>, resolvedType String }
type MethodCallNode:  { receiver AstNode, methodName String, args Array<AstNode>, resolvedType String }
type FieldAccessNode: { receiver AstNode, fieldName String, resolvedType String }
type ArrayLitNode:    { elems Array<AstNode>, resolvedType String }
type StructLitNode:   { fields Array<StructFieldNode>, resolvedType String }
type MatchExprNode:   { condition AstNode, arms Array<MatchArm>, resolvedType String }
type UnaryNode:       { op Int64, operand AstNode, resolvedType String }
type BinaryNode:      { op Int64, left AstNode, right AstNode, resolvedType String }
// CharLitNode: a single-quoted char literal. `text` holds the one decoded
// character (same shape as a 1-char StrLitNode); codegen folds it to an i8.
// Declared/appended LAST — see the header comment on variant ordering.
type CharLitNode:     { text String, resolvedType String }
// VtableRefNode: a reference to a module-level vtable constant. Produced only
// by the method lambda-lift (pipeline.suru) as the value of the synthetic
// `__vtable` struct field. `sym` is the LLVM global name (e.g.
// "@vtable.Greeter.0"); `entries` are the mangled lifted-method symbols in the
// type's declared-method order. Codegen emits
// `<sym> = constant [N x ptr] [ptr <e0>, ...]` and stores
// `ptrtoint (ptr <sym> to i64)` into the slot.
// Appended LAST — see the header comment on variant ordering.
type VtableRefNode:   { sym String, entries Array<String>, resolvedType String }

// ─── Sum type ──────────────────────────────────────────────────────────────────

type AstNode: IncludeNode, FnDeclNode, LetNode, AssignNode, FieldAssignNode, ReturnNode, WhileNode, ExprStmtNode, TypeDeclNode, SumTypeDeclNode, MatchStmtNode, BlockNode, IfNode, BoolLitNode, IntLitNode, FloatLitNode, StrLitNode, WildcardNode, VarRefNode, CallNode, MethodCallNode, FieldAccessNode, ArrayLitNode, StructLitNode, MatchExprNode, UnaryNode, BinaryNode, CharLitNode, VtableRefNode

// ─── Module and result types ───────────────────────────────────────────────────

type AstModule:     { stmts Array<AstNode> }
type ParseResult:   { parser Parser, expr AstNode }
type TypeAnnResult: { parser Parser, typeName String }
type RetTypeResult: { parser Parser, returnType String }
type ArgsResult:    { parser Parser, args Array<AstNode> }
type ArmResult:     { parser Parser, arm MatchArm }
type StmtArmResult: { parser Parser, arm MatchStmtArm }
type PatResult:     { parser Parser, pat AstNode }
type StmtResult:      { parser Parser, stmt AstNode }
type BlockResult:     { parser Parser, block BlockNode }
type TypeParamsResult: { parser Parser, typeParams Array<String> }
