// typeOps.suru — structural operations on the structured `Type` value.
//
// This file hosts the canonical operations that compare and transform `Type`
// values (design in semantic_analysis_architecture_rd.md §4.A).
// It begins with the keystone equality test (`equalType`), then `substitute`
// (type-variable replacement); a later task adds `unify` alongside.
//
// `equalType` is the single structural-equality rule for the whole compiler. It
// replaces the per-call-site string comparisons over the three legacy encodings
// (source / colon / hyphen-mangled) — instead of asking "are these two type
// STRINGS the same after I normalize their form?", later phases (the `unify`
// solver, and the `isAssignable` collapse in §3.4) ask "are these two `Type`
// VALUES structurally identical?". Defined once, here.
//
// Own namespace (not Suru.Compiler.Types) for the same reason as typeParse.suru /
// typePrint.suru: the namespace registry (nsRegistry.suru) maps each namespace to
// exactly one file, so two files cannot share a namespace.
//
// Coverage: tests/unit/compiler/typeOpsTest.suru.

namespace Suru.Compiler.Types.Ops

import {
    [Type, Prim, Named, Arr, Var, primType, namedType, arrType, varType]: Suru.Compiler.Types
}

// equalType — structural equality of two `Type` values.
//
// Two types are equal when they have the same shape AND their corresponding
// payloads are equal, recursively:
//   Prim  == Prim   iff names match
//   Named == Named  iff names match AND args match pairwise (same length, same
//                   order — argument position is significant: `Pair<i64, String>`
//                   != `Pair<String, i64>`)
//   Arr   == Arr    iff element types are equal (recursively)
//   Var   == Var    iff both `id` and `name` match (purely structural; the later
//                   `unify` solver keys vars on `id`, but equality compares the
//                   whole value)
// Any shape mismatch (e.g. a bare `Prim "List"` vs an applied `Named "List" []`)
// is unequal — handled by the `_: { return false }` wildcard in each inner match.
//
// Reads only (the unchecked-downcast idiom `let p Prim: a`); no clones, no drops.
export fn equalType(a Type, b Type) bool {
    match a {
        Prim: {
            match b {
                Prim: {
                    let pa Prim: a
                    let pb Prim: b
                    return pa.name.equals(pb.name)
                }
                _: { return false }
            }
        }
        Named: {
            match b {
                Named: {
                    let na Named: a
                    let nb Named: b
                    if not na.name.equals(nb.name) { return false }
                    return equalArgs(na.args, nb.args)
                }
                _: { return false }
            }
        }
        Arr: {
            match b {
                Arr: {
                    let aa Arr: a
                    let ab Arr: b
                    return equalType(aa.elem, ab.elem)
                }
                _: { return false }
            }
        }
        Var: {
            match b {
                Var: {
                    let va Var: a
                    let vb Var: b
                    if not va.id.equals(vb.id) { return false }
                    return va.name.equals(vb.name)
                }
                _: { return false }
            }
        }
    }
}

// equalArgs — element-wise equality of two type-argument lists. Unequal lengths
// short-circuit to false (this is the arity check: `Pair<i64, String>` has two
// args, `Pair<i64>` one). Equal lengths compare each pair by position via
// `equalType`, so a differing or reordered argument makes the lists unequal.
fn equalArgs(xs Array<Type>, ys Array<Type>) bool {
    if not xs.len().equals(ys.len()) { return false }
    let i i64: 0
    while i.lt(xs.len()) {
        if not equalType(xs.at(i), ys.at(i)) { return false }
        i: i.add(1)
    }
    return true
}

// ─── substitute ─────────────────────────────────────────────────────────────────
//
// `substitute` replaces type variables with concrete types throughout a `Type`,
// keyed by variable NAME. It is the structured replacement for the string-based
// `substituteType` in semantic/mono/monoSubst.suru (which pairs a `paramNames`
// array with a `concreteTypes` array); a later task rebuilds that mangler on
// top of this op, and the `unify` solver produces the very bindings fed in
// here.

// Binding — one `var name -> Type` mapping. A list of these (`Array<Binding>`) IS
// the "Bindings" carrier the design names; Suru has no map type and no type-alias
// syntax, so the ordered-list form mirrors `substituteType`'s parallel arrays.
// Lookup is by `name`, so `Var` payloads with no source name (pure inference vars,
// id-keyed) simply never match a binding here.
export type Binding: { name String, ty Type }

// binding — convenience constructor so call sites and tests read clearly:
// `binding("T", parseType("Token"))`.
export fn binding(name String, ty Type) Binding {
    return { name: name, ty: ty }
}

// substitute — return a fresh `Type` with every bound type variable replaced by
// the type it is bound to in `bindings`; everything else is copied unchanged.
//
//   substitute(Var "T", [T -> i64])        -> Prim "i64"
//   substitute(Var "U", [T -> i64])        -> Var "U"            (unbound: unchanged)
//   substitute(List<T>, [T -> Token])      -> List<Token>        (recurses into args)
//   substitute(Pair<T, U>, [T->i64, U->String]) -> Pair<i64, String>
//   substitute(Array<T>, [T -> bool])      -> Array<bool>
//   substitute(i64, anything)              -> i64                (no var: deep copy)
//
// The result is ALWAYS a fresh deep copy — it never aliases `t` or any bound
// `ty` inside `bindings`, so the caller can drop the result and the inputs
// independently with no double-free. This is why every leaf clones its name
// string (`primType`/`namedType`/`varType` store the ref they are handed) and the
// bound-type hit is cloned via a no-op substitution rather than returned directly.
//
// `bindings` is read-only / borrowed (like `substituteType`'s arrays); `bindings.at(i)`
// yields a borrowed `Binding`, so its `ty` is cloned, never moved or dropped.
export fn substitute(t Type, bindings Array<Binding>) Type {
    match t {
        Prim: {
            let p Prim: t
            return primType(p.name.clone())
        }
        Named: {
            let n Named: t
            return namedType(n.name.clone(), substituteArgs(n.args, bindings))
        }
        Arr: {
            let a Arr: t
            return arrType(substitute(a.elem, bindings))
        }
        Var: {
            let v Var: t
            return substituteVar(v, bindings)
        }
    }
}

// substituteVar — resolve a single type variable against `bindings`. On a name
// hit, return a DEEP CLONE of the bound type (cloneType, below) so the result is
// independent of `bindings`. On a miss, rebuild the variable unchanged (fresh
// name string). Single-pass by design: the bound type is copied, NOT re-substituted,
// so a degenerate binding like `T -> T` cannot loop.
fn substituteVar(v Var, bindings Array<Binding>) Type {
    let i i64: 0
    while i.lt(bindings.len()) {
        let b Binding: bindings.at(i)
        if b.name.equals(v.name) { return cloneType(b.ty) }
        i: i.add(1)
    }
    return varType(v.id, v.name.clone())
}

// substituteArgs — map each type argument through `substitute`, building a fresh
// `Array<Type>`. Mirrors `parseArgs`/`equalArgs`: no manual drops, the returned
// array is auto-dropped by the caller's scope.
fn substituteArgs(args Array<Type>, bindings Array<Binding>) Array<Type> {
    let out Array<Type>: []
    let i i64: 0
    while i.lt(args.len()) {
        out.add(substitute(args.at(i), bindings))
        i: i.add(1)
    }
    return out
}

// cloneType — deep-copy a `Type`. Implemented as a substitution with no bindings,
// so it reuses the same fresh-copy walk: nothing matches, every node is rebuilt.
// `empty` is dropped before returning — substitute only borrows it, so leaving it
// undropped leaks a 40-byte array header on every clone (cloneType runs on every
// Var substitution and every bindVar).
fn cloneType(t Type) Type {
    let empty Array<Binding>: []
    let result Type: substitute(t, empty)
    drop(empty)
    return result
}

// ─── varizeType ─────────────────────────────────────────────────────────────────
//
// `parseType` is context-free, so a type parameter like `T` parses to `Prim "T"`,
// indistinguishable from a concrete name. `substitute` only rewrites `Var` nodes
// (it is keyed by variable, not by every bare name), so before substituting a
// generic body's type-parameter names we must first PROMOTE the matching `Prim`
// leaves to `Var`. `varizeType` is that promotion: a `Prim` whose name is one of
// `paramNames` becomes `varType(0, name)` (name-keyed, id unused here); every other
// shape is deep-copied unchanged, recursing into `Named` args and `Arr` elements.
//
//   varizeType(Prim "T",        ["T"]) -> Var  "T"
//   varizeType(Prim "Token",    ["T"]) -> Prim "Token"     (not a param: unchanged)
//   varizeType(List<T>,         ["T"]) -> List<Var "T">    (recurses into args)
//   varizeType(Array<T>,        ["T"]) -> Array<Var "T">
//
// The result is a fresh deep copy (same ownership discipline as `substitute`), so
// `substituteType` can drop it independently of its input. This is the
// same "type params -> Var" primitive Phase 2/3 will reuse when pushing a type-param
// scope on entering a generic body (§4.B).
export fn varizeType(t Type, paramNames Array<String>) Type {
    match t {
        Prim: {
            let p Prim: t
            if isParamName(p.name, paramNames) { return varType(0, p.name.clone()) }
            return primType(p.name.clone())
        }
        Named: {
            let n Named: t
            return namedType(n.name.clone(), varizeArgs(n.args, paramNames))
        }
        Arr: {
            let a Arr: t
            return arrType(varizeType(a.elem, paramNames))
        }
        Var: {
            let v Var: t
            return varType(v.id, v.name.clone())
        }
    }
}

// isParamName — whether `name` is one of the type-parameter names. Linear scan
// mirrors `substituteType`'s parallel-array lookup; the param lists are tiny.
fn isParamName(name String, paramNames Array<String>) bool {
    let i i64: 0
    while i.lt(paramNames.len()) {
        if paramNames.at(i).equals(name) { return true }
        i: i.add(1)
    }
    return false
}

// varizeArgs — map each type argument through `varizeType`, building a fresh list.
// Mirrors `substituteArgs`.
fn varizeArgs(args Array<Type>, paramNames Array<String>) Array<Type> {
    let out Array<Type>: []
    let i i64: 0
    while i.lt(args.len()) {
        out.add(varizeType(args.at(i), paramNames))
        i: i.add(1)
    }
    return out
}

// ─── unify ────────────────────────────────────────────────────────────────────────
//
// `unify` is the keystone op for Phase 2 (design §4.A / §C). It takes a
// PATTERN type — one that may contain type variables (`Var`) — and a (typically
// concrete) type, and SOLVES for the variables: the bindings that, fed to
// `substitute`, make the pattern equal the target. In Phase 2 the resolver unifies a
// callee's parameter/return signature (vars = the generic params) against the
// argument/`expected` types to recover the concrete type arguments of a generic call.
//
// `unify` is the inverse of `substitute`: where `substitute(pattern, bindings)` APPLIES
// a solution, `unify(pattern, target)` FINDS one. By design, for any successful result
// `equalType(substitute(a, unify(a, b).bindings), b)` holds (the tests verify exactly
// this round-trip).
//
// Bindings are NAME-keyed (reusing the §1.5 `Binding`), so the solution drops straight
// into `substitute`. A `Var` is matched on EITHER side, so `unify(Token, ?0)` is
// symmetric to `unify(?0, Token)`. No occurs-check is performed (a degenerate
// `T = List<T>` records `T -> List<T>` rather than diverging) — consistent with
// `substitute`'s single-pass, non-looping stance and sufficient for the well-formed
// signatures the resolver feeds in.

// UnifyResult — the solver's verdict. `ok` is false on any structural conflict (name,
// shape, arity, or an inconsistent re-binding of the same variable); on success
// `bindings` is the name -> Type solution, ready for `substitute`. On failure
// `bindings` holds whatever partial solution had accumulated and should be ignored.
export type UnifyResult: { ok bool, bindings Array<Binding> }

// unify — solve `a` (the pattern) against `b`. Seeds an empty accumulator, runs the
// recursive solver into it, and packages the result. See section header above.
export fn unify(a Type, b Type) UnifyResult {
    let acc Array<Binding>: []
    let ok bool: solveUnify(a, b, acc)
    return { ok: ok, bindings: acc }
}

// solveUnify — recursive solver, accumulating bindings into the shared `acc` (the
// by-reference accumulator pattern used by `collectConcreteSumTypesAt` in
// monoPass.suru — `acc.add(...)` mutates the caller's array). Returns whether the two
// types unify.
//
// A `Var` on EITHER side is bound to the opposing type first (so the var case is
// symmetric); only when both sides are non-vars do the shapes have to match, mirroring
// `equalType`'s structure: `Prim`/`Prim` by name, `Named`/`Named` by name + pairwise
// args, `Arr`/`Arr` by element. Any shape mismatch is a unification failure.
fn solveUnify(a Type, b Type, acc Array<Binding>) bool {
    // Variable on the left: bind it to the whole of `b`.
    match a {
        Var: {
            let va Var: a
            return bindVar(va, b, acc)
        }
        _: {}
    }
    // Variable on the right (and `a` is not a var): bind it to the whole of `a`.
    match b {
        Var: {
            let vb Var: b
            return bindVar(vb, a, acc)
        }
        _: {}
    }
    // Both sides concrete: shapes must match.
    match a {
        Prim: {
            match b {
                Prim: {
                    let pa Prim: a
                    let pb Prim: b
                    return pa.name.equals(pb.name)
                }
                _: { return false }
            }
        }
        Named: {
            match b {
                Named: {
                    let na Named: a
                    let nb Named: b
                    if not na.name.equals(nb.name) { return false }
                    return unifyArgs(na.args, nb.args, acc)
                }
                _: { return false }
            }
        }
        Arr: {
            match b {
                Arr: {
                    let aa Arr: a
                    let ab Arr: b
                    return solveUnify(aa.elem, ab.elem, acc)
                }
                _: { return false }
            }
        }
        Var: { return false }
    }
}

// bindVar — bind type variable `v` (matched in `solveUnify`) to type `t`:
//   - Trivial self-binding (`t` is the very same `Var`): nothing to record, succeed.
//   - Already bound: `v.name` has a binding in `acc`, so `t` must AGREE with it —
//     recursively unify the existing bound type against `t`. This is the consistency
//     check: `Pair<?0, ?0> = Pair<i64, String>` binds T->i64 then unifies i64 vs
//     String, which fails.
//   - Fresh: append `binding(v.name, cloneType(t))`. The deep clone keeps the result
//     independent of `t` (same ownership discipline as `substitute`), so the caller can
//     drop inputs and result separately with no double-free.
fn bindVar(v Var, t Type, acc Array<Binding>) bool {
    // A variable trivially unifies with itself — no binding needed.
    match t {
        Var: {
            let vt Var: t
            if vt.id.equals(v.id) {
                if vt.name.equals(v.name) { return true }
            }
        }
        _: {}
    }
    if hasBinding(acc, v.name) {
        // Already constrained: the new target must agree with the recorded one.
        return solveUnify(lookupBinding(acc, v.name), t, acc)
    }
    acc.add(binding(v.name, cloneType(t)))
    return true
}

// hasBinding — whether `name` is already bound in `acc`. Split from lookupBinding so a
// miss is an honest false rather than a sentinel value the caller must decode.
fn hasBinding(acc Array<Binding>, name String) bool {
    let i i64: 0
    while i.lt(acc.len()) {
        if acc.at(i).name.equals(name) { return true }
        i: i.add(1)
    }
    return false
}

// lookupBinding — return a deep clone of the type bound to `name` in `acc`. Only called
// when `hasBinding` is true, so the trailing fallback (an unreachable empty `Prim`) is a
// formality the type checker requires, never a real result.
fn lookupBinding(acc Array<Binding>, name String) Type {
    let i i64: 0
    while i.lt(acc.len()) {
        let b Binding: acc.at(i)
        if b.name.equals(name) { return cloneType(b.ty) }
        i: i.add(1)
    }
    return primType("")
}

// unifyArgs — unify two type-argument lists element-wise. Unequal lengths fail (arity
// check: `Pair<i64, String>` vs `Pair<i64>`); equal lengths unify each pair by
// position, threading the shared `acc`. Mirrors `equalArgs`.
fn unifyArgs(xs Array<Type>, ys Array<Type>, acc Array<Binding>) bool {
    if not xs.len().equals(ys.len()) { return false }
    let i i64: 0
    while i.lt(xs.len()) {
        if not solveUnify(xs.at(i), ys.at(i), acc) { return false }
        i: i.add(1)
    }
    return true
}
