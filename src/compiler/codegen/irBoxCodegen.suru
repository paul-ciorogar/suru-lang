// ir-box-codegen.suru — Type utilities and Box/Unbox helpers.
//
// Box/unbox functions are called only at the three boundary points where raw
// scalar values must cross the heap boundary:
//   1. printLn / printError — runtime dispatches by type_tag
//   2. Array element store/load — suru_array_add/set/at carry ptr elements
//   3. Struct field store/load — field slots are i64-encoded
//
// All functions thread IrCodegenContext through so the builder (SSA counter +
// accumulated IR text) and the suruDecls accumulator stay consistent.
//
// Include DAG: depends on ir-codegen-types.suru (which includes ir-builder.suru).
// Imported by ir-string-codegen, ir-array-codegen, ir-struct-codegen,
// ir-fileio-codegen, ir-type-clone-drop-codegen, and ir-codegen.

namespace Suru.Compiler.Codegen.Box

export {
    llvmTypeOf
    isScalarType
    rawLlvmTypeOf
    defaultReturnValue
    ctxNextTmp
    boxBool
    boxInt32
    boxChar
    boxInt64
    boxFloat64
    boxValue
    unboxBool
    unboxInt32
    unboxChar
    unboxInt64
    unboxFloat64
    unboxScalar
}

import { types: Suru.Compiler.Codegen.Types }
import { tyh: Suru.Compiler.Codegen.TypeHelpers }
import { ir: Suru.Compiler.Codegen.Builder }

// ─── Type utility functions ───────────────────────────────────────────────────
// Thin wrappers over the equivalents in ir-codegen-types.suru, provided here so
// higher-level files only need to include ir-box-codegen to get everything.

// LLVM type string for a Suru type name.
// Scalars → raw LLVM types; all heap types and void → "ptr".
fn llvmTypeOf(suruType String) String {
    return tyh.irLlvmTypeOf(suruType)
}

// True for the four scalar types that use raw LLVM values (not heap ptr).
fn isScalarType(suruType String) bool {
    return tyh.isScalarSuruType(suruType)
}

// LLVM type for arithmetic/comparison operands.
// NamedType (unknown struct field) falls back to "i64" — assumed Box<i64>
// at runtime, consistent with UnboxScalar's NamedType arm.
fn rawLlvmTypeOf(suruType String) String {
    return match suruType {
        "bool":    "i1"
        "i32":   "i32"
        "char":    "i8"
        "i64":   "i64"
        "f64": "double"
        _:         "ptr"
    }
}

// Zero-value constant for implicit/fallback returns.
fn defaultReturnValue(suruType String) String {
    return match suruType {
        "bool":    "0"
        "i32":   "0"
        "char":    "0"
        "i64":   "0"
        "f64": "0.0"
        _:         "null"
    }
}

// ─── SSA counter access ───────────────────────────────────────────────────────

// Allocate the next SSA temporary name (%tN) from ctx.builder, advancing tmpCount.
// Used when callers need a fresh name without going through ir.emitCall —
// e.g. when manually constructing a GEP or alloca line via ir.emit.
fn ctxNextTmp(ctx IrCodegenContext) CodegenResult {
    let r IrResult: ir.nextTmp(ctx.builder)
    ctx.builder: r.builder
    return { ctx: ctx, name: r.name, llvmType: "", suruType: "" }
}

// ─── Box helpers ──────────────────────────────────────────────────────────────
// Each helper adds the declare stub (idempotent) and emits the call instruction.

// Box a raw i1 bool into a heap ptr.
fn boxBool(ctx IrCodegenContext, val String) CodegenResult {
    ctx: types.addSuruDecl(ctx, "declare ptr  @suru_box_bool(i1)\n")
    let args Array<String>: []
    args.add("i1 ".append(val))
    let r IrResult: ir.emitCall(ctx.builder, "ptr", "suru_box_bool", args)
    ctx.builder: r.builder
    return { ctx: ctx, name: r.name, llvmType: "ptr", suruType: "bool" }
}

// Box a raw i32 into a heap ptr.
fn boxInt32(ctx IrCodegenContext, val String) CodegenResult {
    ctx: types.addSuruDecl(ctx, "declare ptr  @suru_box_int32(i32)\n")
    let args Array<String>: []
    args.add("i32 ".append(val))
    let r IrResult: ir.emitCall(ctx.builder, "ptr", "suru_box_int32", args)
    ctx.builder: r.builder
    return { ctx: ctx, name: r.name, llvmType: "ptr", suruType: "i32" }
}

// Box a raw i8 char into a heap ptr.
fn boxChar(ctx IrCodegenContext, val String) CodegenResult {
    ctx: types.addSuruDecl(ctx, "declare ptr  @suru_box_char(i8)\n")
    let args Array<String>: []
    args.add("i8 ".append(val))
    let r IrResult: ir.emitCall(ctx.builder, "ptr", "suru_box_char", args)
    ctx.builder: r.builder
    return { ctx: ctx, name: r.name, llvmType: "ptr", suruType: "char" }
}

// Box a raw i64 into a heap ptr.
fn boxInt64(ctx IrCodegenContext, val String) CodegenResult {
    ctx: types.addSuruDecl(ctx, "declare ptr  @suru_box_int64(i64)\n")
    let args Array<String>: []
    args.add("i64 ".append(val))
    let r IrResult: ir.emitCall(ctx.builder, "ptr", "suru_box_int64", args)
    ctx.builder: r.builder
    return { ctx: ctx, name: r.name, llvmType: "ptr", suruType: "i64" }
}

// Box a raw double into a heap ptr.
fn boxFloat64(ctx IrCodegenContext, val String) CodegenResult {
    ctx: types.addSuruDecl(ctx, "declare ptr  @suru_box_float64(double)\n")
    let args Array<String>: []
    args.add("double ".append(val))
    let r IrResult: ir.emitCall(ctx.builder, "ptr", "suru_box_float64", args)
    ctx.builder: r.builder
    return { ctx: ctx, name: r.name, llvmType: "ptr", suruType: "f64" }
}

// Dispatch to the appropriate box helper based on suruType.
// Non-scalar types (String/Array/NamedType) carry their own type_tag and need
// no boxing — val is returned as-is.
fn boxValue(ctx IrCodegenContext, val String, suruType String) CodegenResult {
    match suruType {
        "bool":    { return boxBool(ctx, val) }
        "i32":   { return boxInt32(ctx, val) }
        "char":    { return boxChar(ctx, val) }
        "i64":   { return boxInt64(ctx, val) }
        "f64": { return boxFloat64(ctx, val) }
        _: {}
    }
    return { ctx: ctx, name: val, llvmType: "ptr", suruType: suruType }
}

// ─── Unbox helpers ────────────────────────────────────────────────────────────

// Unbox a heap ptr into a raw i1 bool.
fn unboxBool(ctx IrCodegenContext, ptr String) CodegenResult {
    ctx: types.addSuruDecl(ctx, "declare i1   @suru_unbox_bool(ptr)\n")
    let args Array<String>: []
    args.add("ptr ".append(ptr))
    let r IrResult: ir.emitCall(ctx.builder, "i1", "suru_unbox_bool", args)
    ctx.builder: r.builder
    return { ctx: ctx, name: r.name, llvmType: "i1", suruType: "bool" }
}

// Unbox a heap ptr into a raw i32.
fn unboxInt32(ctx IrCodegenContext, ptr String) CodegenResult {
    ctx: types.addSuruDecl(ctx, "declare i32  @suru_unbox_int32(ptr)\n")
    let args Array<String>: []
    args.add("ptr ".append(ptr))
    let r IrResult: ir.emitCall(ctx.builder, "i32", "suru_unbox_int32", args)
    ctx.builder: r.builder
    return { ctx: ctx, name: r.name, llvmType: "i32", suruType: "i32" }
}

// Unbox a heap ptr into a raw i8 char.
fn unboxChar(ctx IrCodegenContext, ptr String) CodegenResult {
    ctx: types.addSuruDecl(ctx, "declare i8   @suru_unbox_char(ptr)\n")
    let args Array<String>: []
    args.add("ptr ".append(ptr))
    let r IrResult: ir.emitCall(ctx.builder, "i8", "suru_unbox_char", args)
    ctx.builder: r.builder
    return { ctx: ctx, name: r.name, llvmType: "i8", suruType: "char" }
}

// Unbox a heap ptr into a raw i64.
fn unboxInt64(ctx IrCodegenContext, ptr String) CodegenResult {
    ctx: types.addSuruDecl(ctx, "declare i64  @suru_unbox_int64(ptr)\n")
    let args Array<String>: []
    args.add("ptr ".append(ptr))
    let r IrResult: ir.emitCall(ctx.builder, "i64", "suru_unbox_int64", args)
    ctx.builder: r.builder
    return { ctx: ctx, name: r.name, llvmType: "i64", suruType: "i64" }
}

// Unbox a heap ptr into a raw double.
fn unboxFloat64(ctx IrCodegenContext, ptr String) CodegenResult {
    ctx: types.addSuruDecl(ctx, "declare double @suru_unbox_float64(ptr)\n")
    let args Array<String>: []
    args.add("ptr ".append(ptr))
    let r IrResult: ir.emitCall(ctx.builder, "double", "suru_unbox_float64", args)
    ctx.builder: r.builder
    return { ctx: ctx, name: r.name, llvmType: "double", suruType: "f64" }
}

// Dispatch to the appropriate unbox helper based on suruType.
// NamedType (unknown struct field returned dynamically) is assumed to be a
// Box<i64> at runtime.
// Called only for scalar types — caller must not pass String/Array/void.
fn unboxScalar(ctx IrCodegenContext, ptr String, suruType String) CodegenResult {
    return match suruType {
        "bool":    unboxBool(ctx, ptr)
        "i32":   unboxInt32(ctx, ptr)
        "char":    unboxChar(ctx, ptr)
        "i64":   unboxInt64(ctx, ptr)
        "f64": unboxFloat64(ctx, ptr)
        _:         unboxInt64(ctx, ptr)
    }
}
