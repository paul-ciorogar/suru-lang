// irCodegenTypeHelpers.suru — Pure functions over Suru type-name strings.
//
// No IrCodegenContext dependency; no state. Operates entirely on the suruType
// encoding documented in irCodegenTypes.suru:
//   scalars:    "Int64" | "Bool" | "Int32" | "Float64"
//   strings:    "String"
//   arrays:     "Array:" + elemSuruType
//   structs:    the declared type name
//
// Include DAG: leaf. Imported by irBoxCodegen.suru and everything above it.

// True for the four scalar types that use raw LLVM values (not ptr).
fn isScalarSuruType(suruType String) Bool {
    return match suruType {
        "Int64"   : true
        "Bool"    : true
        "Int32"   : true
        "Float64" : true
        "Char"    : true
        _ : false
    }
}

// True when suruType encodes an array (e.g. "Array:Int64", "Array:Lvl1").
fn isArraySuruType(suruType String) Bool {
    match suruType.len().lt(6) { true: { return false } _: {} }
    return suruType.slice(0, 6).equals("Array:")
}

// Extract the element Suru type from an array suruType like "Array:Int64" → "Int64".
fn elemSuruType(suruType String) String {
    return suruType.slice(6, suruType.len())
}

// True when a type annotation string names an Array (e.g. "Array<Int64>").
// Must check for "Array<" (with angle bracket) to avoid matching user-defined
// types whose names begin with "Array" (e.g. ArrayLitNode).
fn isArrayTypeName(typeName String) Bool {
    match typeName.len().lt(6) { true: { return false } _: {} }
    return typeName.slice(0, 6).equals("Array<")
}

// Extract the element type from a generic type annotation: "Array<Int64>" → "Int64".
fn extractElemType(typeName String) String {
    let i Int64: 0
    let start Int64: -1
    while i.lt(typeName.len()) {
        match typeName.at(i).equals("<") { true: { start: i } _: {} }
        i: i.add(1)
    }
    match start.equals(-1) { true: { return "" } _: {} }
    return typeName.slice(start.add(1), typeName.len().take(1))
}

// ─── User-defined generic type-name mangling ─────────────────────────────────
// Map annotations like "Box<Int64>" to their mangled suruType "Box__Int64" so
// that codegen's type-registry lookup finds the concrete TypeDeclNode injected
// by the mono pass.  (These helpers duplicate the equivalent logic in passes.suru
// because irCodegenTypeHelpers.suru is a leaf with no semantic includes.)

// indexOfAngleCG — index of the first '<' in s, or s.len() when absent.
fn indexOfAngleCG(s String) Int64 {
    let i Int64: 0
    while i.lt(s.len()) {
        match s.at(i).equals("<") { true: { return i } _: {} }
        i: i.add(1)
    }
    return s.len()
}

// ltrimCG — strip leading ASCII space characters from s.
fn ltrimCG(s String) String {
    let i Int64: 0
    while i.lt(s.len()) {
        match s.slice(i, i.add(1)).equals(" ") {
            true: {}
            _:    { return s.slice(i, s.len()) }
        }
        i: i.add(1)
    }
    return ""
}

// appendMangledCGAt — scan inner[i..] for comma-separated type args and append
// "__<arg>" for each to acc.
fn appendMangledCGAt(inner String, start Int64, i Int64, acc String) String {
    match i.lt(inner.len()) {
        _: {
            let seg String: ltrimCG(inner.slice(start, inner.len()))
            return acc.append("__").append(seg)
        }
        true: {}
    }
    match inner.at(i).equals(",") {
        true: {
            let seg String: ltrimCG(inner.slice(start, i))
            return appendMangledCGAt(inner, i.add(1), i.add(1), acc.append("__").append(seg))
        }
        _: {}
    }
    return appendMangledCGAt(inner, start, i.add(1), acc)
}

// isUserGenericTypeName — true when typeName has a '<' but is not the builtin
// "Array<...>" form.  Catches user-defined generics like "Box<Int64>".
fn isUserGenericTypeName(typeName String) Bool {
    match isArrayTypeName(typeName) { true: { return false } _: {} }
    let i Int64: 0
    while i.lt(typeName.len()) {
        match typeName.at(i).equals("<") { true: { return true } _: {} }
        i: i.add(1)
    }
    return false
}

// mangleGenericAnnotation — "Box<Int64>" → "Box__Int64".
fn mangleGenericAnnotation(typeName String) String {
    let ltIdx Int64: indexOfAngleCG(typeName)
    let base String: typeName.slice(0, ltIdx)
    let inner String: typeName.slice(ltIdx.add(1), typeName.len().take(1))
    return appendMangledCGAt(inner, 0, 0, base)
}

// Convert a Suru type annotation name to the suruType encoding used in VarEntry.
// "Array<Int64>" → "Array:Int64"; user-defined generics "Box<Int64>" → "Box__Int64";
// all other types pass through unchanged.
fn makeSuruType(typeName String) String {
    match isArrayTypeName(typeName) {
        true: { return "Array:".append(extractElemType(typeName)) }
        _: {}
    }
    match isUserGenericTypeName(typeName) {
        true: { return mangleGenericAnnotation(typeName) }
        _: {}
    }
    return typeName
}

// LLVM type string for a Suru type name.
// Scalars use raw LLVM types; all heap types and void use ptr.
fn irLlvmTypeOf(suruType String) String {
    // Void functions return `ret ptr null` per Suru's IR convention.
    return match suruType {
        "void":     "ptr"
        "Int64":    "i64"
        "Bool":     "i1"
        "Int32":    "i32"
        "Char":     "i8"
        "Float64":  "double"
        _:          "ptr"
    }
}

// Integer type_tag for a Suru type (used for array elem_tag and struct type_tag).
// Values must stay in sync with the Suru runtime's type_tag encoding.
fn suruTypeTag(suruType String) String {
    match isArraySuruType(suruType) { true: { return "5" } _: {} }
    return match suruType {
        "Bool":    "0"
        "Int32":   "1"
        "Int64":   "2"
        "Float64": "3"
        "String":  "6"
        "Char":    "9"
        _:         "4"
    }
}

// True when name is one of the six builtin Suru type names (or a generic array).
fn isBuiltinSuruType(name String) Bool {
    match isArrayTypeName(name) { true: { return true } _: {} }
    return match name {
        "Int64":   true
        "Bool":    true
        "Int32":   true
        "Float64": true
        "Char":    true
        "String":  true
        _:         false
    }
}
