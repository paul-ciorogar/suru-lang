// irCodegenTypeHelpers.suru — Pure functions over Suru type-name strings.
//
// No IrCodegenContext dependency; no state. Operates entirely on the suruType
// encoding documented in irCodegenTypes.suru:
//   scalars:    "i64" | "bool" | "i32" | "f64"
//   strings:    "String"
//   arrays:     "Array:" + elemSuruType
//   structs:    the declared type name
//
// Include DAG: leaf. Imported by irBoxCodegen.suru and everything above it.

namespace Suru.Compiler.Codegen.TypeHelpers

export {
    isScalarSuruType
    isArraySuruType
    elemSuruType
    isArrayTypeName
    extractElemType
    indexOfAngleCG
    ltrimCG
    flattenCGTypeArg
    appendMangledCGAt
    isUserGenericTypeName
    mangleGenericAnnotation
    normalizeTypeName
    makeSuruType
    irLlvmTypeOf
    suruTypeTag
    isBuiltinSuruType
    isStringType
    flatSuruName
    heapCloneSym
    heapDropSym
}

// True for the four scalar types that use raw LLVM values (not ptr).
fn isScalarSuruType(suruType String) bool {
    return match suruType {
        "i64"   : true
        "bool"    : true
        "i32"   : true
        "f64" : true
        "char"    : true
        _ : false
    }
}

// True for the string family: owned heap `String` and borrowed static `Str`.
// Both share the %suru.String layout and all read-only operations; they differ
// only in ownership/drop (Str = no-op, String = free) and in that a `Str` flowing
// into a `String` slot is materialized (heap-cloned). Central helper so the 15+
// scattered string checks stay in sync as the split lands.
fn isStringType(suruType String) bool {
    return suruType.equals("String") or suruType.equals("Str")
}

// True when suruType encodes an array (e.g. "Array:i64", "Array:Lvl1").
fn isArraySuruType(suruType String) bool {
    if suruType.len().lt(6) { return false }
    return suruType.slice(0, 6).equals("Array:")
}

// Extract the element Suru type from an array suruType like "Array:i64" → "i64".
fn elemSuruType(suruType String) String {
    return suruType.slice(6, suruType.len())
}

// True when a type annotation string names an Array (e.g. "Array<i64>").
// Must check for "Array<" (with angle bracket) to avoid matching user-defined
// types whose names begin with "Array" (e.g. ArrayLitNode).
fn isArrayTypeName(typeName String) bool {
    if typeName.len().lt(6) { return false }
    return typeName.slice(0, 6).equals("Array<")
}

// Extract the element type from a generic type annotation: "Array<i64>" → "i64".
// Uses the FIRST '<' and the final '>' so nested generics keep their inner
// brackets intact: "Array<Array<i64>>" → "Array<i64>" (not "i64>").
fn extractElemType(typeName String) String {
    let i i64: 0
    let start i64: -1
    while i.lt(typeName.len()) {
        if typeName.at(i).equals("<") {
            if start.equals(-1) { start: i }
        }
        i: i.add(1)
    }
    if start.equals(-1) { return "" }
    return typeName.slice(start.add(1), typeName.len().take(1))
}

// ─── User-defined generic type-name mangling ─────────────────────────────────
// Map annotations like "Box<i64>" to their mangled suruType "Box-i64" so
// that codegen's type-registry lookup finds the concrete TypeDeclNode injected
// by the mono pass.  (These helpers duplicate the equivalent logic in passes.suru
// because irCodegenTypeHelpers.suru is a leaf with no semantic includes.)

// indexOfAngleCG — index of the first '<' in s, or s.len() when absent.
fn indexOfAngleCG(s String) i64 {
    let i i64: 0
    while i.lt(s.len()) {
        if s.at(i).equals("<") { return i }
        i: i.add(1)
    }
    return s.len()
}

// ltrimCG — strip leading ASCII space characters from s.
fn ltrimCG(s String) String {
    let i i64: 0
    while i.lt(s.len()) {
        if not s.slice(i, i.add(1)).equals(" ") { return s.slice(i, s.len()) }
        i: i.add(1)
    }
    return ""
}

// flattenCGTypeArg — recursively flatten a type-name string to an
// identifier-safe form, using the same conventions as monoInstantiate's
// flattenTypeArg (duplicated here because irCodegenTypeHelpers.suru is a leaf).
//   "Array<i64>"          → "Array-i64"
//   "Option<i64>"         → "Option-i64"
//   "Option<Array<i64>>"  → "Option-Array-i64"
//   plain names             → trimmed clone
fn flattenCGTypeArg(typeName String) String {
    let trimmed String: ltrimCG(typeName)
    let ltIdx i64: indexOfAngleCG(trimmed)
    if ltIdx.equals(trimmed.len()) { return trimmed }
    let base String: trimmed.slice(0, ltIdx)
    let inner String: trimmed.slice(ltIdx.add(1), trimmed.len().take(1))
    let acc String: base
    let start i64: 0
    let i i64: 0
    while i.lt(inner.len()) {
        if inner.at(i).equals(",") {
            let seg String: flattenCGTypeArg(inner.slice(start, i))
            let next String: acc.append("-").append(seg)
            drop(seg)
            drop(acc)
            acc: next
            i: i.add(1)
            start: i
        } else {
            i: i.add(1)
        }
    }
    let seg String: flattenCGTypeArg(inner.slice(start, inner.len()))
    let result String: acc.append("-").append(seg)
    drop(seg)
    drop(acc)
    return result
}

// appendMangledCGAt — scan inner[i..] for comma-separated type args and append
// "-<flattenCGTypeArg(arg)>" for each to acc, so nested generic names like
// "Array<i64>" are flattened to "Array-i64" in the resulting identifier.
fn appendMangledCGAt(inner String, start i64, acc String) String {
    let i i64: start
    while i.lt(inner.len()) {
        if inner.at(i).equals(",") {
            let seg String: flattenCGTypeArg(inner.slice(start, i))
            let next String: acc.append("-").append(seg)
            drop(seg)
            drop(acc)
            acc: next
            i: i.add(1)
            start: i
        } else {
            i: i.add(1)
        }
    }
    let seg String: flattenCGTypeArg(inner.slice(start, inner.len()))
    let result String: acc.append("-").append(seg)
    drop(seg)
    drop(acc)
    return result
}

// isUserGenericTypeName — true when typeName has a '<' but is not the builtin
// "Array<...>" form.  Catches user-defined generics like "Box<i64>".
fn isUserGenericTypeName(typeName String) bool {
    if isArrayTypeName(typeName) { return false }
    let i i64: 0
    while i.lt(typeName.len()) {
        if typeName.at(i).equals("<") { return true }
        i: i.add(1)
    }
    return false
}

// mangleGenericAnnotation — "Box<i64>" → "Box-i64".
fn mangleGenericAnnotation(typeName String) String {
    let ltIdx i64: indexOfAngleCG(typeName)
    let base String: typeName.slice(0, ltIdx)
    let inner String: typeName.slice(ltIdx.add(1), typeName.len().take(1))
    return appendMangledCGAt(inner, 0, base)
}

// normalizeTypeName is now a no-op: all type names are already lowercase.
// Kept as a call site so the bootstrap transition compiles cleanly.
fn normalizeTypeName(name String) String {
    return name
}

// Convert a Suru type annotation name to the suruType encoding used in VarEntry.
// "Array<i64>" → "Array:i64"; user-defined generics "Box<i64>" → "Box-i64";
// all other types pass through unchanged.
fn makeSuruType(typeName String) String {
    // Recurse on the element so nested arrays canonicalize fully:
    // "Array<Array<i64>>" → "Array:Array:i64" (consistent colon encoding).
    if isArrayTypeName(typeName) { return "Array:".append(makeSuruType(extractElemType(typeName))) }
    if isUserGenericTypeName(typeName) { return mangleGenericAnnotation(typeName) }
    return typeName
}

// LLVM type string for a Suru type name.
// Scalars use raw LLVM types; all heap types and void use ptr.
fn irLlvmTypeOf(suruType String) String {
    // Void functions return `ret ptr null` per Suru's IR convention.
    return match suruType {
        "void":     "ptr"
        "i64":    "i64"
        "bool":     "i1"
        "i32":    "i32"
        "char":     "i8"
        "f64":  "double"
        "ptr":      "ptr"
        _:          "ptr"
    }
}

// Integer type_tag for a Suru type (used for array elem_tag and struct type_tag).
// Values must stay in sync with the Suru runtime's type_tag encoding.
fn suruTypeTag(suruType String) String {
    if isArraySuruType(suruType) { return "5" }
    if suruType.equals("Str") { return "8" }
    return match suruType {
        "bool":    "0"
        "i32":   "1"
        "i64":   "2"
        "f64": "3"
        "String":  "6"
        "char":    "9"
        _:         "4"
    }
}

// True when name is one of the builtin Suru type names (or a generic array).
fn isBuiltinSuruType(name String) bool {
    if isArrayTypeName(name) { return true }
    return match name {
        "i64":   true
        "bool":  true
        "i32":   true
        "f64":   true
        "char":  true
        "String":  true
        "Str":     true
        _:         false
    }
}

// ─── Static clone/drop symbol naming ──────────────────────────────────────────
// After monomorphization the element/field type of every heap value is known
// statically, so codegen emits a direct call to a named clone/drop function
// instead of routing through the type-tag dispatchers. These helpers compute the
// bare symbol name (no leading '@') for a given heap suruType.

// Make an array-element suruType into an identifier-safe flat fragment by
// replacing the "Array:" separator ':' with '-': "Array:i64" → "Array-i64".
// Scalars / "String" / already-mangled struct names contain no ':' and pass
// through unchanged.
fn flatSuruName(suruType String) String {
    let out String: ""
    let i i64: 0
    while i.lt(suruType.len()) {
        let c String: suruType.slice(i, i.add(1))
        let piece String: match c.equals(":") { true: "-", _: c }
        let next String: out.append(piece)
        drop(out)
        out: next
        drop(c)
        i: i.add(1)
    }
    return out
}

// Bare symbol name to clone a heap value of the given suruType:
//   "Array:T"  → "suru_array_clone_<flat(T)>"  (per-element-type wrapper)
//   "String"   → "suru_string_clone"
//   struct/var → "suru_clone_via_vtable"  (null-safe trampoline through the
//                value's own clone_fn — uniform for plain structs and variants,
//                where the concrete arm is only known per-value, not statically)
// Callers must guard scalars (no clone call) before calling this.
fn heapCloneSym(suruType String) String {
    if isArraySuruType(suruType) {
        return "suru_array_clone_".append(flatSuruName(elemSuruType(suruType)))
    }
    if isStringType(suruType) { return "suru_string_clone" }
    return "suru_clone_via_vtable"
}

// Bare symbol name to drop a heap value of the given suruType (see heapCloneSym).
fn heapDropSym(suruType String) String {
    if isArraySuruType(suruType) {
        return "suru_array_drop_".append(flatSuruName(elemSuruType(suruType)))
    }
    if isStringType(suruType) { return "suru_string_drop" }
    return "suru_drop_via_vtable"
}
