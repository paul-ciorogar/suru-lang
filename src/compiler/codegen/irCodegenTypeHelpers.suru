// irCodegenTypeHelpers.suru — Pure functions over Suru type-name strings.
//
// No IrCodegenContext dependency; no state. Operates entirely on the suruType
// encoding documented in irCodegenTypes.suru:
//   scalars:    "i64" | "bool" | "i32" | "f64"
//   strings:    "String"
//   arrays:     "Array:" + elemSuruType
//   structs:    the declared type name
//
// Include DAG: near-leaf. Imported by irBoxCodegen.suru and everything above it;
// depends only on the foundational types/ tree (Type + parse/print), which imports
// nothing from codegen — so no cycle.

namespace Suru.Compiler.Codegen.TypeHelpers

import {
    [Type]: Suru.Compiler.Types
    [parseType]: Suru.Compiler.Types.Parse
    [printSuruType]: Suru.Compiler.Types.Print
}

// True for the four scalar types that use raw LLVM values (not ptr).
export fn isScalarSuruType(suruType String) bool {
    return match suruType {
        "i64"   : true
        "bool"    : true
        "i32"   : true
        "f64" : true
        "char"    : true
        _ : false
    }
}

// True for the string family: owned heap `String` and borrowed static `Str`.
// Both share the %suru.String layout and all read-only operations; they differ
// only in ownership/drop (Str = no-op, String = free) and in that a `Str` flowing
// into a `String` slot is materialized (heap-cloned). Central helper so the 15+
// scattered string checks stay in sync as the split lands.
export fn isStringType(suruType String) bool {
    return suruType.equals("String") or suruType.equals("Str")
}

// True when suruType encodes an array (e.g. "Array:i64", "Array:Lvl1").
export fn isArraySuruType(suruType String) bool {
    if suruType.len().lt(6) { return false }
    return suruType.slice(0, 6).equals("Array:")
}

// Extract the element Suru type from an array suruType like "Array:i64" → "i64".
export fn elemSuruType(suruType String) String {
    return suruType.slice(6, suruType.len())
}

// True when a type annotation string names an Array (e.g. "Array<i64>").
// Must check for "Array<" (with angle bracket) to avoid matching user-defined
// types whose names begin with "Array" (e.g. ArrayLitNode).
export fn isArrayTypeName(typeName String) bool {
    if typeName.len().lt(6) { return false }
    return typeName.slice(0, 6).equals("Array<")
}

// Extract the element type from a generic type annotation: "Array<i64>" → "i64".
// Uses the FIRST '<' and the final '>' so nested generics keep their inner
// brackets intact: "Array<Array<i64>>" → "Array<i64>" (not "i64>").
export fn extractElemType(typeName String) String {
    let i i64: 0
    let start i64: -1
    while i.lt(typeName.len()) {
        if typeName.at(i).equals("<") {
            if start.equals(-1) { start: i }
        }
        i: i.add(1)
    }
    if start.equals(-1) { return "" }
    return typeName.slice(start.add(1), typeName.len().take(1))
}

// normalizeTypeName is now a no-op: all type names are already lowercase.
// Kept as a call site so the bootstrap transition compiles cleanly.
fn normalizeTypeName(name String) String {
    return name
}

// Convert a Suru type annotation name to the suruType encoding used in VarEntry.
// "Array<i64>" → "Array:i64"; user-defined generics "Box<i64>" → "Box-i64";
// all other types pass through unchanged.
//
// Implemented as parse→print over the structured `Type` (task 1.7): parseType reads
// the source/colon form at the boundary, printSuruType emits the legacy suruType
// encoding (colon arrays, hyphen generics). This replaces the old hand-rolled string
// munging with no behavior change on any real input.
export fn makeSuruType(typeName String) String {
    let t Type: parseType(typeName)
    let out String: printSuruType(t)
    drop(t)
    return out
}

// LLVM type string for a Suru type name.
// Scalars use raw LLVM types; all heap types and void use ptr.
export fn irLlvmTypeOf(suruType String) String {
    // Void functions return `ret ptr null` per Suru's IR convention.
    return match suruType {
        "void":     "ptr"
        "i64":    "i64"
        "bool":     "i1"
        "i32":    "i32"
        "char":     "i8"
        "f64":  "double"
        "ptr":      "ptr"
        _:          "ptr"
    }
}

// Integer type_tag for a Suru type (used for array elem_tag and struct type_tag).
// Values must stay in sync with the Suru runtime's type_tag encoding.
export fn suruTypeTag(suruType String) String {
    if isArraySuruType(suruType) { return "5" }
    if suruType.equals("Str") { return "8" }
    return match suruType {
        "bool":    "0"
        "i32":   "1"
        "i64":   "2"
        "f64": "3"
        "String":  "6"
        "char":    "9"
        _:         "4"
    }
}

// True when name is one of the builtin Suru type names (or a generic array).
export fn isBuiltinSuruType(name String) bool {
    if isArrayTypeName(name) { return true }
    return match name {
        "i64":   true
        "bool":  true
        "i32":   true
        "f64":   true
        "char":  true
        "String":  true
        "Str":     true
        _:         false
    }
}

// ─── Static clone/drop symbol naming ──────────────────────────────────────────
// After monomorphization the element/field type of every heap value is known
// statically, so codegen emits a direct call to a named clone/drop function
// instead of routing through the type-tag dispatchers. These helpers compute the
// bare symbol name (no leading '@') for a given heap suruType.

// Make an array-element suruType into an identifier-safe flat fragment by
// replacing the "Array:" separator ':' with '-': "Array:i64" → "Array-i64".
// Scalars / "String" / already-mangled struct names contain no ':' and pass
// through unchanged.
export fn flatSuruName(suruType String) String {
    let out String: ""
    let i i64: 0
    while i.lt(suruType.len()) {
        let c String: suruType.slice(i, i.add(1))
        let piece String: match c.equals(":") { true: "-", _: c }
        let next String: out.append(piece)
        drop(out)
        out: next
        drop(c)
        i: i.add(1)
    }
    return out
}

// Bare symbol name to clone a heap value of the given suruType:
//   "Array:T"  → "suru_array_clone_<flat(T)>"  (per-element-type wrapper)
//   "String"   → "suru_string_clone"
//   struct/var → "suru_clone_via_vtable"  (null-safe trampoline through the
//                value's own clone_fn — uniform for plain structs and variants,
//                where the concrete arm is only known per-value, not statically)
// Callers must guard scalars (no clone call) before calling this.
export fn heapCloneSym(suruType String) String {
    if isArraySuruType(suruType) {
        return "suru_array_clone_".append(flatSuruName(elemSuruType(suruType)))
    }
    if isStringType(suruType) { return "suru_string_clone" }
    return "suru_clone_via_vtable"
}

// Bare symbol name to drop a heap value of the given suruType (see heapCloneSym).
export fn heapDropSym(suruType String) String {
    if isArraySuruType(suruType) {
        return "suru_array_drop_".append(flatSuruName(elemSuruType(suruType)))
    }
    if isStringType(suruType) { return "suru_string_drop" }
    return "suru_drop_via_vtable"
}
