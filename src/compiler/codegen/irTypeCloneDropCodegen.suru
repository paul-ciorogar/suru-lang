// ir-type-clone-drop-codegen.suru — Per-type @suru_clone_T / @suru_drop_T emission.
//
// For every locally-declared struct type, emits two module-level helper functions
// stored in ctx.helpers (before user function bodies):
//
//   @suru_clone_{T}(ptr %s) ptr
//     Allocates a new struct of the same flat size, copies the 32-byte header
//     word-by-word, recursively clones heap fields, copies scalar fields, returns ptr.
//
//   @suru_drop_{T}(ptr %s) void
//     Recursively drops all heap fields (via @suru_drop_dyn), then frees the allocation.
//
// These functions are pointed to by the vtable stored in the struct header at
// offsets 16 (clone_fn) and 24 (drop_fn), enabling @suru_clone_dyn / @suru_drop_dyn
// to dispatch correctly for tag=4 (struct) and tag=7 (variant) without knowing T.
//
// The cgTmp counter is separate from the per-function SSA counter (builder.tmpCount).
// It starts at 0 and threads through ALL types so SSA names like %malloc_0, %cgep_1
// are globally unique across all helper functions.
//
// One .ll per program, so every type registered in ctx.typeDecls gets its bodies
// here — there are no external types and no declare stubs.
//
// Include DAG: depends on ir-codegen-types.suru.
// Imported by ir-codegen.suru (the top-level codegen file).

namespace Suru.Compiler.Codegen.CloneDrop

import {
    types: Suru.Compiler.Codegen.Types
    tyh: Suru.Compiler.Codegen.TypeHelpers
    irStruct: Suru.Compiler.Codegen.Struct
    irArr: Suru.Compiler.Codegen.Array
}

// ─── Helper types ─────────────────────────────────────────────────────────────

// Result of a field-copy helper: the emitted IR text fragment and the updated cgTmp
// counter.  The counter must be threaded so SSA names stay globally unique across
// all clone/drop bodies emitted for the module.
type CgTextResult: { text String, cgTmp i64 }

// Result of emitting one type's clone+drop pair: updated context (ctx.helpers,
// ctx.decls, ctx.suruDecls extended) and updated cgTmp counter.
type CloneDropResult: { ctx IrCodegenContext, cgTmp i64 }

// ─── Counter helper ───────────────────────────────────────────────────────────

// Build a counter-indexed SSA name: %prefix_N.
// The counter is passed in as cgTmp; callers advance it by the slot count consumed.
fn cgName(prefix String, n i64) String {
    return "%".append(prefix).append("_").append(n.toString())
}

// ─── Field-copy helpers (raw IR text, no builder) ────────────────────────────
// Clone/drop bodies are module-level helper functions emitted into ctx.helpers,
// not inside a live function builder.  We therefore build raw IR text strings
// rather than using the ir.emit* builder pattern.

// Emit an i64 word copy from %s to dst at byte byteOffset.
// Uses names: cgep (src GEP), cv (load), dgep (dst GEP).
// Consumes 3 counter slots.
fn copyI64Field(dst String, byteOffset i64, cgTmp i64) CgTextResult {
    let sgep String: cgName("cgep", cgTmp)
    let cv   String: cgName("cv",   cgTmp.add(1))
    let dgep String: cgName("dgep", cgTmp.add(2))
    let o    String: byteOffset.toString()
    let r String: "  ".append(sgep).append(" = getelementptr i8, ptr %s, i64 ").append(o).append("\n")
    r: r.append("  ").append(cv).append("    = load i64, ptr ").append(sgep).append("\n")
    r: r.append("  ").append(dgep).append(" = getelementptr i8, ptr ").append(dst).append(", i64 ").append(o).append("\n")
    r: r.append("  store i64 ").append(cv).append(", ptr ").append(dgep).append("\n")
    return { text: r, cgTmp: cgTmp.add(3) }
}

// Emit a scalar field copy from %s to dst at byte byteOffset using the field's
// natural LLVM type (i1/i8/i32/i64/double/ptr) — a narrow load/store so a 1- or
// 4-byte field doesn't read/clobber its neighbours under the compact layout.
// Uses names: cgep (src GEP), cv (load), dgep (dst GEP). Consumes 3 counter slots.
fn copyScalarField(dst String, byteOffset i64, llvm String, cgTmp i64) CgTextResult {
    let sgep String: cgName("cgep", cgTmp)
    let cv   String: cgName("cv",   cgTmp.add(1))
    let dgep String: cgName("dgep", cgTmp.add(2))
    let o    String: byteOffset.toString()
    let r String: "  ".append(sgep).append(" = getelementptr i8, ptr %s, i64 ").append(o).append("\n")
    r: r.append("  ").append(cv).append("    = load ").append(llvm).append(", ptr ").append(sgep).append("\n")
    r: r.append("  ").append(dgep).append(" = getelementptr i8, ptr ").append(dst).append(", i64 ").append(o).append("\n")
    r: r.append("  store ").append(llvm).append(" ").append(cv).append(", ptr ").append(dgep).append("\n")
    return { text: r, cgTmp: cgTmp.add(3) }
}

// Emit a ptr word copy from %s to dst at byte byteOffset.
// Uses names: pgep (src GEP), pv (load), dpgep (dst GEP).
// Consumes 3 counter slots.
fn copyPtrField(dst String, byteOffset i64, cgTmp i64) CgTextResult {
    let sgep String: cgName("pgep",  cgTmp)
    let pv   String: cgName("pv",    cgTmp.add(1))
    let dgep String: cgName("dpgep", cgTmp.add(2))
    let o    String: byteOffset.toString()
    let r String: "  ".append(sgep).append(" = getelementptr i8, ptr %s, i64 ").append(o).append("\n")
    r: r.append("  ").append(pv).append("    = load ptr, ptr ").append(sgep).append("\n")
    r: r.append("  ").append(dgep).append(" = getelementptr i8, ptr ").append(dst).append(", i64 ").append(o).append("\n")
    r: r.append("  store ptr ").append(pv).append(", ptr ").append(dgep).append("\n")
    return { text: r, cgTmp: cgTmp.add(3) }
}

// Emit recursive clone of one heap field: load i64 slot → inttoptr → call the
// field type's static clone symbol → ptrtoint → store back into dst at byteOffset.
// cloneSym is the bare symbol name (no '@') for the field's static type, computed
// by the caller via tyh.heapCloneSym.
//
// Counter pre-allocation order is fixed: raw/ptr/cloned/i64 first, then sgep/dgep,
// even though fsgep is emitted first in the IR text.
// Consumes 6 counter slots.
fn cloneHeapField(dst String, byteOffset i64, cloneSym String, cgTmp i64) CgTextResult {
    let fraw    String: cgName("fraw",    cgTmp)
    let fptr    String: cgName("fptr",    cgTmp.add(1))
    let fcloned String: cgName("fcloned", cgTmp.add(2))
    let fi64    String: cgName("fi64",    cgTmp.add(3))
    let fsgep   String: cgName("fsgep",   cgTmp.add(4))
    let fdgep   String: cgName("fdgep",   cgTmp.add(5))
    let o       String: byteOffset.toString()
    let r String: "  ".append(fsgep).append(" = getelementptr i8, ptr %s, i64 ").append(o).append("\n")
    r: r.append("  ").append(fraw).append("  = load i64, ptr ").append(fsgep).append("\n")
    r: r.append("  ").append(fptr).append("   = inttoptr i64 ").append(fraw).append(" to ptr\n")
    r: r.append("  ").append(fcloned).append("   = call ptr @").append(cloneSym).append("(ptr ").append(fptr).append(")\n")
    r: r.append("  ").append(fi64).append("   = ptrtoint ptr ").append(fcloned).append(" to i64\n")
    r: r.append("  ").append(fdgep).append(" = getelementptr i8, ptr ").append(dst).append(", i64 ").append(o).append("\n")
    r: r.append("  store i64 ").append(fi64).append(", ptr ").append(fdgep).append("\n")
    return { text: r, cgTmp: cgTmp.add(6) }
}

// Emit recursive drop of one heap field: load i64 slot → inttoptr → call the
// field type's static drop symbol. dropSym is the bare symbol name (no '@').
// Counter pre-allocation order: fraw/fptr/fgep; fgep is emitted first in IR text.
// Consumes 3 counter slots.
fn dropHeapField(byteOffset i64, dropSym String, cgTmp i64) CgTextResult {
    let fraw String: cgName("fraw", cgTmp)
    let fptr String: cgName("fptr", cgTmp.add(1))
    let fgep String: cgName("fgep", cgTmp.add(2))
    let o    String: byteOffset.toString()
    let r String: "  ".append(fgep).append(" = getelementptr i8, ptr %s, i64 ").append(o).append("\n")
    r: r.append("  ").append(fraw).append("  = load i64, ptr ").append(fgep).append("\n")
    r: r.append("  ").append(fptr).append("   = inttoptr i64 ").append(fraw).append(" to ptr\n")
    r: r.append("  call void @").append(dropSym).append("(ptr ").append(fptr).append(")\n")
    return { text: r, cgTmp: cgTmp.add(3) }
}

// Ensure the clone/drop targets for a heap field of static type `st` are
// reachable from this module: emit array wrappers for array fields, declare the
// String runtime entry points for String fields, and declare the vtable
// trampolines for struct/variant fields. Idempotent.
fn ensureFieldTargets(ctx IrCodegenContext, st String) IrCodegenContext {
    if tyh.isArraySuruType(st) {
        return irArr.ensureArrayHelper(ctx, tyh.elemSuruType(st))
    }
    if tyh.isStringType(st) {
        ctx: types.addSuruDecl(ctx, "declare ptr  @suru_string_clone(ptr)\n")
        ctx: types.addSuruDecl(ctx, "declare void @suru_string_drop(ptr)\n")
        return ctx
    }
    ctx: types.addSuruDecl(ctx, "declare ptr  @suru_clone_via_vtable(ptr)\n")
    ctx: types.addSuruDecl(ctx, "declare void @suru_drop_via_vtable(ptr)\n")
    return ctx
}

// ─── Per-type clone/drop emission ─────────────────────────────────────────────

// Emit @suru_clone_{typeName} and @suru_drop_{typeName} for one struct type.
// Both bodies are appended to ctx.helpers.
//
// cgTmp is the shared counter threaded across all types — callers must use the
// returned cgTmp for subsequent types so names stay globally unique.
// A field needs no deep clone / drop when it is a scalar OR the synthetic
// `$vtable` slot (a static constant pointer, not heap-owned).
fn cdNonOwnedField(ann String, st String) bool {
    return tyh.isScalarSuruType(st) or ann.equals("$vtable")
}

fn emitTypeCloneDrop(ctx IrCodegenContext, typeName String, cgTmp i64) CloneDropResult {
    let decl TypeDecl: types.lookupType(ctx, typeName)
    let fc   i64:    decl.fields.len()
    let size String:   irStruct.suruStructSize(decl).toString()

    // malloc + free are required for the clone allocation and drop deallocation.
    // addDecl is idempotent so calling it once per type is safe.
    ctx: types.addDecl(ctx, "declare ptr @malloc(i64)\n")
    ctx: types.addDecl(ctx, "declare void @free(ptr)\n")

    // Heap fields are cloned/dropped via their static per-type symbol; scalar
    // fields are copied directly. Pre-pass: make every heap field's clone/drop
    // target reachable (array wrappers, String runtime decls, external struct
    // clone/drop decls). The symbols themselves are computed per field below.
    let chi i64: 0
    while chi.lt(fc) {
        let ann String: decl.fields.at(chi).typeName
        let st  String: tyh.makeSuruType(ann)
        // The synthetic `$vtable` slot holds a static constant pointer — it is
        // NOT heap-owned: shallow-copy on clone, never drop.
        if not cdNonOwnedField(ann, st) {
            ctx: ensureFieldTargets(ctx, st)
        }
        chi: chi.add(1)
    }

    // ── @suru_clone_{typeName} ─────────────────────────────────────────────────
    // Pattern: malloc(size) → copy 32-byte header → copy/clone each field → ret ptr.
    let mallocName String: cgName("malloc", cgTmp)
    cgTmp: cgTmp.add(1)
    let h String: "define ptr @suru_clone_".append(typeName).append("(ptr %s) {\nentry:\n")
    h: h.append("  ").append(mallocName).append(" = call ptr @malloc(i64 ").append(size).append(")\n")

    // Header word-by-word copies preserve type_tag/variant_idx and the vtable ptrs.
    let r0 CgTextResult: copyI64Field(mallocName, 0, cgTmp)
    h: h.append(r0.text)
    cgTmp: r0.cgTmp
    let r1 CgTextResult: copyI64Field(mallocName, 8, cgTmp)
    h: h.append(r1.text)
    cgTmp: r1.cgTmp
    let r2 CgTextResult: copyPtrField(mallocName, 16, cgTmp)
    h: h.append(r2.text)
    cgTmp: r2.cgTmp
    let r3 CgTextResult: copyPtrField(mallocName, 24, cgTmp)
    h: h.append(r3.text)
    cgTmp: r3.cgTmp

    // Per-field: scalar fields are i64-copied directly; heap fields require
    // recursive clone so the new struct doesn't alias the old allocation.
    let fi i64: 0
    while fi.lt(fc) {
        let off  i64:  irStruct.suruFieldOffset(decl, fi)
        let ann  String: decl.fields.at(fi).typeName
        let st   String: tyh.makeSuruType(ann)
        if cdNonOwnedField(ann, st) {
            // Scalar / $vtable: copy at the field's natural width so a narrow
            // field (i32/bool/char) doesn't over-read or clobber its neighbours.
            let llvm String: tyh.irLlvmTypeOf(st)
            let rx CgTextResult: copyScalarField(mallocName, off, llvm, cgTmp)
            h: h.append(rx.text)
            cgTmp: rx.cgTmp
        } else {
            // Heap field (always an 8-byte ptr) — recursive deep clone via the
            // field type's static clone symbol.
            let rx CgTextResult: cloneHeapField(mallocName, off, tyh.heapCloneSym(st), cgTmp)
            h: h.append(rx.text)
            cgTmp: rx.cgTmp
        }
        fi: fi.add(1)
    }
    h: h.append("  ret ptr ").append(mallocName).append("\n}\n\n")

    // ── @suru_drop_{typeName} ──────────────────────────────────────────────────
    // Pattern: drop each heap field (scalar fields need no drop) → free(%s) → ret void.
    h: h.append("define void @suru_drop_".append(typeName).append("(ptr %s) {\nentry:\n"))
    fi: 0
    while fi.lt(fc) {
        let off  i64:  irStruct.suruFieldOffset(decl, fi)
        let ann  String: decl.fields.at(fi).typeName
        let st   String: tyh.makeSuruType(ann)
        if not cdNonOwnedField(ann, st) {
            let rx CgTextResult: dropHeapField(off, tyh.heapDropSym(st), cgTmp)
            h: h.append(rx.text)
            cgTmp: rx.cgTmp
        }
        fi: fi.add(1)
    }
    h: h.append("  call void @free(ptr %s)\n  ret void\n}\n\n")
    ctx.helpers: ctx.helpers.append(h)
    return { ctx: ctx, cgTmp: cgTmp }
}


// ─── Custom-lifecycle vtable-dispatch wrappers ────────────────────────────────

// Emit @suru_clone_T and @suru_drop_T as vtable-dispatch wrappers for types that
// declare both clone() and drop() in their interface (hasCustomLifecycle = true).
// Instead of the normal field-walking body, these functions load the vtable pointer
// from offset 32 ($vtable field), index into it at the clone/drop method slots, and
// call the user-supplied implementation. The cgTmp counter is not consumed because
// the wrappers use fixed SSA names (each lives in its own function scope).
fn emitCustomLifecycleCloneDrop(ctx IrCodegenContext, decl TypeDecl, cgTmp i64) CloneDropResult {
    let cloneIdx i64: types.methodIndex(decl, "clone")
    let dropIdx  i64: types.methodIndex(decl, "drop")
    let typeName String: decl.name

    // malloc and free are needed for clone allocation and drop deallocation.
    ctx: types.addDecl(ctx, "declare ptr @malloc(i64)\n")
    ctx: types.addDecl(ctx, "declare void @free(ptr)\n")

    let h String: "define ptr @suru_clone_".append(typeName).append("(ptr %s) {\nentry:\n")
    h: h.append("  %vt_gep = getelementptr i8, ptr %s, i64 32\n")
    h: h.append("  %vt_ptr = load ptr, ptr %vt_gep\n")
    h: h.append("  %fn_gep = getelementptr ptr, ptr %vt_ptr, i64 ").append(cloneIdx.toString()).append("\n")
    h: h.append("  %fn_val = load ptr, ptr %fn_gep\n")
    h: h.append("  %result = call ptr %fn_val(ptr %s)\n")
    h: h.append("  ret ptr %result\n}\n\n")

    h: h.append("define void @suru_drop_".append(typeName).append("(ptr %s) {\nentry:\n"))
    h: h.append("  %vt_gep2 = getelementptr i8, ptr %s, i64 32\n")
    h: h.append("  %vt_ptr2 = load ptr, ptr %vt_gep2\n")
    h: h.append("  %fn_gep2 = getelementptr ptr, ptr %vt_ptr2, i64 ").append(dropIdx.toString()).append("\n")
    h: h.append("  %fn_val2 = load ptr, ptr %fn_gep2\n")
    h: h.append("  call void %fn_val2(ptr %s)\n")
    h: h.append("  call void @free(ptr %s)\n")
    h: h.append("  ret void\n}\n\n")

    ctx.helpers: ctx.helpers.append(h)
    return { ctx: ctx, cgTmp: cgTmp }
}

// ─── Module-level iteration ───────────────────────────────────────────────────

// Emit @suru_clone_T / @suru_drop_T for every type registered in ctx.typeDecls.
// One .ll per program: every registered type gets its bodies here, no declare stubs.
//
// @suru_clone_T / @suru_drop_T are NOT namespace-mangled, so a name emitted twice
// is a hard LLVM redefinition error.  `emitted` guards against that — both for two
// modules declaring the same type name and for a duplicate TypeDecl registration
// from mono.  It is walked in ctx.typeDecls registration order, so output stays
// deterministic (the bootstrap C2 == C3 fixed point depends on it).
//
// The cgTmp counter starts at 0 and threads through all types, producing globally
// unique SSA names across the entire helpers block.
//
export fn emitAllTypeCloneDrop(ctx IrCodegenContext) IrCodegenContext {
    let cgTmp i64: 0
    let emitted Array<String>: []
    let i i64: 0
    while i.lt(ctx.typeDecls.len()) {
        let decl TypeDecl: ctx.typeDecls.at(i)
        // cTypes have no runtime header / type_tag, so no @suru_clone_T/@suru_drop_T
        // helper is generated — their memory is managed manually via extern fn.
        if not decl.isCType {
            let dup bool: false
            let e i64: 0
            while e.lt(emitted.len()) {
                if emitted.at(e).equals(decl.name) { dup: true }
                e: e.add(1)
            }
            if not dup {
                emitted.add(clone(decl.name))
                if decl.hasCustomLifecycle {
                    // User-declared clone()/drop() — emit vtable-dispatch wrappers.
                    let r CloneDropResult: emitCustomLifecycleCloneDrop(ctx, decl, cgTmp)
                    ctx: r.ctx
                    cgTmp: r.cgTmp
                } else {
                    let r CloneDropResult: emitTypeCloneDrop(ctx, decl.name, cgTmp)
                    ctx: r.ctx
                    cgTmp: r.cgTmp
                }
            }
        }
        i: i.add(1)
    }
    return ctx
}
