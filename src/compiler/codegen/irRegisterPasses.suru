// irRegisterPasses.suru — module-level pre-passes for codegen.
//
// Three registration passes plus the emit for module-level constants.
// All four functions run before any function-body IR emission and never
// call into emitValue, so they live outside irCodegen.suru's
// mutual-recursion cluster.
//
// Include DAG: depends on parserAst.suru, irCodegenTypes.suru,
// irCodegenTypeHelpers.suru, and irBoxCodegen.suru. Imported by irCodegen.suru.

namespace Suru.Compiler.Codegen.RegisterPasses

import {
    ast: Suru.Compiler.Parser.Ast
    types: Suru.Compiler.Codegen.Types
    tyh: Suru.Compiler.Codegen.TypeHelpers
    box: Suru.Compiler.Codegen.Box
    irStruct: Suru.Compiler.Codegen.Struct
}

export {
    registerTypes
    registerFunctions
    registerConstants
    emitGlobalConstants
}

// cloneReturnMatchesType — true when returnType refers to the same (possibly
// generic) type as typeName.  Handles two forms:
//   1. Exact string match:            "MyType"      == "MyType"
//   2. Generic vs mangled mismatch:   "DynArray<String>" ~ "DynArray-String"
//      (clone returns "Base<Arg>" but the type name is the monomorphized "Base-Arg")
// We detect case 2 by comparing base names: the prefix before '<' in returnType
// must equal the prefix before the first '-' in typeName.
fn cloneReturnMatchesType(returnType String, typeName String) bool {
    if returnType.equals(typeName) { return true }
    // Find '<' in returnType
    let ri i64: 0
    while ri.lt(returnType.len()) {
        if returnType.at(ri).equals("<") { break }
        ri: ri.add(1)
    }
    if ri.equals(returnType.len()) { return false }  // no '<', exact-only
    // Find first '-' in typeName (generic mangle separator)
    let ti i64: 0
    while ti.lt(typeName.len()) {
        if typeName.at(ti).equals("-") { break }
        ti: ti.add(1)
    }
    if ti.equals(typeName.len()) { return false }  // no '-', exact-only
    // Base lengths must match
    if not ri.equals(ti) { return false }
    // Check character by character up to ri
    let j i64: 0
    while j.lt(ri) {
        if not returnType.at(j).equals(typeName.at(j)) { return false }
        j: j.add(1)
    }
    return true
}

// Pre-pass 0: register TypeDecl/SumTypeDecl into context registries.
fn registerTypes(ctx IrCodegenContext, stmts Array<AstNode>) IrCodegenContext {
    let i i64: 0
    while i.lt(stmts.len()) {
        let s AstNode: stmts.at(i)
        match s {
            TypeDeclNode: {
                let fields Array<TypeFieldEntry>: []
                // Object types (declare ≥1 method) reserve slot 0 for the
                // single per-instance vtable pointer; data fields follow. The
                // method lambda-lift rewrites literals to match this layout.
                let ms Array<MethodSig>: s.methods
                if ms.len().gt(0) { fields.add({ name: "$vtable", typeName: "$vtable" }) }
                let j i64: 0
                while j.lt(s.fields.len()) {
                    let p Param: s.fields.at(j)
                    let fe TypeFieldEntry: { name: p.name, typeName: p.typeName }
                    fields.add(fe)
                    j: j.add(1)
                }
                let tmethods Array<TypeMethodEntry>: []
                let mj i64: 0
                while mj.lt(ms.len()) {
                    let msig MethodSig: ms.at(mj)
                    let ptys Array<String>: []
                    let mps Array<Param>: msig.params
                    let pk i64: 0
                    while pk.lt(mps.len()) {
                        ptys.add(mps.at(pk).typeName)
                        pk: pk.add(1)
                    }
                    tmethods.add({ name: msig.name, paramTypes: ptys, returnType: msig.returnType })
                    mj: mj.add(1)
                }
                // Regular structs use the compact layout: reorder fields into
                // alignment buckets (8 ++ 4 ++ 1, stable) so suruFieldOffset/
                // suruStructSize lay them out densely. cTypes keep declaration
                // order (the C ABI is order-sensitive).
                let layoutFields Array<TypeFieldEntry>: match s.isCType {
                    true: fields
                    _:    irStruct.reorderSuruFields(fields)
                }
                // Mirror the semantic hasCustomLifecycle flag: true when the interface
                // declares both clone() returning the same type and drop() returning void.
                let hasCloneFn bool: false
                let hasDropFn bool: false
                let cli i64: 0
                while cli.lt(ms.len()) {
                    let csig MethodSig: ms.at(cli)
                    if csig.name.equals("clone") and cloneReturnMatchesType(csig.returnType, s.name) { hasCloneFn: true }
                    if csig.name.equals("drop") and csig.returnType.equals("void") { hasDropFn: true }
                    cli: cli.add(1)
                }
                let td TypeDecl: { name: s.name, fields: layoutFields, methods: tmethods, isCType: s.isCType, hasCustomLifecycle: hasCloneFn and hasDropFn }
                ctx: types.addType(ctx, td)
            }
            SumTypeDeclNode: {
                let sd SumTypeDecl: { name: s.name, variants: s.variants }
                ctx: types.addSumType(ctx, sd)
            }
            // ExternTypeNode is opaque — no struct layout, no clone/drop helpers.
            // Type erasure to `ptr` happens in irLlvmTypeOf via the default arm.
            ExternTypeNode: {}
            _: {}
        }
        i: i.add(1)
    }
    return ctx
}

// Pre-pass 1: register same-file function signatures into ctx.functions.
// Only functions whose names are in ctx.ownFnNames get registered — external
// (included) functions are excluded here; they may be added by the caller.
fn registerFunctions(ctx IrCodegenContext, stmts Array<AstNode>) IrCodegenContext {
    let i i64: 0
    while i.lt(stmts.len()) {
        let s AstNode: stmts.at(i)
        match s {
            FnDeclNode: {
                if types.isOwnFn(ctx, s.name) {
                    let retSuru String: tyh.makeSuruType(s.returnType)
                    let retLlvm String: match s.returnType.equals("void") {
                        true: "ptr"
                        _:    box.llvmTypeOf(retSuru)
                    }
                    let paramTypes Array<String>: []
                    let j i64: 0
                    while j.lt(s.params.len()) {
                        paramTypes.add(tyh.makeSuruType(s.params.at(j).typeName))
                        j: j.add(1)
                    }
                    let fe2 FnEntry: { name: s.name, returnLlvmType: retLlvm, returnSuruType: retSuru, paramSuruTypes: paramTypes }
                    ctx: types.addFn(ctx, fe2)
                }
            }
            _: {}
        }
        i: i.add(1)
    }
    return ctx
}

// Pre-pass 2: register module-level scalar constant names in ctx.globalVars.
fn registerConstants(ctx IrCodegenContext, stmts Array<AstNode>) IrCodegenContext {
    let i i64: 0
    while i.lt(stmts.len()) {
        let s AstNode: stmts.at(i)
        match s {
            LetNode: {
                let val AstNode: s.value
                let suruTy String: ""
                match val {
                    BoolLitNode:  { suruTy: "bool" }
                    IntLitNode:   { suruTy: "i64" }
                    FloatLitNode: { suruTy: "f64" }
                    _: {}
                }
                if not suruTy.equals("") {
                    // Use namespace-based mangling when the constant's source file
                    // has a namespace declaration; fall back to the raw name otherwise.
                    let srcNs String: types.lookupSrcNs(ctx, s.srcPath)
                    let globalSym String: match srcNs.equals("") {
                        true: "@".append(s.name)
                        _:    "@".append(types.mangleNsSym(srcNs, s.name))
                    }
                    let gv GlobalVar: { suruName: s.name, globalName: globalSym, suruType: suruTy }
                    ctx.globalVars.add(gv)
                }
            }
            _: {}
        }
        i: i.add(1)
    }
    return ctx
}

// Emit LLVM global constant declarations for all registered module-level scalars.
// Called during assembly in generate() — reads ctx.globalVars, matches back to stmts
// to get the literal text.
fn emitGlobalConstants(ctx IrCodegenContext, stmts Array<AstNode>) String {
    let out String: ""
    let i i64: 0
    while i.lt(stmts.len()) {
        let s AstNode: stmts.at(i)
        match s {
            LetNode: {
                let g GlobalVar: types.lookupGlobal(ctx, s.name)
                if not g.suruName.equals("") {
                    let val AstNode: s.value
                    match val {
                        BoolLitNode: {
                            let bstr String: match val.boolVal { true: "1", _: "0" }
                            out: out.append(g.globalName).append(" = internal constant i1 ").append(bstr).append("\n")
                        }
                        IntLitNode: {
                            out: out.append(g.globalName).append(" = internal constant i64 ").append(val.text).append("\n")
                        }
                        FloatLitNode: {
                            out: out.append(g.globalName).append(" = internal constant double ").append(val.text).append("\n")
                        }
                        _: {}
                    }
                }
            }
            _: {}
        }
        i: i.add(1)
    }
    return out
}
