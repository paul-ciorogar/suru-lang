// ir-codegen.suru — Main LLVM IR code generator.
//
// emitValue, emitMatchExpr, emitMatchStmt, emitStmt, emitStmts, emitWhile, and
// emitFunction form a mutually-recursive cluster that Suru's acyclic include DAG
// cannot split across files — all live here.
//
// Design: helper files (string/array/struct/fileio) receive pre-emitted SSA names
// and never call emitValue. emitValue pre-emits all sub-expressions, then delegates.
//
// Include DAG: top of the codegen DAG — depends on all seven helper files.
// Imported by suru-build/main.suru as the codegen entry point.

include "../parser/parserAst.suru" as ast
include "irBuilder.suru" as ir
include "irCodegenTypes.suru" as types
include "irCodegenStrIntern.suru" as strIntern
include "irCodegenTypeHelpers.suru" as tyh
include "irBoxCodegen.suru" as box
include "irStringCodegen.suru" as irStr
include "irArrayCodegen.suru" as irArr
include "irStructCodegen.suru" as irStruct
include "irFileioCodegen.suru" as irFile
include "irTypeCloneDropCodegen.suru" as irCD
include "irRegisterPasses.suru" as passes
include "irExprHelpers.suru" as eh

// Module-level pre-passes (registerTypes/registerFunctions/registerConstants/
// emitGlobalConstants) live in irRegisterPasses.suru. Low-level expression
// helpers (emitVarLoad, effectiveSuruType, rawVal, emitArith, emitCmpOp,
// emitCompare, emitInvert, emitCloneDyn, emitDropDyn, emitBoolNot,
// emitBinaryExpr) live in irExprHelpers.suru. Both files are leaves with
// respect to the mutual-recursion cluster that remains here.

// ─── Static type methods ─────────────────────────────────────────────────────────

// Int64.from(str) → call @suru_string_to_int64(ptr str) → i64
fn emitInt64Static(ctx IrCodegenContext, method String, args Array<AstNode>) CodegenResult {
    let arg0 AstNode: args.at(0)
    match arg0 {
        StrLitNode: {
            ctx: strIntern.internString(ctx, arg0.text)
            let gname String: strIntern.lookupStrGlobal(ctx, arg0.text)
            ctx: types.addDecl(ctx, "declare i64 @strtol(ptr, ptr, i32)\n")
            let stArgs Array<String>: []
            stArgs.add("ptr ".append(gname))
            stArgs.add("ptr null")
            stArgs.add("i32 10")
            let stR IrResult: ir.emitCall(ctx.builder, "i64", "strtol", stArgs)
            ctx.builder: stR.builder
            return { ctx: ctx, name: stR.name, llvmType: "i64", suruType: "Int64" }
        }
        _: {
            let ar CodegenResult: emitValue(ctx, arg0)
            ctx: ar.ctx
            let result CodegenResult: irStr.emitInt64FromString(ctx, ar.name)
            ctx: result.ctx
            match isPrintTempString(arg0) {
                true: {
                    let dr CodegenResult: irStr.emitStringDrop(ctx, ar.name)
                    ctx: dr.ctx
                }
                _: {}
            }
            return { ctx: ctx, name: result.name, llvmType: result.llvmType, suruType: result.suruType }
        }
    }
}

// Float64.from(str) → call @suru_string_to_float64(ptr str) → double
fn emitFloat64Static(ctx IrCodegenContext, method String, args Array<AstNode>) CodegenResult {
    let arg0 AstNode: args.at(0)
    match arg0 {
        StrLitNode: {
            ctx: strIntern.internString(ctx, arg0.text)
            let gname String: strIntern.lookupStrGlobal(ctx, arg0.text)
            ctx: types.addDecl(ctx, "declare double @strtod(ptr, ptr)\n")
            let sdArgs Array<String>: []
            sdArgs.add("ptr ".append(gname))
            sdArgs.add("ptr null")
            let sdR IrResult: ir.emitCall(ctx.builder, "double", "strtod", sdArgs)
            ctx.builder: sdR.builder
            return { ctx: ctx, name: sdR.name, llvmType: "double", suruType: "Float64" }
        }
        _: {
            let ar CodegenResult: emitValue(ctx, arg0)
            ctx: ar.ctx
            let result CodegenResult: irStr.emitFloat64FromString(ctx, ar.name)
            ctx: result.ctx
            match isPrintTempString(arg0) {
                true: {
                    let dr CodegenResult: irStr.emitStringDrop(ctx, ar.name)
                    ctx: dr.ctx
                }
                _: {}
            }
            return { ctx: ctx, name: result.name, llvmType: result.llvmType, suruType: result.suruType }
        }
    }
}

// Int32.from(val) → trunc i64 val to i32 (or literal coerce)
fn emitInt32Static(ctx IrCodegenContext, method String, args Array<AstNode>) CodegenResult {
    let ar CodegenResult: emitValue(ctx, args.at(0))
    ctx: ar.ctx
    let raw String: ar.name
    match box.isScalarType(ar.suruType) {
        true: {}
        _: {
            let ur CodegenResult: box.unboxInt64(ctx, ar.name)
            ctx: ur.ctx
            raw: ur.name
        }
    }
    let tr IrResult: ir.emitTrunc(ctx.builder, "i64", raw, "i32")
    ctx.builder: tr.builder
    return { ctx: ctx, name: tr.name, llvmType: "i32", suruType: "Int32" }
}

// ─── Per-module symbol mangling ─────────────────────────────────────────────────

// Replace every non-[A-Za-z0-9_] char with '_' so an absolute source path can
// be used as an LLVM symbol prefix.
fn sanitizePath(p String) String {
    let out String: ""
    let i Int64: 0
    while i.lt(p.len()) {
        let ch String: p.at(i)
        let c Int64: ch.ord()
        let isDig Bool: c.gte(48) and c.lt(58)
        let isLow Bool: c.gte(97) and c.lt(123)
        let isUp  Bool: c.gte(65) and c.lt(91)
        let isUnd Bool: ch.equals("_")
        let keep Bool: isDig or isLow or isUp or isUnd
        match keep {
            true: { out: out.append(ch) }
            _:    { out: out.append("_") }
        }
        i: i.add(1)
    }
    return out
}

// The LLVM symbol for a function: `main` and runtime/builtin names (empty
// srcPath) are emitted verbatim; every other user function is prefixed with a
// per-source-file tag so same-named functions in different files don't collide.
fn mangleSym(srcPath String, name String) String {
    return match name.equals("main") {
        true: "main"
        _: match srcPath.equals("") {
            true: name
            _: sanitizePath(srcPath).append("__").append(name)
        }
    }
}

// name → owning source path (or "" when not a user function: runtime/builtin).
fn lookupFnSrcPath(ctx IrCodegenContext, name String) String {
    let names Array<String>: ctx.fnSrcName
    let paths Array<String>: ctx.fnSrcPath
    let i Int64: 0
    while i.lt(names.len()) {
        match names.at(i).equals(name) {
            true: { return paths.at(i) }
            _:    {}
        }
        i: i.add(1)
    }
    return ""
}

// include alias → resolved source path (or "" when the name is not an alias).
fn lookupAliasSrc(ctx IrCodegenContext, ns String) String {
    let aliasNs  Array<String>: ctx.aliasNs
    let aliasSrc Array<String>: ctx.aliasSrc
    let i Int64: 0
    while i.lt(aliasNs.len()) {
        match aliasNs.at(i).equals(ns) {
            true: { return aliasSrc.at(i) }
            _:    {}
        }
        i: i.add(1)
    }
    return ""
}

// ─── User function call ─────────────────────────────────────────────────────────

// Emit a call to a user-defined function. `lookupName` is the unqualified name
// used for signature lookup in ctx.functions; `llvmSym` is the (mangled) symbol
// actually called. Emits each arg and coerces scalar params.
fn emitUserFnCallSym(ctx IrCodegenContext, lookupName String, llvmSym String, args Array<AstNode>) CodegenResult {
    let sig FnEntry: types.lookupFn(ctx, lookupName)
    let argParts Array<String>: []
    let i Int64: 0
    while i.lt(args.len()) {
        let ar CodegenResult: emitValue(ctx, args.at(i))
        ctx: ar.ctx
        let pSuruType String: match i.lt(sig.paramSuruTypes.len()) {
            true: sig.paramSuruTypes.at(i)
            _:    ar.suruType
        }
        let pLlvm String: box.llvmTypeOf(pSuruType)
        let finalVal String: ar.name
        match box.isScalarType(pSuruType) {
            true: {
                match box.isScalarType(ar.suruType) {
                    true: {}
                    _: {
                        let ur CodegenResult: box.unboxScalar(ctx, ar.name, pSuruType)
                        ctx: ur.ctx
                        finalVal: ur.name
                    }
                }
            }
            _: {}
        }
        argParts.add(pLlvm.append(" ").append(finalVal))
        i: i.add(1)
    }
    let retLlvm String: sig.returnLlvmType
    let rr IrResult: ir.emitCall(ctx.builder, retLlvm, llvmSym, argParts)
    ctx.builder: rr.builder
    return { ctx: ctx, name: rr.name, llvmType: retLlvm, suruType: sig.returnSuruType }
}

// Unqualified call `fn(...)`: mangle to the owning file's symbol (runtime and
// builtin names have no srcPath entry and pass through unchanged).
fn emitUserFnCall(ctx IrCodegenContext, fnName String, args Array<AstNode>) CodegenResult {
    let sym String: mangleSym(lookupFnSrcPath(ctx, fnName), fnName)
    return emitUserFnCallSym(ctx, fnName, sym, args)
}

// ─── Array / struct literal helpers ────────────────────────────────────────────

// Emit an array literal: header alloc first, then elements into raw data buffer,
// then header fields.
//
// SSA emission order (preserves numbering invariants):
//   hdrPtr = malloc(40)
//   if count > 0: firstVal = EmitValue(elements[0])    ← eval first elem BEFORE rawData
//                 rawData  = malloc(count * elemSizeBytes)
//                 slot0    = GEP(rawData, 0); enc0 = emitElemEncode(firstVal); store
//                 for i=1..count-1: elemVal = EmitValue, slot = GEP, enc = emitElemEncode, store
//   pre-allocate all 5 header GEP SSA names in one batch
//   emit header GEPs + stores (lenGep/capGep with double-space after SSA name)
fn emitArrayLit(ctx IrCodegenContext, elems Array<AstNode>, elemSuruType String) CodegenResult {
    ctx: types.addDecl(ctx, "declare ptr @malloc(i64)\n")
    // Step 1: allocate Array header (40 bytes).
    let hdrArgs Array<String>: []
    hdrArgs.add("i64 40")
    let hdrR IrResult: ir.emitCall(ctx.builder, "ptr", "malloc", hdrArgs)
    ctx.builder: hdrR.builder
    let hdrPtr String: hdrR.name
    let count Int64: elems.len()
    let dataPtr String: "null"
    let actualElemSuruType String: elemSuruType
    // Step 2: for non-empty arrays, emit elements into raw data buffer.
    match count.equals(0) {
        true: {}
        _: {
            // Evaluate first element BEFORE malloc'ing rawData (preserves SSA ordering invariant).
            let firstValR CodegenResult: emitValue(ctx, elems.at(0))
            ctx: firstValR.ctx
            actualElemSuruType: firstValR.suruType
            let storeType String: irArr.elemStorageLlvmType(actualElemSuruType)
            let elemBytes Int64: irArr.elemSizeBytes(actualElemSuruType)
            // malloc raw data buffer: count * elemBytes.
            let rawArgs Array<String>: []
            rawArgs.add("i64 ".append(count.multiply(elemBytes).toString()))
            let rawR IrResult: ir.emitCall(ctx.builder, "ptr", "malloc", rawArgs)
            ctx.builder: rawR.builder
            dataPtr: rawR.name
            // Slot 0: GEP first, then encode firstVal, then store.
            let slot0R IrResult: ir.emitGEP(ctx.builder, storeType, dataPtr, "i64 0")
            ctx.builder: slot0R.builder
            let enc0 CodegenResult: irArr.emitElemEncode(ctx, firstValR.name, firstValR.suruType)
            ctx: enc0.ctx
            ctx.builder: ir.emitStore(ctx.builder, storeType, enc0.name, slot0R.name)
            // Slots 1..count-1: eval elem, GEP slot, encode, store.
            let i Int64: 1
            while i.lt(count) {
                let elemValR CodegenResult: emitValue(ctx, elems.at(i))
                ctx: elemValR.ctx
                let slotR IrResult: ir.emitGEP(ctx.builder, storeType, dataPtr, "i64 ".append(i.toString()))
                ctx.builder: slotR.builder
                let enc CodegenResult: irArr.emitElemEncode(ctx, elemValR.name, elemValR.suruType)
                ctx: enc.ctx
                ctx.builder: ir.emitStore(ctx.builder, storeType, enc.name, slotR.name)
                i: i.add(1)
            }
        }
    }
    // Step 3: pre-allocate all 5 header GEP SSA names in one batch.
    let ttagNR IrResult: ir.nextTmp(ctx.builder)
    ctx.builder: ttagNR.builder
    let etagNR IrResult: ir.nextTmp(ctx.builder)
    ctx.builder: etagNR.builder
    let lenNR  IrResult: ir.nextTmp(ctx.builder)
    ctx.builder: lenNR.builder
    let capNR  IrResult: ir.nextTmp(ctx.builder)
    ctx.builder: capNR.builder
    let dataNR IrResult: ir.nextTmp(ctx.builder)
    ctx.builder: dataNR.builder
    let etag String: tyh.suruTypeTag(actualElemSuruType)
    // Step 4: emit header field GEPs + stores.
    // ttagGep and etagGep use single space; lenGep and capGep use double space
    // (aligned formatting required for len/cap GEP SSA names).
    let ttagLine String: "  ".append(ttagNR.name).append(" = getelementptr %suru.Array, ptr ").append(hdrPtr).append(", i32 0, i32 0\n")
    ctx.builder: ir.emit(ctx.builder, ttagLine)
    ctx.builder: ir.emitStore(ctx.builder, "i64", "5", ttagNR.name)
    let etagLine String: "  ".append(etagNR.name).append(" = getelementptr %suru.Array, ptr ").append(hdrPtr).append(", i32 0, i32 1\n")
    ctx.builder: ir.emit(ctx.builder, etagLine)
    ctx.builder: ir.emitStore(ctx.builder, "i64", etag, etagNR.name)
    let lenLine String: "  ".append(lenNR.name).append("  = getelementptr %suru.Array, ptr ").append(hdrPtr).append(", i32 0, i32 2\n")
    ctx.builder: ir.emit(ctx.builder, lenLine)
    ctx.builder: ir.emitStore(ctx.builder, "i64", count.toString(), lenNR.name)
    let capLine String: "  ".append(capNR.name).append("  = getelementptr %suru.Array, ptr ").append(hdrPtr).append(", i32 0, i32 3\n")
    ctx.builder: ir.emit(ctx.builder, capLine)
    ctx.builder: ir.emitStore(ctx.builder, "i64", count.toString(), capNR.name)
    let dataLine String: "  ".append(dataNR.name).append(" = getelementptr %suru.Array, ptr ").append(hdrPtr).append(", i32 0, i32 4\n")
    ctx.builder: ir.emit(ctx.builder, dataLine)
    ctx.builder: ir.emitStore(ctx.builder, "ptr", dataPtr, dataNR.name)
    return { ctx: ctx, name: hdrPtr, llvmType: "ptr", suruType: "Array:".append(actualElemSuruType) }
}

// Emit a struct literal: allocate first, then for each TypeDecl field GEP the slot
// BEFORE evaluating the field value — GEP SSA name must have a lower number than the
// field value's intermediate SSA names (dominance invariant).
// typeName is the declared struct type (from let annotation or current fn return type).
fn emitStructLit(ctx IrCodegenContext, fields Array<StructFieldNode>, typeName String) CodegenResult {
    // `{}` against a field whose type is NOT a registered struct — i.e. a sum
    // type (e.g. AstNode) or an array (e.g. Array:AstNode) — is the
    // ownership-release idiom `x.field: {}` used before drop(x). There is no
    // concrete struct layout to allocate, and emitting @suru_clone_<T> for a
    // sum/array type produces an undefined symbol (and, for arrays, an invalid
    // ':' in the LLVM identifier). Store a null pointer instead: suru_drop_dyn
    // is a no-op on null, so the subsequent drop(x) is safe.
    // Nested matches (no `and`) so the older bootstrap compiler — which predates
    // `match <bool-and-expr>` — codegens this guard correctly.
    let lt TypeDecl: types.lookupType(ctx, typeName)
    match lt.name.equals("") {
        true: {
            match fields.len().equals(0) {
                true: {
                    return { ctx: ctx, name: "null", llvmType: "ptr", suruType: typeName }
                }
                _: {}
            }
        }
        _: {}
    }
    // Step 1: allocate struct memory and write the 32-byte header.
    let allocR CodegenResult: irStruct.emitStructLiteralAlloc(ctx, typeName)
    ctx: allocR.ctx
    let mem String: allocR.name
    // Step 2: for each TypeDecl field (canonical order), GEP the slot FIRST, then
    // evaluate the field value, then encode as i64 and store.
    // Absent fields (not in the literal) are zero-initialized.
    let decl TypeDecl: types.lookupType(ctx, typeName)
    let i Int64: 0
    while i.lt(decl.fields.len()) {
        let tdFieldName String: decl.fields.at(i).name
        let offset Int64: irStruct.fieldOffset(i)
        let fGr IrResult: ir.emitGEP(ctx.builder, "i8", mem, "i64 ".append(offset.toString()))
        ctx.builder: fGr.builder
        // Linear scan: find this TypeDecl field in the literal's provided fields.
        let foundIdx Int64: -1
        let k Int64: 0
        while k.lt(fields.len()) {
            match fields.at(k).name.equals(tdFieldName) { true: { foundIdx: k } _: {} }
            k: k.add(1)
        }
        match foundIdx.equals(-1) {
            true: {
                ctx.builder: ir.emitStore(ctx.builder, "i64", "0", fGr.name)
            }
            _: {
                let fr CodegenResult: emitValue(ctx, fields.at(foundIdx).value)
                ctx: fr.ctx
                let asI64 CodegenResult: irStruct.structFieldToI64(ctx, fr.name, fr.suruType)
                ctx: asI64.ctx
                ctx.builder: ir.emitStore(ctx.builder, "i64", asI64.name, fGr.name)
            }
        }
        i: i.add(1)
    }
    return { ctx: ctx, name: mem, llvmType: "ptr", suruType: typeName }
}

// ─── Temporary allocation predicate ──────────────────────────────────────────────

// Returns true when evaluating `node` produces a fresh heap allocation that no
// variable owns — i.e. the caller is responsible for dropping it after use.
// VarRefNode and FieldAccessNode merely load a pointer owned elsewhere; every
// other node kind (StrLitNode, MethodCallNode, CallNode, …) allocates on the heap.
fn isExprTemp(node AstNode) Bool {
    match node {
        VarRefNode:      { return false }
        FieldAccessNode: { return false }
        _:               { return true }
    }
}

// Returns true when a node definitely produces a new heap-owned String allocation
// that the caller is responsible for freeing after use.
// StrLitNode is excluded: literals are now static globals (type_tag=7) — no allocation.
// CallNode is excluded: user functions may return borrowed references (e.g.
// lookupSymbol returns a ptr into the symbol table — dropping it corrupts the table).
// "at" is excluded because Array<String>.at() returns a borrowed element pointer.
fn isPrintTempString(node AstNode) Bool {
    match node {
        MethodCallNode: {
            match node.methodName.equals("toString") { true: { return true } _: {} }
            match node.methodName.equals("append")   { true: { return true } _: {} }
            match node.methodName.equals("slice")    { true: { return true } _: {} }
            return false
        }
        _: { return false }
    }
}

// Extends isPrintTempString for String-context receivers and arguments.
// String.at(i) creates a new heap char String — unlike Array<T>.at() which is
// a borrowed pointer — and must be dropped after use.
// Checks the variable's type via lookupVar to distinguish String.at() from
// Array.at() when both appear as .at() method calls.
fn isOwnedStringTemp(ctx IrCodegenContext, node AstNode) Bool {
    match isPrintTempString(node) { true: { return true } _: {} }
    match node {
        MethodCallNode: {
            let nodeMethod String: node.methodName
            match nodeMethod.equals("at") {
                true: {
                    let nodeRecv AstNode: node.receiver
                    match nodeRecv {
                        VarRefNode: {
                            let recvName String: nodeRecv.name
                            let entry VarEntry: types.lookupVar(ctx, recvName)
                            let recvType String: entry.suruType
                            match recvType.equals("String") {
                                true: { return true }
                                _: {}
                            }
                        }
                        _: {}
                    }
                }
                _: {}
            }
        }
        _: {}
    }
    return false
}

// Walk a `__append` receiver chain down to its root lvalue. Returns the alloca
// slot of the root VarRef when it is a bound local, else "". This lets every
// link of `s.__append(a).__append(b)` rebind the same variable slot, so the
// final result lands in `s` and intermediates are freed exactly once.
fn appendRootSlot(ctx IrCodegenContext, node AstNode) String {
    match node {
        MethodCallNode: {
            match node.methodName.equals("__append") {
                true: { return appendRootSlot(ctx, node.receiver) }
                _: { return "" }
            }
        }
        VarRefNode: {
            let entry VarEntry: types.lookupVar(ctx, node.name)
            match entry.name.equals("") {
                true: { return "" }
                _: { return entry.allocaName }
            }
        }
        _: { return "" }
    }
}

// ─── Main value dispatch ────────────────────────────────────────────────────────

// Emit IR for any expression node, returning the SSA name and Suru type.
// All sub-expressions are emitted here or in helpers;
// helper files (string/array/struct) never call emitValue themselves.
fn emitValue(ctx IrCodegenContext, expr AstNode) CodegenResult {
    match expr {
        IntLitNode: {
            return { ctx: ctx, name: expr.text, llvmType: "i64", suruType: "Int64" }
        }
        BoolLitNode: {
            let bv String: match expr.boolVal { true: "1", _: "0" }
            return { ctx: ctx, name: bv, llvmType: "i1", suruType: "Bool" }
        }
        FloatLitNode: {
            // LLVM requires float literals in IEEE-754 hex form (e.g. 0x3FF3333333333333).
            // fval.llvmHex() calls @suru_float64_to_llvm_hex at the codegen binary's runtime.
            let fval Float64: Float64.from(expr.text)
            let hexLit String: fval.llvmHex()
            return { ctx: ctx, name: hexLit, llvmType: "double", suruType: "Float64" }
        }
        StrLitNode: {
            return irStr.emitStringLiteralValue(ctx, expr.text)
        }
        CharLitNode: {
            // expr.text is the one decoded character; fold its byte value to an
            // i8 immediate at codegen time — no runtime call, no allocation.
            let code Int64: expr.text.ord()
            return { ctx: ctx, name: code.toString(), llvmType: "i8", suruType: "Char" }
        }
        VarRefNode: {
            return eh.emitVarLoad(ctx, expr.name)
        }
        FieldAccessNode: {
            let rr CodegenResult: emitValue(ctx, expr.receiver)
            ctx: rr.ctx
            return irStruct.emitFieldAccess(ctx, rr.name, rr.suruType, expr.fieldName)
        }
        ArrayLitNode: {
            // Element type derived from the resolvedType annotation written by
            // semantic analysis (`Array:Foo` → `Foo`). Empty literals without a
            // surrounding expectation still resolve to `Array:Int64` per the
            // semantic pass fallback.
            let elemSuruType String: tyh.elemSuruType(expr.resolvedType)
            return emitArrayLit(ctx, expr.elems, elemSuruType)
        }
        StructLitNode: {
            // Resolved type comes from the semantic pass via top-down
            // expectation propagation; no longer relies on the surrounding
            // return-type context.
            return emitStructLit(ctx, expr.fields, expr.resolvedType)
        }
        VtableRefNode: {
            // Emit the module-level vtable constant (once; addDecl dedups) and
            // yield its global symbol. emitStructLit's structFieldToI64 will
            // ptrtoint it into the object's `__vtable` slot.
            let vr VtableRefNode: expr
            let ents Array<String>: vr.entries
            let n Int64: ents.len()
            let body String: ""
            let ei Int64: 0
            while ei.lt(n) {
                let sep String: match ei.gt(0) { true: ", ", _: "" }
                body: body.append(sep).append("ptr @").append(ents.at(ei))
                ei: ei.add(1)
            }
            let line String: vr.sym.append(" = private constant [").append(n.toString()).append(" x ptr] [").append(body).append("]\n")
            ctx: types.addDecl(ctx, line)
            return { ctx: ctx, name: vr.sym, llvmType: "ptr", suruType: "__vtable" }
        }
        CallNode: {
            match expr.name.equals("readFile") {
                true: {
                    let pathArg AstNode: expr.args.at(0)
                    match pathArg {
                        StrLitNode: {
                            ctx: strIntern.internString(ctx, pathArg.text)
                            let gname String: strIntern.lookupStrGlobal(ctx, pathArg.text)
                            return irFile.emitReadFileLit(ctx, gname)
                        }
                        _: {
                            let ar CodegenResult: emitValue(ctx, pathArg)
                            ctx: ar.ctx
                            return irFile.emitReadFile(ctx, ar.name)
                        }
                    }
                }
                _: {}
            }
            match expr.name.equals("clone") {
                true: {
                    let ar CodegenResult: emitValue(ctx, expr.args.at(0))
                    ctx: ar.ctx
                    return eh.emitCloneDyn(ctx, ar.name, ar.suruType)
                }
                _: {}
            }
            match expr.name.equals("drop") {
                true: {
                    let ar CodegenResult: emitValue(ctx, expr.args.at(0))
                    ctx: ar.ctx
                    return eh.emitDropDyn(ctx, ar.name, ar.suruType)
                }
                _: {}
            }
            match expr.name.equals("exec") {
                true: {
                    ctx: types.addDecl(ctx, "declare i32 @system(ptr)\n")
                    let cmdArg AstNode: expr.args.at(0)
                    match cmdArg {
                        StrLitNode: {
                            ctx: strIntern.internString(ctx, cmdArg.text)
                            let gname String: strIntern.lookupStrGlobal(ctx, cmdArg.text)
                            let sysArgs Array<String>: []
                            sysArgs.add("ptr ".append(gname))
                            let cr IrResult: ir.emitCall(ctx.builder, "i32", "system", sysArgs)
                            ctx.builder: cr.builder
                            let sr IrResult: ir.emitSext(ctx.builder, "i32", cr.name, "i64")
                            ctx.builder: sr.builder
                            return { ctx: ctx, name: sr.name, llvmType: "i64", suruType: "Int64" }
                        }
                        _: {
                            let ar CodegenResult: emitValue(ctx, cmdArg)
                            ctx: ar.ctx
                            let dataR CodegenResult: irFile.extractStringData(ctx, ar.name)
                            ctx: dataR.ctx
                            let sysArgs Array<String>: []
                            sysArgs.add("ptr ".append(dataR.name))
                            let cr IrResult: ir.emitCall(ctx.builder, "i32", "system", sysArgs)
                            ctx.builder: cr.builder
                            let sr IrResult: ir.emitSext(ctx.builder, "i32", cr.name, "i64")
                            ctx.builder: sr.builder
                            match isPrintTempString(cmdArg) {
                                true: {
                                    let dr CodegenResult: irStr.emitStringDrop(ctx, ar.name)
                                    ctx: dr.ctx
                                }
                                _: {}
                            }
                            return { ctx: ctx, name: sr.name, llvmType: "i64", suruType: "Int64" }
                        }
                    }
                }
                _: {}
            }
            return emitUserFnCall(ctx, expr.name, expr.args)
        }
        MethodCallNode: {
            return emitMethodCall(ctx, expr)
        }
        MatchExprNode: {
            return emitMatchExpr(ctx, expr)
        }
        UnaryNode: {
            let opr CodegenResult: emitValue(ctx, expr.operand)
            ctx: opr.ctx
            return eh.emitBoolNot(ctx, opr.name, opr.suruType)
        }
        BinaryNode: {
            let lr CodegenResult: emitValue(ctx, expr.left)
            ctx: lr.ctx
            let rr CodegenResult: emitValue(ctx, expr.right)
            ctx: rr.ctx
            return eh.emitBinaryExpr(ctx, lr.name, lr.suruType, rr.name, rr.suruType, expr.op)
        }
        _: {
            return { ctx: ctx, name: "null", llvmType: "ptr", suruType: "" }
        }
    }
}

// Peek the Suru type of an expression node without emitting IR.
// Used by emitMatchExpr to choose the result alloca LLVM type.
// Returns CodegenResult with only suruType set (name/llvmType are irrelevant).
//
// After Task 4 of the resolved-type migration, every expression variant
// carries a `resolvedType` field populated by semantic analysis. This
// function simply reads it from each variant — no more per-method tables,
// scope lookups, or recursive peeks.
fn peekTypeNode(ctx IrCodegenContext, expr AstNode) CodegenResult {
    let st String: ""
    match expr {
        BoolLitNode:     { st: expr.resolvedType }
        IntLitNode:      { st: expr.resolvedType }
        FloatLitNode:    { st: expr.resolvedType }
        StrLitNode:      { st: expr.resolvedType }
        CharLitNode:     { st: expr.resolvedType }
        VarRefNode:      { st: expr.resolvedType }
        CallNode:        { st: expr.resolvedType }
        MethodCallNode:  { st: expr.resolvedType }
        FieldAccessNode: { st: expr.resolvedType }
        ArrayLitNode:    { st: expr.resolvedType }
        StructLitNode:   { st: expr.resolvedType }
        MatchExprNode:   { st: expr.resolvedType }
        UnaryNode:       { st: expr.resolvedType }
        BinaryNode:      { st: expr.resolvedType }
        _: { st: "Int64" }
    }
    return { ctx: ctx, name: "", llvmType: box.llvmTypeOf(st), suruType: st }
}

// ─── Method call dispatch ────────────────────────────────────────────────────────

// Dispatch a MethodCallNode to the appropriate helper.
// Emit a virtual method call: load the object's vtable pointer, index to the
// method's slot, and indirect-call it with `this` (the receiver ptr) as the
// implicit first argument. `decl` is the receiver's object TypeDecl, `mIdx`
// the method's vtable index (== declared-method order).
fn emitObjectMethodCall(ctx IrCodegenContext, expr MethodCallNode, recvVal String, decl TypeDecl, method String, mIdx Int64) CodegenResult {
    let me TypeMethodEntry: types.methodEntry(decl, method)
    // __vtable is field slot 0: load the i64 slot and turn it into a ptr.
    let vtOff Int64: irStruct.fieldOffset(0)
    let slotR IrResult: ir.emitGEP(ctx.builder, "i8", recvVal, "i64 ".append(vtOff.toString()))
    ctx.builder: slotR.builder
    let rawR IrResult: ir.emitLoad(ctx.builder, "i64", slotR.name)
    ctx.builder: rawR.builder
    let vtR IrResult: ir.emitIntToPtr(ctx.builder, rawR.name)
    ctx.builder: vtR.builder
    // GEP to the method's pointer slot in the vtable array, then load the fp.
    let fpSlotR IrResult: ir.emitGEP(ctx.builder, "ptr", vtR.name, "i64 ".append(mIdx.toString()))
    ctx.builder: fpSlotR.builder
    let fpR IrResult: ir.emitLoad(ctx.builder, "ptr", fpSlotR.name)
    ctx.builder: fpR.builder
    // Build the argument list: `this` first, then coerced declared params.
    let argParts Array<String>: []
    argParts.add("ptr ".append(recvVal))
    let args Array<AstNode>: expr.args
    let pts Array<String>: me.paramTypes
    let i Int64: 0
    while i.lt(args.len()) {
        let ar CodegenResult: emitValue(ctx, args.at(i))
        ctx: ar.ctx
        let pSuru String: match i.lt(pts.len()) {
            true: tyh.makeSuruType(pts.at(i))
            _:    ar.suruType
        }
        let pLlvm String: box.llvmTypeOf(pSuru)
        let finalVal String: ar.name
        match box.isScalarType(pSuru) {
            true: {
                match box.isScalarType(ar.suruType) {
                    true: {}
                    _: {
                        let ur CodegenResult: box.unboxScalar(ctx, ar.name, pSuru)
                        ctx: ur.ctx
                        finalVal: ur.name
                    }
                }
            }
            _: {}
        }
        argParts.add(pLlvm.append(" ").append(finalVal))
        i: i.add(1)
    }
    let isVoid Bool: me.returnType.equals("void")
    let retSuru String: tyh.makeSuruType(me.returnType)
    let retLlvm String: match isVoid { true: "ptr", _: box.llvmTypeOf(retSuru) }
    let callR IrResult: ir.emitIndirectCall(ctx.builder, retLlvm, fpR.name, argParts)
    ctx.builder: callR.builder
    let outSuru String: match isVoid { true: "void", _: retSuru }
    return { ctx: ctx, name: callR.name, llvmType: retLlvm, suruType: outSuru }
}

fn emitMethodCall(ctx IrCodegenContext, expr MethodCallNode) CodegenResult {
    let method String: expr.methodName
    let recv AstNode: expr.receiver

    // Namespace alias call: receiver VarRef not in local scope → direct fn call.
    match recv {
        VarRefNode: {
            let recvName String: recv.name
            let lookupResult VarEntry: types.lookupVar(ctx, recvName)
            match lookupResult.name.equals("") {
                true: {
                    // Not in local scope — check if static builtin type or namespace alias.
                    let isBuiltin Bool: tyh.isBuiltinSuruType(recvName)
                    match isBuiltin {
                        true: {}
                        _: {
                            // Not in scope, not a builtin type name → namespace call.
                            // Resolve the alias to the callee file and mangle to
                            // that file's symbol; fall back to name-based mangling
                            // when the receiver isn't a known alias.
                            let nsSrc String: lookupAliasSrc(ctx, recvName)
                            match nsSrc.equals("") {
                                true:  { return emitUserFnCall(ctx, method, expr.args) }
                                _:     { return emitUserFnCallSym(ctx, method, mangleSym(nsSrc, method), expr.args) }
                            }
                        }
                    }
                }
                _: {}
            }
            // Static type methods.
            match recvName.equals("Int64")   { true: { return emitInt64Static(ctx, method, expr.args)   } _: {} }
            match recvName.equals("Float64") { true: { return emitFloat64Static(ctx, method, expr.args) } _: {} }
            match recvName.equals("Int32")   { true: { return emitInt32Static(ctx, method, expr.args)   } _: {} }
        }
        _: {}
    }

    // Emit receiver.
    let rr CodegenResult: emitValue(ctx, recv)
    ctx: rr.ctx
    let recvVal String: rr.name
    let recvSuruType String: rr.suruType

    // User-defined object method: receiver type declares this method → dispatch
    // through the per-instance vtable pointer in the object's `__vtable` slot.
    let objDecl TypeDecl: types.lookupType(ctx, recvSuruType)
    let omi Int64: types.methodIndex(objDecl, method)
    match omi.lt(0) {
        true: {}
        _: { return emitObjectMethodCall(ctx, expr, recvVal, objDecl, method, omi) }
    }

    // Array instance methods.
    match tyh.isArraySuruType(recvSuruType) {
        true: {
            let elemST String: tyh.elemSuruType(recvSuruType)
            match method.equals("len")   { true: { return irArr.emitArrayLen(ctx, recvVal) } _: {} }
            match method.equals("clone") { true: { return irArr.emitArrayClone(ctx, recvVal, elemST) } _: {} }
            match method.equals("drop")  { true: { return irArr.emitArrayDrop(ctx, recvVal) } _: {} }
            match method.equals("at") {
                true: {
                    let idxR CodegenResult: emitValue(ctx, expr.args.at(0))
                    ctx: idxR.ctx
                    let idxRaw String: idxR.name
                    match box.isScalarType(idxR.suruType) {
                        true: {}
                        _: {
                            let ur CodegenResult: box.unboxInt64(ctx, idxR.name)
                            ctx: ur.ctx
                            idxRaw: ur.name
                        }
                    }
                    return irArr.emitArrayAt(ctx, recvVal, idxRaw, elemST)
                }
                _: {}
            }
            match method.equals("add") {
                true: {
                    // Struct-literal arguments carry their own resolvedType
                    // (written by the semantic pass) so no context threading
                    // is needed.
                    let vr CodegenResult: emitValue(ctx, expr.args.at(0))
                    ctx: vr.ctx
                    ctx: irArr.emitArrayAdd(ctx, recvVal, vr.name, elemST)
                    return { ctx: ctx, name: "0", llvmType: "i1", suruType: "Bool" }
                }
                _: {}
            }
            match method.equals("set") {
                true: {
                    let vr CodegenResult: emitValue(ctx, expr.args.at(0))
                    ctx: vr.ctx
                    let ir2 CodegenResult: emitValue(ctx, expr.args.at(1))
                    ctx: ir2.ctx
                    let idxRaw String: ir2.name
                    match box.isScalarType(ir2.suruType) {
                        true: {}
                        _: {
                            let ur CodegenResult: box.unboxInt64(ctx, ir2.name)
                            ctx: ur.ctx
                            idxRaw: ur.name
                        }
                    }
                    ctx: irArr.emitArraySet(ctx, recvVal, vr.name, elemST, idxRaw)
                    return { ctx: ctx, name: "0", llvmType: "i1", suruType: "Bool" }
                }
                _: {}
            }
            // .slice(from, to) → sub-array via suru_array_slice.
            match method.equals("slice") {
                true: {
                    let s1 CodegenResult: emitValue(ctx, expr.args.at(0))
                    ctx: s1.ctx
                    let s2 CodegenResult: emitValue(ctx, expr.args.at(1))
                    ctx: s2.ctx
                    let i1r String: s1.name
                    let i2r String: s2.name
                    match box.isScalarType(s1.suruType) {
                        true: {}
                        _: {
                            let u CodegenResult: box.unboxInt64(ctx, s1.name)
                            ctx: u.ctx
                            i1r: u.name
                        }
                    }
                    match box.isScalarType(s2.suruType) {
                        true: {}
                        _: {
                            let u2 CodegenResult: box.unboxInt64(ctx, s2.name)
                            ctx: u2.ctx
                            i2r: u2.name
                        }
                    }
                    return irArr.emitArraySlice(ctx, recvVal, i1r, i2r, elemST)
                }
                _: {}
            }
        }
        _: {}
    }

    // String instance methods.
    match recvSuruType.equals("String") {
        true: {
            match method.equals("len") {
                true: {
                    let result CodegenResult: irStr.emitStringLen(ctx, recvVal)
                    ctx: result.ctx
                    match isOwnedStringTemp(ctx, recv) {
                        true: {
                            let dr CodegenResult: irStr.emitStringDrop(ctx, recvVal)
                            ctx: dr.ctx
                        }
                        _: {}
                    }
                    return { ctx: ctx, name: result.name, llvmType: result.llvmType, suruType: result.suruType }
                }
                _: {}
            }
            match method.equals("clone")  { true: { return irStr.emitStringClone(ctx, recvVal) } _: {} }
            match method.equals("drop")   { true: { return irStr.emitStringDrop(ctx, recvVal) } _: {} }
            match method.equals("ord") {
                true: {
                    let result CodegenResult: irStr.emitStringOrd(ctx, recvVal)
                    ctx: result.ctx
                    match isOwnedStringTemp(ctx, recv) {
                        true: {
                            let dr CodegenResult: irStr.emitStringDrop(ctx, recvVal)
                            ctx: dr.ctx
                        }
                        _: {}
                    }
                    return { ctx: ctx, name: result.name, llvmType: result.llvmType, suruType: result.suruType }
                }
                _: {}
            }
            match method.equals("toString") { true: { return { ctx: ctx, name: recvVal, llvmType: "ptr", suruType: "String" } } _: {} }
            match method.equals("llvmHex") { true: { return irStr.emitFloat64LlvmHex(ctx, recvVal) } _: {} }
            match method.equals("append") {
                true: {
                    let argNode AstNode: expr.args.at(0)
                    match argNode {
                        StrLitNode: {
                            ctx: strIntern.internString(ctx, argNode.text)
                            let gname String: strIntern.lookupStrGlobal(ctx, argNode.text)
                            let charLen Int64: argNode.text.len()
                            let result CodegenResult: irStr.emitStringAppendLit(ctx, recvVal, gname, charLen)
                            ctx: result.ctx
                            match isOwnedStringTemp(ctx, recv) {
                                true: {
                                    let dr CodegenResult: irStr.emitStringDrop(ctx, recvVal)
                                    ctx: dr.ctx
                                }
                                _: {}
                            }
                            return { ctx: ctx, name: result.name, llvmType: result.llvmType, suruType: result.suruType }
                        }
                        _: {
                            let ar CodegenResult: emitValue(ctx, argNode)
                            ctx: ar.ctx
                            match ar.suruType.equals("Char") {
                                true: {
                                    let cresult CodegenResult: irStr.emitStringAppendChar(ctx, recvVal, ar.name)
                                    ctx: cresult.ctx
                                    match isOwnedStringTemp(ctx, recv) {
                                        true: {
                                            let dr CodegenResult: irStr.emitStringDrop(ctx, recvVal)
                                            ctx: dr.ctx
                                        }
                                        _: {}
                                    }
                                    return { ctx: ctx, name: cresult.name, llvmType: "ptr", suruType: "String" }
                                }
                                _: {}
                            }
                            let result CodegenResult: irStr.emitStringAppend(ctx, recvVal, ar.name)
                            ctx: result.ctx
                            match isOwnedStringTemp(ctx, argNode) {
                                true: {
                                    let dr CodegenResult: irStr.emitStringDrop(ctx, ar.name)
                                    ctx: dr.ctx
                                }
                                _: {}
                            }
                            match isOwnedStringTemp(ctx, recv) {
                                true: {
                                    let dr CodegenResult: irStr.emitStringDrop(ctx, recvVal)
                                    ctx: dr.ctx
                                }
                                _: {}
                            }
                            return { ctx: ctx, name: result.name, llvmType: result.llvmType, suruType: result.suruType }
                        }
                    }
                }
                _: {}
            }
            match method.equals("__append") {
                true: {
                    // Observable in-place append: build the full result in a
                    // fresh buffer, drop the old receiver, rebind the root slot.
                    let rootSlot String: appendRootSlot(ctx, recv)
                    let argNode AstNode: expr.args.at(0)
                    let newPtr String: ""
                    match argNode {
                        StrLitNode: {
                            ctx: strIntern.internString(ctx, argNode.text)
                            let gname String: strIntern.lookupStrGlobal(ctx, argNode.text)
                            let charLen Int64: argNode.text.len()
                            let result CodegenResult: irStr.emitStringAppendLit(ctx, recvVal, gname, charLen)
                            ctx: result.ctx
                            newPtr: result.name
                        }
                        _: {
                            let ar CodegenResult: emitValue(ctx, argNode)
                            ctx: ar.ctx
                            let result CodegenResult: irStr.emitStringAppend(ctx, recvVal, ar.name)
                            ctx: result.ctx
                            newPtr: result.name
                            match isOwnedStringTemp(ctx, argNode) {
                                true: {
                                    let adr CodegenResult: irStr.emitStringDrop(ctx, ar.name)
                                    ctx: adr.ctx
                                }
                                _: {}
                            }
                        }
                    }
                    // Drop the old receiver value: no-op on type_tag=8 literals,
                    // frees heap strings (bytes already copied into newPtr).
                    let rdr CodegenResult: irStr.emitStringDrop(ctx, recvVal)
                    ctx: rdr.ctx
                    match rootSlot.equals("") {
                        true: {}
                        _: { ctx.builder: ir.emitStore(ctx.builder, "ptr", newPtr, rootSlot) }
                    }
                    return { ctx: ctx, name: newPtr, llvmType: "ptr", suruType: "String" }
                }
                _: {}
            }
            match method.equals("equals") {
                true: {
                    let eqArg AstNode: expr.args.at(0)
                    match eqArg {
                        StrLitNode: {
                            ctx: strIntern.internString(ctx, eqArg.text)
                            let gname String: strIntern.lookupStrGlobal(ctx, eqArg.text)
                            let result CodegenResult: irStr.emitStringEqualsLit(ctx, recvVal, gname)
                            ctx: result.ctx
                            match isOwnedStringTemp(ctx, recv) {
                                true: {
                                    let dr CodegenResult: irStr.emitStringDrop(ctx, recvVal)
                                    ctx: dr.ctx
                                }
                                _: {}
                            }
                            return { ctx: ctx, name: result.name, llvmType: result.llvmType, suruType: result.suruType }
                        }
                        _: {
                            let ar CodegenResult: emitValue(ctx, eqArg)
                            ctx: ar.ctx
                            let result CodegenResult: irStr.emitStringEquals(ctx, recvVal, ar.name)
                            ctx: result.ctx
                            match isOwnedStringTemp(ctx, eqArg) {
                                true: {
                                    let dr CodegenResult: irStr.emitStringDrop(ctx, ar.name)
                                    ctx: dr.ctx
                                }
                                _: {}
                            }
                            match isOwnedStringTemp(ctx, recv) {
                                true: {
                                    let dr CodegenResult: irStr.emitStringDrop(ctx, recvVal)
                                    ctx: dr.ctx
                                }
                                _: {}
                            }
                            return { ctx: ctx, name: result.name, llvmType: result.llvmType, suruType: result.suruType }
                        }
                    }
                }
                _: {}
            }
            match method.equals("at") {
                true: {
                    let ir2 CodegenResult: emitValue(ctx, expr.args.at(0))
                    ctx: ir2.ctx
                    let idxRaw String: ir2.name
                    match box.isScalarType(ir2.suruType) {
                        true: {}
                        _: {
                            let ur CodegenResult: box.unboxInt64(ctx, ir2.name)
                            ctx: ur.ctx
                            idxRaw: ur.name
                        }
                    }
                    let result CodegenResult: irStr.emitStringAt(ctx, recvVal, idxRaw)
                    ctx: result.ctx
                    match isOwnedStringTemp(ctx, recv) {
                        true: {
                            let dr CodegenResult: irStr.emitStringDrop(ctx, recvVal)
                            ctx: dr.ctx
                        }
                        _: {}
                    }
                    return { ctx: ctx, name: result.name, llvmType: result.llvmType, suruType: result.suruType }
                }
                _: {}
            }
            match method.equals("__at") {
                true: {
                    let ir2 CodegenResult: emitValue(ctx, expr.args.at(0))
                    ctx: ir2.ctx
                    let idxRaw String: ir2.name
                    match box.isScalarType(ir2.suruType) {
                        true: {}
                        _: {
                            let ur CodegenResult: box.unboxInt64(ctx, ir2.name)
                            ctx: ur.ctx
                            idxRaw: ur.name
                        }
                    }
                    let result CodegenResult: irStr.emitStringCharAt(ctx, recvVal, idxRaw)
                    ctx: result.ctx
                    match isOwnedStringTemp(ctx, recv) {
                        true: {
                            let dr CodegenResult: irStr.emitStringDrop(ctx, recvVal)
                            ctx: dr.ctx
                        }
                        _: {}
                    }
                    return { ctx: ctx, name: result.name, llvmType: "i8", suruType: "Char" }
                }
                _: {}
            }
            match method.equals("slice") {
                true: {
                    let s1 CodegenResult: emitValue(ctx, expr.args.at(0))
                    ctx: s1.ctx
                    let s2 CodegenResult: emitValue(ctx, expr.args.at(1))
                    ctx: s2.ctx
                    let i1r String: s1.name
                    let i2r String: s2.name
                    match box.isScalarType(s1.suruType) {
                        true: {}
                        _: {
                            let u CodegenResult: box.unboxInt64(ctx, s1.name)
                            ctx: u.ctx
                            i1r: u.name
                        }
                    }
                    match box.isScalarType(s2.suruType) {
                        true: {}
                        _: {
                            let u2 CodegenResult: box.unboxInt64(ctx, s2.name)
                            ctx: u2.ctx
                            i2r: u2.name
                        }
                    }
                    let result CodegenResult: irStr.emitStringSlice(ctx, recvVal, i1r, i2r)
                    ctx: result.ctx
                    match isOwnedStringTemp(ctx, recv) {
                        true: {
                            let dr CodegenResult: irStr.emitStringDrop(ctx, recvVal)
                            ctx: dr.ctx
                        }
                        _: {}
                    }
                    return { ctx: ctx, name: result.name, llvmType: result.llvmType, suruType: result.suruType }
                }
                _: {}
            }
            match method.equals("compare") {
                true: {
                    let cr CodegenResult: emitValue(ctx, expr.args.at(0))
                    ctx: cr.ctx
                    let result CodegenResult: irStr.emitStringCompare(ctx, recvVal, cr.name)
                    ctx: result.ctx
                    match isOwnedStringTemp(ctx, expr.args.at(0)) {
                        true: {
                            let dr CodegenResult: irStr.emitStringDrop(ctx, cr.name)
                            ctx: dr.ctx
                        }
                        _: {}
                    }
                    match isOwnedStringTemp(ctx, recv) {
                        true: {
                            let dr CodegenResult: irStr.emitStringDrop(ctx, recvVal)
                            ctx: dr.ctx
                        }
                        _: {}
                    }
                    return { ctx: ctx, name: result.name, llvmType: result.llvmType, suruType: result.suruType }
                }
                _: {}
            }
        }
        _: {}
    }

    // Char receiver: scalar i8 value. Must precede the Float64/struct/generic
    // tail so .ord/.toString/.equals aren't mis-routed (e.g. generic toString
    // would unboxInt64 a Char). No drops — Char is never heap-allocated.
    match recvSuruType.equals("Char") {
        true: {
            match method.equals("ord") {
                true: {
                    let zr IrResult: ir.emitZext(ctx.builder, "i8", recvVal, "i64")
                    ctx.builder: zr.builder
                    return { ctx: ctx, name: zr.name, llvmType: "i64", suruType: "Int64" }
                }
                _: {}
            }
            match method.equals("toString") {
                true: { return irStr.emitStringFromChar(ctx, recvVal) }
                _: {}
            }
            match method.equals("equals") {
                true: {
                    let ar CodegenResult: emitValue(ctx, expr.args.at(0))
                    ctx: ar.ctx
                    return eh.emitCmpOp(ctx, "eq", "oeq", recvVal, "Char", ar.name, ar.suruType)
                }
                _: {}
            }
        }
        _: {}
    }

    // llvmHex on Float64 receiver — converts a double to LLVM IEEE-754 hex string.
    // Must be dispatched for Float64 receivers; llvmHex is never called on String.
    match recvSuruType.equals("Float64") {
        true: {
            match method.equals("llvmHex") { true: { return irStr.emitFloat64LlvmHex(ctx, recvVal) } _: {} }
        }
        _: {}
    }

    // toString on Int64/NamedType (struct field returned as i64).
    match method.equals("toString") {
        true: {
            let rawI String: recvVal
            match box.isScalarType(recvSuruType) {
                true: {}
                _: {
                    let ur CodegenResult: box.unboxInt64(ctx, recvVal)
                    ctx: ur.ctx
                    rawI: ur.name
                }
            }
            return irStr.emitInt64ToString(ctx, rawI)
        }
        _: {}
    }

    // Struct clone/drop dispatch.
    match method.equals("clone") { true: { return irStruct.emitStructClone(ctx, recvVal, recvSuruType) } _: {} }
    match method.equals("drop")  { true: { return irStruct.emitStructDrop(ctx, recvVal)  } _: {} }

    // invert / compare — arithmetic on receiver.
    match method.equals("invert")  { true: { return eh.emitInvert(ctx, recvVal, recvSuruType) } _: {} }
    match method.equals("compare") {
        true: {
            let ar CodegenResult: emitValue(ctx, expr.args.at(0))
            ctx: ar.ctx
            return eh.emitCompare(ctx, recvVal, recvSuruType, ar.name, ar.suruType)
        }
        _: {}
    }

    // Arithmetic / comparison fallthrough.
    let ar CodegenResult: emitValue(ctx, expr.args.at(0))
    ctx: ar.ctx
    match method.equals("add")      { true: { return eh.emitArith(ctx, "add",  "fadd", recvVal, recvSuruType, ar.name, ar.suruType) } _: {} }
    match method.equals("take")     { true: { return eh.emitArith(ctx, "sub",  "fsub", recvVal, recvSuruType, ar.name, ar.suruType) } _: {} }
    match method.equals("multiply") { true: { return eh.emitArith(ctx, "mul",  "fmul", recvVal, recvSuruType, ar.name, ar.suruType) } _: {} }
    match method.equals("split")    { true: { return eh.emitArith(ctx, "sdiv", "fdiv", recvVal, recvSuruType, ar.name, ar.suruType) } _: {} }
    match method.equals("lt")     { true: { return eh.emitCmpOp(ctx, "slt", "olt", recvVal, recvSuruType, ar.name, ar.suruType) } _: {} }
    match method.equals("gt")     { true: { return eh.emitCmpOp(ctx, "sgt", "ogt", recvVal, recvSuruType, ar.name, ar.suruType) } _: {} }
    match method.equals("lte")    { true: { return eh.emitCmpOp(ctx, "sle", "ole", recvVal, recvSuruType, ar.name, ar.suruType) } _: {} }
    match method.equals("gte")    { true: { return eh.emitCmpOp(ctx, "sge", "oge", recvVal, recvSuruType, ar.name, ar.suruType) } _: {} }
    match method.equals("equals") { true: { return eh.emitCmpOp(ctx, "eq",  "oeq", recvVal, recvSuruType, ar.name, ar.suruType) } _: {} }

    // Unreachable: unknown method — return dummy value.
    return { ctx: ctx, name: "null", llvmType: "ptr", suruType: "" }
}

// ─── Match emission ────────────────────────────────────────────────────────────

// Narrow the condition variable's suruType to the concrete variant type for the
// duration of a match arm so field accesses resolve without re-binding.
// Only narrows when the variable's type is a sum type name.
fn narrowCondVar(ctx IrCodegenContext, condVarName String, variantTypeName String) IrCodegenContext {
    match condVarName.equals("")    { true: { return ctx } _: {} }
    match variantTypeName.equals("") { true: { return ctx } _: {} }
    let v VarEntry: types.lookupVar(ctx, condVarName)
    match v.name.equals("") { true: { return ctx } _: {} }
    match types.isSumTypeName(ctx, v.suruType) {
        true: {
            let narrowed VarEntry: { name: v.name, allocaName: v.allocaName, suruType: variantTypeName }
            ctx: types.updateVar(ctx, condVarName, narrowed)
        }
        _: {}
    }
    return ctx
}

// Restore the condition variable's original VarEntry after a narrowed arm.
fn restoreCondVar(ctx IrCodegenContext, condVarName String, original VarEntry) IrCodegenContext {
    match condVarName.equals("") { true: { return ctx } _: {} }
    return types.updateVar(ctx, condVarName, original)
}

// Collect the non-wildcard patterns from a MatchArm array.
// Returns an array of AstNode patterns (one per non-wildcard arm, in order).
fn collectPatterns(arms Array<MatchArm>) Array<AstNode> {
    let pats Array<AstNode>: []
    let i Int64: 0
    while i.lt(arms.len()) {
        let arm MatchArm: arms.at(i)
        match arm.isWildcard { true: {} _: { pats.add(arm.pattern) } }
        i: i.add(1)
    }
    return pats
}

// Collect the non-wildcard patterns from a MatchStmtArm array.
fn collectStmtPatterns(arms Array<MatchStmtArm>) Array<AstNode> {
    let pats Array<AstNode>: []
    let i Int64: 0
    while i.lt(arms.len()) {
        let arm MatchStmtArm: arms.at(i)
        match arm.isWildcard { true: {} _: { pats.add(arm.pattern) } }
        i: i.add(1)
    }
    return pats
}

// Emit the comparison chain for a list of non-wildcard patterns.
// Each pattern gets an icmp/fcmp/strcmp/variant-tag comparison; branches to
// match_arm_{n}_{i} on success or the next test / missLabel on miss.
// For sum-type conditions, @suru_variant_tag is called ONCE before the loop.
fn emitPatternComparisons(ctx IrCodegenContext, condVal String, condSuruType String, patterns Array<AstNode>, hasWildcard Bool, matchN String) IrCodegenContext {
    let missLabel String: match hasWildcard {
        true: "match_wildcard_".append(matchN)
        _:    "match_merge_".append(matchN)
    }
    // Detect sum type / variant condition.
    let isSum Bool: types.isVariant(ctx, condSuruType)
    match isSum { true: {} _: { match types.isSumTypeName(ctx, condSuruType) { true: { isSum: true } _: {} } } }
    // rawCond: the value used in comparisons (tag i64 for sum types, condVal otherwise).
    let rawCond String: condVal
    match isSum {
        true: {
            ctx: types.addSuruDecl(ctx, "declare i64  @suru_variant_tag(ptr)\n")
            let args Array<String>: []
            args.add("ptr ".append(condVal))
            let tr IrResult: ir.emitCall(ctx.builder, "i64", "suru_variant_tag", args)
            ctx.builder: tr.builder
            rawCond: tr.name
        }
        _: {
            // NamedType (non-variant) → unbox to i64 for comparison.
            match box.isScalarType(condSuruType) { true: {} _: {
                match condSuruType.equals("String") { true: {} _: {
                    let ur CodegenResult: box.unboxInt64(ctx, condVal)
                    ctx: ur.ctx
                    rawCond: ur.name
                } }
            } }
        }
    }

    let i Int64: 0
    while i.lt(patterns.len()) {
        let pat AstNode: patterns.at(i)
        let iStr String: i.toString()
        let nextLabel String: match i.add(1).lt(patterns.len()) {
            true: "match_test_".append(matchN).append("_").append(i.add(1).toString())
            _:    missLabel
        }
        // Pre-allocate comparison result name before emitting operands so the icmp SSA name
        // has a lower number than the operand intermediates (dominance ordering invariant).
        let preR CodegenResult: box.ctxNextTmp(ctx)
        ctx: preR.ctx
        let cmpTmp String: preR.name
        let cmpVal String: ""
        match isSum {
            true: {
                // Pattern is a VarRefNode naming a variant — never call emitValue.
                match pat { VarRefNode: {
                    let parent SumTypeDecl: types.findParentSumType(ctx, pat.name)
                    let idx Int64: types.variantIdx(parent, pat.name)
                    ctx.builder: ir.emit(ctx.builder, "  ".append(cmpTmp).append(" = icmp eq i64 ").append(rawCond).append(", ").append(idx.toString()).append("\n"))
                    cmpVal: cmpTmp
                } _: {} }
            }
            _: {
                match condSuruType.equals("String") {
                    true: {
                        ctx: types.addDecl(ctx, "declare i32 @strcmp(ptr, ptr)\n")
                        let pr CodegenResult: emitValue(ctx, pat)
                        ctx: pr.ctx
                        let d1 CodegenResult: irStr.emitExtractStringData(ctx, rawCond)
                        ctx: d1.ctx
                        let d2 CodegenResult: irStr.emitExtractStringData(d1.ctx, pr.name)
                        ctx: d2.ctx
                        let args Array<String>: []
                        args.add("ptr ".append(d1.name))
                        args.add("ptr ".append(d2.name))
                        let sr IrResult: ir.emitCall(ctx.builder, "i32", "strcmp", args)
                        ctx.builder: sr.builder
                        ctx.builder: ir.emit(ctx.builder, "  ".append(cmpTmp).append(" = icmp eq i32 ").append(sr.name).append(", 0\n"))
                        cmpVal: cmpTmp
                    }
                    _: {
                        let pr CodegenResult: emitValue(ctx, pat)
                        ctx: pr.ctx
                        let eff String: eh.effectiveSuruType(condSuruType)
                        let rawT String: box.rawLlvmTypeOf(eff)
                        let patRaw String: pr.name
                        match box.isScalarType(pr.suruType) { true: {} _: {
                            let ur CodegenResult: box.unboxInt64(ctx, pr.name)
                            ctx: ur.ctx
                            patRaw: ur.name
                        } }
                        match eff.equals("Float64") {
                            true: {
                                ctx.builder: ir.emit(ctx.builder, "  ".append(cmpTmp).append(" = fcmp oeq double ").append(rawCond).append(", ").append(patRaw).append("\n"))
                            }
                            _: {
                                ctx.builder: ir.emit(ctx.builder, "  ".append(cmpTmp).append(" = icmp eq ").append(rawT).append(" ").append(rawCond).append(", ").append(patRaw).append("\n"))
                            }
                        }
                        cmpVal: cmpTmp
                    }
                }
            }
        }
        ctx.builder: ir.emitCondBr(ctx.builder, cmpVal, "match_arm_".append(matchN).append("_").append(iStr), nextLabel)
        match i.add(1).lt(patterns.len()) {
            true: { ctx.builder: ir.emitLabel(ctx.builder, "match_test_".append(matchN).append("_").append(i.add(1).toString())) }
            _: {}
        }
        i: i.add(1)
    }
    match patterns.len().equals(0) {
        true: { ctx.builder: ir.emitBr(ctx.builder, missLabel) }
        _: {}
    }
    return ctx
}

// Emit a match-as-expression.  Result alloca MUST be emitted BEFORE the comparison
// chain (LLVM dominance invariant).
fn emitMatchExpr(ctx IrCodegenContext, node MatchExprNode) CodegenResult {
    // Peek result type from first non-wildcard arm.
    let resultSuruType String: "Int64"
    let i Int64: 0
    while i.lt(node.arms.len()) {
        let arm MatchArm: node.arms.at(i)
        match arm.isWildcard { true: {} _: {
            let pr CodegenResult: peekTypeNode(ctx, arm.body)
            resultSuruType: pr.suruType
            i: node.arms.len()
        } }
        i: i.add(1)
    }
    let resultLlvm String: box.llvmTypeOf(resultSuruType)

    // Alloca BEFORE test chain — dominates all arm blocks.
    let mnR IrResult: ir.nextLabelNum(ctx.builder)
    ctx.builder: mnR.builder
    let matchN String: mnR.name
    let resultAlloca String: "match_result_".append(matchN)
    ctx.builder: ir.emitFixedAlloca(ctx.builder, resultAlloca, resultLlvm)

    // Emit comparison chain.
    let condR CodegenResult: emitValue(ctx, node.condition)
    ctx: condR.ctx
    let patterns Array<AstNode>: collectPatterns(node.arms)
    let hasWild Bool: false
    let j Int64: 0
    while j.lt(node.arms.len()) { match node.arms.at(j).isWildcard { true: { hasWild: true } _: {} } j: j.add(1) }
    ctx: emitPatternComparisons(ctx, condR.name, condR.suruType, patterns, hasWild, matchN)

    // Emit arm bodies — store result + branch to merge.
    let condVarName String: ""
    let condExpr AstNode: node.condition
    match condExpr { VarRefNode: { condVarName: condExpr.name } _: {} }
    let patIdx Int64: 0
    let k Int64: 0
    while k.lt(node.arms.len()) {
        let arm MatchArm: node.arms.at(k)
        match arm.isWildcard {
            true: {
                ctx.builder: ir.emitLabel(ctx.builder, "match_wildcard_".append(matchN))
                let armR CodegenResult: emitValue(ctx, arm.body)
                ctx: armR.ctx
                ctx.builder: ir.emitStore(ctx.builder, resultLlvm, armR.name, "%".append(resultAlloca))
                ctx.builder: ir.emitBr(ctx.builder, "match_merge_".append(matchN))
            }
            _: {
                // Narrow condition var for variant arms.
                let origEntry VarEntry: types.lookupVar(ctx, condVarName)
                let variantName String: ""
                let patNode AstNode: arm.pattern
                match patNode { VarRefNode: { variantName: patNode.name } _: {} }
                ctx: narrowCondVar(ctx, condVarName, variantName)
                ctx.builder: ir.emitLabel(ctx.builder, "match_arm_".append(matchN).append("_").append(patIdx.toString()))
                let armR CodegenResult: emitValue(ctx, arm.body)
                ctx: armR.ctx
                ctx: restoreCondVar(ctx, condVarName, origEntry)
                ctx.builder: ir.emitStore(ctx.builder, resultLlvm, armR.name, "%".append(resultAlloca))
                ctx.builder: ir.emitBr(ctx.builder, "match_merge_".append(matchN))
                patIdx: patIdx.add(1)
            }
        }
        k: k.add(1)
    }

    ctx.builder: ir.emitLabel(ctx.builder, "match_merge_".append(matchN))
    let loadR IrResult: ir.emitLoad(ctx.builder, resultLlvm, "%".append(resultAlloca))
    ctx.builder: loadR.builder
    return { ctx: ctx, name: loadR.name, llvmType: resultLlvm, suruType: resultSuruType }
}

// Emit a MatchExprNode used as a statement (side-effects only, no result stored).
fn emitMatchExprAsStmt(ctx IrCodegenContext, node MatchExprNode) IrCodegenContext {
    let condR CodegenResult: emitValue(ctx, node.condition)
    ctx: condR.ctx
    let patterns Array<AstNode>: collectPatterns(node.arms)
    let hasWild Bool: false
    let j Int64: 0
    while j.lt(node.arms.len()) { match node.arms.at(j).isWildcard { true: { hasWild: true } _: {} } j: j.add(1) }
    let mnR IrResult: ir.nextLabelNum(ctx.builder)
    ctx.builder: mnR.builder
    let matchN String: mnR.name
    ctx: emitPatternComparisons(ctx, condR.name, condR.suruType, patterns, hasWild, matchN)
    let condVarName String: ""
    let condExpr AstNode: node.condition
    match condExpr { VarRefNode: { condVarName: condExpr.name } _: {} }
    let patIdx Int64: 0
    let k Int64: 0
    while k.lt(node.arms.len()) {
        let arm MatchArm: node.arms.at(k)
        match arm.isWildcard {
            true: {
                ctx.builder: ir.emitLabel(ctx.builder, "match_wildcard_".append(matchN))
                let sr CodegenResult: emitValue(ctx, arm.body)
                ctx: sr.ctx
                ctx.builder: ir.emitBr(ctx.builder, "match_merge_".append(matchN))
            }
            _: {
                let origEntry VarEntry: types.lookupVar(ctx, condVarName)
                let variantName String: ""
                let patNode AstNode: arm.pattern
                match patNode { VarRefNode: { variantName: patNode.name } _: {} }
                ctx: narrowCondVar(ctx, condVarName, variantName)
                ctx.builder: ir.emitLabel(ctx.builder, "match_arm_".append(matchN).append("_").append(patIdx.toString()))
                let sr CodegenResult: emitValue(ctx, arm.body)
                ctx: sr.ctx
                ctx: restoreCondVar(ctx, condVarName, origEntry)
                ctx.builder: ir.emitBr(ctx.builder, "match_merge_".append(matchN))
                patIdx: patIdx.add(1)
            }
        }
        k: k.add(1)
    }
    ctx.builder: ir.emitLabel(ctx.builder, "match_merge_".append(matchN))
    return ctx
}

// Emit a MatchStatement (block-body arms).
// blockOpen is checked before each merge branch so arms ending with ret/exit
// don't produce a double-terminator.
fn emitMatchStmt(ctx IrCodegenContext, node MatchStmtNode) IrCodegenContext {
    let condR CodegenResult: emitValue(ctx, node.condition)
    ctx: condR.ctx
    let patterns Array<AstNode>: collectStmtPatterns(node.arms)
    let hasWild Bool: false
    let j Int64: 0
    while j.lt(node.arms.len()) { match node.arms.at(j).isWildcard { true: { hasWild: true } _: {} } j: j.add(1) }
    let mnR IrResult: ir.nextLabelNum(ctx.builder)
    ctx.builder: mnR.builder
    let matchN String: mnR.name
    ctx: emitPatternComparisons(ctx, condR.name, condR.suruType, patterns, hasWild, matchN)
    let condVarName String: ""
    let condExpr AstNode: node.condition
    match condExpr { VarRefNode: { condVarName: condExpr.name } _: {} }
    // Emit pattern arms.
    let patIdx Int64: 0
    let k Int64: 0
    while k.lt(node.arms.len()) {
        let arm MatchStmtArm: node.arms.at(k)
        match arm.isWildcard {
            true: {}
            _: {
                let origEntry VarEntry: types.lookupVar(ctx, condVarName)
                let variantName String: ""
                let patNode AstNode: arm.pattern
                match patNode { VarRefNode: { variantName: patNode.name } _: {} }
                ctx: narrowCondVar(ctx, condVarName, variantName)
                ctx.builder: ir.emitLabel(ctx.builder, "match_arm_".append(matchN).append("_").append(patIdx.toString()))
                ctx.blockOpen: true
                ctx: emitStmts(ctx, arm.stmts)
                ctx: restoreCondVar(ctx, condVarName, origEntry)
                match ctx.blockOpen {
                    true: { ctx.builder: ir.emitBr(ctx.builder, "match_merge_".append(matchN)) }
                    _: {}
                }
                patIdx: patIdx.add(1)
            }
        }
        k: k.add(1)
    }
    // Wildcard arm (or synthetic empty arm when no wildcard).
    ctx.builder: ir.emitLabel(ctx.builder, "match_wildcard_".append(matchN))
    ctx.blockOpen: true
    match hasWild {
        true: {
            let wi Int64: 0
            while wi.lt(node.arms.len()) {
                let wArm MatchStmtArm: node.arms.at(wi)
                match wArm.isWildcard {
                    true: { ctx: emitStmts(ctx, wArm.stmts) }
                    _: {}
                }
                wi: wi.add(1)
            }
        }
        _: {}
    }
    match ctx.blockOpen {
        true: { ctx.builder: ir.emitBr(ctx.builder, "match_merge_".append(matchN)) }
        _: {}
    }
    ctx.builder: ir.emitLabel(ctx.builder, "match_merge_".append(matchN))
    ctx.blockOpen: true
    return ctx
}

// ─── Statement and function emission ─────────────────────────────────────────

// Emit a while loop: three labeled blocks (cond/body/after).
fn emitWhile(ctx IrCodegenContext, condition AstNode, body Array<AstNode>) IrCodegenContext {
    let wnR IrResult: ir.nextWhileNum(ctx.builder)
    ctx.builder: wnR.builder
    let wn String: wnR.name
    ctx.builder: ir.emitBr(ctx.builder, "while_cond_".append(wn))
    ctx.builder: ir.emitLabel(ctx.builder, "while_cond_".append(wn))
    let condR CodegenResult: emitValue(ctx, condition)
    ctx: condR.ctx
    let condI1 String: condR.name
    match box.isScalarType(condR.suruType) { true: {} _: {
        let ur CodegenResult: box.unboxBool(ctx, condR.name)
        ctx: ur.ctx
        condI1: ur.name
    } }
    ctx.builder: ir.emitCondBr(ctx.builder, condI1, "while_body_".append(wn), "while_after_".append(wn))
    ctx.builder: ir.emitLabel(ctx.builder, "while_body_".append(wn))
    ctx: emitStmts(ctx, body)
    match ctx.blockOpen {
        true: { ctx.builder: ir.emitBr(ctx.builder, "while_cond_".append(wn)) }
        _: {}
    }
    ctx.builder: ir.emitLabel(ctx.builder, "while_after_".append(wn))
    ctx.blockOpen: true
    return ctx
}

// Emit an `if` / `else if` / `else` chain.
//
// LLVM CFG layout (id is a fresh label number from nextLabelNum):
//
//     <current block>
//        |
//        v
//     evaluate condition → unbox to i1 if needed
//        |
//        v
//     condbr cond, %if_then_<id>, %if_else_<id>
//
//   if_then_<id>:
//        emitStmts(thenBranch.stmts)
//        br %if_merge_<id>          ; suppressed when block already terminated
//
//   if_else_<id>:
//        emitStmts(elseBranch.stmts)  ; no-op if elseBranch.stmts is empty
//        br %if_merge_<id>          ; suppressed when block already terminated
//
//   if_merge_<id>:
//        <continues with next statement>
//
// `else if` chains are handled naturally by recursion: the parser stores
// elseBranch as `BlockNode { stmts: [IfNode] }`, so emitStmts on the else
// branch dispatches back into emitIf for the chained condition.
//
// `ctx.blockOpen` is the codegen's terminator-tracking flag — it is cleared
// to false by terminating instructions (return/unreachable). When the then or
// else branch contains a guaranteed return, we must skip the trailing branch
// to merge to avoid emitting a second terminator into the same basic block,
// which is a verifier error in LLVM IR.
fn emitIf(ctx IrCodegenContext, node IfNode) IrCodegenContext {
    let inR IrResult: ir.nextLabelNum(ctx.builder)
    ctx.builder: inR.builder
    let id String: inR.name

    let thenLabel String: "if_then_".append(id)
    let elseLabel String: "if_else_".append(id)
    let mergeLabel String: "if_merge_".append(id)

    // 1. Evaluate the condition expression and unbox it to an i1 if necessary.
    let condR CodegenResult: emitValue(ctx, node.condition)
    ctx: condR.ctx
    let condI1 String: condR.name
    match box.isScalarType(condR.suruType) {
        true: {}
        _: {
            let ur CodegenResult: box.unboxBool(ctx, condR.name)
            ctx: ur.ctx
            condI1: ur.name
        }
    }

    // 2. Branch to either the then or else block.
    ctx.builder: ir.emitCondBr(ctx.builder, condI1, thenLabel, elseLabel)

    // 3. then block: emit the then branch's statements.
    ctx.builder: ir.emitLabel(ctx.builder, thenLabel)
    ctx.blockOpen: true
    let thenBlock BlockNode: node.thenBranch
    let thenStmts Array<AstNode>: thenBlock.stmts
    ctx: emitStmts(ctx, thenStmts)
    match ctx.blockOpen {
        true: { ctx.builder: ir.emitBr(ctx.builder, mergeLabel) }
        _: {}
    }

    // 4. else block: emit the else branch's statements.
    //    An empty else branch (no else clause in source) still gets a labeled
    //    block that simply branches straight to the merge — the LLVM CFG always
    //    needs both targets of the condbr to be defined.
    ctx.builder: ir.emitLabel(ctx.builder, elseLabel)
    ctx.blockOpen: true
    let elseBlock BlockNode: node.elseBranch
    let elseStmts Array<AstNode>: elseBlock.stmts
    ctx: emitStmts(ctx, elseStmts)
    match ctx.blockOpen {
        true: { ctx.builder: ir.emitBr(ctx.builder, mergeLabel) }
        _: {}
    }

    // 5. merge block: subsequent statements continue here.
    ctx.builder: ir.emitLabel(ctx.builder, mergeLabel)
    ctx.blockOpen: true
    return ctx
}

// Emit a single statement.
fn emitStmt(ctx IrCodegenContext, stmt AstNode) IrCodegenContext {
    match stmt {
        MatchStmtNode: { return emitMatchStmt(ctx, stmt) }
        WhileNode:     { return emitWhile(ctx, stmt.condition, stmt.body) }
        IfNode:        { return emitIf(ctx, stmt) }
        ReturnNode: {
            let retVal String: box.defaultReturnValue(ctx.currentReturnSuruType)
            match stmt.hasValue {
                true: {
                    // Struct literal return: thread the declared return type name.
                    let retValueNode AstNode: stmt.value
                    match retValueNode {
                        StructLitNode: {
                            // Type name comes from the resolvedType annotation
                            // written by semantic analysis (top-down from the
                            // function's declared return type).
                            let sr CodegenResult: emitStructLit(ctx, retValueNode.fields, retValueNode.resolvedType)
                            ctx: sr.ctx
                            retVal: sr.name
                        }
                        _: {
                            let vr CodegenResult: emitValue(ctx, retValueNode)
                            ctx: vr.ctx
                            let rawRet String: vr.name
                            // Coerce dynamic ptr to scalar if function return type is scalar.
                            match box.isScalarType(ctx.currentReturnSuruType) {
                                true: {
                                    match box.isScalarType(vr.suruType) { true: {} _: {
                                        let ur CodegenResult: box.unboxScalar(ctx, vr.name, ctx.currentReturnSuruType)
                                        ctx: ur.ctx
                                        rawRet: ur.name
                                    } }
                                }
                                _: {}
                            }
                            retVal: rawRet
                        }
                    }
                }
                _: {}
            }
            ctx.builder: ir.emitRet(ctx.builder, ctx.currentReturnLlvmType, retVal)
            ctx.blockOpen: false
            return ctx
        }
        LetNode: {
            let annSuruType String: tyh.makeSuruType(stmt.typeName)
            let annLlvm String: box.llvmTypeOf(annSuruType)
            // Struct literal let: thread type annotation name into emitStructLit.
            let letValueNode AstNode: stmt.value
            match letValueNode {
                ArrayLitNode: {
                    // Element type comes from the let annotation. Nested
                    // struct-literal elements carry their own resolvedType
                    // (written by the semantic pass), so no context threading
                    // is needed.
                    let elemSuruType String: tyh.elemSuruType(annSuruType)
                    let ar CodegenResult: emitArrayLit(ctx, letValueNode.elems, elemSuruType)
                    ctx: ar.ctx
                    let arrPtr String: ar.name
                    let ptrR IrResult: ir.emitNamedAlloca(ctx.builder, stmt.name, "ptr")
                    ctx.builder: ptrR.builder
                    ctx.builder: ir.emitStore(ctx.builder, "ptr", arrPtr, ptrR.name)
                    ctx: types.addVar(ctx, stmt.name, ptrR.name, ar.suruType)
                    return ctx
                }
                StructLitNode: {
                    let sr CodegenResult: emitStructLit(ctx, letValueNode.fields, stmt.typeName)
                    ctx: sr.ctx
                    let structVal String: sr.name
                    // Tag variant in-place (type_tag=7, variant_idx) when annotation names a variant.
                    match types.isVariant(ctx, stmt.typeName) {
                        true: {
                            let parent SumTypeDecl: types.findParentSumType(ctx, stmt.typeName)
                            let idx Int64: types.variantIdx(parent, stmt.typeName)
                            // Variant tagging: "{tagGep}  = getelementptr" (double space) for i64 0 GEP,
                            // "{vidxGep} = getelementptr" (single space) for i64 8 GEP.
                            let tgNameR IrResult: ir.nextTmp(ctx.builder)
                            ctx.builder: tgNameR.builder
                            let tgLine String: "  ".append(tgNameR.name).append("  = getelementptr i8, ptr ").append(structVal).append(", i64 0\n")
                            ctx.builder: ir.emit(ctx.builder, tgLine)
                            ctx.builder: ir.emitStore(ctx.builder, "i64", "7", tgNameR.name)
                            let viR IrResult: ir.emitGEP(ctx.builder, "i8", structVal, "i64 8")
                            ctx.builder: viR.builder
                            ctx.builder: ir.emitStore(ctx.builder, "i64", idx.toString(), viR.name)
                        }
                        _: {}
                    }
                    let ptrR IrResult: ir.emitNamedAlloca(ctx.builder, stmt.name, "ptr")
                    ctx.builder: ptrR.builder
                    ctx.builder: ir.emitStore(ctx.builder, "ptr", structVal, ptrR.name)
                    ctx: types.addVar(ctx, stmt.name, ptrR.name, stmt.typeName)
                    return ctx
                }
                _: {}
            }
            // General let: emit value, optionally coerce, alloca, store.
            let vr CodegenResult: emitValue(ctx, letValueNode)
            ctx: vr.ctx
            let letVal String: vr.name
            let letType String: vr.suruType
            // Annotation-guided unbox: `let x Int64: arr.at(0)` returns (ptr, NamedType).
            match box.isScalarType(annSuruType) {
                true: {
                    match box.isScalarType(vr.suruType) { true: {} _: {
                        let ur CodegenResult: box.unboxScalar(ctx, vr.name, annSuruType)
                        ctx: ur.ctx
                        letVal: ur.name
                        letType: annSuruType
                    } }
                }
                _: {}
            }
            let ptrR IrResult: ir.emitNamedAlloca(ctx.builder, stmt.name, annLlvm)
            ctx.builder: ptrR.builder
            ctx.builder: ir.emitStore(ctx.builder, annLlvm, letVal, ptrR.name)
            ctx: types.addVar(ctx, stmt.name, ptrR.name, annSuruType)
            return ctx
        }
        AssignNode: {
            let v VarEntry: types.lookupVar(ctx, stmt.name)
            let assignVal String: ""
            let assignLlvm String: box.llvmTypeOf(v.suruType)
            // Evaluate the RHS first (may read the current variable value, e.g. s: s.append("x")).
            let assignValueNode AstNode: stmt.value
            match assignValueNode {
                StructLitNode: {
                    let sr CodegenResult: emitStructLit(ctx, assignValueNode.fields, v.suruType)
                    ctx: sr.ctx
                    assignVal: sr.name
                }
                _: {
                    let vr CodegenResult: emitValue(ctx, assignValueNode)
                    ctx: vr.ctx
                    assignVal: vr.name
                    match box.isScalarType(v.suruType) {
                        true: {
                            match box.isScalarType(vr.suruType) { true: {} _: {
                                let ur CodegenResult: box.unboxScalar(ctx, vr.name, v.suruType)
                                ctx: ur.ctx
                                assignVal: ur.name
                            } }
                        }
                        _: {}
                    }
                }
            }
            ctx.builder: ir.emitStore(ctx.builder, assignLlvm, assignVal, v.allocaName)
            return ctx
        }
        FieldAssignNode: {
            let recvR CodegenResult: emitValue(ctx, stmt.receiver)
            ctx: recvR.ctx
            let valR CodegenResult: emitValue(ctx, stmt.value)
            ctx: valR.ctx
            ctx: irStruct.emitFieldAssignment(ctx, recvR.name, recvR.suruType, stmt.fieldName, valR.name, valR.suruType)
            return ctx
        }
        ExprStmtNode: {
            let expr AstNode: stmt.expr
            match expr {
                MatchExprNode: { return emitMatchExprAsStmt(ctx, expr) }
                CallNode: {
                    // printLn
                    match expr.name.equals("printLn") {
                        true: {
                            let printArg AstNode: expr.args.at(0)
                            match printArg {
                                StrLitNode: {
                                    ctx: strIntern.internString(ctx, printArg.text)
                                    let gname String: strIntern.lookupStrGlobal(ctx, printArg.text)
                                    ctx: types.addDecl(ctx, "declare i32 @puts(ptr)\n")
                                    let putsArgs Array<String>: []
                                    putsArgs.add("ptr ".append(gname))
                                    ctx.builder: ir.emitCallDiscard(ctx.builder, "i32", "puts", putsArgs)
                                    return ctx
                                }
                                _: {}
                            }
                            let ar CodegenResult: emitValue(ctx, printArg)
                            ctx: ar.ctx
                            let args Array<String>: []
                            match ar.suruType {
                                "Bool": {
                                    ctx: types.addSuruDecl(ctx, "declare void @suru_println_bool(i1)\n")
                                    args.add("i1 ".append(ar.name))
                                    ctx.builder: ir.emitVoidCall(ctx.builder, "suru_println_bool", args)
                                }
                                "Int32": {
                                    ctx: types.addSuruDecl(ctx, "declare void @suru_println_i32(i32)\n")
                                    args.add("i32 ".append(ar.name))
                                    ctx.builder: ir.emitVoidCall(ctx.builder, "suru_println_i32", args)
                                }
                                "Int64": {
                                    ctx: types.addSuruDecl(ctx, "declare void @suru_println_i64(i64)\n")
                                    args.add("i64 ".append(ar.name))
                                    ctx.builder: ir.emitVoidCall(ctx.builder, "suru_println_i64", args)
                                }
                                "Float64": {
                                    ctx: types.addSuruDecl(ctx, "declare void @suru_println_f64(double)\n")
                                    args.add("double ".append(ar.name))
                                    ctx.builder: ir.emitVoidCall(ctx.builder, "suru_println_f64", args)
                                }
                                _: {
                                    ctx: types.addSuruDecl(ctx, "declare void @suru_println(ptr)\n")
                                    args.add("ptr ".append(ar.name))
                                    ctx.builder: ir.emitVoidCall(ctx.builder, "suru_println", args)
                                    // Drop temp string after printing.
                                    // Only drop when the arg definitely produces a new allocation.
                                    // "at" is excluded because Array<String>.at() returns a
                                    // borrowed element pointer — dropping it would cause double-free.
                                    match ar.suruType.equals("String") {
                                        true: {
                                            let shouldDrop Bool: false
                                            match printArg {
                                                CallNode:    { shouldDrop: true }
                                                MethodCallNode: {
                                                    match printArg.methodName.equals("toString") { true: { shouldDrop: true } _: {} }
                                                    match printArg.methodName.equals("append")   { true: { shouldDrop: true } _: {} }
                                                    match printArg.methodName.equals("slice")    { true: { shouldDrop: true } _: {} }
                                                }
                                                _: {}
                                            }
                                            match shouldDrop {
                                                true: {
                                                    let dr CodegenResult: irStr.emitStringDrop(ctx, ar.name)
                                                    ctx: dr.ctx
                                                }
                                                _: {}
                                            }
                                        }
                                        _: {}
                                    }
                                }
                            }
                            return ctx
                        }
                        _: {}
                    }
                    // printError
                    match expr.name.equals("printError") {
                        true: {
                            let peArg AstNode: expr.args.at(0)
                            match peArg {
                                StrLitNode: {
                                    ctx: strIntern.internString(ctx, peArg.text)
                                    let gname String: strIntern.lookupStrGlobal(ctx, peArg.text)
                                    ctx: types.addSuruDecl(ctx, "declare void @suru_printerror_lit(ptr)\n")
                                    let peArgs Array<String>: []
                                    peArgs.add("ptr ".append(gname))
                                    ctx.builder: ir.emitVoidCall(ctx.builder, "suru_printerror_lit", peArgs)
                                    return ctx
                                }
                                _: {}
                            }
                            let ar CodegenResult: emitValue(ctx, peArg)
                            ctx: ar.ctx
                            let args Array<String>: []
                            match ar.suruType {
                                "Bool": {
                                    ctx: types.addSuruDecl(ctx, "declare void @suru_printerror_bool(i1)\n")
                                    args.add("i1 ".append(ar.name))
                                    ctx.builder: ir.emitVoidCall(ctx.builder, "suru_printerror_bool", args)
                                }
                                "Int32": {
                                    ctx: types.addSuruDecl(ctx, "declare void @suru_printerror_i32(i32)\n")
                                    args.add("i32 ".append(ar.name))
                                    ctx.builder: ir.emitVoidCall(ctx.builder, "suru_printerror_i32", args)
                                }
                                "Int64": {
                                    ctx: types.addSuruDecl(ctx, "declare void @suru_printerror_i64(i64)\n")
                                    args.add("i64 ".append(ar.name))
                                    ctx.builder: ir.emitVoidCall(ctx.builder, "suru_printerror_i64", args)
                                }
                                "Float64": {
                                    ctx: types.addSuruDecl(ctx, "declare void @suru_printerror_f64(double)\n")
                                    args.add("double ".append(ar.name))
                                    ctx.builder: ir.emitVoidCall(ctx.builder, "suru_printerror_f64", args)
                                }
                                _: {
                                    ctx: types.addSuruDecl(ctx, "declare void @suru_printerror(ptr)\n")
                                    args.add("ptr ".append(ar.name))
                                    ctx.builder: ir.emitVoidCall(ctx.builder, "suru_printerror", args)
                                }
                            }
                            return ctx
                        }
                        _: {}
                    }
                    // exit(code)
                    match expr.name.equals("exit") {
                        true: {
                            ctx: types.addDecl(ctx, "declare void @exit(i32) noreturn\n")
                            let ar CodegenResult: emitValue(ctx, expr.args.at(0))
                            ctx: ar.ctx
                            let codeI32 String: ar.name
                            match ar.suruType.equals("Int32") { true: {} _: {
                                match box.isScalarType(ar.suruType) {
                                    true: {
                                        let tr IrResult: ir.emitTrunc(ctx.builder, "i64", ar.name, "i32")
                                        ctx.builder: tr.builder
                                        codeI32: tr.name
                                    }
                                    _: {
                                        let ur CodegenResult: box.unboxInt64(ctx, ar.name)
                                        ctx: ur.ctx
                                        let tr IrResult: ir.emitTrunc(ctx.builder, "i64", ur.name, "i32")
                                        ctx.builder: tr.builder
                                        codeI32: tr.name
                                    }
                                }
                            } }
                            let args Array<String>: []
                            args.add("i32 ".append(codeI32))
                            ctx.builder: ir.emitVoidCall(ctx.builder, "exit", args)
                            ctx.builder: ir.emitUnreachable(ctx.builder)
                            let tnR CodegenResult: box.ctxNextTmp(ctx)
                            ctx: tnR.ctx
                            // Dead block after unreachable — label uses just the number.
                            // tnR.name = "%tN"; slice(2,…) strips "%t" leaving "N".
                            ctx.builder: ir.emitLabel(ctx.builder, "dead_".append(tnR.name.slice(2, tnR.name.len())))
                            ctx.blockOpen: true
                            return ctx
                        }
                        _: {}
                    }
                    // writeFile — resolve path to raw char*, then resolve content.
                    match expr.name.equals("writeFile") {
                        true: {
                            let wfPath AstNode: expr.args.at(0)
                            let wfPathData String: ""
                            match wfPath {
                                StrLitNode: {
                                    ctx: strIntern.internString(ctx, wfPath.text)
                                    wfPathData: strIntern.lookupStrGlobal(ctx, wfPath.text)
                                }
                                _: {
                                    let pr CodegenResult: emitValue(ctx, wfPath)
                                    ctx: pr.ctx
                                    let pathDataR CodegenResult: irFile.extractStringData(ctx, pr.name)
                                    ctx: pathDataR.ctx
                                    wfPathData: pathDataR.name
                                }
                            }
                            let wfContent AstNode: expr.args.at(1)
                            match wfContent {
                                StrLitNode: {
                                    ctx: strIntern.internString(ctx, wfContent.text)
                                    let gname String: strIntern.lookupStrGlobal(ctx, wfContent.text)
                                    ctx: irFile.emitWriteFileLit(ctx, wfPathData, gname, wfContent.text.len())
                                }
                                _: {
                                    let cr CodegenResult: emitValue(ctx, wfContent)
                                    ctx: cr.ctx
                                    ctx: irFile.emitWriteFile(ctx, wfPathData, cr.name)
                                }
                            }
                            return ctx
                        }
                        _: {}
                    }
                    // appendToFile — same path-first ordering as writeFile.
                    match expr.name.equals("appendToFile") {
                        true: {
                            let afPath AstNode: expr.args.at(0)
                            let afPathData String: ""
                            match afPath {
                                StrLitNode: {
                                    ctx: strIntern.internString(ctx, afPath.text)
                                    afPathData: strIntern.lookupStrGlobal(ctx, afPath.text)
                                }
                                _: {
                                    let pr CodegenResult: emitValue(ctx, afPath)
                                    ctx: pr.ctx
                                    let pathDataR CodegenResult: irFile.extractStringData(ctx, pr.name)
                                    ctx: pathDataR.ctx
                                    afPathData: pathDataR.name
                                }
                            }
                            let afContent AstNode: expr.args.at(1)
                            match afContent {
                                StrLitNode: {
                                    ctx: strIntern.internString(ctx, afContent.text)
                                    let gname String: strIntern.lookupStrGlobal(ctx, afContent.text)
                                    ctx: irFile.emitAppendToFileLit(ctx, afPathData, gname, afContent.text.len())
                                }
                                _: {
                                    let cr CodegenResult: emitValue(ctx, afContent)
                                    ctx: cr.ctx
                                    ctx: irFile.emitAppendToFile(ctx, afPathData, cr.name)
                                }
                            }
                            return ctx
                        }
                        _: {}
                    }
                    // Discard result of other call expressions.
                    let sr CodegenResult: emitValue(ctx, expr)
                    return sr.ctx
                }
                _: {
                    let sr CodegenResult: emitValue(ctx, expr)
                    return sr.ctx
                }
            }
        }
        _: { return ctx }
    }
}

// Emit a sequence of statements, threading context through.
fn emitStmts(ctx IrCodegenContext, stmts Array<AstNode>) IrCodegenContext {
    let i Int64: 0
    while i.lt(stmts.len()) {
        ctx: emitStmt(ctx, stmts.at(i))
        i: i.add(1)
    }
    return ctx
}

// Emit a function definition or declare stub (for external/included functions).
// Resets per-function state.
fn emitFunction(ctx IrCodegenContext, fnDecl FnDeclNode) IrCodegenContext {
    // A function is defined here only when it belongs to the file being
    // compiled as root (by source path, not name — same-named functions in
    // different included files are distinct). All others get a declare stub.
    let isOwn Bool: fnDecl.srcPath.equals(ctx.rootPath)
    match isOwn {
        true: {}
        _: {
            let retSuru String: tyh.makeSuruType(fnDecl.returnType)
            let retLlvm String: match fnDecl.returnType.equals("void") { true: "void", _: box.llvmTypeOf(retSuru) }
            let paramParts Array<String>: []
            let i Int64: 0
            while i.lt(fnDecl.params.len()) {
                paramParts.add(box.llvmTypeOf(tyh.makeSuruType(fnDecl.params.at(i).typeName)))
                i: i.add(1)
            }
            ctx.fns: ctx.fns.append("declare ").append(retLlvm).append(" @").append(mangleSym(fnDecl.srcPath, fnDecl.name)).append("(").append(ir.joinArgs(paramParts)).append(")\n")
            return ctx
        }
    }

    // Reset per-function state, preserving the SSA counter across functions.
    // SSA names must be globally unique — ir.freshFnBuilder carries the current
    // tmpCount into the new builder so the counter never resets between functions.
    let freshVars Array<VarEntry>: []
    ctx.vars: freshVars
    ctx.blockOpen: true
    ctx.builder: ir.freshFnBuilder(ctx.builder)

    // main → suru_main(ptr %args) i64
    match fnDecl.name.equals("main") {
        true: {
            ctx.currentReturnLlvmType: "i64"
            ctx.currentReturnSuruType: "Int64"
            ctx.builder: ir.emitFnStart(ctx.builder, "internal i64", "suru_main", "ptr %args")
            ctx.builder: ir.emitFixedAlloca(ctx.builder, "args.addr", "ptr")
            ctx.builder: ir.emitStore(ctx.builder, "ptr", "%args", "%args.addr")
            ctx: types.addVar(ctx, "args", "%args.addr", "Array:String")
        }
        _: {
            let retSuru String: tyh.makeSuruType(fnDecl.returnType)
            let retLlvm String: match fnDecl.returnType.equals("void") { true: "ptr", _: box.llvmTypeOf(retSuru) }
            ctx.currentReturnLlvmType: retLlvm
            ctx.currentReturnSuruType: retSuru
            let paramParts Array<String>: []
            let i Int64: 0
            while i.lt(fnDecl.params.len()) {
                let p Param: fnDecl.params.at(i)
                paramParts.add(box.llvmTypeOf(tyh.makeSuruType(p.typeName)).append(" %p.").append(p.name))
                i: i.add(1)
            }
            ctx.builder: ir.emitFnStart(ctx.builder, retLlvm, mangleSym(fnDecl.srcPath, fnDecl.name), ir.joinArgs(paramParts))
            let j Int64: 0
            while j.lt(fnDecl.params.len()) {
                let p Param: fnDecl.params.at(j)
                let pSuru String: tyh.makeSuruType(p.typeName)
                let pLlvm String: box.llvmTypeOf(pSuru)
                let allocName String: "%".append(p.name).append(".addr")
                ctx.builder: ir.emitFixedAlloca(ctx.builder, p.name.append(".addr"), pLlvm)
                ctx.builder: ir.emitStore(ctx.builder, pLlvm, "%p.".append(p.name), allocName)
                ctx: types.addVar(ctx, p.name, allocName, pSuru)
                j: j.add(1)
            }
        }
    }

    ctx: emitStmts(ctx, fnDecl.body)

    // Implicit return / fallback unreachable.
    match ctx.blockOpen {
        true: {
            match fnDecl.name.equals("main") {
                true: {
                    // Drop the Array<String> before returning — it was built by @main wrapper.
                    let argsEntry VarEntry: types.lookupVar(ctx, "args")
                    let argsLoadR IrResult: ir.emitLoad(ctx.builder, "ptr", argsEntry.allocaName)
                    ctx.builder: argsLoadR.builder
                    let dropR CodegenResult: irArr.emitArrayDrop(ctx, argsLoadR.name)
                    ctx: dropR.ctx
                    ctx.builder: ir.emitRet(ctx.builder, "i64", "0")
                }
                _: {
                    match ctx.currentReturnSuruType.equals("void") {
                        true: { ctx.builder: ir.emitRet(ctx.builder, "ptr", "null") }
                        _:    { ctx.builder: ir.emitRet(ctx.builder, ctx.currentReturnLlvmType, box.defaultReturnValue(ctx.currentReturnSuruType)) }
                    }
                }
            }
        }
        _: {}
    }
    ctx.builder: ir.emitFnEnd(ctx.builder)

    // Flush builder to ctx.fns; reset output but preserve SSA counter for next function.
    ctx.fns: ctx.fns.append(ctx.builder.output)
    ctx.builder: ir.freshFnBuilder(ctx.builder)
    return ctx
}

// Emit the @main C entry point that wraps @suru_main.
// Builds a real Array<String> from argc/argv — each argv[i] is copied into a
// heap-owned suru.String (type_tag=6) and added to the array via suru_array_add_i64.
// suru_main receives the fully-populated array and drops it before returning.
fn emitMainWrapper(ctx IrCodegenContext) IrCodegenContext {
    ctx: types.addDecl(ctx, "declare ptr @malloc(i64)\n")
    ctx: types.addDecl(ctx, "declare i64 @strlen(ptr)\n")
    ctx: types.addDecl(ctx, "declare ptr @memcpy(ptr, ptr, i64)\n")
    ctx: types.addSuruDecl(ctx, "declare ptr  @suru_string_create(ptr, i64)\n")
    ctx: types.addSuruDecl(ctx, "declare void @suru_array_add_i64(ptr, i64)\n")
    let out String: "define i32 @main(i32 %argc, ptr %argv) {\n"
        .append("entry:\n")
        .append("  %arr     = call ptr @malloc(i64 40)\n")
        .append("  %tt_gep  = getelementptr %suru.Array, ptr %arr, i32 0, i32 0\n")
        .append("  store i64 5, ptr %tt_gep\n")
        .append("  %et_gep  = getelementptr %suru.Array, ptr %arr, i32 0, i32 1\n")
        .append("  store i64 6, ptr %et_gep\n")
        .append("  %ln_gep  = getelementptr %suru.Array, ptr %arr, i32 0, i32 2\n")
        .append("  store i64 0, ptr %ln_gep\n")
        .append("  %cp_gep  = getelementptr %suru.Array, ptr %arr, i32 0, i32 3\n")
        .append("  store i64 0, ptr %cp_gep\n")
        .append("  %dt_gep  = getelementptr %suru.Array, ptr %arr, i32 0, i32 4\n")
        .append("  store ptr null, ptr %dt_gep\n")
        .append("  %argc64  = sext i32 %argc to i64\n")
        .append("  br label %argv_cond\n")
        .append("argv_cond:\n")
        .append("  %ai      = phi i64 [ 0, %entry ], [ %ai_next, %argv_body ]\n")
        .append("  %acond   = icmp slt i64 %ai, %argc64\n")
        .append("  br i1 %acond, label %argv_body, label %argv_done\n")
        .append("argv_body:\n")
        .append("  %slot    = getelementptr ptr, ptr %argv, i64 %ai\n")
        .append("  %cstr    = load ptr, ptr %slot\n")
        .append("  %clen    = call i64 @strlen(ptr %cstr)\n")
        .append("  %bufsz   = add i64 %clen, 1\n")
        .append("  %buf     = call ptr @malloc(i64 %bufsz)\n")
        .append("  call ptr @memcpy(ptr %buf, ptr %cstr, i64 %bufsz)\n")
        .append("  %str     = call ptr @suru_string_create(ptr %buf, i64 %clen)\n")
        .append("  %strI64  = ptrtoint ptr %str to i64\n")
        .append("  call void @suru_array_add_i64(ptr %arr, i64 %strI64)\n")
        .append("  %ai_next = add i64 %ai, 1\n")
        .append("  br label %argv_cond\n")
        .append("argv_done:\n")
        .append("  %suru_ret = call i64 @suru_main(ptr %arr)\n")
        .append("  %ret32   = trunc i64 %suru_ret to i32\n")
        .append("  ret i32 %ret32\n")
        .append("}\n")
    ctx.fns: ctx.fns.append(out)
    return ctx
}

// ─── Module and assembly ──────────────────────────────────────────────────────

// Full module emit: run pre-passes, emit all type clone/drop helpers, emit all
// function bodies.
fn emitModule(ctx IrCodegenContext, stmts Array<AstNode>) IrCodegenContext {
    ctx: types.addDecl(ctx, "declare ptr @malloc(i64)\n")
    ctx: types.addDecl(ctx, "declare void @free(ptr)\n")
    ctx: passes.registerTypes(ctx, stmts)
    ctx: passes.registerConstants(ctx, stmts)
    ctx: passes.registerFunctions(ctx, stmts)
    ctx: irCD.emitAllTypeCloneDrop(ctx)
    let i Int64: 0
    while i.lt(stmts.len()) {
        let s AstNode: stmts.at(i)
        match s {
            FnDeclNode: { ctx: emitFunction(ctx, s) }
            _: {}
        }
        i: i.add(1)
    }
    // Emit @main wrapper when module has a `main` function.
    let hasMain Bool: false
    let j Int64: 0
    while j.lt(stmts.len()) {
        let s AstNode: stmts.at(j)
        match s { FnDeclNode: { match s.name.equals("main") { true: { hasMain: true } _: {} } } _: {} }
        j: j.add(1)
    }
    match hasMain { true: { ctx: emitMainWrapper(ctx) } _: {} }
    return ctx
}

// Insertion-sort an Array<String> alphabetically and return the sorted copy.
// Used to emit external clone/drop declares in deterministic order.
fn sortStrings(arr Array<String>) Array<String> {
    let result Array<String>: []
    let i Int64: 0
    while i.lt(arr.len()) {
        result.add(arr.at(i))
        i: i.add(1)
    }
    let n Int64: result.len()
    let outer Int64: 1
    while outer.lt(n) {
        let key String: result.at(outer)
        let j Int64: outer.take(1)
        let go Bool: j.gte(0)
        while go {
            match result.at(j).compare(key).gt(0) {
                true: {
                    result.set(result.at(j), j.add(1))
                    j: j.take(1)
                    go: j.gte(0)
                }
                _: { go: false }
            }
        }
        result.set(key, j.add(1))
        outer: outer.add(1)
    }
    return result
}

// Top-level entry point: initialise context, run emit(), assemble .ll text.
// ownFnNames: names of functions defined in THIS file (not from includes).
fn generate(stmts Array<AstNode>, sourceName String, ownFnNames Array<String>, ownTypeNames Array<String>, aliases Array<IncludeAlias>, rootPath String) String {
    let ctx IrCodegenContext: types.makeIrContext()
    ctx.ownFnNames: ownFnNames
    ctx.ownTypeNames: ownTypeNames
    ctx.rootPath: rootPath

    // name → owning source path, for mangling every user function symbol
    // (definition, declare stub, and unqualified call site) per source file.
    let fnSrcName Array<String>: []
    let fnSrcPath Array<String>: []
    let fi Int64: 0
    while fi.lt(stmts.len()) {
        let fs AstNode: stmts.at(fi)
        match fs {
            FnDeclNode: {
                fnSrcName.add(fs.name)
                fnSrcPath.add(fs.srcPath)
            }
            _: {}
        }
        fi: fi.add(1)
    }
    ctx.fnSrcName: fnSrcName
    ctx.fnSrcPath: fnSrcPath

    // alias → resolved source path, for `ns.fn()` calls in this file's bodies.
    let aliasNs  Array<String>: []
    let aliasSrc Array<String>: []
    let ai Int64: 0
    while ai.lt(aliases.len()) {
        let al IncludeAlias: aliases.at(ai)
        aliasNs.add(al.ns)
        aliasSrc.add(al.srcPath)
        ai: ai.add(1)
    }
    ctx.aliasNs:  aliasNs
    ctx.aliasSrc: aliasSrc

    // Register external function signatures for namespace calls.
    let i Int64: 0
    while i.lt(stmts.len()) {
        let s AstNode: stmts.at(i)
        match s {
            FnDeclNode: {
                match types.isOwnFn(ctx, s.name) {
                    true: {}
                    _: {
                        let retSuru String: tyh.makeSuruType(s.returnType)
                        let retLlvm String: match s.returnType.equals("void") { true: "ptr", _: box.llvmTypeOf(retSuru) }
                        let paramTypes Array<String>: []
                        let j Int64: 0
                        while j.lt(s.params.len()) {
                            paramTypes.add(tyh.makeSuruType(s.params.at(j).typeName))
                            j: j.add(1)
                        }
                        let fnEnt FnEntry: { name: s.name, returnLlvmType: retLlvm, returnSuruType: retSuru, paramSuruTypes: paramTypes }
                        ctx: types.addFn(ctx, fnEnt)
                    }
                }
            }
            _: {}
        }
        i: i.add(1)
    }

    ctx: emitModule(ctx, stmts)

    // Assemble output: header | globalConstants | strGlobals | decls | suruDecls |
    //                  extCloneDropDecls | helpers | fns
    let header String: "; ModuleID = '"
        .append(sourceName).append("'\n")
        .append("source_filename = \"").append(sourceName).append("\"\n")
        .append("target triple = \"x86_64-pc-linux-gnu\"\n")
        .append("\n")
        .append("%suru.String = type { i64, i64, ptr }\n")
        .append("%suru.Array  = type { i64, i64, i64, i64, ptr }\n")
        .append("%suru.Box    = type { i64, i64 }\n")
        .append("\n")
    let globalConsts String: passes.emitGlobalConstants(ctx, stmts)
    // Blank-line separators:
    //   sep1 — after globalVars (if any)
    //   sep2 — after user string literals (if any); NOT after mode/format globals
    //   sep3 — after extCloneDropDecls (if any)
    // ctx.strGlobals holds mode/format/bool strings (no blank after).
    // ctx.strLiterals holds user Suru string literal globals (blank after if non-empty).
    let sep1 String: ""
    match globalConsts.len().equals(0) { true: {} _: { sep1: "\n" } }
    let sep2 String: ""
    match ctx.strLiterals.len().equals(0) { true: {} _: { sep2: "\n" } }
    // Build extCloneDropDecls from sorted type names (alphabetical for deterministic output).
    let sortedNames Array<String>: sortStrings(ctx.extCloneDropTypeNames)
    let extCloneDropDecls String: ""
    let ei Int64: 0
    while ei.lt(sortedNames.len()) {
        let tn String: sortedNames.at(ei)
        extCloneDropDecls: extCloneDropDecls
            .append("declare ptr  @suru_clone_").append(tn).append("(ptr)\n")
            .append("declare void @suru_drop_").append(tn).append("(ptr)\n")
        ei: ei.add(1)
    }
    let sep3 String: ""
    match extCloneDropDecls.len().equals(0) { true: {} _: { sep3: "\n" } }
    return header
        .append(globalConsts)
        .append(sep1)
        .append(ctx.strGlobals)
        .append(ctx.strLiterals)
        .append(sep2)
        .append(ctx.decls)
        .append(ctx.suruDecls)
        .append(extCloneDropDecls)
        .append(sep3)
        .append(ctx.helpers)
        .append(ctx.fns)
}
