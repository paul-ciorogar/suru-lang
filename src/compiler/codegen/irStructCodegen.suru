// ir-struct-codegen.suru — Struct IR emission helpers.
//
// Every Suru Struct / variant value is a `ptr` to a flat fixed-layout heap allocation:
//
//   Header (32 bytes):
//     offset  0: i64 type_tag    (4=struct, 7=variant)
//     offset  8: i64 variant_idx (0 for non-variants)
//     offset 16: ptr clone_fn    (@suru_clone_T, sig: ptr(ptr))
//     offset 24: ptr drop_fn     (@suru_drop_T, sig: void(ptr))
//
//   Fields (compact, natural alignment, starting at offset 32):
//     Each field is stored at its natural LLVM type and size (bool/char=1, i32=4,
//     i64/f64/heap-ptr=8). Fields are reordered into three alignment buckets
//     (8 ++ 4 ++ 1, stable within each) by reorderSuruFields at registration, so
//     padding is minimised. suruFieldOffset(decl, i) gives a field's byte offset;
//     suruStructSize(decl) the total size. (Contrast cType: header-less, no reorder.)
//
//   One malloc per object literal; clone/drop walk the same reordered fields.
//
// ── Clone / Drop vtable ────────────────────────────────────────────────────────
// Per-type @suru_clone_T / @suru_drop_T are emitted into ctx.helpers by
// ir-type-clone-drop-codegen.suru BEFORE any user function bodies (for own types).
// For types from included modules, declare stubs are emitted into ctx.extCloneDropDecls
// by emitObjectLiteralAlloc when it detects the type is not in ctx.typeDecls.
// Explicit clone(x)/drop(x) calls route through @suru_clone_dyn / @suru_drop_dyn,
// which read the vtable at offsets 16/24 for tag=4 and tag=7.
//
// ── Design: no emitValue calls ─────────────────────────────────────────────────
// All functions receive pre-emitted SSA names (caller has already called emitValue).
// emitObjectLiteralFields takes pre-emitted field SSA names and their Suru types;
// emitFieldAccess and emitFieldAssignment receive a pre-emitted receiver SSA name.
//
// Include DAG: depends on ir-box-codegen.suru → ir-codegen-types.suru → ir-builder.suru.
// Imported by ir-codegen.suru (the mutual-recursion hub).

namespace Suru.Compiler.Codegen.Struct

import {
    types: Suru.Compiler.Codegen.Types
    tyh: Suru.Compiler.Codegen.TypeHelpers
    ir: Suru.Compiler.Codegen.Builder
    box: Suru.Compiler.Codegen.Box
}

// ─── C ABI layout (cType) ──────────────────────────────────────────────────────
// A cType has NO 32-byte header: field 0 starts at offset 0, each field sits at
// its natural C alignment (padding inserted where needed), and the total size is
// padded up to the largest field alignment. Field order follows declaration order
// (the C ABI is order-sensitive — no reordering, unlike the Suru-struct layout).
// Only fixed-layout primitives are allowed as cType fields (enforced in semantic).

// Natural byte size of a C-ABI primitive field.
export fn cFieldSize(suruType String) i64 {
    if suruType.equals("bool") { return 1 }
    if suruType.equals("char") { return 1 }
    if suruType.equals("i32")  { return 4 }
    return 8     // i64, f64, ptr (and any pointer-erased named type)
}

// Natural alignment of a C-ABI primitive field — equal to its size for scalars.
export fn cFieldAlign(suruType String) i64 {
    return cFieldSize(suruType)
}

// Round `off` up to the next multiple of `align` (align is a power of two ≥ 1).
// Suru i64 method names: .add=+, .take=−, .multiply=×, .split=÷ (sdiv).
export fn cAlignUp(off i64, align i64) i64 {
    return off.add(align).take(1).split(align).multiply(align)
}

// Byte offset of field `idx` in a cType's C-ABI layout. Walks preceding fields,
// accumulating size + per-field alignment padding, then aligns for `idx` itself.
export fn cFieldOffset(decl TypeDecl, idx i64) i64 {
    let off i64: 0
    let i i64: 0
    while i.lt(idx) {
        let st String: decl.fields.at(i).typeName
        off: cAlignUp(off, cFieldAlign(st))
        off: off.add(cFieldSize(st))
        i: i.add(1)
    }
    let target String: decl.fields.at(idx).typeName
    return cAlignUp(off, cFieldAlign(target))
}

// Total byte size of a cType value (padded up to its max field alignment).
export fn cStructSize(decl TypeDecl) i64 {
    let off i64: 0
    let maxAlign i64: 1
    let i i64: 0
    while i.lt(decl.fields.len()) {
        let st String: decl.fields.at(i).typeName
        let a i64: cFieldAlign(st)
        if a.gt(maxAlign) { maxAlign: a }
        off: cAlignUp(off, a)
        off: off.add(cFieldSize(st))
        i: i.add(1)
    }
    return cAlignUp(off, maxAlign)
}

// ─── Compact Suru-struct layout ────────────────────────────────────────────────
// Regular `type` structs keep the 32-byte runtime header but lay their fields out
// with natural alignment (same primitive sizes as a cType) and reorder them into
// three alignment buckets — 8-byte (i64/f64/ptr/heap/$vtable), then 4-byte (i32),
// then 1-byte (bool/char) — so padding is minimised. Ordering within each bucket
// preserves declaration order (a stable partition), so `$vtable` (added first,
// 8-byte) stays at index 0 / offset 32. Unlike a cType, fields ARE reordered and
// every field still routes through the 32-byte header / clone-drop vtable.

// Stable 3-bucket partition of `fields` by natural alignment: 8 ++ 4 ++ 1.
// Declaration order is preserved within each bucket.
export fn reorderSuruFields(fields Array<TypeFieldEntry>) Array<TypeFieldEntry> {
    let out Array<TypeFieldEntry>: []
    // Bucket 1: 8-byte aligned (i64, f64, heap ptrs, named structs, $vtable).
    let i i64: 0
    while i.lt(fields.len()) {
        if cFieldAlign(fields.at(i).typeName).equals(8) { out.add(fields.at(i)) }
        i: i.add(1)
    }
    // Bucket 2: 4-byte aligned (i32).
    i: 0
    while i.lt(fields.len()) {
        if cFieldAlign(fields.at(i).typeName).equals(4) { out.add(fields.at(i)) }
        i: i.add(1)
    }
    // Bucket 3: 1-byte aligned (bool, char).
    i: 0
    while i.lt(fields.len()) {
        if cFieldAlign(fields.at(i).typeName).equals(1) { out.add(fields.at(i)) }
        i: i.add(1)
    }
    return out
}

// Byte offset of field `idx` in a regular struct's compact layout. Like
// cFieldOffset but the accumulator starts at 32 (after the runtime header).
// Assumes decl.fields is already reordered (reorderSuruFields, at registration).
export fn suruFieldOffset(decl TypeDecl, idx i64) i64 {
    let off i64: 32
    let i i64: 0
    while i.lt(idx) {
        let st String: decl.fields.at(i).typeName
        off: cAlignUp(off, cFieldAlign(st))
        off: off.add(cFieldSize(st))
        i: i.add(1)
    }
    let target String: decl.fields.at(idx).typeName
    return cAlignUp(off, cFieldAlign(target))
}

// Total byte size of a regular struct value: 32-byte header + compact fields,
// padded up to the max of the largest field alignment and 8 (header alignment).
// A field-less struct is exactly the 32-byte header.
export fn suruStructSize(decl TypeDecl) i64 {
    let off i64: 32
    let maxAlign i64: 8
    let i i64: 0
    while i.lt(decl.fields.len()) {
        let st String: decl.fields.at(i).typeName
        let a i64: cFieldAlign(st)
        if a.gt(maxAlign) { maxAlign: a }
        off: cAlignUp(off, a)
        off: off.add(cFieldSize(st))
        i: i.add(1)
    }
    return cAlignUp(off, maxAlign)
}

// Zero literal for an LLVM type — used to null/zero-initialise absent fields so a
// later suru_drop_T sees a null pointer (not garbage) in heap-typed slots.
fn suruZeroLit(llvmType String) String {
    if llvmType.equals("double") { return "0.0" }
    if llvmType.equals("ptr") { return "null" }
    return "0"
}

// ─── Scalar ↔ i64 for struct field slots ─────────────────────────────────────
// Scalars are widened/bitcast directly — no Box allocation.
// Heap values (String, Array, NamedType) are stored as ptrtoint.

// Convert a Suru value to the i64 stored in a field slot.
export fn structFieldToI64(ctx IrCodegenContext, val String, suruType String) CodegenResult {
    match suruType {
        "bool": {
            // Zero-extend i1 → i64 (preserves 0/1 without sign-extension).
            let tR IrResult: ir.emitZext(ctx.builder, "i1", val, "i64")
            ctx.builder: tR.builder
            return { ctx: ctx, name: tR.name, llvmType: "i64", suruType: "i64" }
        }
        "i32": {
            // Sign-extend i32 → i64 to preserve negative values.
            let tR IrResult: ir.emitSext(ctx.builder, "i32", val, "i64")
            ctx.builder: tR.builder
            return { ctx: ctx, name: tR.name, llvmType: "i64", suruType: "i64" }
        }
        "char": {
            // Zero-extend i8 → i64 (char is an unsigned byte, matching ord()).
            let tR IrResult: ir.emitZext(ctx.builder, "i8", val, "i64")
            ctx.builder: tR.builder
            return { ctx: ctx, name: tR.name, llvmType: "i64", suruType: "i64" }
        }
        "i64": {
            // Already i64 — pass through unchanged.
            return { ctx: ctx, name: val, llvmType: "i64", suruType: "i64" }
        }
        "f64": {
            // Bitcast double bit-pattern to i64 — no numeric conversion.
            let tR IrResult: ir.emitBitcast(ctx.builder, "double", val, "i64")
            ctx.builder: tR.builder
            return { ctx: ctx, name: tR.name, llvmType: "i64", suruType: "i64" }
        }
        _: {
            // Heap type (String, Array, NamedType): ptrtoint ptr → i64.
            let tR IrResult: ir.emitPtrToInt(ctx.builder, val)
            ctx.builder: tR.builder
            return { ctx: ctx, name: tR.name, llvmType: "i64", suruType: "i64" }
        }
    }
}

// Convert an i64 field slot value back to its native Suru type.
// Inverse of structFieldToI64.
export fn structFieldFromI64(ctx IrCodegenContext, raw String, suruType String) CodegenResult {
    match suruType {
        "bool": {
            // Truncate i64 → i1; recover the 0/1 boolean.
            let tR IrResult: ir.emitTrunc(ctx.builder, "i64", raw, "i1")
            ctx.builder: tR.builder
            return { ctx: ctx, name: tR.name, llvmType: "i1", suruType: "bool" }
        }
        "i32": {
            // Truncate i64 → i32 (low 32 bits; sign preserved because sext stored the full value).
            let tR IrResult: ir.emitTrunc(ctx.builder, "i64", raw, "i32")
            ctx.builder: tR.builder
            return { ctx: ctx, name: tR.name, llvmType: "i32", suruType: "i32" }
        }
        "char": {
            // Truncate i64 → i8 (recover the byte stored via zext).
            let tR IrResult: ir.emitTrunc(ctx.builder, "i64", raw, "i8")
            ctx.builder: tR.builder
            return { ctx: ctx, name: tR.name, llvmType: "i8", suruType: "char" }
        }
        "i64": {
            // Already i64 — pass through unchanged.
            return { ctx: ctx, name: raw, llvmType: "i64", suruType: "i64" }
        }
        "f64": {
            // Bitcast i64 bit-pattern back to double.
            let tR IrResult: ir.emitBitcast(ctx.builder, "i64", raw, "double")
            ctx.builder: tR.builder
            return { ctx: ctx, name: tR.name, llvmType: "double", suruType: "f64" }
        }
        _: {
            // Heap type (String, Array, NamedType): inttoptr i64 → ptr.
            let tR IrResult: ir.emitIntToPtr(ctx.builder, raw)
            ctx.builder: tR.builder
            return { ctx: ctx, name: tR.name, llvmType: "ptr", suruType: suruType }
        }
    }
}

// ─── Object literal allocation ────────────────────────────────────────────────

// Allocate the flat struct header for typeName: malloc(structSize) + write
// type_tag=4, variant_idx=0, vtable pointers @suru_clone_T/@suru_drop_T.
//
// typeName must be a declared struct type — callers are responsible for validation.
// Called by ir-codegen.suru BEFORE emitObjectLiteralFields writes the field slots.
//
// Variant creation (type_tag=7, variant_idx=N) is patched in by ir-codegen.suru
// AFTER this call, by overwriting bytes 0 and 8 with GEP stores.
//
// External type detection: if typeName is NOT in ctx.typeDecls (i.e. it comes from
// an included module), declare stubs for @suru_clone_T/@suru_drop_T are added to
// ctx.extCloneDropDecls.  Own types already have define bodies in ctx.helpers
// emitted by ir-type-clone-drop-codegen.suru before user function bodies.
export fn emitObjectLiteralAlloc(ctx IrCodegenContext, typeName String) CodegenResult {
    ctx: types.addDecl(ctx, "declare ptr @malloc(i64)\n")
    // Determine field count from the registered TypeDecl.
    let decl TypeDecl: types.lookupType(ctx, typeName)
    // cType: header-less C-ABI struct. malloc(cStructSize), no header writes,
    // no @suru_clone_T/@suru_drop_T vtable pointers (a cType has no type_tag and
    // is freed manually via an extern fn — see the FFI plan).
    if decl.isCType {
        let csize i64: cStructSize(decl)
        let cArgs Array<String>: []
        cArgs.add("i64 ".append(csize.toString()))
        let cR IrResult: ir.emitCall(ctx.builder, "ptr", "malloc", cArgs)
        ctx.builder: cR.builder
        return { ctx: ctx, name: cR.name, llvmType: "ptr", suruType: typeName }
    }
    let size i64: suruStructSize(decl)
    let mallocArgs Array<String>: []
    mallocArgs.add("i64 ".append(size.toString()))
    let hdrR IrResult: ir.emitCall(ctx.builder, "ptr", "malloc", mallocArgs)
    ctx.builder: hdrR.builder
    let mem String: hdrR.name

    // type_tag = 4 (Struct).  Overwritten to 7 for variants by the caller.
    let ttGr IrResult: ir.emitGEP(ctx.builder, "i8", mem, "i64 0")
    ctx.builder: ttGr.builder
    ctx.builder: ir.emitStore(ctx.builder, "i64", "4", ttGr.name)

    // variant_idx = 0.  Overwritten for variants by the caller.
    let viGr IrResult: ir.emitGEP(ctx.builder, "i8", mem, "i64 8")
    ctx.builder: viGr.builder
    ctx.builder: ir.emitStore(ctx.builder, "i64", "0", viGr.name)

    // clone_fn at offset 16: @suru_clone_T (ptr → ptr).
    let cfGr IrResult: ir.emitGEP(ctx.builder, "i8", mem, "i64 16")
    ctx.builder: cfGr.builder
    ctx.builder: ir.emitStore(ctx.builder, "ptr", "@suru_clone_".append(typeName), cfGr.name)

    // drop_fn at offset 24: @suru_drop_T (ptr → void).
    let dfGr IrResult: ir.emitGEP(ctx.builder, "i8", mem, "i64 24")
    ctx.builder: dfGr.builder
    ctx.builder: ir.emitStore(ctx.builder, "ptr", "@suru_drop_".append(typeName), dfGr.name)

    // External type detection: if typeName is not an own type, add declare stubs
    // so the LLVM assembler can resolve @suru_clone_T / @suru_drop_T forward references.
    match types.isOwnType(ctx, typeName) {
        true: {}
        _: { ctx: types.addExtCloneDropDecl(ctx, typeName) }
    }

    return { ctx: ctx, name: mem, llvmType: "ptr", suruType: typeName }
}

// Write field values into the flat struct at ptr mem.
// Iterates TypeDecl fields in their (reordered) layout order, storing each at its
// compact offset (suruFieldOffset) and natural LLVM type.  For each declared field:
//   - if its name appears in fieldNames: normalise the corresponding SSA + store.
//   - otherwise: zero-initialize — critical for heap-typed absent fields so
//     suru_drop_T doesn't dereference garbage when the struct is later dropped.
// fieldNames/fieldSSAs/fieldSuruTypes are parallel arrays for the literal's provided fields.
// NOTE: currently unused (ir-codegen.suru's emitObjectLit inlines this logic); kept
// in sync so it stays correct if a caller is reintroduced.
fn emitObjectLiteralFields(ctx IrCodegenContext, mem String, typeName String, fieldNames Array<String>, fieldSSAs Array<String>, fieldSuruTypes Array<String>) IrCodegenContext {
    let decl TypeDecl: types.lookupType(ctx, typeName)
    let i i64: 0
    while i.lt(decl.fields.len()) {
        let tdFieldName String: decl.fields.at(i).name
        let annotation String: decl.fields.at(i).typeName
        let llvm String: box.llvmTypeOf(annotation)
        let offset i64: suruFieldOffset(decl, i)
        let fGr IrResult: ir.emitGEP(ctx.builder, "i8", mem, "i64 ".append(offset.toString()))
        ctx.builder: fGr.builder
        // Linear scan: find this TypeDecl field in the literal's provided fields.
        let foundIdx i64: -1
        let k i64: 0
        while k.lt(fieldNames.len()) {
            if fieldNames.at(k).equals(tdFieldName) { foundIdx: k }
            k: k.add(1)
        }
        if foundIdx.equals(-1) {
            // Absent field — zero-initialize so heap-typed slots hold null (not garbage).
            ctx.builder: ir.emitStore(ctx.builder, llvm, suruZeroLit(llvm), fGr.name)
        } else {
            // Present field — normalise to the field's exact width (i64-encode then
            // decode to `annotation`) so the natural-typed store can't clobber the
            // following field's bytes, then store at the field's natural LLVM type.
            let fieldSsa String: fieldSSAs.at(foundIdx)
            let fieldSuruType String: fieldSuruTypes.at(foundIdx)
            let asI64 CodegenResult: structFieldToI64(ctx, fieldSsa, fieldSuruType)
            ctx: asI64.ctx
            let dec CodegenResult: structFieldFromI64(ctx, asI64.name, annotation)
            ctx: dec.ctx
            ctx.builder: ir.emitStore(ctx.builder, llvm, dec.name, fGr.name)
        }
        i: i.add(1)
    }
    return ctx
}

// ─── Field access ─────────────────────────────────────────────────────────────

// Emit a read of a single struct field by name.
// recv is the pre-emitted SSA ptr to the struct (or variant — same flat layout).
// recvSuruType is the Suru type name of the receiver (e.g. "Token", "Circle").
// fieldName is the Suru field identifier.
// Returns the decoded field value in its native Suru type.
//
// Variant receivers are handled transparently: variant names ARE TypeDecl names
// (e.g. "Circle" has its own TypeDecl), so fieldIndex resolves without extra steps.
// @suru_variant_inner is identity (flat layout) — we skip it and GEP directly.
export fn emitFieldAccess(ctx IrCodegenContext, recv String, recvSuruType String, fieldName String) CodegenResult {
    let decl TypeDecl: types.lookupType(ctx, recvSuruType)
    let fIdx i64: types.fieldIndex(decl, fieldName)
    // cType: read the field at its natural C-ABI offset with its natural LLVM
    // type — no i64 slot encode/decode (the bytes already match the C ABI).
    if decl.isCType {
        let cOff i64: cFieldOffset(decl, fIdx)
        let cGr IrResult: ir.emitGEP(ctx.builder, "i8", recv, "i64 ".append(cOff.toString()))
        ctx.builder: cGr.builder
        let cSuru String: decl.fields.at(fIdx).typeName
        let cLlvm String: box.llvmTypeOf(cSuru)
        let cLoad IrResult: ir.emitLoad(ctx.builder, cLlvm, cGr.name)
        ctx.builder: cLoad.builder
        return { ctx: ctx, name: cLoad.name, llvmType: cLlvm, suruType: cSuru }
    }
    // Regular struct: read the field at its compact offset with its natural LLVM
    // type — the bytes are stored natively (no i64 slot encode/decode).
    let annotation String: decl.fields.at(fIdx).typeName
    // makeSuruType converts annotation strings (e.g. "Array<Token>") to encoding
    // (e.g. "Array:Token") matching VarEntry.suruType conventions.
    let fieldSuruType String: tyh.makeSuruType(annotation)
    let llvm String: box.llvmTypeOf(fieldSuruType)
    let offset i64: suruFieldOffset(decl, fIdx)
    let fGr IrResult: ir.emitGEP(ctx.builder, "i8", recv, "i64 ".append(offset.toString()))
    ctx.builder: fGr.builder
    let loadR IrResult: ir.emitLoad(ctx.builder, llvm, fGr.name)
    ctx.builder: loadR.builder
    return { ctx: ctx, name: loadR.name, llvmType: llvm, suruType: fieldSuruType }
}

// ─── Field assignment ─────────────────────────────────────────────────────────

// Emit a write to a single struct field.
// recv is the pre-emitted SSA ptr; val / valSuruType are the pre-emitted new value.
export fn emitFieldAssignment(ctx IrCodegenContext, recv String, recvSuruType String, fieldName String, val String, valSuruType String) IrCodegenContext {
    let decl TypeDecl: types.lookupType(ctx, recvSuruType)
    let fIdx i64: types.fieldIndex(decl, fieldName)
    // cType: write the field at its natural C-ABI offset with its natural LLVM
    // type — no i64 slot encoding.
    if decl.isCType {
        let cSuru String: decl.fields.at(fIdx).typeName
        let cLlvm String: box.llvmTypeOf(cSuru)
        let cOff i64: cFieldOffset(decl, fIdx)
        let cGr IrResult: ir.emitGEP(ctx.builder, "i8", recv, "i64 ".append(cOff.toString()))
        ctx.builder: cGr.builder
        ctx.builder: ir.emitStore(ctx.builder, cLlvm, val, cGr.name)
        return ctx
    }
    // Regular struct: normalise the value to the field's exact width (i64-encode
    // then decode to the declared type) so a too-wide store can't clobber the
    // next field, then store at the field's natural LLVM type and compact offset.
    let annotation String: decl.fields.at(fIdx).typeName
    let llvm String: box.llvmTypeOf(annotation)
    let offset i64: suruFieldOffset(decl, fIdx)
    let asI64 CodegenResult: structFieldToI64(ctx, val, valSuruType)
    ctx: asI64.ctx
    let dec CodegenResult: structFieldFromI64(ctx, asI64.name, annotation)
    ctx: dec.ctx
    let fGr IrResult: ir.emitGEP(ctx.builder, "i8", recv, "i64 ".append(offset.toString()))
    ctx.builder: fGr.builder
    ctx.builder: ir.emitStore(ctx.builder, llvm, dec.name, fGr.name)
    return ctx
}

// ─── Clone / Drop ─────────────────────────────────────────────────────────────
// A struct/variant value is cloned/dropped through the null-safe vtable
// trampoline (suru_clone_via_vtable/suru_drop_via_vtable), which dispatches via
// the value's own clone_fn/drop_fn pointer with NO type-tag read. Per-type
// @suru_clone_T/@suru_drop_T bodies are emitted into ctx.helpers by
// ir-type-clone-drop-codegen.suru and pointed to by each value's header.

// clone(x) → deep copy via the vtable trampoline (the concrete arm of a variant
// is only known per-value, so dispatch goes through the stored clone_fn).
export fn emitStructClone(ctx IrCodegenContext, recv String, recvSuruType String) CodegenResult {
    ctx: types.addSuruDecl(ctx, "declare ptr  @suru_clone_via_vtable(ptr)\n")
    let args Array<String>: []
    args.add("ptr ".append(recv))
    let r IrResult: ir.emitCall(ctx.builder, "ptr", "suru_clone_via_vtable", args)
    ctx.builder: r.builder
    return { ctx: ctx, name: r.name, llvmType: "ptr", suruType: recvSuruType }
}

// drop(x): deallocate via the vtable trampoline.
// Returns a null placeholder — drop is always used as a statement, result discarded.
export fn emitStructDrop(ctx IrCodegenContext, recv String) CodegenResult {
    ctx: types.addSuruDecl(ctx, "declare void @suru_drop_via_vtable(ptr)\n")
    let args Array<String>: []
    args.add("ptr ".append(recv))
    ctx.builder: ir.emitVoidCall(ctx.builder, "suru_drop_via_vtable", args)
    return { ctx: ctx, name: "null", llvmType: "ptr", suruType: "void" }
}

// ─── Dispatch hub ──────────────────────────────────────────────────────────────

// Route a NamedType/variant receiver method call to the correct emitter.
// recv:         SSA name of the struct ptr (pre-emitted by emitMethodCall in ir-codegen.suru).
// recvSuruType: Suru type name of the receiver (e.g. "Token", "Circle").
// args:         pre-emitted SSA names of each argument.
//
// Only clone/drop are valid instance method calls on struct values; field access
// is handled via emitFieldAccess (called for FieldAccessNode in emitValue).
fn emitStructMethod(ctx IrCodegenContext, method String, recv String, recvSuruType String, args Array<String>) CodegenResult {
    match method {
        "clone": { return emitStructClone(ctx, recv, recvSuruType) }
        "drop":  { return emitStructDrop(ctx, recv) }
        _:       { return { ctx: ctx, name: "null", llvmType: "ptr", suruType: "void" } }
    }
}
