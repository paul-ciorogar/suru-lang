// irCodegenStrIntern.suru — String-literal interning for LLVM IR codegen.
//
// Maintains ctx.strIndex (text → @.str_N global name) and emits both the raw
// byte constant (@.str_N) and the static %suru.String header (@.str_hdr_N) on
// first sighting of each literal. Idempotent.
//
// Depends on irCodegenTypes.suru for IrCodegenContext / StrIndexEntry.

include "irCodegenTypes.suru" as types

// Escape a Suru string for inclusion in an LLVM c-string constant.
// Printable ASCII (32-126) except '"' and '\' pass through unchanged.
// All other characters are encoded as \HH (two-digit uppercase hex).
fn irEscapeStr(text String) String {
    let r String: ""
    let i Int64: 0
    while i.lt(text.len()) {
        let c String: text.at(i)
        let ec String: match c.equals("\n") { true: "\\0A", _: match c.equals("\t") { true: "\\09", _: match c.equals("\\") { true: "\\5C", _: match c.equals("\"") { true: "\\22", _: c } } } }
        r: r.append(ec)
        i: i.add(1)
    }
    return r
}

// Intern a string literal text into ctx.strLiterals.
// If the text is already interned, returns ctx unchanged (idempotent).
// Otherwise: allocates the next @.str_N name, emits the private global constant
// line into ctx.strLiterals, and records the mapping in ctx.strIndex.
// The byteLen stored includes the null terminator so callers can use it for malloc.
// ctx.strLiterals is separate from ctx.strGlobals (mode/format strings) so the
// generate function can add a blank line after user literals but not after mode strings.
fn internString(ctx IrCodegenContext, text String) IrCodegenContext {
    // Dedup: if this text was already interned, nothing to do.
    let i Int64: 0
    while i.lt(ctx.strIndex.len()) {
        match ctx.strIndex.at(i).text.equals(text) { true: { return ctx } _: {} }
        i: i.add(1)
    }
    let n Int64: ctx.strIndex.len()
    let gname String: "@.str_".append(n.toString())
    let byteLen Int64: text.len().add(1)
    let charLen Int64: text.len()
    let escaped String: irEscapeStr(text)
    // Emit: @.str_N = private unnamed_addr constant [byteLen x i8] c"escaped\00"
    let line String: gname
        .append(" = private unnamed_addr constant [")
        .append(byteLen.toString())
        .append(" x i8] c\"")
        .append(escaped)
        .append("\\00\"\n")
    // Emit: @.str_hdr_N = private unnamed_addr constant %suru.String { i64 8, i64 charLen, ptr @.str_N }
    // type_tag=8 marks this as a static literal so suru_string_drop skips freeing it.
    let hdrName String: "@.str_hdr_".append(n.toString())
    let hdrLine String: hdrName
        .append(" = private unnamed_addr constant %suru.String { i64 8, i64 ")
        .append(charLen.toString())
        .append(", ptr ")
        .append(gname)
        .append(" }\n")
    let strEntry StrIndexEntry: { text: text, globalName: gname, byteLen: byteLen }
    ctx.strIndex.add(strEntry)
    ctx.strLiterals: ctx.strLiterals.append(line).append(hdrLine)
    return ctx
}

// Look up the pre-interned global name for a string literal text.
// Returns "" if the text was not previously passed to internString.
fn lookupStrGlobal(ctx IrCodegenContext, text String) String {
    let i Int64: 0
    while i.lt(ctx.strIndex.len()) {
        let e StrIndexEntry: ctx.strIndex.at(i)
        match e.text.equals(text) { true: { return e.globalName } _: {} }
        i: i.add(1)
    }
    return ""
}

// Look up the pre-interned static header global name for a string literal text.
// @.str_hdr_N is the companion to @.str_N — emitted together by internString.
// Returns "" if the text was not previously passed to internString.
fn lookupStrHdrGlobal(ctx IrCodegenContext, text String) String {
    let i Int64: 0
    while i.lt(ctx.strIndex.len()) {
        let e StrIndexEntry: ctx.strIndex.at(i)
        match e.text.equals(text) {
            true: {
                // e.globalName = "@.str_N"; strip "@.str_" (6 chars) to get "N".
                let n String: e.globalName.slice(6, e.globalName.len())
                return "@.str_hdr_".append(n)
            }
            _: {}
        }
        i: i.add(1)
    }
    return ""
}
