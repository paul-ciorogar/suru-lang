// Semantic Analyzer: Resolved-Type Annotation Pass
//
// Walks an AstModule after pre-passes and writes a `resolvedType` String onto
// every expression AST node. The annotation is a SuruType string in the
// codegen-canonical form so codegen can read it directly without further
// conversion:
//
//   primitives : "bool" | "i32" | "i64" | "f64" | "String"
//   arrays     : "Array:<elem>" (e.g. "Array:i64", "Array:Foo")
//   structs    : the declared type name (e.g. "Outer")
//   unknown    : "" (sentinel — parser initialises every node to this)
//
// Resolution is combined bottom-up + top-down:
//   • Literals and variable references produce their type from scope/keyword.
//   • Compound nodes (struct/array literal, match expression) inherit an
//     "expected" type from the surrounding context — let annotation, return
//     type, struct field type, array element type, call parameter type — and
//     propagate it inward so deeply nested struct literals know their type.
//
// This replaces the brittle `ctx.currentReturnTypeName` save/restore dance in
// the codegen with a single read from `expr.resolvedType`. See todo.md task 3
// for the full plan.
//
// Implementation notes
//   • The pass mutates AST nodes in place. The Suru pattern is to bind the
//     specific variant via `let typed XNode: expr` and write the field on
//     `typed`, which references the same heap object as `expr`.
//   • Suru function names are globally unique across the transitive include
//     graph, so every helper here is prefixed `rt` / `resolve` to avoid
//     collisions with `analyze*` and `infer*` helpers in stmts.suru / exprs.suru.
//   • Struct field type lookup uses `state.typeDecls` (SemTypeEntry array
//     populated by collectTypeDeclarations in passes.suru). Keeping the type
//     registry inside AnalyzerState avoids importing parser AST into the leaf
//     semantic.suru.

include "semantic.suru" as sem
include "passes.suru" as passes
include "exprs.suru" as exprs
include "../codegen/irCodegenTypeHelpers.suru" as tyh

// ─── SemTypeEntry / field-type lookup ────────────────────────────────────────

// rtLookupTypeEntry — returns the SemTypeEntry for `name`, or an empty entry
// (name="") when none is registered. Callers must check the returned name.
fn rtLookupTypeEntry(state AnalyzerState, name String) SemTypeEntry {
    let decls Array<SemTypeEntry>: state.typeDecls
    let i i64: 0
    while i.lt(decls.len()) {
        if decls.at(i).name.equals(name) { return decls.at(i) }
        i: i.add(1)
    }
    return { name: "", fields: [], methods: [], privateFieldNames: [], privateMethodNames: [] }
}

// rtLookupFieldType — declared type annotation for `fieldName` on `decl`,
// or "" if the field is missing.
fn rtLookupFieldType(decl SemTypeEntry, fieldName String) String {
    let fields Array<SemFieldEntry>: decl.fields
    let i i64: 0
    while i.lt(fields.len()) {
        if fields.at(i).name.equals(fieldName) { return fields.at(i).typeName }
        i: i.add(1)
    }
    return ""
}

// rtCheckMissingFields — emit a compile error for each publicly-declared field
// absent from the struct literal. Private fields (in decl.privateFieldNames) are
// user-additive extensions and are exempt from this check.
fn rtCheckMissingFields(state AnalyzerState, fields Array<StructFieldNode>, decl SemTypeEntry, line i64, col i64) {
    let declFields Array<SemFieldEntry>: decl.fields
    let privNames Array<String>: decl.privateFieldNames
    let di i64: 0
    while di.lt(declFields.len()) {
        let df SemFieldEntry: declFields.at(di)
        if not isPrivateName(privNames, df.name) {
            let found bool: false
            let fi i64: 0
            while fi.lt(fields.len()) {
                if fields.at(fi).name.equals(df.name) { found: true }
                fi: fi.add(1)
            }
            if not found {
                state.addError("struct literal of type '".append(decl.name).append("' is missing required field '").append(df.name).append("'"), line, col)
            }
        }
        di: di.add(1)
    }
}

// rtCheckUndeclaredMethods — emit a compile error for each public method in the
// struct literal that is not declared on the type. Private methods (isPrivate=true)
// are literal-only extensions and are exempt from this check.
fn rtCheckUndeclaredMethods(state AnalyzerState, fields Array<StructFieldNode>, decl SemTypeEntry, line i64, col i64) {
    let i i64: 0
    while i.lt(fields.len()) {
        let f StructFieldNode: fields.at(i)
        if f.isMethod and not f.isPrivate {
            let found bool: false
            let j i64: 0
            while j.lt(decl.methods.len()) {
                if decl.methods.at(j).name.equals(f.name) { found: true }
                j: j.add(1)
            }
            if not found {
                state.addError("struct literal of type '".append(decl.name).append("' provides method '").append(f.name).append("' which is not declared on the type"), line, col)
            }
        }
        i: i.add(1)
    }
}

// rtLookupMethodReturn — declared return type of `methodName` on `decl`, or ""
// if the type has no such declared method (then it is a builtin method call).
fn rtLookupMethodReturn(decl SemTypeEntry, methodName String) String {
    let methods Array<SemMethodEntry>: decl.methods
    let i i64: 0
    while i.lt(methods.len()) {
        if methods.at(i).name.equals(methodName) { return methods.at(i).returnType }
        i: i.add(1)
    }
    return ""
}

// ─── Private member access control helpers ────────────────────────────────────

// isPrivateName — true if `name` appears in the private-member name list.
fn isPrivateName(names Array<String>, name String) bool {
    let i i64: 0
    while i.lt(names.len()) {
        if names.at(i).equals(name) { return true }
        i: i.add(1)
    }
    return false
}

// rtHasField — true if the SemFieldEntry list already contains a field named `name`.
// Used to avoid double-adding private fields when the same type has multiple literals.
fn rtHasField(fields Array<SemFieldEntry>, name String) bool {
    let i i64: 0
    while i.lt(fields.len()) {
        if fields.at(i).name.equals(name) { return true }
        i: i.add(1)
    }
    return false
}

// rtAugmentPrivateFields — walks the struct literal's field list, adding each
// isPrivate data field to the SemTypeEntry for `typeName` if not already present.
// Also records its name in privateFieldNames (data) or privateMethodNames (methods).
// Must be called before rtResolveStructMethods so method bodies can resolve this.field.
fn rtAugmentPrivateFields(state AnalyzerState, typeName String, litFields Array<StructFieldNode>) {
    let i i64: 0
    while i.lt(litFields.len()) {
        let f StructFieldNode: litFields.at(i)
        if f.isPrivate {
            let decls Array<SemTypeEntry>: state.typeDecls
            let di i64: 0
            while di.lt(decls.len()) {
                let entry SemTypeEntry: decls.at(di)
                if entry.name.equals(typeName) {
                    if f.isMethod {
                        // Private method: record name so MethodCallNode privacy check fires.
                        let privMethods Array<String>: entry.privateMethodNames
                        if not isPrivateName(privMethods, f.name) {
                            privMethods.add(f.name)
                        }
                    } else {
                        // Private data field: add to fields for this.field resolution,
                        // and record name for FieldAccessNode privacy check.
                        let semFields Array<SemFieldEntry>: entry.fields
                        let privFields Array<String>: entry.privateFieldNames
                        if not rtHasField(semFields, f.name) {
                            semFields.add({ name: f.name, typeName: f.privateTypeName })
                            privFields.add(f.name)
                        }
                    }
                }
                di: di.add(1)
            }
        }
        i: i.add(1)
    }
}

// isThisReceiver — true when expr is a VarRefNode named "this".
// Used by privacy checks to allow access to private members inside method bodies.
fn isThisReceiver(expr AstNode) bool {
    match expr {
        VarRefNode: {
            let v VarRefNode: expr
            return v.name.equals("this")
        }
        _: { return false }
    }
}


// ─── Read resolvedType back off any expression node ──────────────────────────

// rtNodeResolvedType — reads the resolvedType field by pattern-matching the
// AstNode variant. Returns "" for non-expression variants (statements,
// wildcards) — those have no value type.
fn rtNodeResolvedType(expr AstNode) String {
    match expr {
        BoolLitNode:     { let t BoolLitNode: expr     return t.resolvedType }
        IntLitNode:      { let t IntLitNode: expr      return t.resolvedType }
        FloatLitNode:    { let t FloatLitNode: expr    return t.resolvedType }
        StrLitNode:      { let t StrLitNode: expr      return t.resolvedType }
        CharLitNode:     { let t CharLitNode: expr     return t.resolvedType }
        VarRefNode:      { let t VarRefNode: expr      return t.resolvedType }
        CallNode:        { let t CallNode: expr        return t.resolvedType }
        MethodCallNode:  { let t MethodCallNode: expr  return t.resolvedType }
        FieldAccessNode: { let t FieldAccessNode: expr return t.resolvedType }
        ArrayLitNode:    { let t ArrayLitNode: expr    return t.resolvedType }
        StructLitNode:   { let t StructLitNode: expr   return t.resolvedType }
        MatchExprNode:   { let t MatchExprNode: expr   return t.resolvedType }
        UnaryNode:       { let t UnaryNode: expr       return t.resolvedType }
        BinaryNode:      { let t BinaryNode: expr      return t.resolvedType }
        _: {}
    }
    return ""
}

// ─── Array / struct / arm / call-arg recursion helpers ───────────────────────

// rtResolveArrayElems — resolve each element with `elemExpected`.
fn rtResolveArrayElems(state AnalyzerState, elems Array<AstNode>, elemExpected String) AnalyzerState {
    let i i64: 0
    while i.lt(elems.len()) {
        resolveExpr(state, elems.at(i), elemExpected)
        i: i.add(1)
    }
    return state
}

// rtResolveStructFields — recurse into each StructFieldNode's value, looking
// up the declared field type on `decl` and using `makeSuruType` to canonicalise
// the annotation into the codegen-form expected by resolveExpr.
fn rtResolveStructFields(state AnalyzerState, fields Array<StructFieldNode>, decl SemTypeEntry) AnalyzerState {
    let i i64: 0
    while i.lt(fields.len()) {
        let field StructFieldNode: fields.at(i)
        let annot String: rtLookupFieldType(decl, field.name)
        let expected String: tyh.makeSuruType(annot)
        resolveExpr(state, field.value, expected)
        i: i.add(1)
    }
    return state
}

// rtResolveStructMethods — resolve the body of each method member of a struct
// literal. Each body is analysed in a fresh scope where `this` is bound to the
// literal's struct type and the method's declared params are in scope, with
// the method's declared return type as the return-expectation. This annotates
// the body expression nodes in place so the later method lambda-lift
// (pipeline.suru) can move them into top-level functions already type-resolved.
fn rtResolveStructMethods(state AnalyzerState, fields Array<StructFieldNode>, structType String) AnalyzerState {
    let i i64: 0
    while i.lt(fields.len()) {
        let field StructFieldNode: fields.at(i)
        if field.isMethod {
            state.pushScope()
            state.declareSymbol("this", structType)
            let mps Array<Param>: field.methodParams
            let pj i64: 0
            while pj.lt(mps.len()) {
                let p Param: mps.at(pj)
                state.declareSymbol(p.name, p.typeName)
                pj: pj.add(1)
            }
            let expectedReturn String: tyh.makeSuruType(field.methodRet)
            rtResolveBody(state, field.methodBody, expectedReturn)
            state.popScope()
        }
        i: i.add(1)
    }
    return state
}

// rtResolveMatchArms — resolve each arm body with the outer-match expected
// type. Pattern expressions are resolved with no expectation.
fn rtResolveMatchArms(state AnalyzerState, arms Array<MatchArm>, expected String) AnalyzerState {
    let i i64: 0
    while i.lt(arms.len()) {
        let arm MatchArm: arms.at(i)
        if not arm.isWildcard {
            resolveExpr(state, arm.pattern, "")
        }
        resolveExpr(state, arm.body, expected)
        i: i.add(1)
    }
    return state
}

// rtResolveCallArgs — resolve each argument with the i-th parameter's declared
// type as the expectation. Built-in calls (printLn, exec, etc.) have no entry
// in state.functions so `paramType` returns "" — fine, args fall back to
// pure bottom-up resolution.
fn rtResolveCallArgs(state AnalyzerState, args Array<AstNode>, fnName String) AnalyzerState {
    let i i64: 0
    while i.lt(args.len()) {
        let paramAnn String: state.functions.paramType(fnName, i)
        let expected String: tyh.makeSuruType(paramAnn)
        resolveExpr(state, args.at(i), expected)
        i: i.add(1)
    }
    return state
}

// ─── Main expression resolver ────────────────────────────────────────────────

// resolveExpr — recursive expression resolver. Reads the surrounding-context
// expected type, computes a SuruType for the node, mutates the node's
// resolvedType field, and recurses into sub-expressions threading the right
// expectation down.
//
// `expected = ""` means "no surrounding expectation; resolve bottom-up only".
// For literal / var-ref / call / method-call / field-access / unary / binary
// nodes the expected value is unused — those produce their own type from
// scope or a fixed table. It matters for ArrayLitNode, StructLitNode and
// MatchExprNode, where the surrounding context picks the type.
fn resolveExpr(state AnalyzerState, expr AstNode, expected String) AnalyzerState {
    match expr {
        BoolLitNode: {
            let typed BoolLitNode: expr
            typed.resolvedType: "bool"
        }

        IntLitNode: {
            let typed IntLitNode: expr
            // i32 literals are upgraded only when the surrounding context
            // explicitly expects i32. Default stays i64 to preserve the
            // existing inferType behaviour from exprs.suru.
            if expected.equals("i32") { typed.resolvedType: "i32" } else { typed.resolvedType: "i64" }
        }

        FloatLitNode: {
            let typed FloatLitNode: expr
            typed.resolvedType: "f64"
        }

        StrLitNode: {
            let typed StrLitNode: expr
            typed.resolvedType: "String"
        }

        CharLitNode: {
            let typed CharLitNode: expr
            typed.resolvedType: "char"
        }

        VarRefNode: {
            let typed VarRefNode: expr
            let raw String: state.lookupSymbol(typed.name)
            typed.resolvedType: tyh.makeSuruType(raw)
        }

        CallNode: {
            let typed CallNode: expr
            let name String: typed.name
            rtResolveCallArgs(state, typed.args, name)
            // readFile is a builtin that returns String; everything else falls
            // through to the function-signature lookup. exit/printLn return
            // nothing meaningful for type-inference purposes — leave "".
            if name.equals("readFile") {
                typed.resolvedType: "String"
            } else {
                let raw String: state.functions.returnType(name)
                typed.resolvedType: tyh.makeSuruType(raw)
            }
        }

        MethodCallNode: {
            let typed MethodCallNode: expr
            let rcv AstNode: typed.receiver
            resolveExpr(state, rcv, "")
            // `arr.add(x)` on an Array<T> receiver: x is expected to be T.
            // Without this, a struct-literal argument (e.g. params.add({...}))
            // resolves with expected "" → resolvedType "" → codegen emits a
            // bogus zero-field @suru_clone_ struct. (Pre-resolvedType codegen
            // inferred this from context; the migration must do it explicitly.)
            let rcvType String: rtNodeResolvedType(rcv)
            let argExpected String: ""
            if typed.methodName.equals("add") {
                if tyh.isArraySuruType(rcvType) { argExpected: tyh.elemSuruType(rcvType) }
            }
            rtResolveArrayElems(state, typed.args, argExpected)
            // User-defined object method: if the receiver's resolved type is a
            // declared struct with a method of this name, the return type comes
            // from the declared signature. Otherwise fall back to the builtin
            // method-name → return-type table in exprs.suru.
            let mdecl SemTypeEntry: rtLookupTypeEntry(state, rcvType)
            // Privacy check: private methods (declared with `_ fn`) may only be
            // called via `this` inside the owning object's method bodies.
            let mPrivNames Array<String>: mdecl.privateMethodNames
            if isPrivateName(mPrivNames, typed.methodName) and not isThisReceiver(rcv) {
                state.addError("cannot call private method '".append(typed.methodName).append("' from outside its object"), typed.line, typed.col)
            }
            let userRet String: rtLookupMethodReturn(mdecl, typed.methodName)
            if userRet.equals("") {
                typed.resolvedType: exprs.inferTypeFromMethod(state, typed)
            } else {
                typed.resolvedType: tyh.makeSuruType(userRet)
            }
        }

        FieldAccessNode: {
            let typed FieldAccessNode: expr
            let rcv AstNode: typed.receiver
            resolveExpr(state, rcv, "")
            let rcvType String: rtNodeResolvedType(rcv)
            let decl SemTypeEntry: rtLookupTypeEntry(state, rcvType)
            // Privacy check: private data fields (declared with `_ name Type`) may
            // only be accessed via `this` inside the owning object's method bodies.
            let privNames Array<String>: decl.privateFieldNames
            if isPrivateName(privNames, typed.fieldName) and not isThisReceiver(rcv) {
                state.addError("cannot access private field '".append(typed.fieldName).append("' from outside its object"), typed.line, typed.col)
            }
            let annot String: rtLookupFieldType(decl, typed.fieldName)
            typed.resolvedType: tyh.makeSuruType(annot)
        }

        ArrayLitNode: {
            let typed ArrayLitNode: expr
            let elems Array<AstNode>: typed.elems
            // Element-type expectation: prefer the surrounding context's
            // "Array:T" form; otherwise peek the first element (after first
            // resolving it bottom-up) and use its inferred type.
            let elemType String: ""
            if tyh.isArraySuruType(expected) { elemType: tyh.elemSuruType(expected) }
            if elemType.equals("") and elems.len().gt(0) {
                resolveExpr(state, elems.at(0), "")
                elemType: rtNodeResolvedType(elems.at(0))
            }
            // Empty arrays without context default to i64 — matches the
            // codegen fallback at irCodegen.suru:395.
            if elemType.equals("") { elemType: "i64" }
            rtResolveArrayElems(state, elems, elemType)
            typed.resolvedType: "Array:".append(elemType)
        }

        StructLitNode: {
            let typed StructLitNode: expr
            typed.resolvedType: expected
            let fields Array<StructFieldNode>: typed.fields
            let decl SemTypeEntry: rtLookupTypeEntry(state, expected)
            // When `expected` is "" or names an unknown type, `decl.name` is
            // "" and rtResolveStructFields will pass "" expectations down — no
            // type information is invented, the AST simply stays under-typed.
            if not decl.name.equals("") {
                rtCheckMissingFields(state, fields, decl, typed.line, typed.col)
                rtCheckUndeclaredMethods(state, fields, decl, typed.line, typed.col)
            }
            rtResolveStructFields(state, fields, decl)
            // Augment the SemTypeEntry with private fields/methods from this literal
            // before resolving method bodies, so `this.fieldname` lookups succeed.
            rtAugmentPrivateFields(state, expected, fields)
            // Method members (isMethod=true) carry a body that references
            // `this` and the method params. Resolve them now so the lift can
            // hoist already-typed bodies into top-level functions.
            rtResolveStructMethods(state, fields, expected)
        }

        MatchExprNode: {
            let typed MatchExprNode: expr
            let cond AstNode: typed.condition
            resolveExpr(state, cond, "")
            let arms Array<MatchArm>: typed.arms
            rtResolveMatchArms(state, arms, expected)
            if expected.equals("") and arms.len().gt(0) {
                typed.resolvedType: rtNodeResolvedType(arms.at(0).body)
            } else {
                typed.resolvedType: expected
            }
        }

        UnaryNode: {
            let typed UnaryNode: expr
            resolveExpr(state, typed.operand, "")
            // The only unary operator today is logical `not`; semantic.suru's
            // inferType already returns "bool" for every UnaryNode.
            typed.resolvedType: "bool"
        }

        BinaryNode: {
            let typed BinaryNode: expr
            resolveExpr(state, typed.left, "")
            resolveExpr(state, typed.right, "")
            // Mirrors the current inferType behaviour: every binary operator
            // produces bool. Expanded to arithmetic in a future task.
            typed.resolvedType: "bool"
        }

        _: {}
    }
    return state
}

// ─── Statement walker ────────────────────────────────────────────────────────

// rtResolveBody — walk a list of statements inside a function body, threading
// `expectedReturn` down to ReturnNodes. Manages its own scope frames so that
// VarRef lookups resolve correctly inside loops and if/else branches.
fn rtResolveBody(state AnalyzerState, stmts Array<AstNode>, expectedReturn String) AnalyzerState {
    let i i64: 0
    while i.lt(stmts.len()) {
        rtResolveStmt(state, stmts.at(i), expectedReturn)
        i: i.add(1)
    }
    return state
}

// rtResolveStmt — dispatch one statement, picking the right expected type for
// each contained expression.
fn rtResolveStmt(state AnalyzerState, stmt AstNode, expectedReturn String) AnalyzerState {
    match stmt {
        LetNode: {
            let typed LetNode: stmt
            let expected String: tyh.makeSuruType(typed.typeName)
            let val AstNode: typed.value
            resolveExpr(state, val, expected)
            // Declare the symbol so later VarRefs inside this scope resolve.
            // collectTypeDeclarations doesn't touch state.scopes, and the
            // statement-analysis pass runs after us — but it re-declares the
            // same symbols, so there's no risk of double-binding. We avoid
            // duplicating sem.existsInCurrentScope errors here.
            if not state.existsInCurrentScope(typed.name) {
                state.declareSymbol(typed.name, typed.typeName)
            }
        }

        AssignNode: {
            let typed AssignNode: stmt
            let varType String: state.lookupSymbol(typed.name)
            let expected String: tyh.makeSuruType(varType)
            let val AstNode: typed.value
            resolveExpr(state, val, expected)
        }

        FieldAssignNode: {
            let typed FieldAssignNode: stmt
            let rcv AstNode: typed.receiver
            resolveExpr(state, rcv, "")
            let rcvType String: rtNodeResolvedType(rcv)
            let decl SemTypeEntry: rtLookupTypeEntry(state, rcvType)
            // Privacy check: private data fields may only be written via `this`.
            let privNamesA Array<String>: decl.privateFieldNames
            if isPrivateName(privNamesA, typed.fieldName) and not isThisReceiver(rcv) {
                state.addError("cannot assign to private field '".append(typed.fieldName).append("' from outside its object"), typed.line, typed.col)
            }
            let annot String: rtLookupFieldType(decl, typed.fieldName)
            let expected String: tyh.makeSuruType(annot)
            let val AstNode: typed.value
            resolveExpr(state, val, expected)
        }

        ReturnNode: {
            let typed ReturnNode: stmt
            if typed.hasValue {
                resolveExpr(state, typed.value, expectedReturn)
            }
        }

        WhileNode: {
            let typed WhileNode: stmt
            resolveExpr(state, typed.condition, "bool")
            state.pushScope()
            rtResolveBody(state, typed.body, expectedReturn)
            state.popScope()
        }

        IfNode: {
            let typed IfNode: stmt
            resolveExpr(state, typed.condition, "bool")
            let thenBlock BlockNode: typed.thenBranch
            state.pushScope()
            rtResolveBody(state, thenBlock.stmts, expectedReturn)
            state.popScope()
            let elseBlock BlockNode: typed.elseBranch
            let elseStmts Array<AstNode>: elseBlock.stmts
            if elseStmts.len().gt(0) {
                state.pushScope()
                rtResolveBody(state, elseStmts, expectedReturn)
                state.popScope()
            }
        }

        MatchStmtNode: {
            let typed MatchStmtNode: stmt
            resolveExpr(state, typed.condition, "")
            rtResolveMatchStmtArms(state, typed.arms, expectedReturn)
        }

        BlockNode: {
            let typed BlockNode: stmt
            rtResolveBody(state, typed.stmts, expectedReturn)
        }

        ExprStmtNode: {
            let typed ExprStmtNode: stmt
            resolveExpr(state, typed.expr, "")
        }

        _: {}
    }
    return state
}

// rtResolveMatchStmtArms — iterate MatchStmtNode arms; each arm body is a
// statement list (not a single expression) so we recurse via rtResolveBody.
// Pattern expressions are resolved with no expectation.
fn rtResolveMatchStmtArms(state AnalyzerState, arms Array<MatchStmtArm>, expectedReturn String) AnalyzerState {
    let i i64: 0
    while i.lt(arms.len()) {
        let arm MatchStmtArm: arms.at(i)
        if not arm.isWildcard {
            resolveExpr(state, arm.pattern, "")
        }
        state.pushScope()
        rtResolveBody(state, arm.stmts, expectedReturn)
        state.popScope()
        i: i.add(1)
    }
    return state
}

// ─── Module driver ───────────────────────────────────────────────────────────

// rtResolveFnDecl — set up a function scope with parameter symbols and walk
// the body with the function's declared return type as the return-expectation.
// Mirrors the scope discipline in fns.suru:analyzeFunctionDeclaration but
// without the error-checking responsibilities (that pass runs separately).
fn rtResolveFnDecl(state AnalyzerState, stmt FnDeclNode) AnalyzerState {
    state.pushScope()
    let params Array<Param>: stmt.params
    let pi i64: 0
    while pi.lt(params.len()) {
        let p Param: params.at(pi)
        state.declareSymbol(p.name, p.typeName)
        pi: pi.add(1)
    }
    let returnType String: stmt.returnType
    let expectedReturn String: tyh.makeSuruType(returnType)
    rtResolveBody(state, stmt.body, expectedReturn)
    state.popScope()
    return state
}

// resolveModuleTypes — top-level driver. Walks `stmts` and writes
// `resolvedType` on every expression node. Must run *after* runPrePasses (so
// state.typeDecls and state.functions are populated) and *before* the regular
// statement analyzer (so the AST is fully annotated when any later pass or
// codegen reads expr.resolvedType).
//
// Scope discipline: this pass declares its own symbols into state.scopes so
// VarRef resolution works inside function bodies. To avoid polluting the
// scope stack seen by the downstream `analyzeModuleStatements` pass (which
// re-declares each module-level `let` and would then report duplicates), we
// swap in a fresh scope stack for the duration of the pass and restore the
// caller's stack on exit.
fn resolveModuleTypes(state AnalyzerState, stmts Array<AstNode>) AnalyzerState {
    let savedScopes Array<Scope>: state.scopes
    let myScopes Array<Scope>: []
    let modScope Scope: sem.newScope(0.take(1))
    myScopes.add(modScope)
    state.scopes: myScopes

    let i i64: 0
    while i.lt(stmts.len()) {
        let stmt AstNode: stmts.at(i)
        match stmt {
            FnDeclNode: {
                let typedFn FnDeclNode: stmt
                rtResolveFnDecl(state, typedFn)
            }
            LetNode: {
                // Module-level constants — same shape as inside a function
                // body. rtResolveStmt declares the symbol so later top-level
                // VarRefs resolve.
                rtResolveStmt(state, stmt, "")
            }
            _: {}
        }
        i: i.add(1)
    }

    state.scopes: savedScopes
    return state
}
