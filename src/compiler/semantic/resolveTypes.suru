// Semantic Analyzer: Resolved-Type Annotation Pass
//
// Walks an AstModule after pre-passes and writes a `resolvedType` String onto
// every expression AST node. The annotation is a SuruType string in the
// codegen-canonical form so codegen can read it directly without further
// conversion:
//
//   primitives : "bool" | "i32" | "i64" | "f64" | "String"
//   arrays     : "Array:<elem>" (e.g. "Array:i64", "Array:Foo")
//   structs    : the declared type name (e.g. "Outer")
//   unknown    : "" (sentinel — parser initialises every node to this)
//
// Resolution is combined bottom-up + top-down:
//   • Literals and variable references produce their type from scope/keyword.
//   • Compound nodes (struct/array literal, match expression) inherit an
//     "expected" type from the surrounding context — let annotation, return
//     type, struct field type, array element type, call parameter type — and
//     propagate it inward so deeply nested object literals know their type.
//
// This replaces the brittle `ctx.currentReturnTypeName` save/restore dance in
// the codegen with a single read from `expr.resolvedType`.
//
// Implementation notes
//   • The pass mutates AST nodes in place. The Suru pattern is to bind the
//     specific variant via `let typed XNode: expr` and write the field on
//     `typed`, which references the same heap object as `expr`.
//   • Suru function names are globally unique across the transitive include
//     graph, so every helper here is prefixed `rt` / `resolve` to avoid
//     collisions with `analyze*` and `infer*` helpers in stmts.suru / exprs.suru.
//   • Struct field type lookup uses `state.typeDecls` (SemTypeEntry array
//     populated by collectTypeDeclarations in passes.suru). Keeping the type
//     registry inside AnalyzerState avoids importing parser AST into the leaf
//     semantic.suru.

namespace Suru.Compiler.Semantic.ResolveTypes

import {
    sem: Suru.Compiler.Semantic
    passes: Suru.Compiler.Semantic.Passes
    exprs: Suru.Compiler.Semantic.Exprs
    tyh: Suru.Compiler.Codegen.TypeHelpers
    [primType]: Suru.Compiler.Types
    [parseType]: Suru.Compiler.Types.Parse
    [rtCallUnify, rtMethodUnify, rtObjectLitRecord, rtRecordArgBindings]: Suru.Compiler.Semantic.ResolveCallUnify
}

// ─── SemTypeEntry / field-type lookup ────────────────────────────────────────

// rtLookupTypeEntry — returns the SemTypeEntry for `name`, or an empty entry
// (name="") when none is registered. Callers must check the returned name.
fn rtLookupTypeEntry(state AnalyzerState, name String) SemTypeEntry {
    let decls Array<SemTypeEntry>: state.typeDecls
    let i i64: 0
    while i.lt(decls.len()) {
        if decls.at(i).name.equals(name) { return decls.at(i) }
        i: i.add(1)
    }
    return { name: "", fields: [], methods: [], privateFieldNames: [], privateMethodNames: [], isCType: false, isExternType: false, hasCustomLifecycle: false }
}

// rtLookupFieldType — declared type annotation for `fieldName` on `decl`,
// or "" if the field is missing.
fn rtLookupFieldType(decl SemTypeEntry, fieldName String) String {
    let fields Array<SemFieldEntry>: decl.fields
    let i i64: 0
    while i.lt(fields.len()) {
        if fields.at(i).name.equals(fieldName) { return fields.at(i).typeName }
        i: i.add(1)
    }
    return ""
}

// rtCheckMissingFields — emit a compile error for each publicly-declared field
// absent from the object literal. Private fields (in decl.privateFieldNames) are
// user-additive extensions and are exempt from this check.
fn rtCheckMissingFields(state AnalyzerState, fields Array<ObjectFieldNode>, decl SemTypeEntry, line i64, col i64) {
    let declFields Array<SemFieldEntry>: decl.fields
    let privNames Array<String>: decl.privateFieldNames
    let di i64: 0
    while di.lt(declFields.len()) {
        let df SemFieldEntry: declFields.at(di)
        if not isPrivateName(privNames, df.name) {
            let found bool: false
            let fi i64: 0
            while fi.lt(fields.len()) {
                if fields.at(fi).name.equals(df.name) { found: true }
                fi: fi.add(1)
            }
            if not found {
                state.addError("object literal of type '".append(decl.name).append("' is missing required field '").append(df.name).append("'"), line, col)
            }
        }
        di: di.add(1)
    }
}

// rtCheckUndeclaredMethods — emit a compile error for each public method in the
// object literal that is not declared on the type. Private methods (isPrivate=true)
// are literal-only extensions and are exempt from this check.
fn rtCheckUndeclaredMethods(state AnalyzerState, fields Array<ObjectFieldNode>, decl SemTypeEntry, line i64, col i64) {
    // A cType is data-only — any method member (public or private) is rejected.
    if decl.isCType {
        let ci i64: 0
        while ci.lt(fields.len()) {
            if fields.at(ci).isMethod {
                state.addError("cType '".append(decl.name).append("' cannot have methods (it is data-only)"), line, col)
            }
            ci: ci.add(1)
        }
        return
    }
    let i i64: 0
    while i.lt(fields.len()) {
        let f ObjectFieldNode: fields.at(i)
        if f.isMethod and not f.isPrivate {
            let found bool: false
            let j i64: 0
            while j.lt(decl.methods.len()) {
                if decl.methods.at(j).name.equals(f.name) { found: true }
                j: j.add(1)
            }
            if not found {
                state.addError("object literal of type '".append(decl.name).append("' provides method '").append(f.name).append("' which is not declared on the type"), line, col)
            }
        }
        i: i.add(1)
    }
}

// rtLookupMethodReturn — declared return type of `methodName` on `decl`, or ""
// if the type has no such declared method (then it is a builtin method call).
fn rtLookupMethodReturn(decl SemTypeEntry, methodName String) String {
    let methods Array<SemMethodEntry>: decl.methods
    let i i64: 0
    while i.lt(methods.len()) {
        if methods.at(i).name.equals(methodName) { return methods.at(i).returnType }
        i: i.add(1)
    }
    return ""
}

// ─── Private member access control helpers ────────────────────────────────────

// isPrivateName — true if `name` appears in the private-member name list.
fn isPrivateName(names Array<String>, name String) bool {
    let i i64: 0
    while i.lt(names.len()) {
        if names.at(i).equals(name) { return true }
        i: i.add(1)
    }
    return false
}

// rtHasField — true if the SemFieldEntry list already contains a field named `name`.
// Used to avoid double-adding private fields when the same type has multiple literals.
fn rtHasField(fields Array<SemFieldEntry>, name String) bool {
    let i i64: 0
    while i.lt(fields.len()) {
        if fields.at(i).name.equals(name) { return true }
        i: i.add(1)
    }
    return false
}

// rtHasMethod — true if the SemMethodEntry list already contains a method named
// `name`. Used to avoid double-adding a private method's signature across the
// pass-1 / pass-2 re-resolution of the same literal.
fn rtHasMethod(methods Array<SemMethodEntry>, name String) bool {
    let i i64: 0
    while i.lt(methods.len()) {
        if methods.at(i).name.equals(name) { return true }
        i: i.add(1)
    }
    return false
}

// rtAugmentPrivateFields — walks the object literal's field list, adding each
// isPrivate data field to the SemTypeEntry for `typeName` if not already present.
// Also records its name in privateFieldNames (data) or privateMethodNames (methods).
// Must be called before rtResolveObjectMethods so method bodies can resolve this.field.
fn rtAugmentPrivateFields(state AnalyzerState, typeName String, litFields Array<ObjectFieldNode>, line i64, col i64) {
    let i i64: 0
    while i.lt(litFields.len()) {
        let f ObjectFieldNode: litFields.at(i)
        if f.isPrivate {
            let decls Array<SemTypeEntry>: state.typeDecls
            let di i64: 0
            while di.lt(decls.len()) {
                let entry SemTypeEntry: decls.at(di)
                if entry.name.equals(typeName) {
                    if f.isMethod {
                        // Private method: record name so MethodCallNode privacy check fires.
                        let privMethods Array<String>: entry.privateMethodNames
                        if not isPrivateName(privMethods, f.name) {
                            privMethods.add(f.name)
                        }
                        // Inject the signature into entry.methods so lowerObjects lifts
                        // the body + adds a vtable entry, and rtLookupMethodReturn can
                        // resolve `this.priv()` calls. Privacy stays enforced via
                        // privateMethodNames above; this only enables dispatch.
                        let semMethods Array<SemMethodEntry>: entry.methods
                        if not rtHasMethod(semMethods, f.name) {
                            let ptys Array<String>: []
                            let mps Array<Param>: f.methodParams
                            let mk i64: 0
                            while mk.lt(mps.len()) {
                                ptys.add(mps.at(mk).typeName)
                                mk: mk.add(1)
                            }
                            semMethods.add({ name: f.name, paramTypes: ptys, returnType: f.methodRet })
                        }
                    } else {
                        // ptr/extern-type private fields require the type to declare
                        // clone() and drop() so codegen can emit vtable-dispatch wrappers
                        // instead of the field-walking auto-generated clone/drop bodies.
                        if f.privateTypeName.equals("ptr") or passes.isExternTypeNamed(state, f.privateTypeName) {
                            if not entry.hasCustomLifecycle {
                                state.addError("private field '".append(f.name).append("' has type 'ptr' — type '").append(typeName).append("' must declare clone() and drop() methods"), line, col)
                            }
                        }
                        // Private data field: add to fields for this.field resolution,
                        // and record name for FieldAccessNode privacy check.
                        let semFields Array<SemFieldEntry>: entry.fields
                        let privFields Array<String>: entry.privateFieldNames
                        if not rtHasField(semFields, f.name) {
                            semFields.add({ name: f.name, typeName: f.privateTypeName })
                            privFields.add(f.name)
                        }
                    }
                }
                di: di.add(1)
            }
        }
        i: i.add(1)
    }
}

// isThisReceiver — true when expr is a VarRefNode named "this".
// Used by privacy checks to allow access to private members inside method bodies.
fn isThisReceiver(expr AstNode) bool {
    match expr {
        VarRefNode: {
            let v VarRefNode: expr
            return v.name.equals("this")
        }
        _: { return false }
    }
}


// ─── Read resolvedType back off any expression node ──────────────────────────

// rtNodeResolvedType — reads the resolvedType field by pattern-matching the
// AstNode variant. Returns "" for non-expression variants (statements,
// wildcards) — those have no value type.
// rtCollectParamAnns — the callee's declared parameter type annotations, in order,
// for as many params as the call supplies arguments. Cloned so the returned array
// owns its strings (the registry hands back borrowed refs).
fn rtCollectParamAnns(state AnalyzerState, name String, n i64) Array<String> {
    let out Array<String>: []
    let i i64: 0
    while i.lt(n) {
        out.add(state.functions.paramType(name, i).clone())
        i: i.add(1)
    }
    return out
}

// rtCollectArgTys — each argument's resolved Type (parsed from its resolvedType
// string) for §3.2 param-vs-arg type-arg recording.
fn rtCollectArgTys(args Array<AstNode>) Array<Type> {
    let out Array<Type>: []
    let i i64: 0
    while i.lt(args.len()) {
        out.add(parseType(rtNodeResolvedType(args.at(i))))
        i: i.add(1)
    }
    return out
}

fn rtNodeResolvedType(expr AstNode) String {
    match expr {
        BoolLitNode:     { let t BoolLitNode: expr     return t.resolvedType }
        IntLitNode:      { let t IntLitNode: expr      return t.resolvedType }
        FloatLitNode:    { let t FloatLitNode: expr    return t.resolvedType }
        StrLitNode:      { let t StrLitNode: expr      return t.resolvedType }
        CharLitNode:     { let t CharLitNode: expr     return t.resolvedType }
        VarRefNode:      { let t VarRefNode: expr      return t.resolvedType }
        CallNode:        { let t CallNode: expr        return t.resolvedType }
        MethodCallNode:  { let t MethodCallNode: expr  return t.resolvedType }
        FieldAccessNode: { let t FieldAccessNode: expr return t.resolvedType }
        ArrayLitNode:    { let t ArrayLitNode: expr    return t.resolvedType }
        ObjectLitNode:   { let t ObjectLitNode: expr   return t.resolvedType }
        MatchExprNode:   { let t MatchExprNode: expr   return t.resolvedType }
        UnaryNode:       { let t UnaryNode: expr       return t.resolvedType }
        BinaryNode:        { let t BinaryNode: expr        return t.resolvedType }
        QualifiedNameNode: { let t QualifiedNameNode: expr return t.resolvedType }
        _: {}
    }
    return ""
}

// ─── Array / struct / arm / call-arg recursion helpers ───────────────────────

// rtResolveArrayElems — resolve each element with `elemExpected`. Array elements
// pass the no-expectation sentinel for the structured `expectedTy` (binding a
// generic call from an array element type is out of scope for §2.2).
fn rtResolveArrayElems(state AnalyzerState, elems Array<AstNode>, elemExpected String) AnalyzerState {
    let noTy Type: primType("")
    let i i64: 0
    while i.lt(elems.len()) {
        resolveExpr(state, elems.at(i), elemExpected, noTy)
        i: i.add(1)
    }
    return state
}

// rtResolveObjectFields — recurse into each ObjectFieldNode's value, looking
// up the declared field type on `decl` and using `makeSuruType` to canonicalise
// the annotation into the codegen-form expected by resolveExpr.
fn rtResolveObjectFields(state AnalyzerState, fields Array<ObjectFieldNode>, decl SemTypeEntry) AnalyzerState {
    let i i64: 0
    while i.lt(fields.len()) {
        let field ObjectFieldNode: fields.at(i)
        let annot String: rtLookupFieldType(decl, field.name)
        let expected String: tyh.makeSuruType(annot)
        let expectedTy Type: parseType(annot)
        resolveExpr(state, field.value, expected, expectedTy)
        i: i.add(1)
    }
    return state
}

// rtResolveObjectMethods — resolve the body of each method member of a struct
// literal. Each body is analysed in a fresh scope where `this` is bound to the
// literal's struct type and the method's declared params are in scope, with
// the method's declared return type as the return-expectation. This annotates
// the body expression nodes in place so the later method lambda-lift
// (pipeline.suru) can move them into top-level functions already type-resolved.
fn rtResolveObjectMethods(state AnalyzerState, fields Array<ObjectFieldNode>, structType String) AnalyzerState {
    let i i64: 0
    while i.lt(fields.len()) {
        let field ObjectFieldNode: fields.at(i)
        if field.isMethod {
            state.pushScope()
            state.declareSymbol("this", structType)
            let mps Array<Param>: field.methodParams
            let pj i64: 0
            while pj.lt(mps.len()) {
                let p Param: mps.at(pj)
                state.declareSymbol(p.name, p.typeName)
                pj: pj.add(1)
            }
            let expectedReturn String: tyh.makeSuruType(field.methodRet)
            let expectedReturnTy Type: parseType(field.methodRet)
            rtResolveBody(state, field.methodBody, expectedReturn, expectedReturnTy)
            state.popScope()
        }
        i: i.add(1)
    }
    return state
}

// rtResolveMatchArms — resolve each arm body with the outer-match expected
// type. Pattern expressions are resolved with no expectation.
fn rtResolveMatchArms(state AnalyzerState, arms Array<MatchArm>, expected String, expectedTy Type) AnalyzerState {
    let noTy Type: primType("")
    let i i64: 0
    while i.lt(arms.len()) {
        let arm MatchArm: arms.at(i)
        if not arm.isWildcard {
            resolveExpr(state, arm.pattern, "", noTy)
        }
        resolveExpr(state, arm.body, expected, expectedTy)
        i: i.add(1)
    }
    return state
}

// rtResolveCallArgs — resolve each argument with the i-th parameter's declared
// type as the expectation. Built-in calls (printLn, exec, etc.) have no entry
// in state.functions so `paramType` returns "" — fine, args fall back to
// pure bottom-up resolution.
fn rtResolveCallArgs(state AnalyzerState, args Array<AstNode>, fnName String) AnalyzerState {
    let i i64: 0
    while i.lt(args.len()) {
        let paramAnn String: state.functions.paramType(fnName, i)
        let expected String: tyh.makeSuruType(paramAnn)
        let expectedTy Type: parseType(paramAnn)
        resolveExpr(state, args.at(i), expected, expectedTy)
        i: i.add(1)
    }
    return state
}

// ─── Expression resolver sub-helpers ─────────────────────────────────────────
//
// Heavy match arms of resolveExpr — extracted so that resolveExpr itself reads
// as a dispatch table. Each helper owns the per-node-type concerns:
// argument resolution, privacy checks, surrounding-context plumbing.

// rtResolveMethodCallNode — resolve the receiver and args of a method call,
// enforce private-method privacy, and set the call's resolvedType from either
// the user-declared method signature or the builtin method table.
// `expectedTy` is the structured form of `expected` (the surrounding-context
// type). For a namespace-qualified generic function called via method syntax
// (e.g. opt.some(42)), it drives type-argument binding by unifying the callee's
// return template against it — the MethodCallNode mirror of the CallNode arm
// (§2.3, see the rcvType=="" block below).
fn rtResolveMethodCallNode(state AnalyzerState, typed MethodCallNode, expected String, expectedTy Type) AnalyzerState {
    let rcv AstNode: typed.receiver
    let noTy Type: primType("")
    resolveExpr(state, rcv, "", noTy)
    // `arr.add(x)` on an Array<T> receiver: x is expected to be T.
    // Without this, an object-literal argument (e.g. params.add({...}))
    // resolves with expected "" → resolvedType "" → codegen emits a
    // bogus zero-field @suru_clone_ struct. (Pre-resolvedType codegen
    // inferred this from context; the migration must do it explicitly.)
    let rcvType String: rtNodeResolvedType(rcv)
    // ptr instance methods (FFI): byte-addressed memory ops on a raw pointer.
    // A `ptr` value behaves like an object exposing these builtins — always
    // available (no import gate, unlike typeSize).
    //   p.load(off i64) T       — T inferred from surrounding context
    //   p.store(off i64, val T) — returns void
    //   p.add(n i64) ptr        — offset pointer arithmetic
    if rcvType.equals("ptr") {
        if typed.methodName.equals("load") {
            rtResolveArrayElems(state, typed.args, "")
            if expected.equals("") {
                state.addError("ptr.load: cannot infer loaded type; assign to a typed variable", typed.line, typed.col)
                typed.resolvedType: "i64"
            } else {
                typed.resolvedType: expected
            }
            return state
        }
        if typed.methodName.equals("store") {
            rtResolveArrayElems(state, typed.args, "")
            typed.resolvedType: "void"
            return state
        }
        if typed.methodName.equals("add") {
            rtResolveArrayElems(state, typed.args, "")
            typed.resolvedType: "ptr"
            return state
        }
    }
    let argExpected String: ""
    if typed.methodName.equals("add") {
        if tyh.isArraySuruType(rcvType) { argExpected: tyh.elemSuruType(rcvType) }
    }
    rtResolveArrayElems(state, typed.args, argExpected)
    // §2.3: namespace-qualified generic function called via method syntax
    // (e.g. opt.some(42), res.ok(99)). After importPass the receiver is a
    // QualifiedNameNode whose resolvedType is "", so rcvType is "" and
    // methodName names a free function. For an unambiguous generic callee with a
    // real expectation, bind its type args by unifying the (varized) return
    // template against expectedTy — the MethodCallNode mirror of the CallNode
    // arm (§2.2). Records typeArgs + concrete resolvedType and returns; fails
    // closed to the method-table resolution below. A real method (add, clone, …)
    // is never a registered free function, so typeParams() is [] and the gate
    // skips it, leaving the receiver-driven resolution below untouched.
    if rcvType.equals("") {
        if state.functions.nameCount(typed.methodName).equals(1) {
            let mtparams Array<String>: state.functions.typeParams(typed.methodName)
            if mtparams.len().gt(0) {
                let mret String: state.functions.returnType(typed.methodName)
                if rtMethodUnify(typed, expectedTy, mtparams, mret) { return state }
                // §3.2: arg-driven type-arg recording for a namespace-aliased
                // generic free function (mirror of the CallNode arm). Records
                // typeArgs only — resolvedType is left to the resolution below.
                let mParamAnns Array<String>: rtCollectParamAnns(state, typed.methodName, typed.args.len())
                let mArgTys Array<Type>: rtCollectArgTys(typed.args)
                rtRecordArgBindings(typed.typeArgs, mtparams, mParamAnns, mArgTys)
                drop(mParamAnns)
                drop(mArgTys)
            }
        }
    }
    // User-defined object method: if the receiver's resolved type is a
    // declared struct with a method of this name, the return type comes
    // from the declared signature. Otherwise fall back to the builtin
    // method-name → return-type table in exprs.suru.
    let mdecl SemTypeEntry: rtLookupTypeEntry(state, rcvType)
    // Privacy check: private methods (declared with `_ fn`) may only be
    // called via `this` inside the owning object's method bodies.
    let mPrivNames Array<String>: mdecl.privateMethodNames
    if isPrivateName(mPrivNames, typed.methodName) and not isThisReceiver(rcv) {
        state.addError("cannot call private method '".append(typed.methodName).append("' from outside its object"), typed.line, typed.col)
    }
    // A cType or raw ptr has no runtime header (no type_tag), so the dynamic
    // clone/drop dispatch cannot run on it — memory is managed manually via extern fn.
    let mIsCloneOrDrop bool: typed.methodName.equals("clone") or typed.methodName.equals("drop")
    if mdecl.isCType and mIsCloneOrDrop {
        state.addError("cannot call ".append(typed.methodName).append("() on cType '").append(mdecl.name).append("' (no type_tag); free it manually via an extern fn"), typed.line, typed.col)
    } else if mdecl.isExternType and mIsCloneOrDrop {
        state.addError("cannot call ".append(typed.methodName).append("() on extern type '").append(mdecl.name).append("' (no type_tag); free it manually via an extern fn"), typed.line, typed.col)
    } else if rcvType.equals("ptr") and mIsCloneOrDrop {
        state.addError("cannot call ".append(typed.methodName).append("() on 'ptr' (unmanaged pointer; free it manually via an extern fn)"), typed.line, typed.col)
    }
    let userRet String: rtLookupMethodReturn(mdecl, typed.methodName)
    if not userRet.equals("") {
        typed.resolvedType: tyh.makeSuruType(userRet)
    } else {
        // Builtin element/identity methods whose return type depends on the
        // receiver's concrete element type — the method-name table in
        // exprs.suru cannot type these, so resolve them here from rcvType
        // (already in canonical suru form, e.g. "Array:Sig").
        //   arr.at(i) : Array<T> → T   (borrowed element)
        //   x.clone() : T → T          (owned copy of the receiver)
        // Without these, a generic call like some(arr.at(i)) leaves the
        // argument's resolvedType empty, so monoInfer cannot bind T and the
        // call site is never monomorphized.
        let handled bool: false
        if typed.methodName.equals("at") and tyh.isArraySuruType(rcvType) {
            typed.resolvedType: tyh.elemSuruType(rcvType)
            handled: true
        }
        if not handled and typed.methodName.equals("clone") and not rcvType.equals("") {
            typed.resolvedType: rcvType
            handled: true
        }
        if not handled {
            typed.resolvedType: exprs.inferTypeFromMethod(state, typed)
        }
    }
    return state
}

// rtResolveFieldAccessNode — resolve the receiver, enforce private-field
// privacy, and look up the field's declared type on the receiver's struct.
fn rtResolveFieldAccessNode(state AnalyzerState, typed FieldAccessNode) AnalyzerState {
    let rcv AstNode: typed.receiver
    let noTy Type: primType("")
    resolveExpr(state, rcv, "", noTy)
    let rcvType String: rtNodeResolvedType(rcv)
    let decl SemTypeEntry: rtLookupTypeEntry(state, rcvType)
    // Privacy check: private data fields (declared with `_ name Type`) may
    // only be accessed via `this` inside the owning object's method bodies.
    let privNames Array<String>: decl.privateFieldNames
    if isPrivateName(privNames, typed.fieldName) and not isThisReceiver(rcv) {
        state.addError("cannot access private field '".append(typed.fieldName).append("' from outside its object"), typed.line, typed.col)
    }
    let annot String: rtLookupFieldType(decl, typed.fieldName)
    typed.resolvedType: tyh.makeSuruType(annot)
    return state
}

// rtResolveArrayLitNode — derive an element-type expectation, resolve each
// element under it, and tag the literal with "Array:<elem>".
fn rtResolveArrayLitNode(state AnalyzerState, typed ArrayLitNode, expected String, expectedTy Type) AnalyzerState {
    let elems Array<AstNode>: typed.elems
    // Element-type expectation: prefer the surrounding context's
    // "Array:T" form; otherwise peek the first element (after first
    // resolving it bottom-up) and use its inferred type.
    let elemType String: ""
    if tyh.isArraySuruType(expected) { elemType: tyh.elemSuruType(expected) }
    if elemType.equals("") and elems.len().gt(0) {
        let noTy Type: primType("")
        resolveExpr(state, elems.at(0), "", noTy)
        elemType: rtNodeResolvedType(elems.at(0))
    }
    // Empty arrays without context default to i64 — matches the
    // codegen fallback at irCodegen.suru:395.
    if elemType.equals("") { elemType: "i64" }
    rtResolveArrayElems(state, elems, elemType)
    typed.resolvedType: "Array:".append(elemType)
    return state
}

// rtResolveObjectLitNode — tag with the expected type, verify field/method
// completeness against the declared SemTypeEntry, augment with private
// members from this literal, then resolve fields and method bodies.
// `expectedTy` (structured form of `expected`) drives the §3.2 generic-arg
// recording (rtObjectLitRecord); field/method resolution otherwise keys off the
// canonical-string `expected`.
fn rtResolveObjectLitNode(state AnalyzerState, typed ObjectLitNode, expected String, expectedTy Type) AnalyzerState {
    typed.resolvedType: expected
    // §3.2: record the concrete type args of a generic literal (e.g. Box<i64> -> [i64])
    // so monomorphization reads the instantiation directly. No-op for plain structs.
    rtObjectLitRecord(typed, expectedTy)
    let fields Array<ObjectFieldNode>: typed.fields
    let decl SemTypeEntry: rtLookupTypeEntry(state, expected)
    // When `expected` is "" or names an unknown type, `decl.name` is
    // "" and rtResolveObjectFields will pass "" expectations down — no
    // type information is invented, the AST simply stays under-typed.
    if not decl.name.equals("") {
        rtCheckMissingFields(state, fields, decl, typed.line, typed.col)
        rtCheckUndeclaredMethods(state, fields, decl, typed.line, typed.col)
    }
    rtResolveObjectFields(state, fields, decl)
    // Augment the SemTypeEntry with private fields/methods from this literal
    // before resolving method bodies, so `this.fieldname` lookups succeed.
    rtAugmentPrivateFields(state, expected, fields, typed.line, typed.col)
    // Method members (isMethod=true) carry a body that references
    // `this` and the method params. Resolve them now so the lift can
    // hoist already-typed bodies into top-level functions.
    rtResolveObjectMethods(state, fields, expected)
    return state
}

// ─── Main expression resolver ────────────────────────────────────────────────

// resolveExpr — recursive expression resolver. Reads the surrounding-context
// expected type, computes a SuruType for the node, mutates the node's
// resolvedType field, and recurses into sub-expressions threading the right
// expectation down.
//
// `expected = ""` means "no surrounding expectation; resolve bottom-up only".
// For literal / var-ref / field-access / unary / binary nodes the expected
// value is unused — those produce their own type from scope or a fixed table.
// It matters for ArrayLitNode, ObjectLitNode and MatchExprNode (which pick the
// type from context) and for CallNode (which unifies its generic type args
// against the expectation).
//
// `expectedTy` is the STRUCTURED form of the same expectation (a `Type`), used
// by the CallNode arm to bind generic type arguments by unification (§2.2). At
// contexts with no expectation it is the sentinel `primType("")`. Threading the
// structured value — rather than re-parsing the lossy `makeSuruType` string —
// is the point of the refactor: type information stays a value, not a string.
fn resolveExpr(state AnalyzerState, expr AstNode, expected String, expectedTy Type) AnalyzerState {
    match expr {
        BoolLitNode: {
            let typed BoolLitNode: expr
            typed.resolvedType: "bool"
        }

        IntLitNode: {
            let typed IntLitNode: expr
            // i32 literals are upgraded only when the surrounding context
            // explicitly expects i32. Default stays i64 to preserve the
            // existing inferType behaviour from exprs.suru.
            if expected.equals("i32") { typed.resolvedType: "i32" } else { typed.resolvedType: "i64" }
        }

        FloatLitNode: {
            let typed FloatLitNode: expr
            typed.resolvedType: "f64"
        }

        StrLitNode: {
            let typed StrLitNode: expr
            typed.resolvedType: "String"
        }

        CharLitNode: {
            let typed CharLitNode: expr
            typed.resolvedType: "char"
        }

        VarRefNode: {
            let typed VarRefNode: expr
            let raw String: state.lookupSymbol(typed.name)
            typed.resolvedType: tyh.makeSuruType(raw)
        }

        CallNode: {
            let typed CallNode: expr
            let name String: typed.name
            rtResolveCallArgs(state, typed.args, name)
            // readFile is a builtin that returns String; everything else falls
            // through to the function-signature lookup. exit/printLn return
            // nothing meaningful for type-inference — leave "". (Byte-addressed
            // pointer ops are now ptr methods — see rtResolveMethodCallNode.)
            if name.equals("readFile") {
                typed.resolvedType: "String"
            } else {
                let raw String: state.functions.returnType(name)
                // §2.2: for an unambiguous generic callee with a known
                // expectation, bind its type arguments by unifying the (varized)
                // return template against `expectedTy`, recording concrete
                // `typeArgs` and the concrete `resolvedType` on the node. We
                // extract the callee's type params + return annotation here
                // (where AnalyzerState access is cheap) and hand them to the
                // pure rtCallUnify. It fails closed; on a miss we keep the legacy
                // template-typed behavior and let monomorphization bind later.
                let bound bool: false
                if state.functions.nameCount(name).equals(1) {
                    let tparams Array<String>: state.functions.typeParams(name)
                    if tparams.len().gt(0) {
                        bound: rtCallUnify(typed, expectedTy, tparams, raw)
                        // §3.2: when return-vs-expected didn't bind (the type var
                        // appears only in a parameter, e.g. elemBytes<T>(dummy T) i64,
                        // or the call has no return expectation), record the type
                        // args from param-vs-arg unification so monomorphization can
                        // read them. This does NOT set resolvedType — the fallback
                        // below preserves the pass's existing IR.
                        if not bound {
                            let paramAnns Array<String>: rtCollectParamAnns(state, name, typed.args.len())
                            let argTys Array<Type>: rtCollectArgTys(typed.args)
                            rtRecordArgBindings(typed.typeArgs, tparams, paramAnns, argTys)
                            drop(paramAnns)
                            drop(argTys)
                        }
                    }
                }
                if not bound {
                    typed.resolvedType: tyh.makeSuruType(raw)
                }
            }
        }

        MethodCallNode: {
            let typed MethodCallNode: expr
            rtResolveMethodCallNode(state, typed, expected, expectedTy)
        }

        FieldAccessNode: {
            let typed FieldAccessNode: expr
            rtResolveFieldAccessNode(state, typed)
        }

        ArrayLitNode: {
            let typed ArrayLitNode: expr
            rtResolveArrayLitNode(state, typed, expected, expectedTy)
        }

        ObjectLitNode: {
            let typed ObjectLitNode: expr
            rtResolveObjectLitNode(state, typed, expected, expectedTy)
        }

        MatchExprNode: {
            let typed MatchExprNode: expr
            let cond AstNode: typed.condition
            let noTy Type: primType("")
            resolveExpr(state, cond, "", noTy)
            let arms Array<MatchArm>: typed.arms
            rtResolveMatchArms(state, arms, expected, expectedTy)
            if expected.equals("") and arms.len().gt(0) {
                typed.resolvedType: rtNodeResolvedType(arms.at(0).body)
            } else {
                typed.resolvedType: expected
            }
        }

        UnaryNode: {
            let typed UnaryNode: expr
            let noTy Type: primType("")
            resolveExpr(state, typed.operand, "", noTy)
            // The only unary operator today is logical `not`; semantic.suru's
            // inferType already returns "bool" for every UnaryNode.
            typed.resolvedType: "bool"
        }

        BinaryNode: {
            let typed BinaryNode: expr
            let noTy Type: primType("")
            resolveExpr(state, typed.left, "", noTy)
            resolveExpr(state, typed.right, "", noTy)
            // Mirrors the current inferType behaviour: every binary operator
            // produces bool. Expanded to arithmetic in a future task.
            typed.resolvedType: "bool"
        }

        SizeNode: {
            let typed SizeNode: expr
            if not currentModuleHasImport(state.currentModuleImports, "stdlib.ffi") {
                state.addError("typeSize is a compiler intrinsic; add: import { [typeSize]: stdlib.ffi }", typed.line, typed.col)
            }
            typed.resolvedType: "i64"
        }

        _: {}
    }
    return state
}

// ─── Statement walker ────────────────────────────────────────────────────────

// rtResolveBody — walk a list of statements inside a function body, threading
// `expectedReturn` down to ReturnNodes. Manages its own scope frames so that
// VarRef lookups resolve correctly inside loops and if/else branches.
fn rtResolveBody(state AnalyzerState, stmts Array<AstNode>, expectedReturn String, expectedReturnTy Type) AnalyzerState {
    let i i64: 0
    while i.lt(stmts.len()) {
        rtResolveStmt(state, stmts.at(i), expectedReturn, expectedReturnTy)
        i: i.add(1)
    }
    return state
}

// rtResolveStmt — dispatch one statement, picking the right expected type for
// each contained expression. `expectedReturnTy` is the structured form of
// `expectedReturn`, threaded to ReturnNode for generic-call type-arg binding.
fn rtResolveStmt(state AnalyzerState, stmt AstNode, expectedReturn String, expectedReturnTy Type) AnalyzerState {
    match stmt {
        LetNode: {
            let typed LetNode: stmt
            let expected String: tyh.makeSuruType(typed.typeName)
            let expectedTy Type: parseType(typed.typeName)
            let val AstNode: typed.value
            resolveExpr(state, val, expected, expectedTy)
            // Declare the symbol so later VarRefs inside this scope resolve.
            // collectTypeDeclarations doesn't touch state.scopes, and the
            // statement-analysis pass runs after us — but it re-declares the
            // same symbols, so there's no risk of double-binding. We avoid
            // duplicating sem.existsInCurrentScope errors here.
            if not state.existsInCurrentScope(typed.name) {
                state.declareSymbol(typed.name, typed.typeName)
            }
        }

        AssignNode: {
            let typed AssignNode: stmt
            let varType String: state.lookupSymbol(typed.name)
            let expected String: tyh.makeSuruType(varType)
            let expectedTy Type: parseType(varType)
            let val AstNode: typed.value
            resolveExpr(state, val, expected, expectedTy)
        }

        FieldAssignNode: {
            let typed FieldAssignNode: stmt
            let rcv AstNode: typed.receiver
            let noTy Type: primType("")
            resolveExpr(state, rcv, "", noTy)
            let rcvType String: rtNodeResolvedType(rcv)
            let decl SemTypeEntry: rtLookupTypeEntry(state, rcvType)
            // Privacy check: private data fields may only be written via `this`.
            let privNamesA Array<String>: decl.privateFieldNames
            if isPrivateName(privNamesA, typed.fieldName) and not isThisReceiver(rcv) {
                state.addError("cannot assign to private field '".append(typed.fieldName).append("' from outside its object"), typed.line, typed.col)
            }
            let annot String: rtLookupFieldType(decl, typed.fieldName)
            let expected String: tyh.makeSuruType(annot)
            let expectedTy Type: parseType(annot)
            let val AstNode: typed.value
            resolveExpr(state, val, expected, expectedTy)
        }

        ReturnNode: {
            let typed ReturnNode: stmt
            if typed.hasValue {
                resolveExpr(state, typed.value, expectedReturn, expectedReturnTy)
            }
        }

        WhileNode: {
            let typed WhileNode: stmt
            let noTy Type: primType("")
            resolveExpr(state, typed.condition, "bool", noTy)
            state.pushScope()
            rtResolveBody(state, typed.body, expectedReturn, expectedReturnTy)
            state.popScope()
        }

        IfNode: {
            let typed IfNode: stmt
            let noTy Type: primType("")
            resolveExpr(state, typed.condition, "bool", noTy)
            let thenBlock BlockNode: typed.thenBranch
            state.pushScope()
            rtResolveBody(state, thenBlock.stmts, expectedReturn, expectedReturnTy)
            state.popScope()
            let elseBlock BlockNode: typed.elseBranch
            let elseStmts Array<AstNode>: elseBlock.stmts
            if elseStmts.len().gt(0) {
                state.pushScope()
                rtResolveBody(state, elseStmts, expectedReturn, expectedReturnTy)
                state.popScope()
            }
        }

        MatchStmtNode: {
            let typed MatchStmtNode: stmt
            let noTy Type: primType("")
            resolveExpr(state, typed.condition, "", noTy)
            rtResolveMatchStmtArms(state, typed.arms, expectedReturn, expectedReturnTy)
        }

        BlockNode: {
            let typed BlockNode: stmt
            rtResolveBody(state, typed.stmts, expectedReturn, expectedReturnTy)
        }

        ExprStmtNode: {
            let typed ExprStmtNode: stmt
            let noTy Type: primType("")
            resolveExpr(state, typed.expr, "", noTy)
        }

        _: {}
    }
    return state
}

// rtResolveMatchStmtArms — iterate MatchStmtNode arms; each arm body is a
// statement list (not a single expression) so we recurse via rtResolveBody.
// Pattern expressions are resolved with no expectation.
fn rtResolveMatchStmtArms(state AnalyzerState, arms Array<MatchStmtArm>, expectedReturn String, expectedReturnTy Type) AnalyzerState {
    let noTy Type: primType("")
    let i i64: 0
    while i.lt(arms.len()) {
        let arm MatchStmtArm: arms.at(i)
        if not arm.isWildcard {
            resolveExpr(state, arm.pattern, "", noTy)
        }
        state.pushScope()
        rtResolveBody(state, arm.stmts, expectedReturn, expectedReturnTy)
        state.popScope()
        i: i.add(1)
    }
    return state
}

// ─── Module driver ───────────────────────────────────────────────────────────

// rtResolveFnDecl — set up a function scope with parameter symbols and walk
// the body with the function's declared return type as the return-expectation.
// Mirrors the scope discipline in fns.suru:analyzeFunctionDeclaration but
// without the error-checking responsibilities (that pass runs separately).
fn rtResolveFnDecl(state AnalyzerState, stmt FnDeclNode) AnalyzerState {
    state.pushScope()
    let params Array<Param>: stmt.params
    let pi i64: 0
    while pi.lt(params.len()) {
        let p Param: params.at(pi)
        state.declareSymbol(p.name, p.typeName)
        pi: pi.add(1)
    }
    let returnType String: stmt.returnType
    let expectedReturn String: tyh.makeSuruType(returnType)
    let expectedReturnTy Type: parseType(returnType)
    rtResolveBody(state, stmt.body, expectedReturn, expectedReturnTy)
    state.popScope()
    return state
}

// resolveModuleTypes — top-level driver. Walks `stmts` and writes
// `resolvedType` on every expression node. Must run *after* runPrePasses (so
// state.typeDecls and state.functions are populated) and *before* the regular
// statement analyzer (so the AST is fully annotated when any later pass or
// codegen reads expr.resolvedType).
//
// Scope discipline: this pass declares its own symbols into state.scopes so
// VarRef resolution works inside function bodies. To avoid polluting the
// scope stack seen by the downstream `analyzeModuleStatements` pass (which
// re-declares each module-level `let` and would then report duplicates), we
// swap in a fresh scope stack for the duration of the pass and restore the
// caller's stack on exit.
export fn resolveModuleTypes(state AnalyzerState, stmts Array<AstNode>) AnalyzerState {
    let savedScopes Array<Scope>: state.scopes
    let myScopes Array<Scope>: []
    let modScope Scope: sem.newScope(0.take(1))
    myScopes.add(modScope)
    state.scopes: myScopes

    let i i64: 0
    while i.lt(stmts.len()) {
        let stmt AstNode: stmts.at(i)
        match stmt {
            FnDeclNode: {
                let typedFn FnDeclNode: stmt
                // Update current-module import context before resolving the
                // function body.  This is the per-module isolation mechanism:
                // each function's imports are those of its owning source file,
                // not the root file's.  The registry lookup uses fd.srcPath so
                // this is correct for both pass 1 (per-module stmts) and pass
                // 2 (merged stmts with injected concrete copies).
                state.currentModuleImports: lookupModuleImports(state.moduleImportRegistry, typedFn.srcPath)
                rtResolveFnDecl(state, typedFn)
            }
            LetNode: {
                // Module-level constants — same shape as inside a function
                // body. rtResolveStmt declares the symbol so later top-level
                // VarRefs resolve.
                let noTy Type: primType("")
                rtResolveStmt(state, stmt, "", noTy)
            }
            _: {}
        }
        i: i.add(1)
    }

    state.scopes: savedScopes
    return state
}
