// monoSubst.suru — Type-parameter substitution for monomorphization.
//
// substituteType replaces type-variable names with concrete types in a
// type-name string.  substStmt and substExpr deep-clone an AstNode while
// substituting all type annotations (typeName, returnType, resolvedType,
// Param.typeName, MethodSig types, etc.).
//
// substStmt and substExpr are mutually recursive (StructFieldNode method
// bodies need both) and so live in this single file.
//
// Used by monoInstantiate.suru to produce concrete copies of generic defs.

include "../parser/parserAst.suru" as ast

// ─── String helpers ───────────────────────────────────────────────────────────

// indexOfLT — index of first '<' in s, or s.len() when absent.
fn indexOfLT(s String) Int64 {
    let i Int64: 0
    while i.lt(s.len()) {
        match s.at(i).equals("<") {
            true: { return i }
            _: {}
        }
        i: i.add(1)
    }
    return s.len()
}

// trimLeft — strip leading ASCII spaces from s.
fn trimLeft(s String) String {
    let i Int64: 0
    while i.lt(s.len()) {
        match s.slice(i, i.add(1)).equals(" ") {
            true: {}
            _: { return s.slice(i, s.len()) }
        }
        i: i.add(1)
    }
    return ""
}

// splitByCommaAt — accumulates comma-separated substrings of s into results.
fn splitByCommaAt(s String, start Int64, i Int64, results Array<String>) Array<String> {
    match i.lt(s.len()) {
        _: {
            results.add(s.slice(start, s.len()))
            return results
        }
        true: {}
    }
    match s.at(i).equals(",") {
        true: {
            results.add(s.slice(start, i))
            return splitByCommaAt(s, i.add(1), i.add(1), results)
        }
        _: {}
    }
    return splitByCommaAt(s, start, i.add(1), results)
}

// splitByComma — split s by ',' into an Array<String>.
fn splitByComma(s String) Array<String> {
    let results Array<String>: []
    return splitByCommaAt(s, 0, 0, results)
}

// joinSubstituted — substitute each element of args and join with ','.
fn joinSubstituted(args Array<String>, paramNames Array<String>, concreteTypes Array<String>, i Int64) String {
    match i.lt(args.len()) {
        _: { return "" }
        true: {}
    }
    let arg String: trimLeft(args.at(i))
    let sub String: substituteType(arg, paramNames, concreteTypes)
    let rest String: joinSubstituted(args, paramNames, concreteTypes, i.add(1))
    match rest.len().gt(0) {
        true: { return sub.append(",").append(rest) }
        _: { return sub }
    }
}

// substituteType — replace type-variable names with concrete types.
// Handles bare type vars ("T" → "Int64"), single-arg generics
// ("Array<T>" → "Array<Int64>"), and multi-arg forms
// ("Pair<T, U>" → "Pair<Int64,String>").
fn substituteType(typeName String, paramNames Array<String>, concreteTypes Array<String>) String {
    // Exact match: bare type variable.
    let i Int64: 0
    while i.lt(paramNames.len()) {
        match paramNames.at(i).equals(typeName) {
            true: { return concreteTypes.at(i) }
            _: {}
        }
        i: i.add(1)
    }
    // No '<': plain non-generic type — return unchanged.
    let ltIdx Int64: indexOfLT(typeName)
    match ltIdx.equals(typeName.len()) {
        true: { return typeName }
        _: {}
    }
    // Generic application: substitute all type args and rebuild.
    let base String: typeName.slice(0, ltIdx)
    let inner String: typeName.slice(ltIdx.add(1), typeName.len().take(1))
    let args Array<String>: splitByComma(inner)
    let substArgs String: joinSubstituted(args, paramNames, concreteTypes, 0)
    return base.append("<").append(substArgs).append(">")
}

// ─── Param / MethodSig substitution ──────────────────────────────────────────

fn substParam(p Param, paramNames Array<String>, concreteTypes Array<String>) Param {
    return { name: p.name, typeName: substituteType(p.typeName, paramNames, concreteTypes) }
}

fn substParamsAt(params Array<Param>, paramNames Array<String>, concreteTypes Array<String>, i Int64, out Array<Param>) Array<Param> {
    match i.lt(params.len()) {
        _: { return out }
        true: {}
    }
    out.add(substParam(params.at(i), paramNames, concreteTypes))
    return substParamsAt(params, paramNames, concreteTypes, i.add(1), out)
}

fn substParams(params Array<Param>, paramNames Array<String>, concreteTypes Array<String>) Array<Param> {
    let out Array<Param>: []
    return substParamsAt(params, paramNames, concreteTypes, 0, out)
}

fn substMethodSig(ms MethodSig, paramNames Array<String>, concreteTypes Array<String>) MethodSig {
    let newParams Array<Param>: substParams(ms.params, paramNames, concreteTypes)
    let newRet String: substituteType(ms.returnType, paramNames, concreteTypes)
    return { name: ms.name, params: newParams, returnType: newRet }
}

fn substMethodSigsAt(methods Array<MethodSig>, paramNames Array<String>, concreteTypes Array<String>, i Int64, out Array<MethodSig>) Array<MethodSig> {
    match i.lt(methods.len()) {
        _: { return out }
        true: {}
    }
    out.add(substMethodSig(methods.at(i), paramNames, concreteTypes))
    return substMethodSigsAt(methods, paramNames, concreteTypes, i.add(1), out)
}

fn substMethodSigs(methods Array<MethodSig>, paramNames Array<String>, concreteTypes Array<String>) Array<MethodSig> {
    let out Array<MethodSig>: []
    return substMethodSigsAt(methods, paramNames, concreteTypes, 0, out)
}

// ─── Array helpers (forward-reference substStmt / substExpr) ─────────────────

fn substStmtsAt(stmts Array<AstNode>, paramNames Array<String>, concreteTypes Array<String>, i Int64, out Array<AstNode>) Array<AstNode> {
    match i.lt(stmts.len()) {
        _: { return out }
        true: {}
    }
    out.add(substStmt(stmts.at(i), paramNames, concreteTypes))
    return substStmtsAt(stmts, paramNames, concreteTypes, i.add(1), out)
}

fn substStmts(stmts Array<AstNode>, paramNames Array<String>, concreteTypes Array<String>) Array<AstNode> {
    let out Array<AstNode>: []
    return substStmtsAt(stmts, paramNames, concreteTypes, 0, out)
}

fn substExprsAt(exprs Array<AstNode>, paramNames Array<String>, concreteTypes Array<String>, i Int64, out Array<AstNode>) Array<AstNode> {
    match i.lt(exprs.len()) {
        _: { return out }
        true: {}
    }
    out.add(substExpr(exprs.at(i), paramNames, concreteTypes))
    return substExprsAt(exprs, paramNames, concreteTypes, i.add(1), out)
}

fn substExprs(exprs Array<AstNode>, paramNames Array<String>, concreteTypes Array<String>) Array<AstNode> {
    let out Array<AstNode>: []
    return substExprsAt(exprs, paramNames, concreteTypes, 0, out)
}

// ─── BlockNode helper ─────────────────────────────────────────────────────────

fn substBlock(block BlockNode, paramNames Array<String>, concreteTypes Array<String>) BlockNode {
    let newStmts Array<AstNode>: substStmts(block.stmts, paramNames, concreteTypes)
    return { stmts: newStmts }
}

// ─── StructFieldNode substitution ────────────────────────────────────────────

fn substStructField(sf StructFieldNode, paramNames Array<String>, concreteTypes Array<String>) StructFieldNode {
    let newVal AstNode: substExpr(sf.value, paramNames, concreteTypes)
    let newMparams Array<Param>: substParams(sf.methodParams, paramNames, concreteTypes)
    let newMret String: substituteType(sf.methodRet, paramNames, concreteTypes)
    let newMbody Array<AstNode>: substStmts(sf.methodBody, paramNames, concreteTypes)
    return { name: sf.name, value: newVal, isMethod: sf.isMethod, methodParams: newMparams, methodRet: newMret, methodBody: newMbody }
}

fn substStructFieldsAt(fields Array<StructFieldNode>, paramNames Array<String>, concreteTypes Array<String>, i Int64, out Array<StructFieldNode>) Array<StructFieldNode> {
    match i.lt(fields.len()) {
        _: { return out }
        true: {}
    }
    out.add(substStructField(fields.at(i), paramNames, concreteTypes))
    return substStructFieldsAt(fields, paramNames, concreteTypes, i.add(1), out)
}

fn substStructFields(fields Array<StructFieldNode>, paramNames Array<String>, concreteTypes Array<String>) Array<StructFieldNode> {
    let out Array<StructFieldNode>: []
    return substStructFieldsAt(fields, paramNames, concreteTypes, 0, out)
}

// ─── MatchArm / MatchStmtArm substitution ────────────────────────────────────

fn substMatchArm(arm MatchArm, paramNames Array<String>, concreteTypes Array<String>) MatchArm {
    let newPat AstNode: substExpr(arm.pattern, paramNames, concreteTypes)
    let newBody AstNode: substExpr(arm.body, paramNames, concreteTypes)
    return { isWildcard: arm.isWildcard, pattern: newPat, body: newBody }
}

fn substMatchArmsAt(arms Array<MatchArm>, paramNames Array<String>, concreteTypes Array<String>, i Int64, out Array<MatchArm>) Array<MatchArm> {
    match i.lt(arms.len()) {
        _: { return out }
        true: {}
    }
    out.add(substMatchArm(arms.at(i), paramNames, concreteTypes))
    return substMatchArmsAt(arms, paramNames, concreteTypes, i.add(1), out)
}

fn substMatchArms(arms Array<MatchArm>, paramNames Array<String>, concreteTypes Array<String>) Array<MatchArm> {
    let out Array<MatchArm>: []
    return substMatchArmsAt(arms, paramNames, concreteTypes, 0, out)
}

fn substMatchStmtArm(arm MatchStmtArm, paramNames Array<String>, concreteTypes Array<String>) MatchStmtArm {
    let newPat AstNode: substExpr(arm.pattern, paramNames, concreteTypes)
    let newStmts Array<AstNode>: substStmts(arm.stmts, paramNames, concreteTypes)
    return { isWildcard: arm.isWildcard, pattern: newPat, stmts: newStmts }
}

fn substMatchStmtArmsAt(arms Array<MatchStmtArm>, paramNames Array<String>, concreteTypes Array<String>, i Int64, out Array<MatchStmtArm>) Array<MatchStmtArm> {
    match i.lt(arms.len()) {
        _: { return out }
        true: {}
    }
    out.add(substMatchStmtArm(arms.at(i), paramNames, concreteTypes))
    return substMatchStmtArmsAt(arms, paramNames, concreteTypes, i.add(1), out)
}

fn substMatchStmtArms(arms Array<MatchStmtArm>, paramNames Array<String>, concreteTypes Array<String>) Array<MatchStmtArm> {
    let out Array<MatchStmtArm>: []
    return substMatchStmtArmsAt(arms, paramNames, concreteTypes, 0, out)
}

// ─── Statement substitution ──────────────────────────────────────────────────

// substStmt — deep-clone a statement AstNode with all type annotations
// substituted.  Non-statement variants (expressions used as patterns) fall
// through to _: { return node }.
fn substStmt(node AstNode, paramNames Array<String>, concreteTypes Array<String>) AstNode {
    match node {
        FnDeclNode: {
            let fd FnDeclNode: node
            let newParams Array<Param>: substParams(fd.params, paramNames, concreteTypes)
            let newRet String: substituteType(fd.returnType, paramNames, concreteTypes)
            let newBody Array<AstNode>: substStmts(fd.body, paramNames, concreteTypes)
            let result FnDeclNode: { name: fd.name, params: newParams, returnType: newRet, body: newBody, srcPath: fd.srcPath, typeParams: fd.typeParams }
            return result
        }
        TypeDeclNode: {
            let td TypeDeclNode: node
            let newFields Array<Param>: substParams(td.fields, paramNames, concreteTypes)
            let newMethods Array<MethodSig>: substMethodSigs(td.methods, paramNames, concreteTypes)
            let result TypeDeclNode: { name: td.name, fields: newFields, methods: newMethods, typeParams: td.typeParams }
            return result
        }
        LetNode: {
            let ln LetNode: node
            let newType String: substituteType(ln.typeName, paramNames, concreteTypes)
            let newVal AstNode: substExpr(ln.value, paramNames, concreteTypes)
            let result LetNode: { name: ln.name, typeName: newType, value: newVal }
            return result
        }
        AssignNode: {
            let an AssignNode: node
            let newVal AstNode: substExpr(an.value, paramNames, concreteTypes)
            let result AssignNode: { name: an.name, value: newVal }
            return result
        }
        FieldAssignNode: {
            let fan FieldAssignNode: node
            let newRec AstNode: substExpr(fan.receiver, paramNames, concreteTypes)
            let newVal AstNode: substExpr(fan.value, paramNames, concreteTypes)
            let result FieldAssignNode: { receiver: newRec, fieldName: fan.fieldName, value: newVal }
            return result
        }
        ReturnNode: {
            let rn ReturnNode: node
            let newVal AstNode: substExpr(rn.value, paramNames, concreteTypes)
            let result ReturnNode: { hasValue: rn.hasValue, value: newVal }
            return result
        }
        WhileNode: {
            let wn WhileNode: node
            let newCond AstNode: substExpr(wn.condition, paramNames, concreteTypes)
            let newBody Array<AstNode>: substStmts(wn.body, paramNames, concreteTypes)
            let result WhileNode: { condition: newCond, body: newBody }
            return result
        }
        ExprStmtNode: {
            let en ExprStmtNode: node
            let newExpr AstNode: substExpr(en.expr, paramNames, concreteTypes)
            let result ExprStmtNode: { expr: newExpr }
            return result
        }
        IfNode: {
            let ifn IfNode: node
            let newCond AstNode: substExpr(ifn.condition, paramNames, concreteTypes)
            let newThen BlockNode: substBlock(ifn.thenBranch, paramNames, concreteTypes)
            let newElse BlockNode: substBlock(ifn.elseBranch, paramNames, concreteTypes)
            let result IfNode: { condition: newCond, thenBranch: newThen, elseBranch: newElse }
            return result
        }
        MatchStmtNode: {
            let mn MatchStmtNode: node
            let newCond AstNode: substExpr(mn.condition, paramNames, concreteTypes)
            let newArms Array<MatchStmtArm>: substMatchStmtArms(mn.arms, paramNames, concreteTypes)
            let result MatchStmtNode: { condition: newCond, arms: newArms }
            return result
        }
        BlockNode: {
            let bn BlockNode: node
            let result BlockNode: substBlock(bn, paramNames, concreteTypes)
            return result
        }
        _: { return node }
    }
    return node
}

// ─── Expression substitution ─────────────────────────────────────────────────

// substExpr — deep-clone an expression AstNode with all type annotations
// substituted.  Non-expression variants fall through to _: { return node }.
fn substExpr(node AstNode, paramNames Array<String>, concreteTypes Array<String>) AstNode {
    match node {
        BoolLitNode: {
            let bl BoolLitNode: node
            let result BoolLitNode: { boolVal: bl.boolVal, resolvedType: substituteType(bl.resolvedType, paramNames, concreteTypes) }
            return result
        }
        IntLitNode: {
            let il IntLitNode: node
            let result IntLitNode: { text: il.text, resolvedType: substituteType(il.resolvedType, paramNames, concreteTypes) }
            return result
        }
        FloatLitNode: {
            let fl FloatLitNode: node
            let result FloatLitNode: { text: fl.text, resolvedType: substituteType(fl.resolvedType, paramNames, concreteTypes) }
            return result
        }
        StrLitNode: {
            let sl StrLitNode: node
            let result StrLitNode: { text: sl.text, resolvedType: substituteType(sl.resolvedType, paramNames, concreteTypes) }
            return result
        }
        CharLitNode: {
            let cl CharLitNode: node
            let result CharLitNode: { text: cl.text, resolvedType: substituteType(cl.resolvedType, paramNames, concreteTypes) }
            return result
        }
        WildcardNode: {
            return node
        }
        VarRefNode: {
            let vr VarRefNode: node
            let result VarRefNode: { name: vr.name, resolvedType: substituteType(vr.resolvedType, paramNames, concreteTypes) }
            return result
        }
        CallNode: {
            let cn CallNode: node
            let newArgs Array<AstNode>: substExprs(cn.args, paramNames, concreteTypes)
            let result CallNode: { name: cn.name, args: newArgs, resolvedType: substituteType(cn.resolvedType, paramNames, concreteTypes) }
            return result
        }
        MethodCallNode: {
            let mcn MethodCallNode: node
            let newRec AstNode: substExpr(mcn.receiver, paramNames, concreteTypes)
            let newArgs Array<AstNode>: substExprs(mcn.args, paramNames, concreteTypes)
            let result MethodCallNode: { receiver: newRec, methodName: mcn.methodName, args: newArgs, resolvedType: substituteType(mcn.resolvedType, paramNames, concreteTypes) }
            return result
        }
        FieldAccessNode: {
            let fan FieldAccessNode: node
            let newRec AstNode: substExpr(fan.receiver, paramNames, concreteTypes)
            let result FieldAccessNode: { receiver: newRec, fieldName: fan.fieldName, resolvedType: substituteType(fan.resolvedType, paramNames, concreteTypes) }
            return result
        }
        ArrayLitNode: {
            let aln ArrayLitNode: node
            let newElems Array<AstNode>: substExprs(aln.elems, paramNames, concreteTypes)
            let result ArrayLitNode: { elems: newElems, resolvedType: substituteType(aln.resolvedType, paramNames, concreteTypes) }
            return result
        }
        StructLitNode: {
            let sln StructLitNode: node
            let newFields Array<StructFieldNode>: substStructFields(sln.fields, paramNames, concreteTypes)
            let result StructLitNode: { fields: newFields, resolvedType: substituteType(sln.resolvedType, paramNames, concreteTypes) }
            return result
        }
        MatchExprNode: {
            let men MatchExprNode: node
            let newCond AstNode: substExpr(men.condition, paramNames, concreteTypes)
            let newArms Array<MatchArm>: substMatchArms(men.arms, paramNames, concreteTypes)
            let result MatchExprNode: { condition: newCond, arms: newArms, resolvedType: substituteType(men.resolvedType, paramNames, concreteTypes) }
            return result
        }
        UnaryNode: {
            let un UnaryNode: node
            let newOperand AstNode: substExpr(un.operand, paramNames, concreteTypes)
            let result UnaryNode: { op: un.op, operand: newOperand, resolvedType: substituteType(un.resolvedType, paramNames, concreteTypes) }
            return result
        }
        BinaryNode: {
            let bn BinaryNode: node
            let newLeft AstNode: substExpr(bn.left, paramNames, concreteTypes)
            let newRight AstNode: substExpr(bn.right, paramNames, concreteTypes)
            let result BinaryNode: { op: bn.op, left: newLeft, right: newRight, resolvedType: substituteType(bn.resolvedType, paramNames, concreteTypes) }
            return result
        }
        VtableRefNode: {
            let vr VtableRefNode: node
            let result VtableRefNode: { sym: vr.sym, entries: vr.entries, resolvedType: substituteType(vr.resolvedType, paramNames, concreteTypes) }
            return result
        }
        _: { return node }
    }
    return node
}
