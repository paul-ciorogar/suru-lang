// Semantic Analyzer: Function Declaration Analysis
//
// Implements analyzeFunctionDeclaration and the checkHasReturn helper suite.
//
// analyzeFunctionDeclaration:
//   push fresh scope → inject params → set currentReturnType → analyze body →
//   verify non-void has return → pop scope → restore context.
//
// checkHasReturn:
//   linear scan of a statement list; returns true on ReturnNode or on
//   a WhileNode whose body transitively contains a return. The exit()
//   path is handled in expr analysis (requires expression analysis to resolve).
//
// All function names here are distinct from those in suru-semantic-stmts.suru
// to avoid LLVM link-time symbol collisions — each included file compiles to
// its own .o and names are not prefixed by their include alias.

namespace Suru.Compiler.Semantic.Fns

import {
    semantic: Suru.Compiler.Semantic
    passes: Suru.Compiler.Semantic.Passes
    analysis: Suru.Compiler.Semantic.Stmts
}

// ─── checkHasReturn ───────────────────────────────────────────────────────────

// allMatchArmsHaveReturn — true when every arm of a MatchStmtNode has a return/exit
// path.  Typed as Array<MatchStmtArm> so arm.stmts resolves without an undeclared-field GEP.
fn allMatchArmsHaveReturn(arms Array<MatchStmtArm>) bool {
    let i i64: 0
    while i.lt(arms.len()) {
        let arm MatchStmtArm: arms.at(i)
        if not checkHasReturn(arm.stmts) { return false }
        i: i.add(1)
    }
    return true
}

// Typed bridge: accepts a generic AstNode, casts to MatchStmtNode so .arms resolves.
fn checkHasReturnInMatchStmt(node AstNode) bool {
    let matchNode MatchStmtNode: node
    return allMatchArmsHaveReturn(matchNode.arms)
}

// isExitCall — true when an ExprStmtNode contains a direct call to exit().
// Uses typed intermediate so CallNode.name (String) dispatches correctly.
//
// IMPORTANT: innerExpr.name is only accessed inside the CallNode arm.
// Other node kinds (e.g. MatchExprNode) have no `name` field; suru_find_field
// walks off the end of the linked list and segfaults when the field is absent.
fn isExitCall(stmt ExprStmtNode) bool {
    let innerExpr AstNode: stmt.expr
    match innerExpr {
        CallNode: {
            let typedCall CallNode: innerExpr
            let innerName String: typedCall.name
            return innerName.equals("exit")
        }
        _: {}
    }
    return false
}

// checkHasReturnInIf — true when an IfNode guarantees a return on every path.
//
// Two conditions must hold:
//   1. The else branch is non-empty.  Without an else clause the false path
//      falls through past the if, so the statement cannot guarantee return.
//   2. Both the then and else branches transitively contain a return.
//
// Typed bridge analogous to checkHasReturnInMatchStmt: accepts AstNode and
// casts to IfNode internally so .thenBranch / .elseBranch resolve.
fn checkHasReturnInIf(node AstNode) bool {
    let ifNode IfNode: node
    let elseBlock BlockNode: ifNode.elseBranch
    let elseStmts Array<AstNode>: elseBlock.stmts
    if not elseStmts.len().gt(0) { return false }
    let thenBlock BlockNode: ifNode.thenBranch
    return checkHasReturn(thenBlock.stmts) and checkHasReturn(elseStmts)
}

// checkHasReturn — linear scan of stmts.
// Returns true on ReturnNode, a WhileNode that transitively contains a return,
// an ExprStmtNode that is a direct call to exit(), a MatchStmtNode whose every
// arm returns, or an IfNode whose then+else branches both return.
fn checkHasReturn(stmts Array<AstNode>) bool {
    let i i64: 0
    while i.lt(stmts.len()) {
        match stmts.at(i) {
            ReturnNode:    { return true }
            WhileNode:     {
                let wn WhileNode: stmts.at(i)
                if checkHasReturn(wn.body) { return true }
            }
            ExprStmtNode:  {
                let es ExprStmtNode: stmts.at(i)
                if isExitCall(es) { return true }
            }
            MatchStmtNode: { if checkHasReturnInMatchStmt(stmts.at(i)) { return true } }
            IfNode:        { if checkHasReturnInIf(stmts.at(i))        { return true } }
            _: {}
        }
        i: i.add(1)
    }
    return false
}

// ─── analyzeFunctionDeclaration ───────────────────────────────────────────────

// analyzeFunctionDeclaration — mirrors SemanticAnalyzer.AnalyzeFunctionDeclaration
// (SemanticAnalyzer.cs:201–226).
//
// stmt fields (all declared in FnDeclNode):
//   stmt.name        String       — function name for error messages
//   stmt.returnType  String       — determines void vs non-void; set on state.currentReturnType
//   stmt.params      Array<Param> — injected as symbols in the fresh function scope
//   stmt.body        Array<AstNode> — analyzed via analysis.analyzeStatements
//
// Module-scope constants and symbols remain visible inside the function through
// the parent-chain traversal in lookupSymbol: the new function scope's parent
// index points to the module scope, so lookupSymbolAt walks up naturally.
export fn analyzeFunctionDeclaration(state AnalyzerState, stmt FnDeclNode) AnalyzerState {
    // 1. Save outer context for restoration after body analysis.
    let savedReturnType String: state.currentReturnType
    let savedInsideFunction i64: state.insideFunction
    let savedMovedVars Array<String>: state.movedVars
    let savedSrcPath String: state.currentSrcPath
    state.currentSrcPath: stmt.srcPath

    // 2. Push a fresh scope so param names and body locals are scoped to this function.
    state.pushScope()

    // 3. Inject parameters as symbols in the new scope.
    let params Array<Param>: stmt.params
    let pi i64: 0
    while pi.lt(params.len()) {
        let p Param: params.at(pi)
        state.declareSymbol(p.name, p.typeName)
        pi: pi.add(1)
    }

    // 4. Set function context; analyzeReturnStatement reads currentReturnType to
    //    detect bare returns in non-void functions.
    let returnType String: stmt.returnType
    state.currentReturnType: returnType
    state.insideFunction: 1
    // Each function body starts with a clean move-tracking slate.
    state.resetMovedVars()

    // 5. Analyze the function body using the statement analyzer.
    let body Array<AstNode>: stmt.body
    analysis.analyzeStatements(state, body)

    // 6. Non-void functions must have at least one reachable return path.
    let isVoid bool: returnType.equals("void") or returnType.equals("")
    if not isVoid and not checkHasReturn(body) {
        state.addError("function '".append(stmt.name).append("' has no return statement"), stmt.line, stmt.col)
    }

    // 7. Pop function scope and restore context for the enclosing scope.
    state.popScope()
    state.currentReturnType: savedReturnType
    state.insideFunction: savedInsideFunction
    state.movedVars: savedMovedVars
    state.currentSrcPath: savedSrcPath

    return state
}
