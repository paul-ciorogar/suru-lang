// monoInstantiate.suru — Produce concrete copies of generic definitions
// via monomorphization.
//
// mangleGenericName builds the mangled name for a concrete instantiation
// (e.g. "Pair__Int64__String").  instantiateType / instantiateFn deep-clone a
// generic AST node with all type-parameter names substituted with their concrete
// counterparts and the definition name replaced by the mangled form.
// instantiateAll orchestrates deduplication across a list of
// InstantiationRequests and returns only newly produced concrete nodes.
//
// Used by monoPass.suru after monoInfer.suru has collected all instantiation
// sites from the first resolveModuleTypes pass.

include "monoCollect.suru" as collect
include "monoSubst.suru"   as subst

// ─── InstantiationRequest ─────────────────────────────────────────────────────

// InstantiationRequest names one concrete instantiation: the generic definition
// identified by genericName, specialized with the listed concrete type arguments.
// One request per usage site; duplicates are deduplicated by instantiateAll.
type InstantiationRequest: { genericName String, concreteTypes Array<String> }

// ─── Name mangling ────────────────────────────────────────────────────────────

// mangleAt — append "__<types[i]>" for each remaining concrete type to acc.
fn mangleAt(acc String, types Array<String>, i Int64) String {
    if not i.lt(types.len()) { return acc }
    return mangleAt(acc.append("__").append(types.at(i)), types, i.add(1))
}

// mangleGenericName — produce the monomorphized identifier for a generic
// definition instantiated with the given concrete types.
//   mangleGenericName("Box",  ["Int64"])          → "Box__Int64"
//   mangleGenericName("Pair", ["Int64","String"]) → "Pair__Int64__String"
fn mangleGenericName(baseName String, concreteTypes Array<String>) String {
    return mangleAt(baseName, concreteTypes, 0)
}

// ─── Instantiation ────────────────────────────────────────────────────────────

// instantiateType — produce a concrete TypeDeclNode from a generic definition.
// The result has the mangled name, empty typeParams, and all field/method type
// annotations substituted by the monoSubst helpers.
fn instantiateType(def GenericTypeDef, concreteTypes Array<String>) TypeDeclNode {
    let mangledName String: mangleGenericName(def.name, concreteTypes)
    let newFields Array<Param>: subst.substParams(def.node.fields, def.typeParams, concreteTypes)
    let newMethods Array<MethodSig>: subst.substMethodSigs(def.node.methods, def.typeParams, concreteTypes)
    let emptyTp Array<String>: []
    return { name: mangledName, fields: newFields, methods: newMethods, typeParams: emptyTp }
}

// instantiateFn — produce a concrete FnDeclNode from a generic definition.
// The result has the mangled name, empty typeParams, and all type annotations
// in params, returnType, and body substituted by the monoSubst helpers.
fn instantiateFn(def GenericFnDef, concreteTypes Array<String>) FnDeclNode {
    let mangledName String: mangleGenericName(def.name, concreteTypes)
    let newParams Array<Param>: subst.substParams(def.node.params, def.typeParams, concreteTypes)
    let newRet String: subst.substituteType(def.node.returnType, def.typeParams, concreteTypes)
    let newBody Array<AstNode>: subst.substStmts(def.node.body, def.typeParams, concreteTypes)
    let emptyTp Array<String>: []
    return { name: mangledName, params: newParams, returnType: newRet, body: newBody, srcPath: def.srcPath, typeParams: emptyTp }
}

// ─── AstNode wrap helpers ────────────────────────────────────────────────────
// The bootstrap binary's codegen only emits the AstNode sum-type header
// (offset 0 = SumType runtime tag, offset 8 = variant index) when a new
// struct LITERAL is returned from a function whose return type is AstNode.
// Merely returning an existing TypeDeclNode/FnDeclNode pointer does NOT add
// the header, leaving offset 8 as 0 (refCount), which match dispatch reads as
// IncludeNode (variant 0) instead of TypeDeclNode (8) or FnDeclNode (1).
// The workaround: create a fresh struct literal with all fields copied so
// the codegen emits the correct variant index at offset 8.
fn wrapTypeDeclNode(td TypeDeclNode) AstNode {
    let n String: td.name
    let f Array<Param>: td.fields
    let m Array<MethodSig>: td.methods
    let tp Array<String>: td.typeParams
    let r TypeDeclNode: { name: n, fields: f, methods: m, typeParams: tp }
    return r
}
fn wrapFnDeclNode(fd FnDeclNode) AstNode {
    let n String: fd.name
    let p Array<Param>: fd.params
    let rt String: fd.returnType
    let b Array<AstNode>: fd.body
    let sp String: fd.srcPath
    let tp Array<String>: fd.typeParams
    let r FnDeclNode: { name: n, params: p, returnType: rt, body: b, srcPath: sp, typeParams: tp }
    return r
}

// ─── Sum type instantiation ───────────────────────────────────────────────────

// mangleTypeExpr — convert a post-substitution type expression string into a
// mangled identifier.  Plain names are returned unchanged; generic applications
// are flattened to the mangled form.
//   "None"        → "None"
//   "Some<Int64>" → "Some__Int64"
//   "Pair<Int64,String>" → "Pair__Int64__String"
fn mangleTypeExpr(typeExpr String) String {
    let ltIdx Int64: subst.indexOfLT(typeExpr)
    // No '<': plain name — return as-is.
    if ltIdx.equals(typeExpr.len()) { return typeExpr }
    let base String: typeExpr.slice(0, ltIdx)
    // Strip the enclosing '<' and '>' and split the type args by comma.
    let inner String: typeExpr.slice(ltIdx.add(1), typeExpr.len().take(1))
    let args Array<String>: subst.splitByComma(inner)
    return mangleAt(base, args, 0)
}

// substAndMangleVariantAt — for each variant in variants[i..], apply
// substituteType then mangleTypeExpr, appending results to out.
fn substAndMangleVariantAt(variants Array<String>, paramNames Array<String>, concreteTypes Array<String>, i Int64, out Array<String>) Array<String> {
    if not i.lt(variants.len()) { return out }
    let substituted String: subst.substituteType(variants.at(i), paramNames, concreteTypes)
    out.add(mangleTypeExpr(substituted))
    return substAndMangleVariantAt(variants, paramNames, concreteTypes, i.add(1), out)
}

// instantiateSumType — produce a concrete SumTypeDeclNode from a generic sum
// type definition.  The result has the mangled name, empty typeParams, and all
// variant type expressions substituted and mangled.
fn instantiateSumType(def GenericSumTypeDef, concreteTypes Array<String>) SumTypeDeclNode {
    let mangledName String: mangleGenericName(def.name, concreteTypes)
    let outVariants Array<String>: []
    let newVariants Array<String>: substAndMangleVariantAt(def.node.variants, def.typeParams, concreteTypes, 0, outVariants)
    let emptyTp Array<String>: []
    return { name: mangledName, variants: newVariants, typeParams: emptyTp }
}

// wrapSumTypeDeclNode — forced-copy workaround so the returned AstNode carries
// the correct SumTypeDeclNode variant tag (same rationale as wrapTypeDeclNode).
fn wrapSumTypeDeclNode(sd SumTypeDeclNode) AstNode {
    let n String: sd.name
    let v Array<String>: sd.variants
    let tp Array<String>: sd.typeParams
    let r SumTypeDeclNode: { name: n, variants: v, typeParams: tp }
    return r
}

// ─── Dispatch helpers ─────────────────────────────────────────────────────────

// findInstTypeAt — walk registry.types from index i; if the name matches,
// instantiate and push the concrete TypeDeclNode into out (then stop).
// Uses wrapTypeDeclNode + typed intermediate to ensure correct AstNode tagging.
fn findInstTypeAt(registry GenericRegistry, genericName String, concreteTypes Array<String>, out Array<AstNode>, i Int64) {
    if not i.lt(registry.types.len()) { return }
    if registry.types.at(i).name.equals(genericName) {
        let concrete TypeDeclNode: instantiateType(registry.types.at(i), concreteTypes)
        let outArr Array<AstNode>: out
        outArr.add(wrapTypeDeclNode(concrete))
    } else {
        findInstTypeAt(registry, genericName, concreteTypes, out, i.add(1))
    }
}

// findInstFnAt — walk registry.fns from index i; if the name matches,
// instantiate and push the concrete FnDeclNode into out (then stop).
// Uses wrapFnDeclNode + typed intermediate to ensure correct AstNode tagging.
fn findInstFnAt(registry GenericRegistry, genericName String, concreteTypes Array<String>, out Array<AstNode>, i Int64) {
    if not i.lt(registry.fns.len()) { return }
    if registry.fns.at(i).name.equals(genericName) {
        let concrete FnDeclNode: instantiateFn(registry.fns.at(i), concreteTypes)
        let outArr Array<AstNode>: out
        outArr.add(wrapFnDeclNode(concrete))
    } else {
        findInstFnAt(registry, genericName, concreteTypes, out, i.add(1))
    }
}

// instantiateVariantTypeAt — for each variant in rawVariants[i..], if the
// variant has type arguments (e.g. "Some<T>"), substitute the type params and
// call findInstTypeAt to produce the concrete variant struct TypeDeclNode.
// This ensures that when Option<T> is instantiated, the variant structs like
// Some<T> → Some__Int64 are also generated (needed for field access in match arms).
// seen is the same deduplication set used by instantiateAllAt so variant
// structs are not added twice when the same generic struct is also inferred
// from a direct type annotation.
fn instantiateVariantTypeAt(registry GenericRegistry, rawVariants Array<String>, paramNames Array<String>, concreteTypes Array<String>, out Array<AstNode>, seen Array<String>, i Int64) {
    if not i.lt(rawVariants.len()) { return }
    let raw String: rawVariants.at(i)
    let ltIdx Int64: subst.indexOfLT(raw)
    // Only process generic variants (those with '<' in raw template form).
    if not ltIdx.equals(raw.len()) {
        // Substitute type params in the full variant expression, then
        // re-parse to extract base name and concrete arg list.
        // E.g. "Some<T>" + {T→Int64} → "Some<Int64>" → base="Some", args=["Int64"]
        let substituted String: subst.substituteType(raw, paramNames, concreteTypes)
        let subLtIdx Int64: subst.indexOfLT(substituted)
        if not subLtIdx.equals(substituted.len()) {
            let baseName String: substituted.slice(0, subLtIdx)
            let inner String: substituted.slice(subLtIdx.add(1), substituted.len().take(1))
            let variantArgs Array<String>: subst.splitByComma(inner)
            let mangledVariant String: mangleGenericName(baseName, variantArgs)
            // Skip if already instantiated (prevents duplicate TypeDeclNodes).
            if not alreadySeen(seen, mangledVariant) {
                seen.add(mangledVariant)
                findInstTypeAt(registry, baseName, variantArgs, out, 0)
            }
        }
    }
    instantiateVariantTypeAt(registry, rawVariants, paramNames, concreteTypes, out, seen, i.add(1))
}

// findInstSumTypeAt — walk registry.sumTypes from index i; if the name matches,
// instantiate and push the concrete SumTypeDeclNode into out (then stop).
// Also instantiates the concrete variant struct TypeDeclNodes (e.g. Some<T> →
// Some__Int64) so that field access inside match arms works correctly.
// seen is the deduplication set from instantiateAllAt, shared to prevent
// double-adding variant structs that were also directly inferred.
fn findInstSumTypeAt(registry GenericRegistry, genericName String, concreteTypes Array<String>, out Array<AstNode>, seen Array<String>, i Int64) {
    if not i.lt(registry.sumTypes.len()) { return }
    if registry.sumTypes.at(i).name.equals(genericName) {
        let def GenericSumTypeDef: registry.sumTypes.at(i)
        let concrete SumTypeDeclNode: instantiateSumType(def, concreteTypes)
        let outArr Array<AstNode>: out
        outArr.add(wrapSumTypeDeclNode(concrete))
        // Instantiate the variant struct types (e.g. Some<T> → Some__Int64).
        instantiateVariantTypeAt(registry, def.node.variants, def.typeParams, concreteTypes, out, seen, 0)
    } else {
        findInstSumTypeAt(registry, genericName, concreteTypes, out, seen, i.add(1))
    }
}

// ─── Deduplication ────────────────────────────────────────────────────────────

// alreadySeenAt — linear scan of seen[i..] for name.
fn alreadySeenAt(seen Array<String>, name String, i Int64) Bool {
    if not i.lt(seen.len()) { return false }
    if seen.at(i).equals(name) { return true }
    return alreadySeenAt(seen, name, i.add(1))
}

// alreadySeen — true if name is already in the seen set.
fn alreadySeen(seen Array<String>, name String) Bool {
    return alreadySeenAt(seen, name, 0)
}

// ─── Batch instantiation ──────────────────────────────────────────────────────

// instantiateAllAt — process requests[i..], skipping already-seen mangled names.
// For each new request: add its mangled name to seen, then dispatch to
// findInstTypeAt and findInstFnAt (exactly one will match for any valid request).
fn instantiateAllAt(registry GenericRegistry, requests Array<InstantiationRequest>, seen Array<String>, out Array<AstNode>, i Int64) Array<AstNode> {
    if not i.lt(requests.len()) { return out }
    let req InstantiationRequest: requests.at(i)
    let mangledName String: mangleGenericName(req.genericName, req.concreteTypes)
    if not alreadySeen(seen, mangledName) {
        seen.add(mangledName)
        findInstTypeAt(registry, req.genericName, req.concreteTypes, out, 0)
        findInstFnAt(registry, req.genericName, req.concreteTypes, out, 0)
        findInstSumTypeAt(registry, req.genericName, req.concreteTypes, out, seen, 0)
    }
    return instantiateAllAt(registry, requests, seen, out, i.add(1))
}

// instantiateAll — process all requests, deduplicate by mangled name, and
// return an array of new concrete AstNodes (TypeDeclNode or FnDeclNode variants).
// Requests whose genericName does not appear in the registry are silently skipped.
fn instantiateAll(registry GenericRegistry, requests Array<InstantiationRequest>) Array<AstNode> {
    let seen Array<String>: []
    let out Array<AstNode>: []
    return instantiateAllAt(registry, requests, seen, out, 0)
}
