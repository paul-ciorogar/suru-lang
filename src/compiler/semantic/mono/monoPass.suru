// monoPass.suru — Monomorphization pass orchestrator.
//
// Runs after the first resolveModuleTypes pass.  Calls monoCollect,
// monoInfer, and monoInstantiate in sequence:
//
//   1. collectGenericDefs   — find all FnDeclNode / TypeDeclNode with typeParams
//   2. collectInstantiations — walk stmts to find every usage site
//   3. instantiateAll        — produce concrete copies with substituted types
//
// runMonoPass returns a MonoResult carrying the new concrete nodes and their
// names (for augmenting ownFnNames / ownTypeNames in the pipeline).
//
// filterGenericDefs strips every FnDeclNode / TypeDeclNode with a non-empty
// typeParams list from a statement array — used on both the resolved stmts
// and on ownStmts before analyzeModuleStatements to prevent spurious errors.

namespace Suru.Compiler.Semantic.Mono

export {
    MonoResult
    extractFnNames
    extractTypeNames
    runMonoPass
    isGenericStmt
    filterGenericDefs
    rewriteCallName
    rewriteZeroArgCallName
    rewriteCallInExprWithAnnotation
    rewriteZeroArgFnFromAnnotation
    rewriteCallsInExprs
    rewriteCallsInStmts
    rewriteMatchArm
    rewriteMatchArms
    rewriteMatchStmtArm
    rewriteMatchStmtArms
    rewriteStructField
    rewriteStructFields
    rewriteBlock
    rewriteCallsInExpr
    rewriteCallsInStmt
    rewriteCallSites
    collectConcreteSumTypesAt
    getVariantsForAt
    resolveVariantNameAt
    rewriteArmPat
    rewriteStmtArmsAt
    rewriteVariantArmsInStmt
    rewriteVariantArmsInStmtsAt
    rewriteVariantArms
}

import { collect: Suru.Compiler.Semantic.Mono.Collect }
import { infer: Suru.Compiler.Semantic.Mono.Infer }
import { inst: Suru.Compiler.Semantic.Mono.Instantiate }
import { nodes: Suru.Compiler.Parser.Nodes }

// ─── Result type ─────────────────────────────────────────────────────────────

// MonoResult carries the concrete nodes produced by one mono pass plus the
// names of those nodes so the pipeline can add them to ownFnNames / ownTypeNames.
type MonoResult: { newNodes Array<AstNode>, newFnNames Array<String>, newTypeNames Array<String> }

// ─── Name extraction ─────────────────────────────────────────────────────────

// extractFnNames — collect the name of every FnDeclNode in nodes.
fn extractFnNames(nodes Array<AstNode>, out Array<String>) {
    let i i64: 0
    while i.lt(nodes.len()) {
        let node AstNode: nodes.at(i)
        match node {
            FnDeclNode: {
                let fd FnDeclNode: node
                out.add(fd.name)
            }
            _: {}
        }
        i: i.add(1)
    }
}

// extractTypeNames — collect the name of every TypeDeclNode in nodes.
fn extractTypeNames(nodes Array<AstNode>, out Array<String>) {
    let i i64: 0
    while i.lt(nodes.len()) {
        let node AstNode: nodes.at(i)
        match node {
            TypeDeclNode: {
                let td TypeDeclNode: node
                out.add(td.name)
            }
            _: {}
        }
        i: i.add(1)
    }
}

// ─── Orchestrator ─────────────────────────────────────────────────────────────

// runMonoPass — given the current registry of generic definitions, infer all
// instantiation requests from stmts and produce the concrete copies.
// Returns new concrete nodes and their names for the pipeline to inject.
fn runMonoPass(stmts Array<AstNode>, registry GenericRegistry) MonoResult {
    let requests Array<InstantiationRequest>: infer.collectInstantiations(stmts, registry)
    let newNodes Array<AstNode>: inst.instantiateAll(registry, requests)
    let newFnNames Array<String>: []
    extractFnNames(newNodes, newFnNames)
    let newTypeNames Array<String>: []
    extractTypeNames(newNodes, newTypeNames)
    return { newNodes: newNodes, newFnNames: newFnNames, newTypeNames: newTypeNames }
}

// ─── Filter ───────────────────────────────────────────────────────────────────

// isGenericStmt — true when stmt is a FnDeclNode, TypeDeclNode, or SumTypeDeclNode
// with a non-empty typeParams list (i.e. it is still a generic template, not concrete).
fn isGenericStmt(stmt AstNode) bool {
    match stmt {
        FnDeclNode: {
            let fd FnDeclNode: stmt
            let tp Array<String>: fd.typeParams
            return tp.len().gt(0)
        }
        TypeDeclNode: {
            let td TypeDeclNode: stmt
            let tp Array<String>: td.typeParams
            return tp.len().gt(0)
        }
        SumTypeDeclNode: {
            let sd SumTypeDeclNode: stmt
            let tp Array<String>: sd.typeParams
            return tp.len().gt(0)
        }
        _: { return false }
    }
}

// filterGenericDefs — return a new array containing only the non-generic
// statements from stmts.  Called on both the resolved stmts (to remove
// template definitions before pass 2) and on ownStmts (to stop
// analyzeModuleStatements from emitting false errors on typeParam bodies).
fn filterGenericDefs(stmts Array<AstNode>) Array<AstNode> {
    let out Array<AstNode>: []
    let i i64: 0
    while i.lt(stmts.len()) {
        let stmt AstNode: stmts.at(i)
        if not isGenericStmt(stmt) { out.add(stmt) }
        i: i.add(1)
    }
    return out
}

// ─── Call-site name rewriter ──────────────────────────────────────────────────
// After pass 2 (resolveModuleTypes), all arg expression nodes carry their
// resolvedType.  This walker deep-clones every statement/expression and, for
// each CallNode whose name matches a generic function in the registry, replaces
// the name with the mangled form inferred from the arg resolvedTypes.

// rewriteCallName — return the (possibly mangled) name for a call.
// Reuses monoInfer's binding helpers: collectArgTypes, buildConcreteTypes, allBound.
fn rewriteCallName(cn CallNode, registry GenericRegistry) String {
    let fnIdx i64: registry.findFn(cn.name)
    if fnIdx.equals(registry.fns.len()) { return cn.name }
    let def GenericFnDef: registry.fns.at(fnIdx)
    let argTypes Array<String>: infer.collectArgTypes(cn.args)
    let concretesOut Array<String>: []
    let concretes Array<String>: infer.buildConcreteTypes(def.typeParams(), def.node.params, argTypes, concretesOut)
    if not infer.allBound(concretes) { return cn.name }
    return inst.mangleGenericName(cn.name, concretes)
}

// rewriteZeroArgCallName — for a zero-param generic CallNode, try to determine
// the mangled name from the let-binding type annotation (return-type context).
// Returns cn.name unchanged if no mangling can be determined.
fn rewriteZeroArgCallName(cn CallNode, annotation String, registry GenericRegistry) String {
    let fnIdx i64: registry.findFn(cn.name)
    if fnIdx.equals(registry.fns.len()) { return cn.name }
    let def GenericFnDef: registry.fns.at(fnIdx)
    if not def.node.params.len().equals(0) { return cn.name }
    let typeParams Array<String>: def.typeParams()
    if not typeParams.len().equals(1) { return cn.name }
    let bound String: infer.matchReturnTypeSingle(def.node.returnType, annotation, typeParams.at(0))
    if bound.equals("") { return cn.name }
    let concretes Array<String>: []
    concretes.add(clone(bound))
    drop(bound)
    let mangled String: inst.mangleGenericName(cn.name, concretes)
    drop(concretes)
    return mangled
}

// rewriteCallInExprWithAnnotation — rewrite a call expression using the
// expected-type annotation as context for zero-arg generic calls.
// Falls through to rewriteCallsInExpr for all other expression types.
fn rewriteCallInExprWithAnnotation(expr AstNode, annotation String, registry GenericRegistry) AstNode {
    match expr {
        CallNode: {
            let cn CallNode: expr
            let newName String: rewriteCallName(cn, registry)
            // If arg-based binding failed, try annotation-based binding.
            let shouldTry bool: newName.equals(cn.name) and not annotation.equals("")
            let finalName String: match shouldTry {
                true: rewriteZeroArgCallName(cn, annotation, registry)
                _: newName
            }
            let newArgs Array<AstNode>: rewriteCallsInExprs(cn.args, registry)
            let result CallNode: { name: finalName, args: newArgs, line: cn.line, col: cn.col, resolvedType: cn.resolvedType }
            return result
        }
        _: { return rewriteCallsInExpr(expr, registry) }
    }
    return rewriteCallsInExpr(expr, registry)
}

// rewriteZeroArgFnFromAnnotation — scan registry for a zero-arg generic function
// whose return type can produce `annotation`. Returns the mangled name of the
// first matching function, or "" if none found.
// Used as a fallback when rewriteCallInExprWithAnnotation cannot match the call
// expression's variant (bootstrap binary limitation).
fn rewriteZeroArgFnFromAnnotation(annotation String, resolvedRet String, registry GenericRegistry) String {
    // Only proceed if annotation is a generic application (has a '<').
    let annotBase String: infer.extractBaseTypeName(annotation)
    if annotBase.equals(annotation) { drop(annotBase)  return "" }
    let i i64: 0
    while i.lt(registry.fns.len()) {
        let def GenericFnDef: registry.fns.at(i)
        if def.node.params.len().equals(0) {
            let typeParams Array<String>: def.typeParams()
            if typeParams.len().equals(1) {
                let defBase String: infer.extractBaseTypeName(def.node.returnType)
                let baseMatch bool: defBase.equals(annotBase)
                drop(defBase)
                if baseMatch {
                    // Also verify against the expression's resolved return type
                    // (contains the generic type param, e.g. "List<T>").
                    let resolvedBase String: infer.extractBaseTypeName(resolvedRet)
                    let resolvedMatch bool: resolvedBase.equals(annotBase)
                    drop(resolvedBase)
                    if resolvedMatch {
                        let bound String: infer.matchReturnTypeSingle(def.node.returnType, annotation, typeParams.at(0))
                        if not bound.equals("") {
                            let concretes Array<String>: []
                            concretes.add(clone(bound))
                            drop(bound)
                            drop(annotBase)
                            let mangled String: inst.mangleGenericName(def.name, concretes)
                            drop(concretes)
                            return mangled
                        }
                    }
                }
            }
        }
        i: i.add(1)
    }
    drop(annotBase)
    return ""
}

// rewriteCallsInExprs — return a new expression array with all generic call names mangled.
fn rewriteCallsInExprs(exprs Array<AstNode>, registry GenericRegistry) Array<AstNode> {
    let out Array<AstNode>: []
    let i i64: 0
    while i.lt(exprs.len()) {
        out.add(rewriteCallsInExpr(exprs.at(i), registry))
        i: i.add(1)
    }
    return out
}

// rewriteCallsInStmts — return a new statement array with all generic call names mangled.
fn rewriteCallsInStmts(stmts Array<AstNode>, registry GenericRegistry) Array<AstNode> {
    let out Array<AstNode>: []
    let i i64: 0
    while i.lt(stmts.len()) {
        out.add(rewriteCallsInStmt(stmts.at(i), registry))
        i: i.add(1)
    }
    return out
}

// rewriteMatchArm — rewrite generic calls in a match-expression arm's
// pattern and body expressions.
fn rewriteMatchArm(arm MatchArm, registry GenericRegistry) MatchArm {
    let newPat AstNode: rewriteCallsInExpr(arm.pattern, registry)
    let newBody AstNode: rewriteCallsInExpr(arm.body, registry)
    return { isWildcard: arm.isWildcard, pattern: newPat, body: newBody }
}

// rewriteMatchArms — return a new MatchArm array with all generic call names mangled.
fn rewriteMatchArms(arms Array<MatchArm>, registry GenericRegistry) Array<MatchArm> {
    let out Array<MatchArm>: []
    let i i64: 0
    while i.lt(arms.len()) {
        out.add(rewriteMatchArm(arms.at(i), registry))
        i: i.add(1)
    }
    return out
}

// rewriteMatchStmtArm — rewrite generic calls in a match-statement arm's
// pattern expression and body statement list.
fn rewriteMatchStmtArm(arm MatchStmtArm, registry GenericRegistry) MatchStmtArm {
    let newPat AstNode: rewriteCallsInExpr(arm.pattern, registry)
    let newStmts Array<AstNode>: rewriteCallsInStmts(arm.stmts, registry)
    return { isWildcard: arm.isWildcard, pattern: newPat, stmts: newStmts }
}

// rewriteMatchStmtArms — return a new MatchStmtArm array with all generic call names mangled.
fn rewriteMatchStmtArms(arms Array<MatchStmtArm>, registry GenericRegistry) Array<MatchStmtArm> {
    let out Array<MatchStmtArm>: []
    let i i64: 0
    while i.lt(arms.len()) {
        out.add(rewriteMatchStmtArm(arms.at(i), registry))
        i: i.add(1)
    }
    return out
}

// rewriteStructField — rewrite generic calls in a StructFieldNode's value expression
// and optional inline method body.
fn rewriteStructField(sf StructFieldNode, registry GenericRegistry) StructFieldNode {
    let newVal AstNode: rewriteCallsInExpr(sf.value, registry)
    let newMbody Array<AstNode>: rewriteCallsInStmts(sf.methodBody, registry)
    return { name: sf.name, value: newVal, isMethod: sf.isMethod, isPrivate: sf.isPrivate, privateTypeName: sf.privateTypeName, methodParams: sf.methodParams, methodRet: sf.methodRet, methodBody: newMbody }
}

// rewriteStructFields — return a new StructFieldNode array with all generic call names mangled.
fn rewriteStructFields(fields Array<StructFieldNode>, registry GenericRegistry) Array<StructFieldNode> {
    let out Array<StructFieldNode>: []
    let i i64: 0
    while i.lt(fields.len()) {
        out.add(rewriteStructField(fields.at(i), registry))
        i: i.add(1)
    }
    return out
}

// rewriteBlock — rewrite generic calls in all statements of a BlockNode.
fn rewriteBlock(block BlockNode, registry GenericRegistry) BlockNode {
    let newStmts Array<AstNode>: rewriteCallsInStmts(block.stmts, registry)
    return { stmts: newStmts }
}

// rewriteCallsInExpr — deep-clone an expression node, rewriting any CallNode
// names that match generic functions to their mangled forms.
fn rewriteCallsInExpr(node AstNode, registry GenericRegistry) AstNode {
    match node {
        BoolLitNode:  { return node }
        IntLitNode:   { return node }
        FloatLitNode: { return node }
        StrLitNode:   { return node }
        CharLitNode:  { return node }
        WildcardNode: { return node }
        VarRefNode:   { return node }
        CallNode: {
            let cn CallNode: node
            let newName String: rewriteCallName(cn, registry)
            let newArgs Array<AstNode>: rewriteCallsInExprs(cn.args, registry)
            let result CallNode: { name: newName, args: newArgs, line: cn.line, col: cn.col, resolvedType: cn.resolvedType }
            return result
        }
        MethodCallNode: {
            let mcn MethodCallNode: node
            let newRec AstNode: rewriteCallsInExpr(mcn.receiver, registry)
            let newArgs Array<AstNode>: rewriteCallsInExprs(mcn.args, registry)
            // Rewrite method name for namespace-qualified generic calls
            // (e.g. opt.some(42) → opt.some__Int64(42)).  Only applies when
            // the receiver has no resolvedType, meaning it is a namespace prefix
            // rather than a typed local variable.
            let recvType String: infer.resolvedTypeOf(mcn.receiver)
            let newName String: mcn.methodName
            if recvType.equals("") {
                let synth CallNode: { name: mcn.methodName, args: mcn.args, line: mcn.line, col: mcn.col, resolvedType: mcn.resolvedType }
                newName: rewriteCallName(synth, registry)
            }
            let result MethodCallNode: { receiver: newRec, methodName: newName, args: newArgs, line: mcn.line, col: mcn.col, resolvedType: mcn.resolvedType }
            return result
        }
        FieldAccessNode: {
            let fan FieldAccessNode: node
            let newRec AstNode: rewriteCallsInExpr(fan.receiver, registry)
            let result FieldAccessNode: { receiver: newRec, fieldName: fan.fieldName, line: fan.line, col: fan.col, resolvedType: fan.resolvedType }
            return result
        }
        ArrayLitNode: {
            let aln ArrayLitNode: node
            let newElems Array<AstNode>: rewriteCallsInExprs(aln.elems, registry)
            let result ArrayLitNode: { elems: newElems, resolvedType: aln.resolvedType }
            return result
        }
        StructLitNode: {
            let sln StructLitNode: node
            let newFields Array<StructFieldNode>: rewriteStructFields(sln.fields, registry)
            let result StructLitNode: { fields: newFields, resolvedType: sln.resolvedType, line: 0, col: 0 }
            return result
        }
        MatchExprNode: {
            let men MatchExprNode: node
            let newCond AstNode: rewriteCallsInExpr(men.condition, registry)
            let newArms Array<MatchArm>: rewriteMatchArms(men.arms, registry)
            let result MatchExprNode: { condition: newCond, arms: newArms, line: men.line, col: men.col, resolvedType: men.resolvedType }
            return result
        }
        UnaryNode: {
            let un UnaryNode: node
            let newOperand AstNode: rewriteCallsInExpr(un.operand, registry)
            let result UnaryNode: { op: un.op, operand: newOperand, resolvedType: un.resolvedType }
            return result
        }
        BinaryNode: {
            let bn BinaryNode: node
            let newLeft AstNode: rewriteCallsInExpr(bn.left, registry)
            let newRight AstNode: rewriteCallsInExpr(bn.right, registry)
            let result BinaryNode: { op: bn.op, left: newLeft, right: newRight, resolvedType: bn.resolvedType }
            return result
        }
        VtableRefNode: { return node }
        _: { return node }
    }
    return node
}

// rewriteCallsInStmt — deep-clone a statement node, rewriting generic calls.
fn rewriteCallsInStmt(node AstNode, registry GenericRegistry) AstNode {
    match node {
        FnDeclNode: {
            let fd FnDeclNode: node
            let newBody Array<AstNode>: rewriteCallsInStmts(fd.body, registry)
            let result FnDeclNode: { name: fd.name, params: fd.params, returnType: fd.returnType, body: newBody, srcPath: fd.srcPath, typeParams: fd.typeParams, line: fd.line, col: fd.col }
            return result
        }
        TypeDeclNode: { return node }
        LetNode: {
            let ln LetNode: node
            // Pass the annotation as context so zero-arg generic calls can be
            // mangled even when arg-based binding fails (e.g. newList()).
            let newVal AstNode: rewriteCallInExprWithAnnotation(ln.value, ln.typeName, registry)
            // Fallback: if the value has a generic resolved return type that
            // matches the annotation base (e.g. "List<T>" vs "List<i64>"),
            // scan registry.fns for a zero-arg function producing that type.
            // This handles cases where rewriteCallInExprWithAnnotation's match on
            // the expr's AstNode variant does not fire (bootstrap binary limitation).
            // resolvedTypeOf returns a borrowed field reference — do NOT drop it.
            let resolvedRet String: infer.resolvedTypeOf(newVal)
            if not resolvedRet.equals("") {
                if not resolvedRet.equals(ln.typeName) {
                    let mangledName String: rewriteZeroArgFnFromAnnotation(ln.typeName, resolvedRet, registry)
                    if not mangledName.equals("") {
                        // mangledName ownership transfers to rewrittenCall.name — do NOT drop.
                        let emptyArgs Array<AstNode>: []
                        let rewrittenCall CallNode: { name: mangledName, args: emptyArgs, line: 0, col: 0, resolvedType: ln.typeName }
                        newVal: rewrittenCall
                    }
                }
            }
            let result LetNode: { name: ln.name, typeName: ln.typeName, value: newVal, line: ln.line, col: ln.col, srcPath: ln.srcPath }
            return result
        }
        AssignNode: {
            let an AssignNode: node
            let newVal AstNode: rewriteCallsInExpr(an.value, registry)
            let result AssignNode: { name: an.name, value: newVal, line: an.line, col: an.col }
            return result
        }
        FieldAssignNode: {
            let fan FieldAssignNode: node
            let newRec AstNode: rewriteCallsInExpr(fan.receiver, registry)
            let newVal AstNode: rewriteCallsInExpr(fan.value, registry)
            let result FieldAssignNode: { receiver: newRec, fieldName: fan.fieldName, value: newVal, line: fan.line, col: fan.col }
            return result
        }
        ReturnNode: {
            let rn ReturnNode: node
            let newVal AstNode: rewriteCallsInExpr(rn.value, registry)
            let result ReturnNode: { hasValue: rn.hasValue, value: newVal, line: rn.line, col: rn.col }
            return result
        }
        WhileNode: {
            let wn WhileNode: node
            let newCond AstNode: rewriteCallsInExpr(wn.condition, registry)
            let newBody Array<AstNode>: rewriteCallsInStmts(wn.body, registry)
            let result WhileNode: { condition: newCond, body: newBody, line: wn.line, col: wn.col }
            return result
        }
        ExprStmtNode: {
            let en ExprStmtNode: node
            let newExpr AstNode: rewriteCallsInExpr(en.expr, registry)
            let result ExprStmtNode: { expr: newExpr }
            return result
        }
        IfNode: {
            let ifn IfNode: node
            let newCond AstNode: rewriteCallsInExpr(ifn.condition, registry)
            let newThen BlockNode: rewriteBlock(ifn.thenBranch, registry)
            let newElse BlockNode: rewriteBlock(ifn.elseBranch, registry)
            let result IfNode: { condition: newCond, thenBranch: newThen, elseBranch: newElse, line: ifn.line, col: ifn.col }
            return result
        }
        MatchStmtNode: {
            let mn MatchStmtNode: node
            let newCond AstNode: rewriteCallsInExpr(mn.condition, registry)
            let newArms Array<MatchStmtArm>: rewriteMatchStmtArms(mn.arms, registry)
            let result MatchStmtNode: { condition: newCond, arms: newArms }
            return result
        }
        BlockNode: {
            let bn BlockNode: node
            let result BlockNode: rewriteBlock(bn, registry)
            return result
        }
        _: { return node }
    }
    return node
}

// rewriteCallSites — entry point: walk all statements and rewrite generic
// call-site names to their mangled forms using post-pass-2 resolvedTypes.
// Short-circuits when there are no generic functions in the registry to
// avoid deep recursion over large non-generic codebases.
fn rewriteCallSites(stmts Array<AstNode>, registry GenericRegistry) Array<AstNode> {
    let fns Array<GenericFnDef>: registry.fns
    if fns.len().equals(0) { return stmts }
    return rewriteCallsInStmts(stmts, registry)
}

// ─── Variant arm rewriting ────────────────────────────────────────────────────
// After pass 2 and rewriteCallSites, match arm patterns still use the
// unmangled base names (e.g. "Some", "None") as written by the programmer.
// rewriteVariantArms resolves each arm pattern to the mangled variant name
// stored in the concrete SumTypeDeclNode (e.g. "Some" → "Some__Int64") by
// looking up the matched expression's resolvedType.

// collectConcreteSumTypesAt — append every concrete SumTypeDeclNode in
// stmts[i..] (typeParams empty) to out; skip generic templates.
fn collectConcreteSumTypesAt(stmts Array<AstNode>, out Array<SumTypeDeclNode>, i i64) {
    if not i.lt(stmts.len()) { return }
    match stmts.at(i) {
        SumTypeDeclNode: {
            let sd SumTypeDeclNode: stmts.at(i)
            let tp Array<String>: sd.typeParams
            if tp.len().equals(0) { out.add(sd) }
        }
        _: {}
    }
    collectConcreteSumTypesAt(stmts, out, i.add(1))
}

// getVariantsForAt — return the variants of sumTypes[i..] whose name equals
// `name`, or an empty array if not found.
fn getVariantsForAt(sumTypes Array<SumTypeDeclNode>, name String, i i64) Array<String> {
    let empty Array<String>: []
    if not i.lt(sumTypes.len()) { return empty }
    if sumTypes.at(i).name.equals(name) { return sumTypes.at(i).variants }
    return getVariantsForAt(sumTypes, name, i.add(1))
}

// resolveVariantNameAt — scan variants[i..] for one that equals armName (exact)
// or starts with "armName__" (prefix).  Returns armName unchanged if not found.
fn resolveVariantNameAt(armName String, variants Array<String>, i i64) String {
    if not i.lt(variants.len()) { return armName }
    let v String: variants.at(i)
    // Exact match (e.g. "None" in ["Some__Int64","None"]).
    if v.equals(armName) { return v }
    // Prefix match: variant starts with "armName__".
    let prefix String: armName.append("__")
    let prefixLen i64: prefix.len()
    if prefixLen.lt(v.len().add(1)) {
        if v.slice(0, prefixLen).equals(prefix) { return v }
    }
    return resolveVariantNameAt(armName, variants, i.add(1))
}

// rewriteArmPat — if pat is a VarRefNode, rewrite its name to the mangled
// variant; otherwise return pat unchanged.
fn rewriteArmPat(pat AstNode, variants Array<String>) AstNode {
    match pat {
        VarRefNode: {
            let vr VarRefNode: pat
            let newName String: resolveVariantNameAt(vr.name, variants, 0)
            let r VarRefNode: { name: newName, line: vr.line, col: vr.col, resolvedType: vr.resolvedType }
            return r
        }
        _: { return pat }
    }
    return pat
}

// rewriteStmtArmsAt — deep-clone arms[i..] rewriting non-wildcard patterns.
fn rewriteStmtArmsAt(arms Array<MatchStmtArm>, variants Array<String>, out Array<MatchStmtArm>, i i64, sumTypes Array<SumTypeDeclNode>) Array<MatchStmtArm> {
    if not i.lt(arms.len()) { return out }
    let arm MatchStmtArm: arms.at(i)
    if arm.isWildcard {
        // Wildcard arm: recurse into body stmts only.
        let newStmts Array<AstNode>: []
        let rewritten Array<AstNode>: rewriteVariantArmsInStmtsAt(arm.stmts, sumTypes, newStmts, 0)
        let newArm MatchStmtArm: { isWildcard: arm.isWildcard, pattern: arm.pattern, stmts: rewritten }
        out.add(newArm)
    } else {
        let newPat AstNode: rewriteArmPat(arm.pattern, variants)
        let newStmts Array<AstNode>: []
        let rewritten Array<AstNode>: rewriteVariantArmsInStmtsAt(arm.stmts, sumTypes, newStmts, 0)
        let newArm MatchStmtArm: { isWildcard: arm.isWildcard, pattern: newPat, stmts: rewritten }
        out.add(newArm)
    }
    return rewriteStmtArmsAt(arms, variants, out, i.add(1), sumTypes)
}

// rewriteVariantArmsInStmt — rewrite one statement, recursing into sub-bodies.
fn rewriteVariantArmsInStmt(stmt AstNode, sumTypes Array<SumTypeDeclNode>) AstNode {
    match stmt {
        MatchStmtNode: {
            let mn MatchStmtNode: stmt
            let condType String: infer.resolvedTypeOf(mn.condition)
            let variants Array<String>: getVariantsForAt(sumTypes, condType, 0)
            let outArms Array<MatchStmtArm>: []
            let newArms Array<MatchStmtArm>: rewriteStmtArmsAt(mn.arms, variants, outArms, 0, sumTypes)
            let result MatchStmtNode: { condition: mn.condition, arms: newArms }
            return result
        }
        FnDeclNode: {
            let fd FnDeclNode: stmt
            let newBody Array<AstNode>: []
            let rewritten Array<AstNode>: rewriteVariantArmsInStmtsAt(fd.body, sumTypes, newBody, 0)
            let r FnDeclNode: { name: fd.name, params: fd.params, returnType: fd.returnType, body: rewritten, srcPath: fd.srcPath, typeParams: fd.typeParams, line: fd.line, col: fd.col }
            return r
        }
        WhileNode: {
            let wn WhileNode: stmt
            let newBody Array<AstNode>: []
            let rewritten Array<AstNode>: rewriteVariantArmsInStmtsAt(wn.body, sumTypes, newBody, 0)
            let r WhileNode: { condition: wn.condition, body: rewritten, line: wn.line, col: wn.col }
            return r
        }
        IfNode: {
            let ifn IfNode: stmt
            let thenStmts Array<AstNode>: []
            let newThen Array<AstNode>: rewriteVariantArmsInStmtsAt(ifn.thenBranch.stmts, sumTypes, thenStmts, 0)
            let elseStmts Array<AstNode>: []
            let newElse Array<AstNode>: rewriteVariantArmsInStmtsAt(ifn.elseBranch.stmts, sumTypes, elseStmts, 0)
            let newThenBranch BlockNode: { stmts: newThen }
            let newElseBranch BlockNode: { stmts: newElse }
            let r IfNode: { condition: ifn.condition, thenBranch: newThenBranch, elseBranch: newElseBranch, line: ifn.line, col: ifn.col }
            return r
        }
        _: { return stmt }
    }
    return stmt
}

// rewriteVariantArmsInStmtsAt — walk stmts[i..] applying rewriteVariantArmsInStmt.
fn rewriteVariantArmsInStmtsAt(stmts Array<AstNode>, sumTypes Array<SumTypeDeclNode>, out Array<AstNode>, i i64) Array<AstNode> {
    if not i.lt(stmts.len()) { return out }
    out.add(rewriteVariantArmsInStmt(stmts.at(i), sumTypes))
    return rewriteVariantArmsInStmtsAt(stmts, sumTypes, out, i.add(1))
}

// rewriteVariantArms — entry point called from pipeline.suru after
// rewriteCallSites.  Builds a concrete sum-type map from the merged statement
// list and rewrites every match-arm pattern from its unmangled base name to
// the fully-mangled variant name that the codegen expects.
fn rewriteVariantArms(stmts Array<AstNode>) Array<AstNode> {
    let sumTypes Array<SumTypeDeclNode>: []
    collectConcreteSumTypesAt(stmts, sumTypes, 0)
    if sumTypes.len().equals(0) { return stmts }
    let out Array<AstNode>: []
    return rewriteVariantArmsInStmtsAt(stmts, sumTypes, out, 0)
}
