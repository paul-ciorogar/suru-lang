// monoSubst.suru — Type-parameter substitution for monomorphization.
//
// substituteType replaces type-variable names with concrete types in a
// type-name string.  substStmt and substExpr deep-clone an AstNode while
// substituting all type annotations (typeName, returnType, resolvedType,
// Param.typeName, MethodSig types, etc.).
//
// substStmt and substExpr are mutually recursive (ObjectFieldNode method
// bodies need both) and so live in this single file.
//
// Used by monoInstantiate.suru to produce concrete copies of generic defs.

namespace Suru.Compiler.Semantic.Mono.Subst

import {
    ast: Suru.Compiler.Parser.Ast
    nodes: Suru.Compiler.Parser.Nodes
    [Type]: Suru.Compiler.Types
    [parseType]: Suru.Compiler.Types.Parse
    [printAnnotation]: Suru.Compiler.Types.Print
    [substitute, Binding, binding, varizeType]: Suru.Compiler.Types.Ops
}

// ─── String helpers ───────────────────────────────────────────────────────────

// indexOfLT — index of first '<' in s, or s.len() when absent.
export fn indexOfLT(s String) i64 {
    let i i64: 0
    while i.lt(s.len()) {
        if s.at(i).equals("<") { return i }
        i: i.add(1)
    }
    return s.len()
}

// trimLeft — strip leading ASCII spaces from s.
export fn trimLeft(s String) String {
    let i i64: 0
    while i.lt(s.len()) {
        if not s.slice(i, i.add(1)).equals(" ") { return s.slice(i, s.len()) }
        i: i.add(1)
    }
    return ""
}

// splitByComma — split s by ',' into an Array<String>.
export fn splitByComma(s String) Array<String> {
    let results Array<String>: []
    let start i64: 0
    let i i64: 0
    while i.lt(s.len()) {
        if s.at(i).equals(",") {
            results.add(s.slice(start, i))
            start: i.add(1)
        }
        i: i.add(1)
    }
    results.add(s.slice(start, s.len()))
    return results
}

// buildBindings — pair each type-parameter name with the parsed concrete type it
// maps to, producing the `Array<Binding>` `substitute` consumes. Mirrors the
// parallel-array convention of the legacy substituteType (paramNames[i] ↦
// concreteTypes[i]); the parameter name is CLONED so the binding owns it and the
// whole array can be dropped without aliasing the caller's `paramNames`.
fn buildBindings(paramNames Array<String>, concreteTypes Array<String>) Array<Binding> {
    let out Array<Binding>: []
    let i i64: 0
    while i.lt(paramNames.len()) {
        out.add(binding(paramNames.at(i).clone(), parseType(concreteTypes.at(i))))
        i: i.add(1)
    }
    return out
}

// substituteType — replace type-variable names with concrete types in a
// type-name string.  Handles bare type vars ("T" → "i64"), single-arg generics
// ("List<T>" → "List<i64>"), and multi-arg forms ("Pair<T, U>" → "Pair<i64, String>").
//
// Reimplemented (todo.md §1.8) on top of the structured `Type` ops, replacing the
// old hand-rolled string surgery:
//   1. parseType reads the annotation into a `Type` at the boundary.
//   2. varizeType promotes the type-parameter names (which parse to context-free
//      `Prim` leaves) to `Var`, since `substitute` only rewrites `Var` nodes.
//   3. substitute applies the paramName ↦ concreteType bindings.
//   4. printAnnotation emits the result in source form.
// This NORMALIZES the output to a single canonical form (e.g. a colon-array input
// "Array:i64" reprints as "Array<i64>", and multi-arg generics print with ", ");
// the legacy form-preserving surgery is gone. Every downstream consumer of the
// result (flattenTypeArg / mangleGenericName / makeSuruType) re-normalizes, so the
// mangled instantiation names are unchanged — see the §1.8 plan and bootstrap.
export fn substituteType(typeName String, paramNames Array<String>, concreteTypes Array<String>) String {
    let t Type: parseType(typeName)
    let tv Type: varizeType(t, paramNames)
    drop(t)
    let bindings Array<Binding>: buildBindings(paramNames, concreteTypes)
    let sub Type: substitute(tv, bindings)
    drop(tv)
    drop(bindings)
    let out String: printAnnotation(sub)
    drop(sub)
    return out
}

// ─── Param / MethodSig substitution ──────────────────────────────────────────

// substParam — produce a new Param with its typeName rewritten.
fn substParam(p Param, paramNames Array<String>, concreteTypes Array<String>) Param {
    return { name: p.name, typeName: substituteType(p.typeName, paramNames, concreteTypes) }
}

// substParams — return a new Array<Param> with all typeName fields substituted.
export fn substParams(params Array<Param>, paramNames Array<String>, concreteTypes Array<String>) Array<Param> {
    let out Array<Param>: []
    let i i64: 0
    while i.lt(params.len()) {
        out.add(substParam(params.at(i), paramNames, concreteTypes))
        i: i.add(1)
    }
    return out
}

// substMethodSig — produce a new MethodSig with all type annotations substituted.
fn substMethodSig(ms MethodSig, paramNames Array<String>, concreteTypes Array<String>) MethodSig {
    let newParams Array<Param>: substParams(ms.params, paramNames, concreteTypes)
    let newRet String: substituteType(ms.returnType, paramNames, concreteTypes)
    return { name: ms.name, params: newParams, returnType: newRet }
}

// substMethodSigs — return a new Array<MethodSig> with all type annotations substituted.
export fn substMethodSigs(methods Array<MethodSig>, paramNames Array<String>, concreteTypes Array<String>) Array<MethodSig> {
    let out Array<MethodSig>: []
    let i i64: 0
    while i.lt(methods.len()) {
        out.add(substMethodSig(methods.at(i), paramNames, concreteTypes))
        i: i.add(1)
    }
    return out
}

// ─── Array helpers (forward-reference substStmt / substExpr) ─────────────────
// These wrappers call substStmt / substExpr, which are defined below.  In Suru,
// functions are resolved at module scope, so forward references within a single
// file are legal even though the callee appears later in the source.

// substStmts — return a new statement array with all type annotations substituted.
export fn substStmts(stmts Array<AstNode>, paramNames Array<String>, concreteTypes Array<String>) Array<AstNode> {
    let out Array<AstNode>: []
    let i i64: 0
    while i.lt(stmts.len()) {
        out.add(substStmt(stmts.at(i), paramNames, concreteTypes))
        i: i.add(1)
    }
    return out
}

// substExprs — return a new expression array with all type annotations substituted.
fn substExprs(exprs Array<AstNode>, paramNames Array<String>, concreteTypes Array<String>) Array<AstNode> {
    let out Array<AstNode>: []
    let i i64: 0
    while i.lt(exprs.len()) {
        out.add(substExpr(exprs.at(i), paramNames, concreteTypes))
        i: i.add(1)
    }
    return out
}

// ─── BlockNode helper ─────────────────────────────────────────────────────────

// substBlock — substitute all type annotations in a BlockNode's statement list.
// BlockNode is the container for if/else branch bodies.
fn substBlock(block BlockNode, paramNames Array<String>, concreteTypes Array<String>) BlockNode {
    let newStmts Array<AstNode>: substStmts(block.stmts, paramNames, concreteTypes)
    return { stmts: newStmts }
}

// ─── ObjectFieldNode substitution ────────────────────────────────────────────

// substObjectField — deep-clone a ObjectFieldNode, substituting type annotations
// in its value expression and optional inline method signature/body.
fn substObjectField(sf ObjectFieldNode, paramNames Array<String>, concreteTypes Array<String>) ObjectFieldNode {
    let newVal AstNode: substExpr(sf.value, paramNames, concreteTypes)
    let newMparams Array<Param>: substParams(sf.methodParams, paramNames, concreteTypes)
    let newMret String: substituteType(sf.methodRet, paramNames, concreteTypes)
    let newMbody Array<AstNode>: substStmts(sf.methodBody, paramNames, concreteTypes)
    return { name: sf.name, value: newVal, isMethod: sf.isMethod, isPrivate: sf.isPrivate, privateTypeName: sf.privateTypeName, methodParams: newMparams, methodRet: newMret, methodBody: newMbody }
}

// substObjectFields — return a new ObjectFieldNode array with all type annotations substituted.
fn substObjectFields(fields Array<ObjectFieldNode>, paramNames Array<String>, concreteTypes Array<String>) Array<ObjectFieldNode> {
    let out Array<ObjectFieldNode>: []
    let i i64: 0
    while i.lt(fields.len()) {
        out.add(substObjectField(fields.at(i), paramNames, concreteTypes))
        i: i.add(1)
    }
    return out
}

// ─── MatchArm / MatchStmtArm substitution ────────────────────────────────────

// substMatchArm — substitute type annotations in a match-expression arm
// (pattern + body are both expressions).
fn substMatchArm(arm MatchArm, paramNames Array<String>, concreteTypes Array<String>) MatchArm {
    let newPat AstNode: substExpr(arm.pattern, paramNames, concreteTypes)
    let newBody AstNode: substExpr(arm.body, paramNames, concreteTypes)
    return { isWildcard: arm.isWildcard, pattern: newPat, body: newBody }
}

// substMatchArms — return a new MatchArm array with all type annotations substituted.
fn substMatchArms(arms Array<MatchArm>, paramNames Array<String>, concreteTypes Array<String>) Array<MatchArm> {
    let out Array<MatchArm>: []
    let i i64: 0
    while i.lt(arms.len()) {
        out.add(substMatchArm(arms.at(i), paramNames, concreteTypes))
        i: i.add(1)
    }
    return out
}

// substMatchStmtArm — substitute type annotations in a match-statement arm
// (pattern is an expression; stmts is a statement list).
fn substMatchStmtArm(arm MatchStmtArm, paramNames Array<String>, concreteTypes Array<String>) MatchStmtArm {
    let newPat AstNode: substExpr(arm.pattern, paramNames, concreteTypes)
    let newStmts Array<AstNode>: substStmts(arm.stmts, paramNames, concreteTypes)
    return { isWildcard: arm.isWildcard, pattern: newPat, stmts: newStmts }
}

// substMatchStmtArms — return a new MatchStmtArm array with all type annotations substituted.
fn substMatchStmtArms(arms Array<MatchStmtArm>, paramNames Array<String>, concreteTypes Array<String>) Array<MatchStmtArm> {
    let out Array<MatchStmtArm>: []
    let i i64: 0
    while i.lt(arms.len()) {
        out.add(substMatchStmtArm(arms.at(i), paramNames, concreteTypes))
        i: i.add(1)
    }
    return out
}

// ─── Statement substitution ──────────────────────────────────────────────────

// substStmt — deep-clone a statement AstNode with all type annotations
// substituted.  Non-statement variants (expressions used as patterns) fall
// through to _: { return node }.
fn substStmt(node AstNode, paramNames Array<String>, concreteTypes Array<String>) AstNode {
    match node {
        FnDeclNode: {
            let fd FnDeclNode: node
            let newParams Array<Param>: substParams(fd.params, paramNames, concreteTypes)
            let newRet String: substituteType(fd.returnType, paramNames, concreteTypes)
            let newBody Array<AstNode>: substStmts(fd.body, paramNames, concreteTypes)
            let result FnDeclNode: { name: fd.name, params: newParams, returnType: newRet, body: newBody, srcPath: fd.srcPath, typeParams: fd.typeParams, line: fd.line, col: fd.col }
            return result
        }
        TypeDeclNode: {
            let td TypeDeclNode: node
            let newFields Array<Param>: substParams(td.fields, paramNames, concreteTypes)
            let newMethods Array<MethodSig>: substMethodSigs(td.methods, paramNames, concreteTypes)
            let result TypeDeclNode: { name: td.name, fields: newFields, methods: newMethods, typeParams: td.typeParams, isCType: td.isCType, line: td.line, col: td.col }
            return result
        }
        LetNode: {
            let ln LetNode: node
            let newType String: substituteType(ln.typeName, paramNames, concreteTypes)
            let newVal AstNode: substExpr(ln.value, paramNames, concreteTypes)
            let result LetNode: { name: ln.name, typeName: newType, value: newVal, line: ln.line, col: ln.col, srcPath: ln.srcPath }
            return result
        }
        AssignNode: {
            let an AssignNode: node
            let newVal AstNode: substExpr(an.value, paramNames, concreteTypes)
            let result AssignNode: { name: an.name, value: newVal, line: an.line, col: an.col }
            return result
        }
        FieldAssignNode: {
            let fan FieldAssignNode: node
            let newRec AstNode: substExpr(fan.receiver, paramNames, concreteTypes)
            let newVal AstNode: substExpr(fan.value, paramNames, concreteTypes)
            let result FieldAssignNode: { receiver: newRec, fieldName: fan.fieldName, value: newVal, line: fan.line, col: fan.col }
            return result
        }
        ReturnNode: {
            let rn ReturnNode: node
            let newVal AstNode: substExpr(rn.value, paramNames, concreteTypes)
            let result ReturnNode: { hasValue: rn.hasValue, value: newVal, line: rn.line, col: rn.col }
            return result
        }
        WhileNode: {
            let wn WhileNode: node
            let newCond AstNode: substExpr(wn.condition, paramNames, concreteTypes)
            let newBody Array<AstNode>: substStmts(wn.body, paramNames, concreteTypes)
            let result WhileNode: { condition: newCond, body: newBody, line: wn.line, col: wn.col }
            return result
        }
        ExprStmtNode: {
            let en ExprStmtNode: node
            let newExpr AstNode: substExpr(en.expr, paramNames, concreteTypes)
            let result ExprStmtNode: { expr: newExpr }
            return result
        }
        IfNode: {
            let ifn IfNode: node
            let newCond AstNode: substExpr(ifn.condition, paramNames, concreteTypes)
            let newThen BlockNode: substBlock(ifn.thenBranch, paramNames, concreteTypes)
            let newElse BlockNode: substBlock(ifn.elseBranch, paramNames, concreteTypes)
            let result IfNode: { condition: newCond, thenBranch: newThen, elseBranch: newElse, line: ifn.line, col: ifn.col }
            return result
        }
        MatchStmtNode: {
            let mn MatchStmtNode: node
            let newCond AstNode: substExpr(mn.condition, paramNames, concreteTypes)
            let newArms Array<MatchStmtArm>: substMatchStmtArms(mn.arms, paramNames, concreteTypes)
            let result MatchStmtNode: { condition: newCond, arms: newArms }
            return result
        }
        BlockNode: {
            let bn BlockNode: node
            let result BlockNode: substBlock(bn, paramNames, concreteTypes)
            return result
        }
        _: { return node }
    }
    return node
}

// ─── Expression substitution ─────────────────────────────────────────────────

// substExpr — deep-clone an expression AstNode with all type annotations
// substituted.  Non-expression variants fall through to _: { return node }.
fn substExpr(node AstNode, paramNames Array<String>, concreteTypes Array<String>) AstNode {
    match node {
        BoolLitNode: {
            let bl BoolLitNode: node
            let result BoolLitNode: { boolVal: bl.boolVal, resolvedType: substituteType(bl.resolvedType, paramNames, concreteTypes) }
            return result
        }
        IntLitNode: {
            let il IntLitNode: node
            let result IntLitNode: { text: il.text, resolvedType: substituteType(il.resolvedType, paramNames, concreteTypes) }
            return result
        }
        FloatLitNode: {
            let fl FloatLitNode: node
            let result FloatLitNode: { text: fl.text, resolvedType: substituteType(fl.resolvedType, paramNames, concreteTypes) }
            return result
        }
        StrLitNode: {
            let sl StrLitNode: node
            let result StrLitNode: { text: sl.text, resolvedType: substituteType(sl.resolvedType, paramNames, concreteTypes) }
            return result
        }
        CharLitNode: {
            let cl CharLitNode: node
            let result CharLitNode: { text: cl.text, resolvedType: substituteType(cl.resolvedType, paramNames, concreteTypes) }
            return result
        }
        WildcardNode: {
            return node
        }
        VarRefNode: {
            let vr VarRefNode: node
            let result VarRefNode: { name: vr.name, line: vr.line, col: vr.col, resolvedType: substituteType(vr.resolvedType, paramNames, concreteTypes) }
            return result
        }
        CallNode: {
            let cn CallNode: node
            let newArgs Array<AstNode>: substExprs(cn.args, paramNames, concreteTypes)
            let result CallNode: { name: cn.name, args: newArgs, line: cn.line, col: cn.col, resolvedType: substituteType(cn.resolvedType, paramNames, concreteTypes) }
            return result
        }
        MethodCallNode: {
            let mcn MethodCallNode: node
            let newRec AstNode: substExpr(mcn.receiver, paramNames, concreteTypes)
            let newArgs Array<AstNode>: substExprs(mcn.args, paramNames, concreteTypes)
            let result MethodCallNode: { receiver: newRec, methodName: mcn.methodName, args: newArgs, line: mcn.line, col: mcn.col, resolvedType: substituteType(mcn.resolvedType, paramNames, concreteTypes) }
            return result
        }
        FieldAccessNode: {
            let fan FieldAccessNode: node
            let newRec AstNode: substExpr(fan.receiver, paramNames, concreteTypes)
            let result FieldAccessNode: { receiver: newRec, fieldName: fan.fieldName, line: fan.line, col: fan.col, resolvedType: substituteType(fan.resolvedType, paramNames, concreteTypes) }
            return result
        }
        ArrayLitNode: {
            let aln ArrayLitNode: node
            let newElems Array<AstNode>: substExprs(aln.elems, paramNames, concreteTypes)
            let result ArrayLitNode: { elems: newElems, resolvedType: substituteType(aln.resolvedType, paramNames, concreteTypes) }
            return result
        }
        ObjectLitNode: {
            let sln ObjectLitNode: node
            let newFields Array<ObjectFieldNode>: substObjectFields(sln.fields, paramNames, concreteTypes)
            let result ObjectLitNode: { fields: newFields, resolvedType: substituteType(sln.resolvedType, paramNames, concreteTypes), line: 0, col: 0 }
            return result
        }
        MatchExprNode: {
            let men MatchExprNode: node
            let newCond AstNode: substExpr(men.condition, paramNames, concreteTypes)
            let newArms Array<MatchArm>: substMatchArms(men.arms, paramNames, concreteTypes)
            let result MatchExprNode: { condition: newCond, arms: newArms, line: men.line, col: men.col, resolvedType: substituteType(men.resolvedType, paramNames, concreteTypes) }
            return result
        }
        UnaryNode: {
            let un UnaryNode: node
            let newOperand AstNode: substExpr(un.operand, paramNames, concreteTypes)
            let result UnaryNode: { op: un.op, operand: newOperand, resolvedType: substituteType(un.resolvedType, paramNames, concreteTypes) }
            return result
        }
        BinaryNode: {
            let bn BinaryNode: node
            let newLeft AstNode: substExpr(bn.left, paramNames, concreteTypes)
            let newRight AstNode: substExpr(bn.right, paramNames, concreteTypes)
            let result BinaryNode: { op: bn.op, left: newLeft, right: newRight, resolvedType: substituteType(bn.resolvedType, paramNames, concreteTypes) }
            return result
        }
        VtableRefNode: {
            let vr VtableRefNode: node
            let result VtableRefNode: { sym: vr.sym, entries: vr.entries, resolvedType: substituteType(vr.resolvedType, paramNames, concreteTypes) }
            return result
        }
        SizeNode: {
            let sn SizeNode: node
            let result SizeNode: { typeName: substituteType(sn.typeName, paramNames, concreteTypes), line: sn.line, col: sn.col, resolvedType: substituteType(sn.resolvedType, paramNames, concreteTypes) }
            return result
        }
        _: { return node }
    }
    return node
}
