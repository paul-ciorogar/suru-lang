// monoInfer.suru — Collect InstantiationRequests from a resolved statement list.
//
// Runs after the first resolveModuleTypes pass so every expression node has its
// resolvedType field populated.  Walks all statements and expressions to find:
//   - explicit generic type annotations in LetNode.typeName, FnDeclNode.returnType,
//     Param.typeName  (handled by inferFromAnnotation)
//   - generic function call sites where arg resolvedTypes bind type vars
//     (handled by inferFromCallSite)
//
// The entry point is collectInstantiations; it returns a deduplicated
// Array<InstantiationRequest>.  Used by monoPass.suru.

namespace Suru.Compiler.Semantic.Mono.Infer

export {
    extractBaseTypeName
    collectTrimmedArgs
    extractTypeArgs
    inferFromAnnotation
    resolvedTypeOf
    suruCanonToAnnotation
    collectArgTypes
    findBindingForVar
    buildConcreteTypes
    allBound
    inferFromGenericFnCall
    inferFromCallSite
    appendAll
    inferFromStmts
    inferFromExprs
    inferFromParams
    inferFromObjectFieldAt
    inferFromObjectFields
    inferFromMatchArms
    inferFromMatchStmtArms
    inferFromExpr
    inferFromStmt
    keyAlreadySeen
    deduplicateRequests
    collectInstantiations
    matchReturnTypeSingle
    inferZeroArgFnFromAnnotation
    inferZeroArgFnsFromAnnotation
}

import { inst: Suru.Compiler.Semantic.Mono.Instantiate }
import { subst: Suru.Compiler.Semantic.Mono.Subst }
import { collect: Suru.Compiler.Semantic.Mono.Collect }

// ─── Type-name string helpers ─────────────────────────────────────────────────

// extractBaseTypeName — return the portion of typeName before the first '<'.
// "Pair<i64, String>" → "Pair";  "i64" → "i64".
fn extractBaseTypeName(typeName String) String {
    return typeName.slice(0, subst.indexOfLT(typeName))
}

// collectTrimmedArgs — trim leading spaces from each element of args and return a new array.
fn collectTrimmedArgs(args Array<String>) Array<String> {
    let out Array<String>: []
    let i i64: 0
    while i.lt(args.len()) {
        out.add(subst.trimLeft(args.at(i)))
        i: i.add(1)
    }
    return out
}

// extractTypeArgs — parse the concrete type argument list from a generic
// type-name annotation string.
//   "Pair<i64, String>" → ["i64", "String"]
//   "Array<i64>"        → ["i64"]
//   "i64"               → []
fn extractTypeArgs(typeName String) Array<String> {
    let ltIdx i64: subst.indexOfLT(typeName)
    let empty Array<String>: []
    if ltIdx.equals(typeName.len()) { return empty }
    drop(empty)
    // inner = content between '<' and the closing '>'
    let inner String: typeName.slice(ltIdx.add(1), typeName.len().take(1))
    let raw Array<String>: subst.splitByComma(inner)
    drop(inner)
    let result Array<String>: collectTrimmedArgs(raw)
    // trimLeft produces new independent strings, so raw elements don't alias result elements.
    drop(raw)
    return result
}

// ─── inferFromAnnotation ──────────────────────────────────────────────────────

// inferFromAnnotation — if typeName is a generic application whose base name
// appears in the registry as a struct type or sum type, return one
// InstantiationRequest.  Otherwise return an empty array.
fn inferFromAnnotation(typeName String, registry GenericRegistry) Array<InstantiationRequest> {
    let empty Array<InstantiationRequest>: []
    // Quick exit: no '<' means not a generic annotation.
    let ltIdx i64: subst.indexOfLT(typeName)
    if ltIdx.equals(typeName.len()) { return empty }
    let base String: extractBaseTypeName(typeName)
    // Return empty unless the base name is a generic struct type or sum type.
    if not registry.hasType(base) {
        if not registry.hasSumType(base) { return empty }
    }
    drop(empty)
    let concretes Array<String>: extractTypeArgs(typeName)
    let req InstantiationRequest: { genericName: base, concreteTypes: concretes }
    let result Array<InstantiationRequest>: []
    result.add(req)
    return result
}

// ─── resolvedTypeOf ───────────────────────────────────────────────────────────

// resolvedTypeOf — extract the resolvedType String from any expression AstNode.
// Returns "" for non-expression variants (statements, WildcardNode).
fn resolvedTypeOf(node AstNode) String {
    return match node {
        BoolLitNode:      node.resolvedType
        IntLitNode:       node.resolvedType
        FloatLitNode:     node.resolvedType
        StrLitNode:       node.resolvedType
        CharLitNode:      node.resolvedType
        VarRefNode:       node.resolvedType
        CallNode:         node.resolvedType
        MethodCallNode:   node.resolvedType
        FieldAccessNode:  node.resolvedType
        ArrayLitNode:     node.resolvedType
        ObjectLitNode:    node.resolvedType
        MatchExprNode:    node.resolvedType
        UnaryNode:        node.resolvedType
        BinaryNode:       node.resolvedType
        VtableRefNode:    node.resolvedType
        _: ""
    }
}

// ─── inferFromCallSite ────────────────────────────────────────────────────────

// suruCanonToAnnotation — convert the suru canonical form "Array:X" to the
// annotation form "Array<X>" so that monoInfer produces requests that match
// what inferFromAnnotation generates from explicit type annotations.
// Non-array types pass through unchanged (they're already in annotation form
// or are plain mangled names like "Option__Int64").
fn suruCanonToAnnotation(t String) String {
    let len i64: t.len()
    if len.gt(5) {
        if t.slice(0, 6).equals("Array:") {
            return "Array<".append(t.slice(6, len)).append(">")
        }
    }
    return clone(t)
}

// collectArgTypes — return the type of each arg, normalised to annotation form.
// resolvedTypeOf returns the suru canonical form (e.g. "Array:i64"); we
// convert that to annotation form ("Array<i64>") so the resulting
// InstantiationRequest matches requests inferred from explicit annotations.
fn collectArgTypes(args Array<AstNode>) Array<String> {
    let out Array<String>: []
    let i i64: 0
    while i.lt(args.len()) {
        let raw String: clone(resolvedTypeOf(args.at(i)))
        let normalized String: suruCanonToAnnotation(raw)
        drop(raw)
        out.add(normalized)
        i: i.add(1)
    }
    return out
}

// findBindingForVar — search params for the first param whose typeName equals
// typeVar (bare type-variable match).  Return the corresponding argTypes element,
// or "" if not found.
fn findBindingForVar(typeVar String, params Array<Param>, argTypes Array<String>) String {
    let i i64: 0
    while i.lt(params.len()) {
        if params.at(i).typeName.equals(typeVar) { return argTypes.at(i) }
        i: i.add(1)
    }
    return ""
}

// buildConcreteTypes — for each typeParam, find its binding and append to out.
fn buildConcreteTypes(typeParams Array<String>, params Array<Param>, argTypes Array<String>, out Array<String>) Array<String> {
    let j i64: 0
    while j.lt(typeParams.len()) {
        let binding String: findBindingForVar(typeParams.at(j), params, argTypes)
        out.add(clone(binding))
        j: j.add(1)
    }
    return out
}

// allBound — true if every element of concretes is non-empty.
fn allBound(concretes Array<String>) bool {
    let i i64: 0
    while i.lt(concretes.len()) {
        if concretes.at(i).equals("") { return false }
        i: i.add(1)
    }
    return true
}

// inferFromGenericFnCall — shared logic for inferring an instantiation request
// from a generic function call.  Given the function name and arg list, looks up
// the function in the registry, unifies arg resolvedTypes against declared param
// types, and returns a single-element request array when all type vars bind.
// Returns [] when the function is not registered as generic or any binding is
// unresolved.
fn inferFromGenericFnCall(fnName String, args Array<AstNode>, registry GenericRegistry) Array<InstantiationRequest> {
    let empty Array<InstantiationRequest>: []
    let fnIdx i64: registry.findFn(fnName)
    if fnIdx.equals(registry.fns.len()) { return empty }
    let def GenericFnDef: registry.fns.at(fnIdx)
    let argTypes Array<String>: collectArgTypes(args)
    let concretesOut Array<String>: []
    let concretes Array<String>: buildConcreteTypes(def.typeParams(), def.node.params, argTypes, concretesOut)
    if not allBound(concretes) {
        drop(argTypes)
        drop(concretes)
        return empty
    }
    drop(empty)
    drop(argTypes)
    // concretes transfers into req.concreteTypes; do not drop it separately.
    let req InstantiationRequest: { genericName: clone(def.name), concreteTypes: concretes }
    let result Array<InstantiationRequest>: []
    result.add(req)
    return result
}

// inferFromCallSite — if callNode.name matches a registered generic function,
// unify its declared param types against the arg resolvedTypes to bind each
// type variable.  Only bare type-variable params (e.g. typeName = "T") are
// handled; nested forms like "Array<T>" are skipped.  Returns [] if the
// function is not generic or any binding is unresolved.
fn inferFromCallSite(callNode CallNode, registry GenericRegistry) Array<InstantiationRequest> {
    return inferFromGenericFnCall(callNode.name, callNode.args, registry)
}

// ─── Accumulator helpers ──────────────────────────────────────────────────────

// appendAll — append cloned copies of src to dst.
// Clones each element so src can be dropped by the caller without aliasing dst.
fn appendAll(src Array<InstantiationRequest>, dst Array<InstantiationRequest>) Array<InstantiationRequest> {
    let i i64: 0
    while i.lt(src.len()) {
        let req InstantiationRequest: src.at(i)
        let clonedReq InstantiationRequest: { genericName: clone(req.genericName), concreteTypes: clone(req.concreteTypes) }
        dst.add(clonedReq)
        i: i.add(1)
    }
    return dst
}

// inferFromStmts — walk stmts, collecting instantiation requests into out.
fn inferFromStmts(stmts Array<AstNode>, registry GenericRegistry, out Array<InstantiationRequest>) Array<InstantiationRequest> {
    let i i64: 0
    while i.lt(stmts.len()) {
        out: inferFromStmt(stmts.at(i), registry, out)
        i: i.add(1)
    }
    return out
}

// inferFromExprs — walk exprs, collecting instantiation requests into out.
fn inferFromExprs(exprs Array<AstNode>, registry GenericRegistry, out Array<InstantiationRequest>) Array<InstantiationRequest> {
    let i i64: 0
    while i.lt(exprs.len()) {
        out: inferFromExpr(exprs.at(i), registry, out)
        i: i.add(1)
    }
    return out
}

// inferFromParams — run inferFromAnnotation on each Param.typeName.
fn inferFromParams(params Array<Param>, registry GenericRegistry, out Array<InstantiationRequest>) Array<InstantiationRequest> {
    let i i64: 0
    while i.lt(params.len()) {
        let fromAnnot Array<InstantiationRequest>: inferFromAnnotation(params.at(i).typeName, registry)
        out: appendAll(fromAnnot, out)
        drop(fromAnnot)
        i: i.add(1)
    }
    return out
}

// inferFromObjectFieldAt — recurse into a ObjectFieldNode's value and any
// method body.
fn inferFromObjectFieldAt(field ObjectFieldNode, registry GenericRegistry, out Array<InstantiationRequest>) Array<InstantiationRequest> {
    out: inferFromExpr(field.value, registry, out)
    out: inferFromStmts(field.methodBody, registry, out)
    return out
}

// inferFromObjectFields — recurse into each ObjectFieldNode in fields,
// including method bodies (which are statement lists, not just expressions).
fn inferFromObjectFields(fields Array<ObjectFieldNode>, registry GenericRegistry, out Array<InstantiationRequest>) Array<InstantiationRequest> {
    let i i64: 0
    while i.lt(fields.len()) {
        out: inferFromObjectFieldAt(fields.at(i), registry, out)
        i: i.add(1)
    }
    return out
}

// inferFromMatchArms — recurse into expression MatchArm bodies.
fn inferFromMatchArms(arms Array<MatchArm>, registry GenericRegistry, out Array<InstantiationRequest>) Array<InstantiationRequest> {
    let i i64: 0
    while i.lt(arms.len()) {
        let arm MatchArm: arms.at(i)
        out: inferFromExpr(arm.body, registry, out)
        i: i.add(1)
    }
    return out
}

// inferFromMatchStmtArms — recurse into statement MatchStmtArm bodies.
fn inferFromMatchStmtArms(arms Array<MatchStmtArm>, registry GenericRegistry, out Array<InstantiationRequest>) Array<InstantiationRequest> {
    let i i64: 0
    while i.lt(arms.len()) {
        let arm MatchStmtArm: arms.at(i)
        out: inferFromStmts(arm.stmts, registry, out)
        i: i.add(1)
    }
    return out
}

// ─── Zero-arg generic function inference ─────────────────────────────────────
//
// Some generic functions take no parameters (e.g. fn newList<T>() List<T>).
// Their type variable T cannot be bound from call arguments, but it can be bound
// from the expected return type when the call appears as a let-binding value:
//
//   let arr List<i64>: newList()
//
// matchReturnTypeSingle matches the fn's declared return type against the
// annotation to extract the single type-variable binding.  Only handles the
// single-type-param case (one level of generic application).

// matchReturnTypeSingle — for a single type parameter, match returnType against
// expected and return the bound concrete type, or "" when no match.
// Handles:
//   returnType = "T"             → expected                    (bare var)
//   returnType = "Base<T>"       → inner of expected           (one-level generic)
fn matchReturnTypeSingle(returnType String, expected String, typeParam String) String {
    if returnType.equals(typeParam) { return clone(expected) }
    let rtLt i64: subst.indexOfLT(returnType)
    if rtLt.equals(returnType.len()) { return "" }
    let exLt i64: subst.indexOfLT(expected)
    if exLt.equals(expected.len()) { return "" }
    let rtBase String: returnType.slice(0, rtLt)
    let exBase String: expected.slice(0, exLt)
    let basesMatch bool: rtBase.equals(exBase)
    drop(rtBase)
    drop(exBase)
    if not basesMatch { return "" }
    let rtInner String: returnType.slice(rtLt.add(1), returnType.len().take(1))
    let innerIsParam bool: rtInner.equals(typeParam)
    drop(rtInner)
    if not innerIsParam { return "" }
    return expected.slice(exLt.add(1), expected.len().take(1))
}

// inferZeroArgFnFromAnnotation — if fnName is a registered zero-param generic
// function whose return type matches expectedType under a single type binding,
// return one InstantiationRequest for that concrete instantiation.
// Used for let-binding patterns: let arr List<i64>: newList()
fn inferZeroArgFnFromAnnotation(fnName String, expectedType String, registry GenericRegistry) Array<InstantiationRequest> {
    let empty Array<InstantiationRequest>: []
    let fnIdx i64: registry.findFn(fnName)
    if fnIdx.equals(registry.fns.len()) { return empty }
    let def GenericFnDef: registry.fns.at(fnIdx)
    if not def.node.params.len().equals(0) { return empty }
    let typeParams Array<String>: def.typeParams()
    if not typeParams.len().equals(1) { return empty }
    let bound String: matchReturnTypeSingle(def.node.returnType, expectedType, typeParams.at(0))
    if bound.equals("") { return empty }
    drop(empty)
    let concretes Array<String>: []
    concretes.add(clone(bound))
    drop(bound)
    let req InstantiationRequest: { genericName: clone(def.name), concreteTypes: concretes }
    let result Array<InstantiationRequest>: []
    result.add(req)
    return result
}

// inferZeroArgFnsFromAnnotation — scan ALL zero-param generic functions in
// registry and return InstantiationRequests for any that can produce expectedType.
// This avoids pattern-matching on the call expression's AstNode variant tag,
// which can be unreliable across bootstrap binary versions.
// Safe to call for any LetNode annotation — spurious matches are prevented by
// deduplication and the `allBound` guard inside instantiateAll.
fn inferZeroArgFnsFromAnnotation(expectedType String, registry GenericRegistry, out Array<InstantiationRequest>) Array<InstantiationRequest> {
    let ltIdx i64: subst.indexOfLT(expectedType)
    if ltIdx.equals(expectedType.len()) { return out }
    let i i64: 0
    while i.lt(registry.fns.len()) {
        let def GenericFnDef: registry.fns.at(i)
        if def.node.params.len().equals(0) {
            let typeParams Array<String>: def.typeParams()
            if typeParams.len().equals(1) {
                let bound String: matchReturnTypeSingle(def.node.returnType, expectedType, typeParams.at(0))
                if not bound.equals("") {
                    let concretes Array<String>: []
                    concretes.add(clone(bound))
                    drop(bound)
                    let req InstantiationRequest: { genericName: clone(def.name), concreteTypes: concretes }
                    out.add(req)
                }
            }
        }
        i: i.add(1)
    }
    return out
}

// ─── Expression walker ────────────────────────────────────────────────────────

// inferFromExpr — walk an expression node and collect all generic
// instantiation sites into out.
fn inferFromExpr(expr AstNode, registry GenericRegistry, out Array<InstantiationRequest>) Array<InstantiationRequest> {
    match expr {
        CallNode: {
            let cn CallNode: expr
            let fromCall Array<InstantiationRequest>: inferFromCallSite(cn, registry)
            out: appendAll(fromCall, out)
            drop(fromCall)
            out: inferFromExprs(cn.args, registry, out)
            return out
        }
        MethodCallNode: {
            let mcn MethodCallNode: expr
            // Namespace-qualified generic call (e.g. opt.some(42)): the receiver
            // is a VarRefNode with resolvedType "" because namespace prefixes are
            // not local variables.  In that case, treat the call as a direct
            // generic fn call on mcn.methodName.
            let recvType String: resolvedTypeOf(mcn.receiver)
            if recvType.equals("") {
                let fromFnCall Array<InstantiationRequest>: inferFromGenericFnCall(mcn.methodName, mcn.args, registry)
                out: appendAll(fromFnCall, out)
                drop(fromFnCall)
            }
            out: inferFromExpr(mcn.receiver, registry, out)
            out: inferFromExprs(mcn.args, registry, out)
            return out
        }
        FieldAccessNode: {
            let fan FieldAccessNode: expr
            out: inferFromExpr(fan.receiver, registry, out)
            return out
        }
        ArrayLitNode: {
            let aln ArrayLitNode: expr
            out: inferFromExprs(aln.elems, registry, out)
            return out
        }
        ObjectLitNode: {
            let sln ObjectLitNode: expr
            // resolvedType may be a generic application (e.g. set by top-down
            // propagation from a LetNode annotation).
            let fromSln Array<InstantiationRequest>: inferFromAnnotation(sln.resolvedType, registry)
            out: appendAll(fromSln, out)
            drop(fromSln)
            out: inferFromObjectFields(sln.fields, registry, out)
            return out
        }
        MatchExprNode: {
            let men MatchExprNode: expr
            out: inferFromExpr(men.condition, registry, out)
            out: inferFromMatchArms(men.arms, registry, out)
            return out
        }
        UnaryNode: {
            let un UnaryNode: expr
            out: inferFromExpr(un.operand, registry, out)
            return out
        }
        BinaryNode: {
            let bn BinaryNode: expr
            out: inferFromExpr(bn.left, registry, out)
            out: inferFromExpr(bn.right, registry, out)
            return out
        }
        _: { return out }
    }
    return out
}

// ─── Statement walker ─────────────────────────────────────────────────────────

// inferFromStmt — walk a statement node and collect all generic instantiation
// sites into out.
fn inferFromStmt(stmt AstNode, registry GenericRegistry, out Array<InstantiationRequest>) Array<InstantiationRequest> {
    match stmt {
        LetNode: {
            let ln LetNode: stmt
            let fromLet Array<InstantiationRequest>: inferFromAnnotation(ln.typeName, registry)
            out: appendAll(fromLet, out)
            drop(fromLet)
            // Zero-arg generic function inference from the let annotation.
            // Scans all zero-param generic fns in the registry to find any that
            // can produce ln.typeName — avoids matching on ln.value's AstNode
            // variant tag (which is unreliable across bootstrap binary versions).
            // E.g. let arr List<i64>: newList() → {newList, ["i64"]}
            out: inferZeroArgFnsFromAnnotation(ln.typeName, registry, out)
            out: inferFromExpr(ln.value, registry, out)
            return out
        }
        FnDeclNode: {
            let fd FnDeclNode: stmt
            // Skip generic function templates: walking their annotations/bodies
            // produces garbage requests like {genericName:"Some", concreteTypes:["T"]}
            // that instantiate dead "Some__T" / "Option__T" types.  Concrete
            // requests are generated from the call sites and annotations in
            // user code instead.
            let isGeneric bool: fd.typeParams.len().gt(0)
            if not isGeneric {
                let fromFd Array<InstantiationRequest>: inferFromAnnotation(fd.returnType, registry)
                out: appendAll(fromFd, out)
                drop(fromFd)
                out: inferFromParams(fd.params, registry, out)
                out: inferFromStmts(fd.body, registry, out)
            }
            return out
        }
        ReturnNode: {
            let rn ReturnNode: stmt
            if rn.hasValue { out: inferFromExpr(rn.value, registry, out) }
            return out
        }
        AssignNode: {
            let an AssignNode: stmt
            out: inferFromExpr(an.value, registry, out)
            return out
        }
        FieldAssignNode: {
            let fan FieldAssignNode: stmt
            out: inferFromExpr(fan.receiver, registry, out)
            out: inferFromExpr(fan.value, registry, out)
            return out
        }
        ExprStmtNode: {
            let en ExprStmtNode: stmt
            out: inferFromExpr(en.expr, registry, out)
            return out
        }
        WhileNode: {
            let wn WhileNode: stmt
            out: inferFromExpr(wn.condition, registry, out)
            out: inferFromStmts(wn.body, registry, out)
            return out
        }
        IfNode: {
            let ifn IfNode: stmt
            out: inferFromExpr(ifn.condition, registry, out)
            out: inferFromStmts(ifn.thenBranch.stmts, registry, out)
            out: inferFromStmts(ifn.elseBranch.stmts, registry, out)
            return out
        }
        MatchStmtNode: {
            let mn MatchStmtNode: stmt
            out: inferFromExpr(mn.condition, registry, out)
            out: inferFromMatchStmtArms(mn.arms, registry, out)
            return out
        }
        _: { return out }
    }
    return out
}

// ─── Deduplication ────────────────────────────────────────────────────────────

// keyAlreadySeen — true if seen contains key.
fn keyAlreadySeen(seen Array<String>, key String) bool {
    let i i64: 0
    while i.lt(seen.len()) {
        if seen.at(i).equals(key) { return true }
        i: i.add(1)
    }
    return false
}

// deduplicateRequests — remove duplicate InstantiationRequests from raw,
// keyed by mangled name (e.g. "Box__Int64").  Preserves first occurrence order.
fn deduplicateRequests(raw Array<InstantiationRequest>) Array<InstantiationRequest> {
    let seen Array<String>: []
    let out Array<InstantiationRequest>: []
    let i i64: 0
    while i.lt(raw.len()) {
        let req InstantiationRequest: raw.at(i)
        let key String: inst.mangleGenericName(req.genericName, req.concreteTypes)
        if not keyAlreadySeen(seen, key) {
            seen.add(key)
            let clonedReq InstantiationRequest: { genericName: clone(req.genericName), concreteTypes: clone(req.concreteTypes) }
            out.add(clonedReq)
        } else {
            drop(key)
        }
        i: i.add(1)
    }
    drop(seen)
    return out
}

// ─── Entry point ──────────────────────────────────────────────────────────────

// collectInstantiations — walk all stmts, collect every generic instantiation
// site, and return a deduplicated Array<InstantiationRequest>.
// Call this after resolveModuleTypes so resolvedType fields are populated.
fn collectInstantiations(stmts Array<AstNode>, registry GenericRegistry) Array<InstantiationRequest> {
    let raw Array<InstantiationRequest>: []
    raw: inferFromStmts(stmts, registry, raw)
    let result Array<InstantiationRequest>: deduplicateRequests(raw)
    // deduplicateRequests clones into result, so raw elements are independent and can be freed.
    drop(raw)
    return result
}
