// Semantic Analyzer: Assignability
//
// Hosts `isAssignable`, the single "can a value of type `actual` be bound to a slot
// of type `expected`?" predicate shared by every value-flow site in the analyzer
// (return statements, call arguments, `let` bindings, assignments, field
// assignments, object-literal fields, array elements).
//
// Split out of semantic/exprs.suru by §3.4 of the type-system refactor, for two
// reasons: exprs.suru was over the 500-line limit, and this predicate is no longer
// an expression-inference helper — it is the semantic layer's copy of the
// STRUCTURAL type comparison that lives in src/compiler/types/ (`parseType` →
// `canonType` → `equalType`), with the language's assignability rules layered on
// top. Only the rules belong here; the type algebra belongs in types/.
//
// There is exactly ONE definition of this predicate. A duplicate second definition
// once existed in exprs.suru and made the compiler fail to build itself
// ("function 'isAssignable' is already declared") — extend the single one below
// rather than adding a variant.
//
// Coverage: tests/unit/compiler/assignability_test.suru.

namespace Suru.Compiler.Semantic.Assignable

import {
    semantic: Suru.Compiler.Semantic
    [Type, Prim]: Suru.Compiler.Types
    [parseType]: Suru.Compiler.Types.Parse
    [printSuruType]: Suru.Compiler.Types.Print
    [canonType, equalType]: Suru.Compiler.Types.Ops
}

// ─── Type families ────────────────────────────────────────────────────────────
//
// Both predicates take a canonicalized `Type` rather than a raw string: a family
// member is always a `Prim` after `canonType`, so a non-`Prim` shape (an `Arr`, a
// leftover `Var`) is simply not in any family.

// primName — the name of a `Prim` type, or "" for any other shape. The single
// place this file steps from structure back to a name; both family tests and the
// sum-type registry query go through it or through `printSuruType`.
fn primName(t Type) String {
    match t {
        Prim: {
            let p Prim: t
            return p.name.clone()
        }
        _: { return "" }
    }
}

// isStringFamily — the string family: owned heap `String` and borrowed static
// `Str`. Codegen materializes a heap copy at the boundary when an owned String is
// required, so either may flow into the other's slot.
fn isStringFamily(t Type) bool {
    let n String: primName(t)
    let result bool: n.equals("String") or n.equals("Str")
    drop(n)
    return result
}

// isIntegerFamily — the fixed-width integer types that are mutually assignable.
// Integer literals infer as `i64` (see inferType) but validly initialize
// `i32`/`char` slots too (`let c i32: 0`, hex literals → char), and codegen adapts
// the value to the slot width — so a mismatch *within* this family is not a type
// error. `f64` is deliberately excluded: Suru has no implicit int↔float
// conversion, so `let x f64: 0` should still be rejected.
fn isIntegerFamily(t Type) bool {
    let n String: primName(t)
    let result bool: n.equals("i64") or n.equals("i32") or n.equals("char")
    drop(n)
    return result
}

// ─── isAssignable ─────────────────────────────────────────────────────────────

// isAssignable — the single "can a value of type `actual` be bound to a slot of
// type `expected`?" predicate.  This is the one place to extend when a legitimate
// subtyping relation must be permitted.
//
// An unknown type on either side ("") is assignable — `inferType` /
// `nodeResolvedType` return "" for anything they cannot pin down, and an
// un-inferred node must be skipped rather than falsely rejected.  Call sites may
// additionally gate on non-"" before *reporting*, which some do to keep their
// diagnostic text honest; the guard here is what makes the ungated sites (array
// elements, object-literal fields, plain-call args) safe.
//
// Beyond that, a value is assignable when:
//   - the canonicalized types are STRUCTURALLY EQUAL.  Both sides are parsed into
//     a `Type` and canonicalized (`canonType`), so a substituted-but-unmangled
//     generic annotation ("Option<i64>") compares equal to its registered mangled
//     form ("Option-i64"), and the colon array form ("Array:i64") compares equal
//     to the source form ("Array<i64>").  Before §3.4 this was a string
//     comparison of both sides after `tyh.makeSuruType`; the canonical forms feed
//     the same strings to the registries below, so the accepted set is unchanged;
//   - `actual` is a declared variant of the sum type `expected` (a `Some<i64>`
//     value flowing into an `Option<i64>` slot);
//   - `expected` is a declared variant of the sum type `actual` — the compiler's
//     own "typed bridge" downcast idiom (`let n MatchStmtNode: someAstNode`),
//     which narrows a sum value to one variant for field access.  Codegen relies
//     on this being permitted;
//   - both sides are in the String family (see isStringFamily);
//   - both sides are in the integer family (see isIntegerFamily).
//
// The sum-type queries stay string-keyed: `state.sumTypes` records variant names
// as strings, and re-keying the registries on `Type` is §4.B, not this task.
export fn isAssignable(state AnalyzerState, expected String, actual String) bool {
    // Separate ifs, not `or`: Suru's boolean operators are not short-circuit.
    if expected.equals("") { return true }
    if actual.equals("") { return true }

    let expRaw Type: parseType(expected)
    let actRaw Type: parseType(actual)
    let expT Type: canonType(expRaw)
    let actT Type: canonType(actRaw)
    drop(expRaw)
    drop(actRaw)

    let verdict bool: assignableCanon(state, expT, actT)
    drop(expT)
    drop(actT)
    return verdict
}

// assignableCanon — the rule set, applied to the two ALREADY-CANONICAL types.
// Split from isAssignable so the parsed values are dropped on exactly one path
// (a `return` from inside the rule chain would otherwise leak them).
fn assignableCanon(state AnalyzerState, expT Type, actT Type) bool {
    if equalType(expT, actT) { return true }

    // Registry queries speak the legacy suruType string (§4.B re-keys them).
    let exp String: printSuruType(expT)
    let act String: printSuruType(actT)
    let variantHit bool: state.isSumVariant(exp, act) or state.isSumVariant(act, exp)
    drop(exp)
    drop(act)
    if variantHit { return true }

    if isStringFamily(expT) and isStringFamily(actT) { return true }
    if isIntegerFamily(expT) and isIntegerFamily(actT) { return true }
    return false
}
