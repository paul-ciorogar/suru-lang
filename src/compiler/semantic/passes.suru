// Semantic Analyzer: Declaration Pre-passes
//
// Implements two passes over an AstModule's statement list that populate
// AnalyzerState before any statement analysis runs:
//
//   Pass 1 (collectTypeDeclarations)  — collects TypeDeclaration node names
//     into state.typeNames; errors on duplicates.
//
//   Pass 2 (collectFunctionDeclarations) — collects FunctionDeclaration
//     signatures into state.functions; validates param and return types via
//     resolveTypeName; errors on unknown types and duplicate function names.
//
// Entry point: runPrePasses(state, stmts) runs both passes in order.
//
// Design note: AnalyzerState fields (typeNames, functions, errors) are accessed
// through typed intermediate variables (e.g. `let typeNames Array<String>: state.typeNames`)
// before calling array methods on them. Without this, the field access has an unknown
// resolved type (struct parameters don't get PropagateStructMeta), causing the codegen
// to route `.add()` to integer arithmetic instead of suru_array_add.
//
// Function bodies may call namespace functions from sem.* or parser.* — transitive
// namespace propagation in ResolveIncludes makes those namespaces visible in any
// file that includes this one. Types (AstNode, Param, AnalysisError, FunctionSig)
// are merged unqualified and are also safe.

namespace Suru.Compiler.Semantic.Passes

export {
    isArrayGeneric
    isBuiltinType
    typeNameExistsAt
    indexOfAngle
    ltrimStr
    flattenPassTypeArg
    appendMangledArgsAt
    mangleAnnotation
    isUserGenericAnnotation
    resolveTypeName
    isTypeParam
    recordTypeDecl
    isCTypeNamed
    isExternTypeNamed
    collectTypeDeclarations
    registerFnDecl
    registerExternFnDecl
    collectFunctionDeclarations
    runPrePasses
    normalizeGenericTypeName
}

import { sem: Suru.Compiler.Semantic }
import { parser: Suru.Compiler.Parser }

// ─── Type resolution ──────────────────────────────────────────────────────────

// isArrayGeneric — true when name is a generic Array type like "Array<i64>".
// The Suru parser stores generic type annotations as flat strings ("Array<T>"),
// so we check the first 5 characters for "Array" when the name is long enough.
fn isArrayGeneric(name String) bool {
    return match name.len().gt(5) {
        true: name.slice(0, 5).equals("Array")
        _: false
    }
}

// isBuiltinType — true for the seven primitive type names, ptr, and generic Array forms.
// ptr is an untyped C pointer, valid only in extern fn signatures and let declarations.
fn isBuiltinType(name String) bool {
    return name.equals("bool")
        or name.equals("i32")
        or name.equals("i64")
        or name.equals("f64")
        or name.equals("char")
        or name.equals("String")
        or name.equals("ptr")
        or name.equals("Array")
        or isArrayGeneric(name)
}

// typeNameExistsAt — linear search; true if name is in typeNames.
fn typeNameExistsAt(typeNames Array<String>, name String) bool {
    let i i64: 0
    while i.lt(typeNames.len()) {
        if typeNames.at(i).equals(name) { return true }
        i: i.add(1)
    }
    return false
}

// ─── Generic type-annotation mangling ────────────────────────────────────────
// These helpers let resolveTypeName recognise user-defined generic annotations
// like "Box<i64>" by looking up their mangled form "Box__Int64" in typeNames.

// indexOfAngle — index of the first '<' in s, or s.len() when absent.
fn indexOfAngle(s String) i64 {
    let i i64: 0
    while i.lt(s.len()) {
        if s.at(i).equals("<") { return i }
        i: i.add(1)
    }
    return s.len()
}

// ltrimStr — strip leading ASCII space characters from s.
fn ltrimStr(s String) String {
    let i i64: 0
    while i.lt(s.len()) {
        if not s.slice(i, i.add(1)).equals(" ") { return s.slice(i, s.len()) }
        i: i.add(1)
    }
    return ""
}

// flattenPassTypeArg — recursively flatten a type-name string to an
// identifier-safe form (duplicated from monoInstantiate because passes.suru
// is a separate include chain).
//   "Array<i64>"          → "Array__Int64"
//   "Option<i64>"         → "Option__Int64"
//   "Option<Array<i64>>"  → "Option__Array__Int64"
//   plain names             → trimmed clone
fn flattenPassTypeArg(typeName String) String {
    let trimmed String: ltrimStr(typeName)
    let ltIdx i64: indexOfAngle(trimmed)
    if ltIdx.equals(trimmed.len()) { return trimmed }
    let base String: trimmed.slice(0, ltIdx)
    let inner String: trimmed.slice(ltIdx.add(1), trimmed.len().take(1))
    let acc String: base
    let start i64: 0
    let i i64: 0
    while i.lt(inner.len()) {
        if inner.at(i).equals(",") {
            let seg String: flattenPassTypeArg(inner.slice(start, i))
            let next String: acc.append("__").append(seg)
            drop(seg)
            drop(acc)
            acc: next
            i: i.add(1)
            start: i
        } else {
            i: i.add(1)
        }
    }
    let seg String: flattenPassTypeArg(inner.slice(start, inner.len()))
    let result String: acc.append("__").append(seg)
    drop(seg)
    drop(acc)
    return result
}

// appendMangledArgsAt — scan inner for comma-separated type arguments and
// append "__<flattenPassTypeArg(arg)>" for each to acc.  Used by mangleAnnotation.
// Calls flattenPassTypeArg so nested generics like "Array<i64>" become
// "Array__Int64" in the resulting identifier rather than the raw annotation string.
fn appendMangledArgsAt(inner String, start i64, acc String) String {
    let i i64: start
    while i.lt(inner.len()) {
        if inner.at(i).equals(",") {
            let seg String: flattenPassTypeArg(inner.slice(start, i))
            let next String: acc.append("__").append(seg)
            drop(seg)
            drop(acc)
            acc: next
            i: i.add(1)
            start: i
        } else {
            i: i.add(1)
        }
    }
    let seg String: flattenPassTypeArg(inner.slice(start, inner.len()))
    let result String: acc.append("__").append(seg)
    drop(seg)
    drop(acc)
    return result
}

// mangleAnnotation — convert a generic type annotation string to its mangled
// form.  "Box<i64>" → "Box__Int64", "Pair<i64, String>" → "Pair__Int64__String".
fn mangleAnnotation(name String) String {
    let ltIdx i64: indexOfAngle(name)
    let base String: name.slice(0, ltIdx)
    let inner String: name.slice(ltIdx.add(1), name.len().take(1))
    return appendMangledArgsAt(inner, 0, base)
}

// isUserGenericAnnotation — true when name is a generic type annotation for a
// user-defined type (i.e. contains '<' but is not the builtin Array<T> form).
fn isUserGenericAnnotation(name String) bool {
    let ltIdx i64: indexOfAngle(name)
    if ltIdx.equals(name.len()) { return false }
    if isArrayGeneric(name)     { return false }
    return true
}

// resolveTypeName — true when name is a built-in or a user-declared type.
// Passes state.typeNames as a typed argument; the callee's Array<String> annotation
// ensures correct dispatch inside typeNameExistsAt.
// Also accepts user-defined generic annotations like "Box<i64>" by looking up
// the mangled form "Box__Int64" in typeNames (injected by the mono pass).
// Note: uses explicit match rather than `and` to guard the mangleAnnotation call
// because Suru's boolean `and` is not short-circuit (both sides are always evaluated).
fn resolveTypeName(state AnalyzerState, name String) bool {
    let typeNames Array<String>: state.typeNames
    if isBuiltinType(name) or typeNameExistsAt(typeNames, name) { return true }
    if isUserGenericAnnotation(name) { return typeNameExistsAt(typeNames, mangleAnnotation(name)) }
    return false
}

// isTypeParam — true when name matches one of the type-param names in typeParams.
// Used by registerFnDecl to skip validation for generic parameter/return types.
fn isTypeParam(name String, typeParams Array<String>) bool {
    let i i64: 0
    while i.lt(typeParams.len()) {
        if typeParams.at(i).equals(name) { return true }
        i: i.add(1)
    }
    return false
}

// ─── Pass 1: collect type declarations ───────────────────────────────────────

// isCTypeNamed — true if `typeName` names a registered cType. Used by the
// analyze pass to reject clone()/drop() in function-call form on a cType value.
// Returns false for unknown / empty names, so it never produces a false positive.
fn isCTypeNamed(state AnalyzerState, typeName String) bool {
    let decls Array<SemTypeEntry>: state.typeDecls
    let i i64: 0
    while i.lt(decls.len()) {
        let e SemTypeEntry: decls.at(i)
        if e.name.equals(typeName) { return e.isCType }
        i: i.add(1)
    }
    return false
}

// isExternTypeNamed — true when `typeName` resolves to a declared `extern type`.
// Used to reject clone()/drop() and use as a regular struct field.
fn isExternTypeNamed(state AnalyzerState, typeName String) bool {
    let decls Array<SemTypeEntry>: state.typeDecls
    let i i64: 0
    while i.lt(decls.len()) {
        let e SemTypeEntry: decls.at(i)
        if e.name.equals(typeName) { return e.isExternType }
        i: i.add(1)
    }
    return false
}

// isCAbiPrimitive — true for the scalar types that have a fixed C ABI size and
// alignment and may therefore appear as cType fields. `ptr` is added with the
// Phase B `ptr` primitive; String/Array/named types are deferred.
fn isCAbiPrimitive(typeName String) bool {
    return typeName.equals("bool") or typeName.equals("char") or typeName.equals("i32") or typeName.equals("i64") or typeName.equals("f64")
}

// normalizeGenericTypeName — convert a generic-application return type like
// "DynArray<i64>" to its mangled form "DynArray__i64" for hasCustomLifecycle
// comparison.  Handles single-level generics only (all clone() return types
// are necessarily single-level — a type clones itself, not a nested wrapper).
// Plain types without '<' are returned unchanged.
fn normalizeGenericTypeName(typeName String) String {
    let len i64: typeName.len()
    let i i64: 0
    while i.lt(len) {
        if typeName.at(i).equals("<") {
            let base String: typeName.slice(0, i)
            let inner String: typeName.slice(i.add(1), len.take(1))
            return base.append("__").append(inner)
        }
        i: i.add(1)
    }
    return clone(typeName)
}

// recordTypeDecl — copy a parser TypeDeclNode into a semantic-layer
// SemTypeEntry and append it to state.typeDecls. Used so resolveTypes.suru can
// look up struct field types without importing the parser AST into the leaf
// semantic.suru file.
fn recordTypeDecl(state AnalyzerState, typed TypeDeclNode) AnalyzerState {
    let semFields Array<SemFieldEntry>: []
    let params Array<Param>: typed.fields
    let fi i64: 0
    while fi.lt(params.len()) {
        let p Param: params.at(fi)
        let entry SemFieldEntry: { name: p.name, typeName: p.typeName }
        semFields.add(entry)
        // A cType maps onto the C ABI, so each field must be a fixed-layout C
        // primitive. String/Array/named-struct/nested-cType fields are rejected
        // (deferred per the FFI plan).
        if typed.isCType and not isCAbiPrimitive(p.typeName) {
            state.addError("cType '".append(typed.name).append("' field '").append(p.name).append("' has type '").append(p.typeName).append("'; only bool, char, i32, i64, f64 are allowed"), typed.line, typed.col)
        }
        fi: fi.add(1)
    }
    let semMethods Array<SemMethodEntry>: []
    let methodSigs Array<MethodSig>: typed.methods
    let mi i64: 0
    while mi.lt(methodSigs.len()) {
        let ms MethodSig: methodSigs.at(mi)
        let ptypes Array<String>: []
        let mps Array<Param>: ms.params
        let pj i64: 0
        while pj.lt(mps.len()) {
            ptypes.add(mps.at(pj).typeName)
            pj: pj.add(1)
        }
        let me SemMethodEntry: { name: ms.name, paramTypes: ptypes, returnType: ms.returnType }
        semMethods.add(me)
        mi: mi.add(1)
    }
    // hasCustomLifecycle: true when the interface declares both clone() returning the
    // same type and drop() returning void. Enables ptr/extern-type private fields.
    // For monomorphized generic types, clone() return types may arrive as the
    // generic-application form ("DynArray<i64>") rather than the mangled form
    // ("DynArray__i64"); normalizeGenericTypeName handles the comparison in both forms.
    let hasClone bool: false
    let hasDrop bool: false
    let lci i64: 0
    while lci.lt(methodSigs.len()) {
        let lms MethodSig: methodSigs.at(lci)
        if lms.name.equals("clone") {
            let normalizedRet String: normalizeGenericTypeName(lms.returnType)
            if lms.returnType.equals(typed.name) or normalizedRet.equals(typed.name) { hasClone: true }
            drop(normalizedRet)
        }
        if lms.name.equals("drop") and lms.returnType.equals("void") { hasDrop: true }
        lci: lci.add(1)
    }
    let hasCustomLifecycle bool: hasClone and hasDrop
    let typeDecls Array<SemTypeEntry>: state.typeDecls
    // privateFieldNames and privateMethodNames start empty; resolveTypes.suru populates
    // them lazily on first encounter of a ObjectLitNode with isPrivate members.
    let teEntry SemTypeEntry: { name: typed.name, fields: semFields, methods: semMethods, privateFieldNames: [], privateMethodNames: [], isCType: typed.isCType, isExternType: false, hasCustomLifecycle: hasCustomLifecycle }
    typeDecls.add(teEntry)
    return state
}

// collectTypeDeclarations — walk stmts; for each TypeDeclNode either add its
// name to state.typeNames or report a duplicate-type error. Non-duplicate
// TypeDeclNodes are also copied into state.typeDecls so resolveTypes can
// recurse into nested object literals with the right field-type expectations.
fn collectTypeDeclarations(state AnalyzerState, stmts Array<AstNode>) AnalyzerState {
    let typeNames Array<String>: state.typeNames
    let i i64: 0
    while i.lt(stmts.len()) {
        let stmt AstNode: stmts.at(i)
        match stmt {
            TypeDeclNode: {
                let typed TypeDeclNode: stmt
                if typeNameExistsAt(typeNames, typed.name) {
                    state.addError("type '".append(typed.name).append("' is already declared"), typed.line, typed.col)
                } else {
                    typeNames.add(typed.name)
                    recordTypeDecl(state, typed)
                }
            }
            SumTypeDeclNode: {
                let sumTyped SumTypeDeclNode: stmt
                if typeNameExistsAt(typeNames, sumTyped.name) {
                    state.addError("type '".append(sumTyped.name).append("' is already declared"), sumTyped.line, sumTyped.col)
                } else {
                    typeNames.add(sumTyped.name)
                    state.recordSumType(sumTyped.name, sumTyped.variants)
                }
            }
            ExternTypeNode: {
                let extTyped ExternTypeNode: stmt
                if typeNameExistsAt(typeNames, extTyped.name) {
                    state.addError("type '".append(extTyped.name).append("' is already declared"), extTyped.line, extTyped.col)
                } else {
                    typeNames.add(extTyped.name)
                    let typeDecls Array<SemTypeEntry>: state.typeDecls
                    let noFields Array<SemFieldEntry>: []
                    let noMethods Array<SemMethodEntry>: []
                    let extEntry SemTypeEntry: { name: extTyped.name, fields: noFields, methods: noMethods, privateFieldNames: [], privateMethodNames: [], isCType: false, isExternType: true, hasCustomLifecycle: false }
                    typeDecls.add(extEntry)
                }
            }
            _: {}
        }
        i: i.add(1)
    }
    // Second pass (order-independent — all cTypes and extern types are now registered):
    // reject a cType, extern type, or ptr used as a field of a regular type. A regular struct carries a runtime
    // header and its generated clone/drop would treat an unmanaged pointer as a
    // managed heap value (calling suru_clone_dyn on a raw allocation), so
    // this is a compile error regardless of whether the container is instantiated.
    let j i64: 0
    while j.lt(stmts.len()) {
        match stmts.at(j) {
            TypeDeclNode: {
                let td2 TypeDeclNode: stmts.at(j)
                if not td2.isCType {
                    let fparams Array<Param>: td2.fields
                    let fk i64: 0
                    while fk.lt(fparams.len()) {
                        let fp Param: fparams.at(fk)
                        if isCTypeNamed(state, fp.typeName) {
                            state.addError("cType '".append(fp.typeName).append("' cannot be a field of regular type '").append(td2.name).append("' (use it only at the extern fn boundary)"), td2.line, td2.col)
                        } else if isExternTypeNamed(state, fp.typeName) {
                            state.addError("extern type '".append(fp.typeName).append("' cannot be a field of regular type '").append(td2.name).append("' (use it only at the extern fn boundary)"), td2.line, td2.col)
                        } else if fp.typeName.equals("ptr") {
                            state.addError("'ptr' cannot be a field of type '".append(td2.name).append("' (only allowed in extern fn signatures and let declarations)"), td2.line, td2.col)
                        }
                        fk: fk.add(1)
                    }
                }
            }
            _: {}
        }
        j: j.add(1)
    }
    return state
}

// ─── Pass 2: collect function declarations ────────────────────────────────────

// registerFnDecl — validate and register one FnDeclNode into state.functions.
// Emits errors for unknown param/return types but still registers the signature.
// typeParams holds the generic type-param names for this function; any param or
// return type that matches one of them is accepted without a resolveTypeName check.
fn registerFnDecl(state AnalyzerState, stmt FnDeclNode, typeParams Array<String>) AnalyzerState {
    state.currentSrcPath: stmt.srcPath
    let paramTypes Array<String>: []
    let params Array<Param>: stmt.params
    let pi i64: 0
    while pi.lt(params.len()) {
        let p Param: params.at(pi)
        let pType String: p.typeName
        if pType.equals("ptr") or resolveTypeName(state, pType) or isTypeParam(pType, typeParams) {
            paramTypes.add(pType)
        } else {
            state.addError("unknown type '".append(pType).append("' in parameter '").append(p.name).append("' of function '").append(stmt.name).append("'"), stmt.line, stmt.col)
        }
        pi: pi.add(1)
    }
    let returnType String: stmt.returnType
    if returnType.equals("ptr") {
        state.addError("type 'ptr' is not allowed as a regular function return type; use extern fn for C interop", stmt.line, stmt.col)
    } else {
        let validReturn bool: returnType.equals("void") or resolveTypeName(state, returnType) or isTypeParam(returnType, typeParams)
        if not validReturn {
            state.addError("unknown return type '".append(returnType).append("' for function '").append(stmt.name).append("'"), stmt.line, stmt.col)
        }
    }
    let sig FunctionSig: newFunctionSig(stmt.name, paramTypes, returnType, stmt.srcPath)
    state.functions.add(sig)
    return state
}

// registerExternFnDecl — validate and register one ExternFnNode into state.functions.
// Extern fns are raw IR declarations with no source path (srcPath: ""), so
// mangleSym passes their names through verbatim at every call site.
fn registerExternFnDecl(state AnalyzerState, stmt ExternFnNode) AnalyzerState {
    let paramTypes Array<String>: []
    let params Array<Param>: stmt.params
    let pi i64: 0
    while pi.lt(params.len()) {
        let p Param: params.at(pi)
        let pType String: p.typeName
        if resolveTypeName(state, pType) {
            paramTypes.add(pType)
        } else {
            state.addError("unknown type '".append(pType).append("' in parameter '").append(p.name).append("' of extern fn '").append(stmt.name).append("'"), 0, 0)
        }
        pi: pi.add(1)
    }
    let returnType String: stmt.returnType
    let validReturn bool: returnType.equals("void") or resolveTypeName(state, returnType)
    if not validReturn {
        state.addError("unknown return type '".append(returnType).append("' for extern fn '").append(stmt.name).append("'"), 0, 0)
    }
    let sig FunctionSig: newFunctionSig(stmt.name, paramTypes, returnType, "")
    state.functions.add(sig)
    return state
}

// collectFunctionDeclarations — walk stmts; for each FnDeclNode or ExternFnNode
// either report a duplicate-function error or register the signature.
fn collectFunctionDeclarations(state AnalyzerState, stmts Array<AstNode>) AnalyzerState {
    let i i64: 0
    while i.lt(stmts.len()) {
        let stmt AstNode: stmts.at(i)
        match stmt {
            FnDeclNode: {
                let typed FnDeclNode: stmt
                if state.functions.hasSig(typed.srcPath, typed.name) {
                    state.currentSrcPath: typed.srcPath
                    state.addError("function '".append(typed.name).append("' is already declared"), typed.line, typed.col)
                } else {
                    registerFnDecl(state, typed, typed.typeParams)
                }
            }
            ExternFnNode: {
                let typed ExternFnNode: stmt
                if state.functions.hasSig("", typed.name) {
                    state.addError("function '".append(typed.name).append("' is already declared"), 0, 0)
                } else {
                    registerExternFnDecl(state, typed)
                }
            }
            _: {}
        }
        i: i.add(1)
    }
    return state
}

// ─── Entry point ──────────────────────────────────────────────────────────────

// runPrePasses — runs pass 1 then pass 2 in order.
fn runPrePasses(state AnalyzerState, stmts Array<AstNode>) AnalyzerState {
    collectTypeDeclarations(state, stmts)
    collectFunctionDeclarations(state, stmts)
    return state
}
