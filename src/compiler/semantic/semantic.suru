// Semantic Analyzer Data Structures
//
// Defines the scope-chain types and core helpers used by all semantic analysis passes.
// Uses a flat Array<Scope> with integer parent indices as the scope stack;
// in-place heap mutation (no copy-on-write).
//
// Invariant: the current scope is always the last element of state.scopes.
// pushScope appends; popScope slices off the last element.
// parent = -1 marks the module scope (no parent).
//
// Field access on array elements (e.g. symbols.at(i).name) works directly
// because the compiler tracks Array<T> element types and annotates every
// AST expression node with its resolved SuruType during semantic analysis.

// ─── Type declarations ────────────────────────────────────────────────────────

type SymbolEntry: { name String, typeName String }

type Scope: { symbols Array<SymbolEntry>, parent Int64 }

type FunctionSig: { name String, paramTypes Array<String>, returnType String, srcPath String }

type AnalysisError: { message String }

// SemFieldEntry / SemTypeEntry mirror parser TypeDeclNode + Param shape but live
// inside the semantic layer so semantic.suru can stay a leaf (no parser/ast
// include). collectTypeDeclarations copies each TypeDeclNode into a SemTypeEntry
// at pre-pass time; resolveTypes.suru reads them when resolving StructLitNodes
// and FieldAccessNodes.
type SemFieldEntry: { name String, typeName String }
// SemMethodEntry mirrors a parser MethodSig (declared method signature on a
// type). paramTypes are the declared parameter type names in order; the
// implicit `this` receiver is NOT included here.
type SemMethodEntry: { name String, paramTypes Array<String>, returnType String }
// SemTypeEntry mirrors a parser TypeDeclNode. privateFieldNames / privateMethodNames
// are populated by resolveTypes.suru when it first encounters a StructLitNode whose
// fields carry isPrivate=true; they drive the access-control check in FieldAccessNode
// and MethodCallNode resolution.
type SemTypeEntry:  { name String, fields Array<SemFieldEntry>, methods Array<SemMethodEntry>, privateFieldNames Array<String>, privateMethodNames Array<String> }

type AnalyzerState: {
    scopes          Array<Scope>
    functions       Array<FunctionSig>
    typeNames       Array<String>
    typeDecls       Array<SemTypeEntry>
    sumTypes        Array<SemTypeEntry>
    errors          Array<AnalysisError>
    currentReturnType String
    insideFunction  Int64
    constants       Array<String>
}

// ─── State constructor ────────────────────────────────────────────────────────

fn makeAnalyzerState() AnalyzerState {
    let state AnalyzerState: {
        scopes: [],
        functions: [],
        typeNames: [],
        typeDecls: [],
        sumTypes: [],
        errors: [],
        currentReturnType: "",
        insideFunction: 0,
        constants: []
    }
    return pushScope(state)
}

// ─── Scope stack helpers ──────────────────────────────────────────────────────

// pushScope — adds a new empty scope on top of the stack.
// parent = index of the current last scope before the push (or -1 when empty).
fn pushScope(state AnalyzerState) AnalyzerState {
    let scopes Array<Scope>: state.scopes
    let parent Int64: scopes.len().take(1)
    let scope Scope: { symbols: [], parent: parent }
    scopes.add(scope)
    return state
}

// popScope — removes the innermost scope.
// Uses slice to drop the last element; the parent chain in remaining scopes is unchanged.
fn popScope(state AnalyzerState) AnalyzerState {
    let scopes Array<Scope>: state.scopes
    let newLen Int64: scopes.len().take(1)
    let newScopes Array<Scope>: scopes.slice(0, newLen)
    state.scopes: newScopes
    return state
}

// ─── Symbol declaration ───────────────────────────────────────────────────────

// declareSymbol — adds a name→typeName binding to the current (innermost) scope.
fn declareSymbol(state AnalyzerState, name String, typeName String) AnalyzerState {
    let scopes Array<Scope>: state.scopes
    let idx Int64: scopes.len().take(1)
    let scope Scope: scopes.at(idx)
    let symbols Array<SymbolEntry>: scope.symbols
    let entry SymbolEntry: { name: name, typeName: typeName }
    symbols.add(entry)
    return state
}

// ─── Symbol lookup ────────────────────────────────────────────────────────────

// lookupInScopeAt — linear search starting at index i.
// Returns the typeName of the first matching entry, or "" when exhausted.
fn lookupInScopeAt(symbols Array<SymbolEntry>, name String, i Int64) String {
    return match i.lt(symbols.len()) {
        true: match symbols.at(i).name.equals(name) {
            true: symbols.at(i).typeName
            _: lookupInScopeAt(symbols, name, i.add(1))
        }
        _: ""
    }
}

// lookupInScope — searches one scope frame.
fn lookupInScope(scope Scope, name String) String {
    let symbols Array<SymbolEntry>: scope.symbols
    return lookupInScopeAt(symbols, name, 0)
}

// lookupSymbolAt — walks the parent chain from scope[idx].
// Returns the nearest binding, or "" when the chain is exhausted (parent = -1).
fn lookupSymbolAt(state AnalyzerState, name String, idx Int64) String {
    let scopes Array<Scope>: state.scopes
    return match idx.gte(0) {
        true: match lookupInScope(scopes.at(idx), name).equals("") {
            true: lookupSymbolAt(state, name, scopes.at(idx).parent)
            _: lookupInScope(scopes.at(idx), name)
        }
        _: ""
    }
}

// lookupSymbol — public entry point; starts from the innermost scope.
fn lookupSymbol(state AnalyzerState, name String) String {
    let scopes Array<Scope>: state.scopes
    let idx Int64: scopes.len().take(1)
    return lookupSymbolAt(state, name, idx)
}

// existsInCurrentScope — checks only the innermost scope (for duplicate-let detection).
fn existsInCurrentScope(state AnalyzerState, name String) Bool {
    let scopes Array<Scope>: state.scopes
    let idx Int64: scopes.len().take(1)
    let scope Scope: scopes.at(idx)
    return not lookupInScope(scope, name).equals("")
}

// ─── Sum type variant registry ────────────────────────────────────────────────

// recordSumType — register a sum type and its variant names so the return-type
// check can recognise that a variant is assignable to its sum type. Variants
// are stored as SemFieldEntry rows (name = variant, typeName = variant) to
// reuse the SemTypeEntry shape without importing the parser AST here.
fn recordSumType(state AnalyzerState, name String, variants Array<String>) AnalyzerState {
    let semVariants Array<SemFieldEntry>: []
    let vi Int64: 0
    while vi.lt(variants.len()) {
        let v String: variants.at(vi)
        let entry SemFieldEntry: { name: v, typeName: v }
        semVariants.add(entry)
        vi: vi.add(1)
    }
    let sumTypes Array<SemTypeEntry>: state.sumTypes
    let noMethods Array<SemMethodEntry>: []
    let teEntry SemTypeEntry: { name: name, fields: semVariants, methods: noMethods, privateFieldNames: [], privateMethodNames: [] }
    sumTypes.add(teEntry)
    return state
}

// sumHasVariantAt — linear search through a sum type's variant rows.
fn sumHasVariantAt(variants Array<SemFieldEntry>, candidate String, i Int64) Bool {
    return match i.lt(variants.len()) {
        true: match variants.at(i).name.equals(candidate) {
            true: true
            _: sumHasVariantAt(variants, candidate, i.add(1))
        }
        _: false
    }
}

// isSumVariantAt — linear search through state.sumTypes for `sumName`, then
// check whether `candidate` is one of its variants.
fn isSumVariantAt(sumTypes Array<SemTypeEntry>, sumName String, candidate String, i Int64) Bool {
    return match i.lt(sumTypes.len()) {
        true: match sumTypes.at(i).name.equals(sumName) {
            true: sumHasVariantAt(sumTypes.at(i).fields, candidate, 0)
            _: isSumVariantAt(sumTypes, sumName, candidate, i.add(1))
        }
        _: false
    }
}

// isSumVariant — true when `candidate` is a declared variant of sum type `sumName`.
fn isSumVariant(state AnalyzerState, sumName String, candidate String) Bool {
    return isSumVariantAt(state.sumTypes, sumName, candidate, 0)
}

// ─── Error accumulation ───────────────────────────────────────────────────────

fn addError(state AnalyzerState, message String) AnalyzerState {
    let errors Array<AnalysisError>: state.errors
    let err AnalysisError: { message: message }
    errors.add(err)
    return state
}
