// Semantic Analyzer Data Structures
//
// Defines the scope-chain types and core helpers used by all semantic analysis passes.
// Uses a flat Array<Scope> with integer parent indices as the scope stack;
// in-place heap mutation (no copy-on-write).
//
// Invariant: the current scope is always the last element of state.scopes.
// pushScope appends; popScope slices off the last element.
// parent = -1 marks the module scope (no parent).
//
// Field access on array elements (e.g. symbols.at(i).name) works directly
// because the compiler tracks Array<T> element types and annotates every
// AST expression node with its resolved SuruType during semantic analysis.

namespace Suru.Compiler.Semantic

export {
    SymbolEntry
    Scope
    FunctionSig
    FunctionRegistry
    AnalysisError
    SemFieldEntry
    SemMethodEntry
    SemTypeEntry
    SrcModImports
    AnalyzerState
    newFunctionSig
    newFunctionRegistry
    makeAnalyzerState
    newScope
    sumHasVariantAt
    isSumVariantAt
    isMovedAt
    clearMovedAt
    currentModuleHasImport
    lookupModuleImports
}

// ─── Type declarations ────────────────────────────────────────────────────────

// SrcModImports — lightweight per-module import record stored in
// AnalyzerState.moduleImportRegistry. Built by the pipeline from the Module
// list returned by resolveIncludes. Carries only what semantic analysis needs:
// the source path and the set of namespace strings that module imported.
type SrcModImports: { srcPath String, importedNs Array<String> }

type SymbolEntry: { name String, typeName String }

type Scope: {
    symbols Array<SymbolEntry>,
    parent i64,
    fn lookup(name String) String
}

type FunctionSig: { 
    name String
    paramTypes Array<String>
    returnType String
    srcPath String
    fn paramCount() i64 
}

fn newFunctionSig(name String, paramTypes Array<String>, returnType String, srcPath String) FunctionSig {
    return { 
        name: name
        paramTypes: paramTypes
        returnType: returnType
        srcPath: srcPath

        fn paramCount() i64 { 
            return this.paramTypes.len() 
        } 
    }
}

type FunctionRegistry: { 
    signatures Array<FunctionSig>

    fn add(sig FunctionSig)
    fn hasSig(srcPath String, name String) bool
    fn findIndexByName(name String) i64
    fn returnType(name String) String
    fn paramCount(name String) i64
    fn paramType(name String, idx i64) String 
}

fn newFunctionRegistry() FunctionRegistry {
    return {
        signatures: [],

        fn add(sig FunctionSig) {
            this.signatures.add(sig)
        }

        fn hasSig(srcPath String, name String) bool {
            let i i64: 0
            while i.lt(this.signatures.len()) {
                let s FunctionSig: this.signatures.at(i)
                if s.name.equals(name) and s.srcPath.equals(srcPath) { return true }
                i: i.add(1)
            }
            return false
        }

        // Linear search for the first signature with the given name.
        // Returns its index in `signatures`, or -1 if no signature matches.
        fn findIndexByName(name String) i64 {
            let i i64: 0
            while i.lt(this.signatures.len()) {
                if this.signatures.at(i).name.equals(name) { return i }
                i: i.add(1)
            }
            return -1
        }

        fn returnType(name String) String {
            let i i64: this.findIndexByName(name)
            if i.lt(0) { return "" }
            return this.signatures.at(i).returnType
        }

        fn paramCount(name String) i64 {
            let i i64: this.findIndexByName(name)
            if i.lt(0) { return -1 }
            return this.signatures.at(i).paramCount()
        }

        fn paramType(name String, idx i64) String {
            let i i64: this.findIndexByName(name)
            if i.lt(0) { return "" }
            let pts Array<String>: this.signatures.at(i).paramTypes
            if idx.lt(pts.len()) { return pts.at(idx) }
            return ""
        }
    }
}

type AnalysisError: { message String, line i64, col i64, srcPath String }

// SemFieldEntry / SemTypeEntry mirror parser TypeDeclNode + Param shape but live
// inside the semantic layer so semantic.suru can stay a leaf (no parser/ast
// include). collectTypeDeclarations copies each TypeDeclNode into a SemTypeEntry
// at pre-pass time; resolveTypes.suru reads them when resolving StructLitNodes
// and FieldAccessNodes.
type SemFieldEntry: { name String, typeName String }
// SemMethodEntry mirrors a parser MethodSig (declared method signature on a
// type). paramTypes are the declared parameter type names in order; the
// implicit `this` receiver is NOT included here.
type SemMethodEntry: { name String, paramTypes Array<String>, returnType String }
// SemTypeEntry mirrors a parser TypeDeclNode. privateFieldNames / privateMethodNames
// are populated by resolveTypes.suru when it first encounters a StructLitNode whose
// fields carry isPrivate=true; they drive the access-control check in FieldAccessNode
// and MethodCallNode resolution.
// `isCType` is true for `cType` declarations (header-less, C-ABI FFI structs);
// it drives the rejections of methods, clone()/drop(), and nesting in a regular type.
// `isExternType` is true for `extern type` declarations (opaque C handles erased to
// `ptr` in codegen); it drives the same clone()/drop() rejections and field nesting
// rejection as isCType, but for named opaque handles like `FILE*` or `LLVMContextRef`.
// `hasCustomLifecycle` is true when the type interface declares both `clone() TypeName`
// and `drop() void`, signalling that the programmer provides manual memory management.
// This allows `ptr`/extern-type private fields in the object literal and causes codegen
// to emit vtable-dispatch wrappers for @suru_clone_T / @suru_drop_T instead of the
// normal field-walking auto-generated bodies.
type SemTypeEntry:  { name String, fields Array<SemFieldEntry>, methods Array<SemMethodEntry>, privateFieldNames Array<String>, privateMethodNames Array<String>, isCType bool, isExternType bool, hasCustomLifecycle bool }

type AnalyzerState: {
    scopes          Array<Scope>
    functions       FunctionRegistry
    typeNames       Array<String>
    typeDecls       Array<SemTypeEntry>
    sumTypes        Array<SemTypeEntry>
    errors          Array<AnalysisError>
    currentReturnType String
    insideFunction  i64
    insideLoop      i64
    constants       Array<String>
    movedVars       Array<String>
    currentSrcPath        String
    moduleNamespace       String
    exportedNames         Array<String>
    currentModuleImports  Array<String>
    moduleImportRegistry  Array<SrcModImports>
    fn pushScope()
    fn popScope()
    fn declareSymbol(name String, typeName String)
    fn lookupSymbolAt(name String, idx i64) String
    fn lookupSymbol(name String) String
    fn existsInCurrentScope(name String) bool
    fn recordSumType(name String, variants Array<String>)
    fn isSumVariant(sumName String, candidate String) bool
    fn isMoved(name String) bool
    fn markMoved(name String)
    fn clearMoved(name String)
    fn resetMovedVars()
    fn addError(message String, line i64, col i64)
}

// ─── State constructor ────────────────────────────────────────────────────────

fn makeAnalyzerState() AnalyzerState {
    let state AnalyzerState: {
        scopes: [],
        functions: newFunctionRegistry(),
        typeNames: [],
        typeDecls: [],
        sumTypes: [],
        errors: [],
        currentReturnType: "",
        insideFunction: 0,
        insideLoop: 0,
        constants: [],
        movedVars: [],
        currentSrcPath: "",
        moduleNamespace: "",
        exportedNames: [],
        currentModuleImports: [],
        moduleImportRegistry: [],

        // ─── Scope stack ─────────────────────────────────────────────────────

        // pushScope — adds a new empty scope on top of the stack.
        // parent = index of the current last scope before the push (or -1 when empty).
        fn pushScope() {
            let scopes Array<Scope>: this.scopes
            let parent i64: scopes.len().take(1)
            let scope Scope: newScope(parent)
            scopes.add(scope)
        }

        // popScope — removes the innermost scope.
        // Uses slice to drop the last element; parent chain in remaining scopes is unchanged.
        fn popScope() {
            let scopes Array<Scope>: this.scopes
            let newLen i64: scopes.len().take(1)
            let newScopes Array<Scope>: scopes.slice(0, newLen)
            this.scopes: newScopes
        }

        // ─── Symbol declaration ───────────────────────────────────────────────

        // declareSymbol — adds a name→typeName binding to the current (innermost) scope.
        fn declareSymbol(name String, typeName String) {
            let scopes Array<Scope>: this.scopes
            let idx i64: scopes.len().take(1)
            let scope Scope: scopes.at(idx)
            let symbols Array<SymbolEntry>: scope.symbols
            let entry SymbolEntry: { name: name, typeName: typeName }
            symbols.add(entry)
        }

        // ─── Symbol lookup ────────────────────────────────────────────────────

        // lookupSymbolAt — walks the parent chain from scope[idx].
        // Returns the nearest binding, or "" when the chain is exhausted (parent = -1).
        fn lookupSymbolAt(name String, idx i64) String {
            let scopes Array<Scope>: this.scopes
            return match idx.gte(0) {
                true: match scopes.at(idx).lookup(name).equals("") {
                    true: this.lookupSymbolAt(name, scopes.at(idx).parent)
                    _: scopes.at(idx).lookup(name)
                }
                _: ""
            }
        }

        // lookupSymbol — starts from the innermost scope.
        fn lookupSymbol(name String) String {
            let scopes Array<Scope>: this.scopes
            let idx i64: scopes.len().take(1)
            return this.lookupSymbolAt(name, idx)
        }

        // existsInCurrentScope — checks only the innermost scope (for duplicate-let detection).
        fn existsInCurrentScope(name String) bool {
            let scopes Array<Scope>: this.scopes
            let idx i64: scopes.len().take(1)
            let scope Scope: scopes.at(idx)
            return not scope.lookup(name).equals("")
        }

        // ─── Sum type variant registry ────────────────────────────────────────

        // recordSumType — register a sum type and its variant names.
        fn recordSumType(name String, variants Array<String>) {
            let semVariants Array<SemFieldEntry>: []
            let vi i64: 0
            while vi.lt(variants.len()) {
                let v String: variants.at(vi)
                let entry SemFieldEntry: { name: v, typeName: v }
                semVariants.add(entry)
                vi: vi.add(1)
            }
            let sumTypes Array<SemTypeEntry>: this.sumTypes
            let noMethods Array<SemMethodEntry>: []
            let teEntry SemTypeEntry: { name: name, fields: semVariants, methods: noMethods, privateFieldNames: [], privateMethodNames: [], isCType: false, isExternType: false, hasCustomLifecycle: false }
            sumTypes.add(teEntry)
        }

        // isSumVariant — true when `candidate` is a declared variant of sum type `sumName`.
        fn isSumVariant(sumName String, candidate String) bool {
            return isSumVariantAt(this.sumTypes, sumName, candidate, 0)
        }

        // ─── Move tracking ────────────────────────────────────────────────────

        // isMoved — returns true if `name` has been moved and not yet re-bound.
        fn isMoved(name String) bool {
            return isMovedAt(this.movedVars, name, 0)
        }

        // markMoved — records that `name` has been moved in the current function.
        fn markMoved(name String) {
            let moved Array<String>: this.movedVars
            moved.add(name)
        }

        // clearMoved — removes `name` from movedVars (called on re-binding or re-assignment).
        fn clearMoved(name String) {
            let empty Array<String>: []
            this.movedVars: clearMovedAt(this.movedVars, empty, name, 0)
        }

        // resetMovedVars — clears all move state; called at the start of each function body.
        fn resetMovedVars() {
            let empty Array<String>: []
            this.movedVars: empty
        }

        // ─── Error accumulation ───────────────────────────────────────────────

        fn addError(message String, line i64, col i64) {
            let errors Array<AnalysisError>: this.errors
            let err AnalysisError: { message: message, line: line, col: col, srcPath: this.currentSrcPath }
            errors.add(err)
        }
    }
    state.pushScope()
    return state
}

// ─── Scope constructor ────────────────────────────────────────────────────────

fn newScope(parent i64) Scope {
    return {
        symbols: [],
        parent: parent,

        // lookup — linear search.
        // Returns the typeName of the first matching entry, or "" when exhausted.
        fn lookup(name String) String {
            let idx i64: 0
            while idx.lt(this.symbols.len()) {
                if this.symbols.at(idx).name.equals(name) {
                    return this.symbols.at(idx).typeName
                }
                idx: idx.add(1)
            }
            return ""
        }
    }
}

// ─── Private sum type helpers ─────────────────────────────────────────────────

// sumHasVariantAt — linear search through a sum type's variant rows.
fn sumHasVariantAt(variants Array<SemFieldEntry>, candidate String, i i64) bool {
    return match i.lt(variants.len()) {
        true: match variants.at(i).name.equals(candidate) {
            true: true
            _: sumHasVariantAt(variants, candidate, i.add(1))
        }
        _: false
    }
}

// isSumVariantAt — linear search through state.sumTypes for `sumName`, then
// check whether `candidate` is one of its variants.
fn isSumVariantAt(sumTypes Array<SemTypeEntry>, sumName String, candidate String, i i64) bool {
    return match i.lt(sumTypes.len()) {
        true: match sumTypes.at(i).name.equals(sumName) {
            true: sumHasVariantAt(sumTypes.at(i).fields, candidate, 0)
            _: isSumVariantAt(sumTypes, sumName, candidate, i.add(1))
        }
        _: false
    }
}

// ─── Private move-tracking helpers ───────────────────────────────────────────

// isMovedAt — linear scan of movedVars from index i.
fn isMovedAt(moved Array<String>, name String, i i64) bool {
    if not i.lt(moved.len()) { return false }
    if moved.at(i).equals(name) { return true }
    return isMovedAt(moved, name, i.add(1))
}

// clearMovedAt — rebuilds movedVars without `name`, from index i.
fn clearMovedAt(src Array<String>, dst Array<String>, name String, i i64) Array<String> {
    if not i.lt(src.len()) { return dst }
    if not src.at(i).equals(name) { dst.add(src.at(i)) }
    return clearMovedAt(src, dst, name, i.add(1))
}

// ─── Per-module import helpers ────────────────────────────────────────────────

// currentModuleHasImport — returns true if the namespace `ns` appears in the
// current module's import list (state.currentModuleImports).  Called from
// resolveTypes.suru to gate compiler intrinsics (typeSize, ptrLoad, ptrStore)
// behind an explicit per-module import, not a root-only global flag.
fn currentModuleHasImport(importedNs Array<String>, ns String) bool {
    let i i64: 0
    while i.lt(importedNs.len()) {
        if importedNs.at(i).equals(ns) { return true }
        i: i.add(1)
    }
    return false
}

// lookupModuleImports — find the importedNs list for a given srcPath in the
// registry.  Returns [] if srcPath is not found (covers synthetic nodes with
// no source file, such as injected object-lowering stubs).
fn lookupModuleImports(registry Array<SrcModImports>, srcPath String) Array<String> {
    let i i64: 0
    while i.lt(registry.len()) {
        if registry.at(i).srcPath.equals(srcPath) { return registry.at(i).importedNs }
        i: i.add(1)
    }
    let empty Array<String>: []
    return empty
}
