// Semantic Analyzer: Expression Analysis
//
// Implements inferType and analyzeExpr, the expression-analysis layer that
// completes the semantic analyzer.
//
// Key design decisions:
//   - inferType returns a String type name ("bool", "i64", etc.) or "" for
//     unknown/context-dependent types (array/object literals, field access).
//     The "" return suppresses type-mismatch errors rather than reporting false positives.
//
//   - Namespace alias detection: when a MethodCallNode receiver is a VarRefNode
//     whose name is not in scope and not a static builtin type receiver
//     (i32/i64/f64/bool), the receiver is assumed to be a namespace alias
//     (e.g. `semantic.pushScope`). The call is silently skipped — no "undefined
//     variable" error and no arity check.
//
//   - Inside match arms, typed intermediate variables (`let typed XNode: expr`)
//     give the specific variant type so @suru_variant_inner is called before
//     @suru_find_field, making field access work correctly.
//
//   - All function names are unique across the semantic analyzer files to
//     avoid LLVM link-time symbol collisions (each .suru compiles to its own .o).

namespace Suru.Compiler.Semantic.Exprs

import {
    semantic: Suru.Compiler.Semantic
    passes: Suru.Compiler.Semantic.Passes
    assign: Suru.Compiler.Semantic.Assignable
    ntype: Suru.Compiler.Semantic.NodeType
    tyh: Suru.Compiler.Codegen.TypeHelpers
}

// ─── Type inference ───────────────────────────────────────────────────────────

// inferTypeFromMethod — infers the return type of a MethodCallNode from its
// method name and, for "from" conversions, the static receiver name.
// Mirrors the MethodCallExpression cases in InferType (SemanticAnalyzer.cs:483–506).
export fn inferTypeFromMethod(state AnalyzerState, expr MethodCallNode) String {
    let m String: expr.methodName
    match m {
        "compare": { return "i64" }
        "len":     { return "i64" }
        "ord":     { return "i64" }
        _: {}
    }
    match m {
        "equals": { return "bool" }
        "lt":     { return "bool" }
        "gt":     { return "bool" }
        "lte":    { return "bool" }
        "gte":    { return "bool" }
        _: {}
    }
    if m.equals("toString") { return "String" }
    if m.equals("__append") { return "String" }
    if m.equals("__at")     { return "char" }
    if m.equals("from") {
        let rcv AstNode: expr.receiver
        match rcv {
            VarRefNode: {
                let typedRcv VarRefNode: rcv
                let rcvName String: typedRcv.name
                if rcvName.equals("i32")   { return "i32" }
                if rcvName.equals("i64")   { return "i64" }
                if rcvName.equals("f64")   { return "f64" }
            }
            _: {}
        }
        return ""
    }
    return ""
}

// inferTypeFromFirstArm — returns the inferred type of the first arm's body, or "".
// All arms are expected to be the same type, so the first concrete arm is sampled.
fn inferTypeFromFirstArm(state AnalyzerState, arms Array<MatchArm>) String {
    if arms.len().gt(0) { return inferType(state, arms.at(0).body) }
    return ""
}

// inferType — infers the type of an expression node as a String type name.
// Returns "" for unknowns rather than reporting errors.
// Mirrors InferType in SemanticAnalyzer.cs:456–517.
export fn inferType(state AnalyzerState, expr AstNode) String {
    match expr {
        BoolLitNode:    { return "bool"    }
        IntLitNode:     { return "i64"   }
        FloatLitNode:   { return "f64" }
        StrLitNode:     { return "String"  }
        CharLitNode:    { return "char"    }
        VarRefNode: {
            let typed VarRefNode: expr
            return state.lookupSymbol(typed.name)
        }
        UnaryNode:  { return "bool" }
        BinaryNode: { return "bool" }
        MethodCallNode: {
            let typed MethodCallNode: expr
            return inferTypeFromMethod(state, typed)
        }
        CallNode: {
            let typed CallNode: expr
            let name String: typed.name
            if name.equals("readFile") { return "String" }
            if name.equals("move") {
                let args Array<AstNode>: typed.args
                if args.len().equals(1) {
                    match args.at(0) {
                        VarRefNode: {
                            let typedArg VarRefNode: args.at(0)
                            return state.lookupSymbol(typedArg.name)
                        }
                        _: {}
                    }
                }
                return ""
            }
            return state.functions.returnType(name)
        }
        MatchExprNode: {
            let typed MatchExprNode: expr
            let arms Array<MatchArm>: typed.arms
            return inferTypeFromFirstArm(state, arms)
        }
        _: {}
    }
    return ""
}

// ─── Expression recursion helpers ─────────────────────────────────────────────

// analyzeExprAt — iterates an Array<AstNode>, calling analyzeExpr on each.
fn analyzeExprAt(state AnalyzerState, nodes Array<AstNode>) AnalyzerState {
    let i i64: 0
    while i.lt(nodes.len()) {
        analyzeExpr(state, nodes.at(i))
        i: i.add(1)
    }
    return state
}

// analyzeMatchArmsAt — iterates MatchArm array. Analyzes each arm body, and the
// arm pattern only when it is a value expression (literal). A bare-identifier
// pattern (VarRefNode) is a sum-type variant tag, NOT a variable reference, so it
// is skipped — analyzing it as an expression would wrongly report the variant
// name as an undefined variable. Wildcard arms carry no pattern.
fn analyzeMatchArmsAt(state AnalyzerState, arms Array<MatchArm>) AnalyzerState {
    let i i64: 0
    while i.lt(arms.len()) {
        let arm MatchArm: arms.at(i)
        if not arm.isWildcard and not isVariantTagPattern(arm.pattern) {
            analyzeExpr(state, arm.pattern)
        }
        analyzeExpr(state, arm.body)
        i: i.add(1)
    }
    return state
}

// isVariantTagPattern — true when a match arm pattern is a bare identifier
// (VarRefNode), i.e. a sum-type variant tag rather than a value literal.
fn isVariantTagPattern(pattern AstNode) bool {
    match pattern {
        VarRefNode: { return true }
        _:          { return false }
    }
}

// isSumTypeName — true when `name` is a registered sum type (membership in
// state.sumTypes, which only ever holds sum types).
fn isSumTypeName(state AnalyzerState, name String) bool {
    let sums Array<SemTypeEntry>: state.sumTypes
    let i i64: 0
    while i.lt(sums.len()) {
        if sums.at(i).name.equals(name) { return true }
        i: i.add(1)
    }
    return false
}

// analyzeObjectFieldsAt — iterates ObjectFieldNode array,
// calling analyzeExpr on each field's value expression.
fn analyzeObjectFieldsAt(state AnalyzerState, fields Array<ObjectFieldNode>) AnalyzerState {
    let i i64: 0
    while i.lt(fields.len()) {
        analyzeExpr(state, fields.at(i).value)
        i: i.add(1)
    }
    return state
}

// inferTypeForMismatchCheck — inferType, but returns "" (unknown → skip) for the
// expression kinds whose inferred type is a heuristic that is unreliable for
// user-defined types, so a value-flow mismatch check never rejects valid code on
// a guessed type:
//   - MethodCallNode: inferTypeFromMethod hardcodes toString→String, equals→bool,
//     len→i64, … which is correct for builtins but WRONG for user methods
//     (e.g. StringBuilder.toString() actually returns SuruString). Resolving the
//     true return type needs receiver-type + method-signature lookup, which the
//     heuristic does not do.
//   - MatchExprNode: its type is sampled from the first arm's body, which may
//     itself be one of the unreliable kinds.
// This wrapper is used ONLY by the mismatch checks; inferType itself (and the
// codegen resolvedType path in resolveTypes.suru) is unchanged. Reliable kinds
// (literals, VarRefNode → symbol table, CallNode → function registry) flow
// through, so free-function return mismatches — the class that caused the
// List<Token>/Array<Token> segfault — are still caught.
export fn inferTypeForMismatchCheck(state AnalyzerState, expr AstNode) String {
    match expr {
        MethodCallNode: { return "" }
        MatchExprNode:  { return "" }
        _: {}
    }
    return inferType(state, expr)
}

// The value-flow assignability predicate (`isAssignable`) lives in
// semantic/assignable.suru — it is imported here as `assign.isAssignable` and used
// by the two call-argument checks below. It moved out in §3.4 when it stopped
// comparing canonicalized type STRINGS and started comparing structured `Type`
// values; see that file's header for the full rule set.

// checkCallArgTypesAt — validates argument types against declared parameter
// types for function fnName.
// Emits "argument type mismatch: expected X, got Y" when both types are known
// and do not match (and the actual type is not a sum-type variant of expected).
fn checkCallArgTypesAt(state AnalyzerState, fnName String, args Array<AstNode>, callLine i64, callCol i64) AnalyzerState {
    // Ambiguous across modules: the flat registry can't pick the right signature,
    // so skip arg typing rather than compare against an arbitrary one.
    if state.functions.nameCount(fnName).gt(1) { return state }
    let i i64: 0
    while i.lt(args.len()) {
        let expected String: state.functions.paramType(fnName, i)
        let argType String: inferType(state, args.at(i))
        if not expected.equals("") and not argType.equals("") and not assign.isAssignable(state, expected, argType) {
            state.addError("argument type mismatch: expected ".append(expected).append(", got ").append(argType), callLine, callCol)
        }
        i: i.add(1)
    }
    return state
}

// checkFnCallArgTypes — argument type checking for a plain function CallNode
// (e.g. `f(x)`), the companion to checkCallArgTypesAt's method-call path. Plain
// calls used to skip argument typing entirely, so passing the wrong type (e.g. a
// String where an i64 is expected) slipped through to a runtime crash. Uses the
// argument's resolved type (resolveTypes narrows each arg to the i-th parameter
// type, so integer literals don't spuriously read as i64) against the declared
// parameter type. Builtins and unknown functions have no paramType entry → "" →
// skipped by isAssignable.
fn checkFnCallArgTypes(state AnalyzerState, fnName String, args Array<AstNode>, callLine i64, callCol i64) AnalyzerState {
    // Ambiguous across modules: see checkCallArgTypesAt.
    if state.functions.nameCount(fnName).gt(1) { return state }
    let i i64: 0
    while i.lt(args.len()) {
        let paramAnn String: state.functions.paramType(fnName, i)
        let expected String: tyh.makeSuruType(paramAnn)
        let actual String: ntype.nodeResolvedType(args.at(i))
        if not assign.isAssignable(state, expected, actual) {
            state.addError("argument type mismatch: expected ".append(paramAnn).append(", got ").append(actual), callLine, callCol)
        }
        i: i.add(1)
    }
    return state
}

// ─── Expression analysis ──────────────────────────────────────────────────────

fn isBuiltinTypeName(name String) bool {
    return name.equals("i32")
        or name.equals("i64")
        or name.equals("f64")
        or name.equals("bool")
        or name.equals("char")
        or name.equals("String")
        or name.equals("Str")
        or name.equals("Array")
}

// analyzeExpr — analyzes one expression node, mutating state.errors for any
// semantic violations found. Recurses into sub-expressions.
//
// Mirrors AnalyzeExpression in SemanticAnalyzer.cs:285–451.
//
// Namespace alias heuristic: a MethodCallNode whose receiver is a VarRefNode
// not in scope and not a static builtin type is treated as a namespace call.
// The receiver is silently skipped — no "undefined variable" error.
export fn analyzeExpr(state AnalyzerState, expr AstNode) AnalyzerState {
    match expr {
        VarRefNode: {
            let typed VarRefNode: expr
            let name String: typed.name
            let inScope bool: not state.lookupSymbol(name).equals("")
            if not isBuiltinTypeName(name) and not inScope {
                state.addError("undefined variable '".append(name).append("'"), typed.line, typed.col)
            }
            if inScope and state.isMoved(name) {
                state.addError("variable '".append(name).append("' has been moved"), typed.line, typed.col)
            }
        }

        MethodCallNode: {
            let typed MethodCallNode: expr
            let rcv AstNode: typed.receiver
            match rcv {
                VarRefNode: {
                    let typedRcv VarRefNode: rcv
                    let rcvName String: typedRcv.name
                    let isStaticRcv bool: rcvName.equals("i32")
                        or rcvName.equals("i64")
                        or rcvName.equals("f64")
                        or rcvName.equals("bool")
                    let rcvInScope bool: not state.lookupSymbol(rcvName).equals("")
                    if not isStaticRcv and not rcvInScope {
                        let args Array<AstNode>: typed.args
                        analyzeExprAt(state, args)
                        checkCallArgTypesAt(state, typed.methodName, args, typed.line, typed.col)
                    } else {
                        analyzeExpr(state, rcv)
                        analyzeExprAt(state, typed.args)
                    }
                }
                QualifiedNameNode: {
                    // Desugared import alias: lib.fn(args) → MethodCallNode{QualNS,fn,args}.
                    // Mirror the VarRefNode namespace-alias branch: analyze args and check types.
                    analyzeExprAt(state, typed.args)
                    checkCallArgTypesAt(state, typed.methodName, typed.args, typed.line, typed.col)
                }
                _: {
                    analyzeExpr(state, rcv)
                    analyzeExprAt(state, typed.args)
                    checkCallArgTypesAt(state, typed.methodName, typed.args, typed.line, typed.col)
                }
            }
        }

        CallNode: {
            let typed CallNode: expr
            let name String: typed.name
            let args Array<AstNode>: typed.args
            let argCount i64: args.len()
            let is1ArgBuiltin bool: name.equals("printLn") or name.equals("printError") or name.equals("exit") or name.equals("readFile") or name.equals("clone") or name.equals("drop") or name.equals("exec") or name.equals("move")
            if is1ArgBuiltin and not argCount.equals(1) {
                state.addError("'".append(name).append("' expects exactly 1 argument"), typed.line, typed.col)
            }
            let is2ArgBuiltin bool: name.equals("writeFile") or name.equals("appendToFile")
            if is2ArgBuiltin and not argCount.equals(2) {
                state.addError("'".append(name).append("' expects exactly 2 arguments"), typed.line, typed.col)
            }
            // Undefined function: a non-builtin name with no definition anywhere in
            // the registry (no exact match and no monomorphized instantiation).
            // Reported before the arity/arg-type checks so an unknown name yields
            // one clear diagnostic rather than a misleading arity message. This
            // catches calls that mono left unmangled because the template was
            // removed and could NOT be instantiated (e.g. an un-inferable
            // `newList()`), which otherwise slipped through pass-3 and failed later
            // at link time. Extern fns and normal/imported fns match exactly; a
            // generic call site keeps its base name and is accepted via its
            // concrete `name__T` instantiation (see FunctionRegistry.isDefined).
            let isBuiltin bool: is1ArgBuiltin or is2ArgBuiltin
            if not isBuiltin and not state.functions.isDefined(name) {
                state.addError("undefined function '".append(name).append("'"), typed.line, typed.col)
            }
            let paramCount i64: state.functions.paramCount(name)
            if not is1ArgBuiltin and not is2ArgBuiltin and paramCount.gte(0) and not argCount.equals(paramCount) {
                state.addError("function '".append(name).append("' called with ").append(argCount.toString()).append(" argument(s), expected ").append(paramCount.toString()), typed.line, typed.col)
            }
            checkFnCallArgTypes(state, name, args, typed.line, typed.col)
            let isCloneOrDrop bool: name.equals("clone") or name.equals("drop")
            if isCloneOrDrop and argCount.equals(1) {
                match args.at(0) {
                    VarRefNode: {
                        let cva VarRefNode: args.at(0)
                        let cvt String: state.lookupSymbol(cva.name)
                        if passes.isCTypeNamed(state, cvt) {
                            state.addError("cannot call ".append(name).append("() on cType '").append(cvt).append("' (no type_tag); free it manually via an extern fn"), typed.line, typed.col)
                        } else if passes.isExternTypeNamed(state, cvt) {
                            state.addError("cannot call ".append(name).append("() on extern type '").append(cvt).append("' (no type_tag); free it manually via an extern fn"), typed.line, typed.col)
                        } else if cvt.equals("ptr") {
                            state.addError("cannot call ".append(name).append("() on 'ptr' (unmanaged pointer; free it manually via an extern fn)"), typed.line, typed.col)
                        }
                    }
                    _: {}
                }
            }
            if name.equals("move") and argCount.equals(1) {
                match args.at(0) {
                    VarRefNode: {
                        let typedArg VarRefNode: args.at(0)
                        if state.isMoved(typedArg.name) {
                            state.addError("variable '".append(typedArg.name).append("' has already been moved"), typedArg.line, typedArg.col)
                        }
                        state.markMoved(typedArg.name)
                    }
                    _: {
                        state.addError("move() argument must be a variable", typed.line, typed.col)
                        analyzeExprAt(state, args)
                    }
                }
            } else {
                analyzeExprAt(state, args)
            }
        }

        MatchExprNode: {
            let typed MatchExprNode: expr
            let cond AstNode: typed.condition
            analyzeExpr(state, cond)
            let condType String: inferType(state, cond)
            // A sum-type subject is valid too; its arm patterns are variant tag
            // names, so check only the arm bodies (see analyzeMatchArmBodiesAt).
            let isSum bool: isSumTypeName(state, tyh.makeSuruType(condType)) or isSumTypeName(state, condType)
            let isScalarCondType bool: condType.equals("") or condType.equals("bool") or condType.equals("i64") or condType.equals("f64") or condType.equals("String") or condType.equals("Str") or condType.equals("char") or condType.equals("SuruString")
            if not isScalarCondType and not isSum {
                state.addError("match condition must be bool, i64, f64, String, SuruString, char, or a sum type, got ".append(condType), typed.line, typed.col)
            }
            analyzeMatchArmsAt(state, typed.arms)
        }

        FieldAccessNode: {
            let typed FieldAccessNode: expr
            analyzeExpr(state, typed.receiver)
        }

        ArrayLitNode: {
            let typed ArrayLitNode: expr
            let elems Array<AstNode>: typed.elems
            analyzeExprAt(state, elems)
            // Element type-mismatch: compare each element's inferred type against
            // the element type resolveTypes annotated on the literal ("Array:T").
            // resolvedType folds in any surrounding annotation context (e.g.
            // `let a Array<i64>: [...]`), so a wrong-but-homogeneous literal is
            // still caught. Element nodes carry no line/col → report at 0,0.
            let elemType String: ""
            if tyh.isArraySuruType(typed.resolvedType) { elemType: tyh.elemSuruType(typed.resolvedType) }
            let ei i64: 0
            while ei.lt(elems.len()) {
                let actual String: ntype.nodeResolvedType(elems.at(ei))
                if not assign.isAssignable(state, elemType, actual) {
                    state.addError("array element type mismatch: expected ".append(elemType).append(", got ").append(actual), 0, 0)
                }
                ei: ei.add(1)
            }
        }

        ObjectLitNode: {
            let typed ObjectLitNode: expr
            let fields Array<ObjectFieldNode>: typed.fields
            analyzeObjectFieldsAt(state, fields)
            // Struct-literal field type-mismatch: look up each data field's
            // declared type on the resolved struct type and compare against the
            // field value's inferred type. Method fields are skipped.
            let typeName String: typed.resolvedType
            let fi i64: 0
            while fi.lt(fields.len()) {
                let field ObjectFieldNode: fields.at(fi)
                if not field.isMethod {
                    let annot String: state.lookupFieldType(typeName, field.name)
                    let expectedFieldType String: tyh.makeSuruType(annot)
                    let actual String: ntype.nodeResolvedType(field.value)
                    if not assign.isAssignable(state, expectedFieldType, actual) {
                        state.addError("struct literal field '".append(field.name).append("' type mismatch: expected ").append(annot).append(", got ").append(actual), typed.line, typed.col)
                    }
                }
                fi: fi.add(1)
            }
        }

        UnaryNode: {
            let typed UnaryNode: expr
            analyzeExpr(state, typed.operand)
        }

        BinaryNode: {
            let typed BinaryNode: expr
            analyzeExpr(state, typed.left)
            analyzeExpr(state, typed.right)
        }

        _: {}
    }
    return state
}
