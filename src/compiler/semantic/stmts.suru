// Semantic Analyzer: Statement Analysis
//
// Implements statement-level analysis over an Array<AstNode>.
//
// Provided analyzers:
//   analyzeLetStatement          — duplicate check, type resolution, constant marking
//   analyzeAssignmentStatement   — constant-reassign check, undefined-variable check
//   analyzeFieldAssignmentStatement — undefined receiver check (VarRef receivers only)
//   analyzeReturnStatement       — bare return in non-void function check
//   analyzeWhileStatement        — push scope, analyze body, pop scope
//   analyzeStatements            — iterate an Array<AstNode> and dispatch each
//   analyzeStatement             — dispatch over AstNode statement variants
//
// All analysis is done through in-place mutation of heap-allocated arrays inside
// AnalyzerState. Functions return state for caller convenience; callers may
// discard the return value since mutations are visible through the original reference.
//
// Each handler takes the specific AstNode variant type; the sum type dispatch in
// analyzeStatement coerces the AstNode ptr to the variant ptr at the call site.
// Field access on variant types calls @suru_variant_inner before @suru_find_field.

include "semantic.suru" as semantic
include "passes.suru" as passes
include "exprs.suru" as exprs

// ─── Constants array helpers ──────────────────────────────────────────────────

// isConstantAt — recursive linear search from index i.
fn isConstantAt(constants Array<String>, name String, i Int64) Bool {
    if not i.lt(constants.len()) { return false }
    if constants.at(i).equals(name) { return true }
    return isConstantAt(constants, name, i.add(1))
}

// isConstant — true when name is in state.constants (module-level constant).
fn isConstant(state AnalyzerState, name String) Bool {
    let constants Array<String>: state.constants
    return isConstantAt(constants, name, 0)
}

// addConstant — appends name to state.constants.
fn addConstant(state AnalyzerState, name String) AnalyzerState {
    let constants Array<String>: state.constants
    constants.add(name)
    return state
}

// markConstantIfModuleScope — adds name to constants only when currently at
// module scope (scopes.len() == 1) and the let was not a duplicate declaration.
// Duplicate lets are skipped to avoid registering an invalid constant name that
// would later produce a spurious "cannot reassign constant" error.
fn markConstantIfModuleScope(state AnalyzerState, name String, isDuplicate Bool) AnalyzerState {
    let scopes Array<Scope>: state.scopes
    if scopes.len().equals(1) and not isDuplicate { addConstant(state, name) }
    return state
}

// ─── Statement analyzers ──────────────────────────────────────────────────────

// checkBareReturn — emits an error when state.currentReturnType indicates a
// non-void function context.
fn checkBareReturn(state AnalyzerState) AnalyzerState {
    let isVoid Bool: state.currentReturnType.equals("void") or state.currentReturnType.equals("")
    if not isVoid { semantic.addError(state, "bare 'return' in non-void function") }
    return state
}

// analyzeLetStatement — mirrors SemanticAnalyzer.AnalyzeLetStatement (lines 167–186).
//
// Order of checks:
//   1. Duplicate in current scope → error, skip declaration.
//   2. Type resolution via resolveTypeName → declare or emit unknown-type error.
//   3. Module scope → mark as constant (regardless of unknown-type).
//
// stmt fields: stmt.name (String), stmt.typeName (String), stmt.value (AstNode).
fn analyzeLetStatement(state AnalyzerState, stmt LetNode) AnalyzerState {
    let isDuplicate Bool: semantic.existsInCurrentScope(state, stmt.name)
    if isDuplicate { semantic.addError(state, "variable '".append(stmt.name).append("' is already declared")) }
    let typeResolved Bool: passes.resolveTypeName(state, stmt.typeName)
    if not isDuplicate and typeResolved { semantic.declareSymbol(state, stmt.name, stmt.typeName) }
    if not isDuplicate and not typeResolved {
        semantic.addError(state, "unknown type '".append(stmt.typeName).append("' for variable '").append(stmt.name).append("'"))
    }
    markConstantIfModuleScope(state, stmt.name, isDuplicate)
    let val AstNode: stmt.value
    exprs.analyzeExpr(state, val)
    return state
}

// analyzeAssignmentStatement — mirrors SemanticAnalyzer.AnalyzeAssignmentStatement
// (lines 150–157). Constant reassignment takes priority over undefined-variable check.
fn analyzeAssignmentStatement(state AnalyzerState, stmt AssignNode) AnalyzerState {
    let isConst Bool: isConstant(state, stmt.name)
    if isConst { semantic.addError(state, "cannot reassign constant '".append(stmt.name).append("'")) }
    let isDefined Bool: not semantic.lookupSymbol(state, stmt.name).equals("")
    if not isConst and not isDefined {
        semantic.addError(state, "undefined variable '".append(stmt.name).append("'"))
    }
    let val AstNode: stmt.value
    exprs.analyzeExpr(state, val)
    return state
}

// analyzeFieldAssignmentStatement — mirrors SemanticAnalyzer.AnalyzeFieldAssignmentStatement
// (lines 159–165). Only checks the receiver when it is a VarRefNode.
fn analyzeFieldAssignmentStatement(state AnalyzerState, stmt FieldAssignNode) AnalyzerState {
    let val AstNode: stmt.value
    exprs.analyzeExpr(state, val)
    let rcv AstNode: stmt.receiver
    match rcv {
        VarRefNode: {
            let typedRcv VarRefNode: rcv
            if semantic.lookupSymbol(state, typedRcv.name).equals("") {
                semantic.addError(state, "undefined variable '".append(typedRcv.name).append("'"))
            }
        }
        _: {}
    }
    return state
}

// analyzeReturnStatement — mirrors SemanticAnalyzer.AnalyzeReturnStatement (lines 207–224).
//
// When hasValue is true: analyze the return expression; check return type mismatch
// when both the inferred type and the declared return type are known (non-"").
// When hasValue is false (bare return): check bare-return-in-non-void.
//
// IMPORTANT: test ReturnNodes with hasValue: true must include a valid AstNode
// value — analyzeExpr will be called on it.
fn analyzeReturnStatement(state AnalyzerState, stmt ReturnNode) AnalyzerState {
    if stmt.hasValue {
        let val AstNode: stmt.value
        exprs.analyzeExpr(state, val)
        let retType String: exprs.inferType(state, val)
        let expected String: state.currentReturnType
        let typesKnown Bool: not retType.equals("") and not expected.equals("") and not expected.equals("void")
        let assignable Bool: retType.equals(expected) or semantic.isSumVariant(state, expected, retType)
        if typesKnown and not assignable {
            semantic.addError(state, "return type mismatch: expected ".append(expected).append(", got ").append(retType))
        }
    } else {
        checkBareReturn(state)
    }
    return state
}

// analyzeStatements — iterates stmts in order, dispatching each to analyzeStatement.
// Mutually recursive with analyzeWhileStatement: while bodies are analyzed by
// calling back into analyzeStatements, enabling arbitrarily nested loops.
fn analyzeStatements(state AnalyzerState, stmts Array<AstNode>) AnalyzerState {
    let i Int64: 0
    while i.lt(stmts.len()) {
        analyzeStatement(state, stmts.at(i))
        i: i.add(1)
    }
    return state
}

// analyzeWhileStatement — mirrors SemanticAnalyzer.AnalyzeWhileStatement (lines 153–163).
fn analyzeWhileStatement(state AnalyzerState, stmt WhileNode) AnalyzerState {
    let cond AstNode: stmt.condition
    exprs.analyzeExpr(state, cond)
    let condType String: exprs.inferType(state, cond)
    if not condType.equals("") and not condType.equals("Bool") {
        semantic.addError(state, "while condition must be Bool, got ".append(condType))
    }
    semantic.pushScope(state)
    let body Array<AstNode>: stmt.body
    analyzeStatements(state, body)
    semantic.popScope(state)
    return state
}

// analyzeIfStatement — type-check the condition and analyze each branch in its own scope.
//
// Mirrors analyzeWhileStatement's scope discipline:
//   1. Analyze + type-check condition; emit error if inferred type is non-empty and not Bool.
//   2. Push scope, analyze thenBranch.stmts, pop scope.
//   3. If elseBranch.stmts is non-empty, repeat the push/analyze/pop for the else branch.
//
// elseBranch.stmts empty means there is no else clause (parser convention from
// parserAst.suru) — skip the second scope/analyze pair entirely.
//
// else-if chains arrive here as elseBranch.stmts = [IfNode]; the recursive
// analyzeStatements → analyzeStatement → analyzeIfStatement handles them naturally.
fn analyzeIfStatement(state AnalyzerState, stmt IfNode) AnalyzerState {
    let cond AstNode: stmt.condition
    exprs.analyzeExpr(state, cond)
    let condType String: exprs.inferType(state, cond)
    if not condType.equals("") and not condType.equals("Bool") {
        semantic.addError(state, "if condition must be Bool, got ".append(condType))
    }
    let thenBlock BlockNode: stmt.thenBranch
    let thenStmts Array<AstNode>: thenBlock.stmts
    semantic.pushScope(state)
    analyzeStatements(state, thenStmts)
    semantic.popScope(state)

    let elseBlock BlockNode: stmt.elseBranch
    let elseStmts Array<AstNode>: elseBlock.stmts
    if elseStmts.len().gt(0) {
        semantic.pushScope(state)
        analyzeStatements(state, elseStmts)
        semantic.popScope(state)
    }
    return state
}

// analyzeStatement — dispatch over AstNode statement variants.
// Mirrors SemanticAnalyzer.AnalyzeStatement (lines 101–136).
//
// TypeDeclNode, SumTypeDeclNode, and FnDeclNode are handled by pre-passes.
// All other statement variants fall through to _:{}.
fn analyzeStatement(state AnalyzerState, stmt AstNode) AnalyzerState {
    match stmt {
        LetNode:         { analyzeLetStatement(state, stmt) }
        AssignNode:      { analyzeAssignmentStatement(state, stmt) }
        FieldAssignNode: { analyzeFieldAssignmentStatement(state, stmt) }
        ReturnNode:      { analyzeReturnStatement(state, stmt) }
        WhileNode:       { analyzeWhileStatement(state, stmt) }
        IfNode:          { analyzeIfStatement(state, stmt) }
        ExprStmtNode: {
            let typed ExprStmtNode: stmt
            let innerExpr AstNode: typed.expr
            exprs.analyzeExpr(state, innerExpr)
        }
        _: {}
    }
    return state
}
