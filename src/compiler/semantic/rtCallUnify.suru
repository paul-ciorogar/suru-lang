namespace Suru.Compiler.Semantic.ResolveCallUnify

import {
    ast: Suru.Compiler.Parser.Ast
    [Type, Prim, Named, primType]: Suru.Compiler.Types
    [parseType]: Suru.Compiler.Types.Parse
    [printSuruType]: Suru.Compiler.Types.Print
    [unify, UnifyResult, substitute, varizeType, Binding, binding]: Suru.Compiler.Types.Ops
}

fn rtIsNoExpect(t Type) bool {
    match t {
        Prim: {
            let p Prim: t
            return p.name.equals("")
        }
        _: {}
    }
    return false
}

fn rtHasBinding(bindings Array<Binding>, name String) bool {
    let i i64: 0
    while i.lt(bindings.len()) {
        if bindings.at(i).name.equals(name) { return true }
        i: i.add(1)
    }
    return false
}

// rtIsStrPrim — is this solved type argument the borrowed `Str`, i.e. does it need
// normalizing to its OWNED form before being recorded? (String-split B2.)
//
// A type argument names the type stored in a generic's slot, and a generic
// container deep-drops what it stores (`Option<T>`, `List<T>`, `Result<T,E>` all
// clone/drop their payload). So a type-argument slot is an owned slot, and the
// borrowed `Str` can never be a legitimate type argument.
//
// It reaches here because inference reads the ARGUMENT's type, and a string
// literal now infers as `Str`: `res.err("oops")` would bind E := Str and ask
// monomorphization for `err-Str` / `Result-i64-Str` — instantiations that no
// annotation ever names (the declared type is `Result<i64, String>`), so the
// mangled call name and the mangled declaration diverge and the build fails.
// Normalizing at the single point where a binding becomes a recorded type
// argument keeps every caller — return-vs-expected and param-vs-arg alike —
// consistent. The value side is reconciled by B3, which materializes an owned
// heap copy where a `Str` flows into an owned slot.
//
// Only the top level is checked: `Str` is produced solely by literal inference,
// which is always a bare type, never nested inside an application.
fn rtIsStrPrim(t Type) bool {
    match t {
        Prim: {
            let p Prim: t
            return p.name.equals("Str")
        }
        _: {}
    }
    return false
}

fn rtAppendBinding(bindings Array<Binding>, name String, dst Array<Type>) {
    let i i64: 0
    while i.lt(bindings.len()) {
        let b Binding: bindings.at(i)
        if b.name.equals(name) {
            let empty Array<Binding>: []
            let solved Type: substitute(b.ty, empty)
            // Owned-form normalization (see rtIsStrPrim above): the solved Type is
            // replaced, so the discarded one is dropped here rather than leaked.
            if rtIsStrPrim(solved) {
                drop(solved)
                dst.add(primType("String"))
            } else {
                dst.add(solved)
            }
            return
        }
        i: i.add(1)
    }
}

// rtSolveReturnArgs — shared §2.2/§2.3 solver, node-agnostic. Appends one bound
// Type per type-param (declaration order) into `dst` by unifying the varized
// return template against `expectedTy`, and returns the concrete resolved-type
// string (e.g. "List-Token", "Option-i64"). Returns "" and leaves `dst`
// untouched on any miss — no expectation, empty return annotation, unify
// failure, or an unbound type-param — so callers keep their legacy behavior.
//
// Mutation discipline: every type param must bind BEFORE any append, so a
// partial solve never half-fills the node's typeArgs array.
fn rtSolveReturnArgs(dst Array<Type>, expectedTy Type, tparams Array<String>, retAnn String) String {
    // Gate: need a real expectation to solve a (possibly zero-arg) generic.
    if rtIsNoExpect(expectedTy) { return "" }
    if retAnn.equals("") { return "" }

    // Return template: parse the source-form return annotation, then promote the
    // type-param names to type variables, e.g. "List<T>" -> Named List [Var T].
    let retParsed Type: parseType(retAnn)
    let retTmpl Type: varizeType(retParsed, tparams)

    // Solve template vs expected. A zero-param call (e.g. newList) has the
    // return-vs-expected unification as its sole binding source; param-vs-arg
    // unification is left to a later task — when the return doesn't bind every
    // type param we fail closed below.
    let res UnifyResult: unify(retTmpl, expectedTy)
    if not res.ok { return "" }

    // Every type param must be solved; otherwise the recorded args would be
    // incomplete — fail closed (before any mutation) and let mono handle it.
    let allBound bool: true
    let i i64: 0
    while i.lt(tparams.len()) {
        if not rtHasBinding(res.bindings, tparams.at(i)) { allBound: false }
        i: i.add(1)
    }
    if not allBound { return "" }

    // Commit. Append one concrete Type per type param, in declaration order,
    // into the node's existing (parser-initialised empty) typeArgs array — an
    // in-place append, not a whole-array field assignment.
    let j i64: 0
    while j.lt(tparams.len()) {
        rtAppendBinding(res.bindings, tparams.at(j), dst)
        j: j.add(1)
    }

    // Concrete resolved return type, e.g. printSuruType(Named List [Token]) =
    // "List-Token" (the legacy codegen encoding the rest of the pass expects).
    let concrete Type: substitute(retTmpl, res.bindings)
    return printSuruType(concrete)
}

// rtMergeBindings — fold the bindings produced by one unify into an accumulator,
// keeping the first binding seen for each type-param name (later unifications must
// agree; the first-wins rule mirrors the old monoInfer arg scan). Each kept binding
// is deep-copied (substitute with empty bindings) so `acc` owns its Types.
fn rtMergeBindings(acc Array<Binding>, src Array<Binding>) Array<Binding> {
    let i i64: 0
    while i.lt(src.len()) {
        let b Binding: src.at(i)
        if not rtHasBinding(acc, b.name) {
            let empty Array<Binding>: []
            acc.add(binding(b.name.clone(), substitute(b.ty, empty)))
        }
        i: i.add(1)
    }
    return acc
}

// rtRecordArgBindings — §3.2 param-vs-arg type-arg recorder. Binds the callee's
// type params by unifying each declared parameter-type template (varized) against
// the corresponding argument's resolved Type, and — when EVERY type param is bound
// — appends the concrete args, in declaration order, to `dst` (the node's typeArgs).
//
// Unlike rtSolveReturnArgs this deliberately does NOT set resolvedType: it only
// fills the binding monomorphization reads, so the pass's existing resolvedType and
// emitted IR are byte-identical. It is the source for arg-driven generics whose type
// var appears only in a parameter (e.g. `elemBytes<T>(dummy T) i64`) or that are
// called with no return expectation (e.g. `printLn(identity("x"))`) — the cases
// §2.2's return-vs-expected solve left to monomorphization.
//
// No-op when `dst` is already populated (return-vs-expected solved it) or when the
// callee is non-generic. Fails closed (records nothing) when any type param is
// unbound, exactly like the old `allBound` guard.
export fn rtRecordArgBindings(dst Array<Type>, tparams Array<String>, paramAnns Array<String>, argTys Array<Type>) {
    if dst.len().gt(0) { return }
    if tparams.len().equals(0) { return }
    let acc Array<Binding>: []
    let i i64: 0
    while i.lt(argTys.len()) {
        if i.lt(paramAnns.len()) {
            let pTmpl Type: varizeType(parseType(paramAnns.at(i)), tparams)
            let r UnifyResult: unify(pTmpl, argTys.at(i))
            if r.ok { acc: rtMergeBindings(acc, r.bindings) }
        }
        i: i.add(1)
    }
    let allBound bool: true
    let k i64: 0
    while k.lt(tparams.len()) {
        if not rtHasBinding(acc, tparams.at(k)) { allBound: false }
        k: k.add(1)
    }
    if allBound {
        let j i64: 0
        while j.lt(tparams.len()) {
            rtAppendBinding(acc, tparams.at(j), dst)
            j: j.add(1)
        }
    }
    drop(acc)
}

// rtObjectLitRecord — §3.2 recorder for a generic struct/sum-type literal. Unlike
// a call site, an object literal has no type variables to solve: the expected type
// is already concrete (e.g. `let b Box<i64>: { value: 42 }` gives expectedTy =
// Named "Box" [i64]). So this just copies the expected type's args onto the node's
// typeArgs, letting monomorphization read the instantiation (`Box<i64>`) directly
// instead of re-parsing the mangled resolvedType.
//
// Each arg is deep-copied via `substitute(.., empty)` (the rtAppendBinding idiom)
// so the node owns its Types and never aliases expectedTy.  Guarded on an empty
// typeArgs so a node resolved in both pass 1 and pass 2 records exactly once — the
// pass-1 recording is the one mono reads.  A non-Named or arg-less expected type
// (a plain struct like `Point`, or the no-expectation sentinel) records nothing.
export fn rtObjectLitRecord(typed ObjectLitNode, expectedTy Type) {
    if typed.typeArgs.len().gt(0) { return }
    match expectedTy {
        Named: {
            let n Named: expectedTy
            let i i64: 0
            while i.lt(n.args.len()) {
                let empty Array<Binding>: []
                typed.typeArgs.add(substitute(n.args.at(i), empty))
                i: i.add(1)
            }
        }
        _: {}
    }
}

// rtCallUnify — §2.2 entry point for the resolver's CallNode arm. Solves the
// callee's generic type args from the return-vs-expected unification, recording
// them on the node and setting its concrete resolvedType. Returns false (node
// untouched) on a miss so the caller keeps the legacy template-typed fallback.
export fn rtCallUnify(typed CallNode, expectedTy Type, tparams Array<String>, retAnn String) bool {
    let s String: rtSolveReturnArgs(typed.typeArgs, expectedTy, tparams, retAnn)
    if s.equals("") { return false }
    typed.resolvedType: s
    return true
}

// rtMethodUnify — §2.3 entry point for the resolver's MethodCallNode arm. Same
// contract as rtCallUnify, for a namespace-qualified generic function called via
// method syntax (e.g. opt.some(42), whose receiver importPass rewrites to a
// QualifiedNameNode so the call survives as a MethodCallNode).
export fn rtMethodUnify(typed MethodCallNode, expectedTy Type, tparams Array<String>, retAnn String) bool {
    let s String: rtSolveReturnArgs(typed.typeArgs, expectedTy, tparams, retAnn)
    if s.equals("") { return false }
    typed.resolvedType: s
    return true
}
