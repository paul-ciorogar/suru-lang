// pathUtils.suru — Pure path-string helpers shared by the compiler pipeline.
//
// Split out of pipeline.suru so the orchestration file stays focused on
// pipeline stages, not byte-twiddling over '/'.  These helpers depend on
// nothing beyond String/Array builtins, which keeps the import graph acyclic.

namespace Suru.Compiler.PathUtils

export {
    dirName
    baseName
    normalizePath
    fileNameStem
}

// Return the directory prefix of an absolute path (everything up to and
// including the last '/').  Used to resolve relative include paths.
fn dirName(path String) String {
    let i i64: path.len().take(1)
    while i.gte(0) {
        if path.at(i).equals("/") { return path.slice(0, i.add(1)) }
        i: i.take(1)
    }
    return "./"
}

// Return the filename component of a path (everything after the last '/').
fn baseName(path String) String {
    let i i64: path.len().take(1)
    while i.gte(0) {
        if path.at(i).equals("/") { return path.slice(i.add(1), path.len()) }
        i: i.take(1)
    }
    return path
}

// Normalize an absolute path by resolving all "/../" segments.
// Splits on "/" into a segment stack: pushes normal segments, pops on "..".
fn normalizePath(path String) String {
    let parts Array<String>: []
    let i i64: 0
    let segStart i64: 0
    while i.lte(path.len()) {
        let done bool: i.equals(path.len())
        if done {
            parts.add(path.slice(segStart, i))
            i: i.add(1)
        } else {
            if path.at(i).equals("/") {
                parts.add(path.slice(segStart, i))
                segStart: i.add(1)
                i: i.add(1)
            } else { i: i.add(1) }
        }
    }
    let stack Array<String>: []
    let stackLen i64: 0
    let j i64: 0
    while j.lt(parts.len()) {
        let seg String: parts.at(j)
        if seg.equals("..") {
            if stackLen.gt(0) { stackLen: stackLen.take(1) }
        } else {
            if stackLen.lt(stack.len()) { stack.set(seg, stackLen) } else { stack.add(seg) }
            stackLen: stackLen.add(1)
        }
        j: j.add(1)
    }
    let result String: ""
    let k i64: 0
    while k.lt(stackLen) {
        if k.equals(0) { result: stack.at(k) } else { result: result.append("/").append(stack.at(k)) }
        k: k.add(1)
    }
    return result
}

// Strip the extension from a filename component (e.g. "lexer.suru" → "lexer").
// Scans backwards for the last '.'; if none found, returns the name unchanged.
fn fileNameStem(path String) String {
    let name String: baseName(path)
    let i i64: name.len().take(1)
    while i.gte(0) {
        if name.at(i).equals(".") { return name.slice(0, i) }
        i: i.take(1)
    }
    return name
}
