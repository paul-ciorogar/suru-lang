// suru build driver — thin entry point for bin/suru-build.
//
// Delegates the full lex→parse→semantic→codegen→writeFile pipeline to
// pipeline.suru.  See that file for implementation details.
//
// Usage:
//   suru-build <source.suru> <output.ll>

namespace Suru.Compiler.Build

import { pipeline: Suru.Compiler.Pipeline }

fn main(args Array<String>) {
    pipeline.runBuildDriver(args.at(1), args.at(2))
}
