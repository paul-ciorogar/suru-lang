// result.suru — generic Result sum type.
//
// Result<T, E> represents either a successful value (Ok<T>) or an error (Err<E>).
//
// Usage (include style):
//   include "stdlib/result.suru" as res
//   let r Result<i64, String>: res.ok(42)
//   match r { Ok: { printLn(r.value) }  Err: { printLn(r.error) } }
//
// Usage (import style):
//   import { [Result, Ok, Err, ok, err]: Suru.Stdlib.Result }
//   let r Result<i64, String>: ok(42)
//   match r { Ok: { printLn(r.value) }  Err: { printLn(r.error) } }

namespace Suru.Stdlib.Result

export type Ok<T>:  { value T }
export type Err<E>: { error E }
export type Result<T, E>: Ok<T>, Err<E>

// ok — wrap a success value in Ok<T>.
export fn ok<T>(value T) Ok<T> {
    let o Ok<T>: { value: value }
    return o
}

// err — wrap an error value in Err<E>.
export fn err<E>(error E) Err<E> {
    let e Err<E>: { error: error }
    return e
}
