namespace stdlib.ffi

// typeSize(T) is a compiler intrinsic that returns the element storage size
// of type T in bytes as a compile-time i64 constant:
//   bool, char → 1 | i32 → 4 | all other types → 8
//
// Usage: import { [typeSize]: stdlib.ffi }
// then:  typeSize(i64)          → 8
//        typeSize(i32)          → 4
//        typeSize(T)            → size of T (inside a generic function body)
//
// Note: the argument position accepts a type name, not a value expression.
// The parser rewrites typeSize(T) to a compile-time SizeNode constant before
// semantic analysis; this declaration exists solely to satisfy the export
// system so the import can be validated.

// Byte-addressed pointer ops are now methods on the `ptr` type — no import
// needed (a `ptr` value behaves like an object exposing these builtins):
//
//   p.load(offset i64) → T     // GEP i8 + typed load; T inferred from context
//   p.store(offset i64, val T) // GEP i8 + typed store; void
//   p.add(n i64) → ptr         // GEP i8 — p advanced by n bytes (for memcpy etc.)
//
// They are intercepted by the compiler (semantic/resolveTypes.suru +
// codegen/irCodegen.suru) on a `ptr` receiver, so no phantom declaration is
// required here.

export { typeSize }

fn typeSize<T>() i64 { return 0 }
