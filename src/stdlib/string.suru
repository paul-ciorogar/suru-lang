// string.suru — SuruString: a fully Suru-native, IMMUTABLE string type.
//
// Implements a NUL-terminated byte string using only libc primitives
// (malloc / free / realloc) — no calls to runtime/string.c functions.
//
// A SuruString is immutable: it exposes no in-place mutating methods. Every
// transformation (concat, slice, clone) allocates and returns a fresh
// SuruString. To build a string incrementally, use StringBuilder
// (Suru.Stdlib.StringBuilder) and call its toString() to produce a SuruString.
//
// Internal layout:
//   _ data  ptr   — malloc'd NUL-terminated byte buffer
//   _ count i64   — number of bytes stored (excluding the NUL terminator)
//   _ cap   i64   — total allocated buffer capacity in bytes (always > count)
//
// Construction model: suruStringFromBuffer(buf, n, cap) is the single raw-buffer
// factory and the only object-literal site for SuruString — it takes ownership of a
// malloc'd, NUL-terminated buffer. Every other constructor produces such a buffer and
// delegates to it: suruStringFromBuilder copies a StringBuilder's bytes; clone() does
// a malloc + memcpy; concat/slice build via StringBuilder. The produced SuruString
// owns an independent buffer in every case.
//
// Memory model:
//   SuruString owns its data buffer exclusively.
//   drop() frees the buffer; the struct header is freed by the vtable wrapper.
//
// ptrLoad type-inference note: T is only inferred from let-binding types and
// return types — not from method-argument positions or method-receiver chains.
// All ptrLoad calls therefore use an explicit `let b char: ptrLoad(...)` form.
//
// Usage:
//   import { [SuruString, suruStringFrom]: Suru.Stdlib.String }
//   let s SuruString: suruStringFrom("hello")
//   let t SuruString: s.concat(" world")   // returns a new string
//   printLn(t.len().toString())            // 11
//   drop(s)
//   drop(t)

namespace Suru.Stdlib.String

import { [ptrLoad, ptrStore, ptrAdd]: stdlib.ffi }
import { [StringBuilder, newStringBuilder]: Suru.Stdlib.StringBuilder }

export {
    SuruString
    newSuruString
    suruStringFrom
    suruStringFromBuilder
}

extern fn malloc(n i64) ptr
extern fn free(p ptr) void
extern fn memcpy(dst ptr, src ptr, n i64) void

// SuruString: an immutable string with explicit clone/drop lifecycle.
// Declaring fn clone() and fn drop() sets hasCustomLifecycle = true, so the
// compiler emits vtable-dispatch @suru_clone_SuruString / @suru_drop_SuruString
// wrappers instead of auto-walking fields — required because `data` is a raw ptr.
type SuruString: {
    fn concat(other String) SuruString
    fn concatStr(other SuruString) SuruString
    fn dataBuffer() ptr
    fn len() i64
    fn charAt(idx i64) char
    fn equals(other String) bool
    fn equalsStr(other SuruString) bool
    fn slice(from i64, to i64) SuruString
    fn clone() SuruString
    fn drop() void
}

// suruStringFromBuffer — the single SuruString factory and the only object-literal
// site for SuruString. Takes ownership of a malloc'd, NUL-terminated byte buffer
// `buf` of `n` bytes (excluding the terminator) and `cap` total capacity, and wraps
// it in an immutable SuruString. The returned value owns `buf`; its drop() frees it.
fn suruStringFromBuffer(buf ptr, n i64, cap i64) SuruString {
    return {
        _ data  ptr: buf
        _ count i64: n
        _ cap   i64: cap

        // concat — return a new SuruString equal to this + other. Does not
        // modify this. Accumulates both halves in a StringBuilder, then snapshots.
        fn concat(other String) SuruString {
            let sb StringBuilder: newStringBuilder()
            let i i64: 0
            while i.lt(this.count) {
                let c char: ptrLoad(this.data, i)
                sb.appendChar(c)
                i: i.add(1)
            }
            sb.append(other)
            let r SuruString: suruStringFromBuilder(sb)
            drop(sb)
            return r
        }

        // concatStr — return a new SuruString equal to this + other. Like concat,
        // but appends another immutable SuruString instead of a built-in String.
        // Does not modify this or other. One malloc + two memcpy (this half, then
        // other's bytes at offset this.count via its dataBuffer()), then NUL-terminate
        // — no StringBuilder, no per-byte loop.
        fn concatStr(other SuruString) SuruString {
            let n1 i64: this.count
            let n2 i64: other.len()
            let total i64: n1.add(n2)
            let buf ptr: malloc(total.add(1))
            memcpy(buf, this.data, n1)
            let dst ptr: ptrAdd(buf, n1)
            memcpy(dst, other.dataBuffer(), n2)
            ptrStore(buf, total, '\0')
            return suruStringFromBuffer(buf, total, total.add(1))
        }

        // dataBuffer — return the internal NUL-terminated byte buffer (borrowed,
        // read-only). Exposed so a sibling SuruString can memcpy this string's
        // bytes (e.g. concatStr). The caller must not free or mutate it; the
        // buffer remains owned by this SuruString.
        fn dataBuffer() ptr { return this.data }

        // len — number of bytes in this string (not counting the NUL terminator).
        fn len() i64 { return this.count }

        // charAt — return the byte at position idx (0-based, no bounds check).
        fn charAt(idx i64) char {
            let b char: ptrLoad(this.data, idx)
            return b
        }

        // equals — compare with a built-in String value byte-by-byte.
        fn equals(other String) bool {
            if not this.count.equals(other.len()) { return false }
            let i i64: 0
            while i.lt(this.count) {
                let b char: ptrLoad(this.data, i)
                if not b.equals(other.__at(i)) { return false }
                i: i.add(1)
            }
            return true
        }

        // equalsStr — compare two SuruStrings byte-by-byte.
        fn equalsStr(other SuruString) bool {
            if not this.count.equals(other.len()) { return false }
            let i i64: 0
            while i.lt(this.count) {
                let b char: ptrLoad(this.data, i)
                if not b.equals(other.charAt(i)) { return false }
                i: i.add(1)
            }
            return true
        }

        // slice — return a new SuruString containing bytes [from, to).
        // One malloc + one memcpy from an offset source pointer (this.data + from),
        // then NUL-terminate — no StringBuilder, no per-byte loop.
        fn slice(from i64, to i64) SuruString {
            let n i64: to.take(from)
            let buf ptr: malloc(n.add(1))
            let src ptr: ptrAdd(this.data, from)
            memcpy(buf, src, n)
            ptrStore(buf, n, '\0')
            return suruStringFromBuffer(buf, n, n.add(1))
        }

        // clone — return a deep copy: fresh buffer, same bytes, same length.
        // One malloc + one memcpy (copies the bytes AND the NUL terminator), then
        // hands the buffer to suruStringFromBuffer — no StringBuilder allocation.
        fn clone() SuruString {
            let n i64: this.count
            let buf ptr: malloc(n.add(1))
            memcpy(buf, this.data, n.add(1))
            return suruStringFromBuffer(buf, n, n.add(1))
        }

        // drop — free the data buffer.
        // The struct header itself is freed by the vtable-dispatch wrapper after this returns.
        fn drop() void {
            free(this.data)
        }
    }
}

// suruStringFromBuilder — copy a StringBuilder's bytes into a fresh malloc'd buffer
// and wrap them in an immutable SuruString via suruStringFromBuffer. The builder is
// read-only here (via its public len()/charAt()) and remains owned by the caller.
fn suruStringFromBuilder(b StringBuilder) SuruString {
    let n i64: b.len()
    let buf ptr: malloc(n.add(1))
    let i i64: 0
    while i.lt(n) {
        ptrStore(buf, i, b.charAt(i))
        i: i.add(1)
    }
    ptrStore(buf, n, '\0')
    return suruStringFromBuffer(buf, n, n.add(1))
}

// newSuruString — create an empty immutable SuruString.
fn newSuruString() SuruString {
    let sb StringBuilder: newStringBuilder()
    let r SuruString: suruStringFromBuilder(sb)
    drop(sb)
    return r
}

// suruStringFrom — create a SuruString by copying bytes from a built-in String value.
// Handles both static string literals (type_tag=8) and heap strings (type_tag=6).
fn suruStringFrom(s String) SuruString {
    let sb StringBuilder: newStringBuilder()
    sb.append(s)
    let r SuruString: suruStringFromBuilder(sb)
    drop(sb)
    return r
}
