// option.suru — generic Option sum type.
//
// Option<T> represents a value that may or may not be present.
// None signals absence (variant index 0); Some<T> holds a value (variant index 1).
//
// None is listed first in the variant declaration so that None: {} struct
// literals created outside the monomorphized context (e.g. in the none()
// helper compiled by compileOneFile) keep the default variant_idx=0 and
// are dispatched correctly by suru_variant_tag.
//
// Usage (include style):
//   include "stdlib/option.suru" as opt
//   let x Option<i64>: opt.some(42)
//   let n Option<i64>: opt.none()
//   match x { Some: { printLn(x.value) }  None: { printLn("none") } }
//
// Usage (import style):
//   import { [Option, Some, None, some, none]: Suru.Stdlib.Option }
//   let x Option<i64>: some(42)
//   let n Option<i64>: none()
//   match x { Some: { printLn(x.value) }  None: { printLn("none") } }

namespace Suru.Stdlib.Option

export {
    Option
    Some
    None
    some
    none
}

type Some<T>: { value T }
type None: {}

// None is variant 0, Some<T> is variant 1.  This ordering ensures that a
// None struct created in compileOneFile (where the generic Option<T> is
// filtered out by filterGenericDefs) retains the default variant_idx=0 and
// is correctly dispatched by suru_variant_tag in any Option<T> match.
type Option<T>: None, Some<T>

// some — wrap a value in Some, returning Option<T>.
fn some<T>(value T) Option<T> {
    let s Some<T>: { value: value }
    return s
}

// none — return a None value for use where Option<T> is expected.
// Works correctly because None is variant index 0, matching the default
// variant_idx emitted by emitObjectLiteralAlloc when Option<T> is absent
// from the codegen context (filtered by filterGenericDefs).
fn none() None {
    let n None: {}
    return n
}
